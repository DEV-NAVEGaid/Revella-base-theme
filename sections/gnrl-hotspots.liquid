      "max": 1600,
      "step": 20,
      "default": 1100
    },
    {
      "type": "range",
      "id": "image_max_width",
      "label": "Image max width (rem)",
      "min": 20,
      "max": 60,
      "step": 1,
      "default": 35
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding left/right (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 20
