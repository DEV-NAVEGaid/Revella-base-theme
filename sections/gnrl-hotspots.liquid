    {
      "type": "range",
      "id": "mobile_offset_y",
      "label": "Mobile vertical position (%)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 30
    },
    {
      "type": "header",
      "content": "Hotspot pin"
    },
    {
      "type": "range",
      "id": "pin_size",
      "label": "Pin size (px)",
      "min": 0,
