{% comment %}
  General Journey Timeline — gnrl-journey.liquid
  Matches reference: large circular dot/checkmark icons, label as eyebrow+heading,
  sticky image left column, scroll-activated active states.
{% endcomment %}

{%- liquid
  assign active_color   = section.settings.dot_color
  assign inactive_color = section.settings.inactive_dot_color
  assign line_color     = section.settings.line_color
  assign inactive_line  = section.settings.inactive_line_color
  assign dot_bg_alpha   = section.settings.dot_bg_opacity | divided_by: 100.0
  assign dot_bg_rgba    = section.settings.dot_bg_color | color_to_rgb | replace: 'rgb(', '' | replace: ')', ''
-%}

<section
  id="GnrlJourney-{{ section.id }}"
  class="gnrl-journey{% if section.settings.show_dot_background %} gnrl-journey--dotted{% endif %}"
  style="
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
  "
>
  <div class="gnrl-journey__inner" style="max-width: {{ section.settings.max_width }}px; margin: 0 auto;">
    <div class="gnrl-journey__layout{% if section.settings.image_position == 'right' %} gnrl-journey__layout--image-right{% endif %}">

      {%- comment -%} ── Image column ── {%- endcomment -%}
      <div class="gnrl-journey__image-col">
        {%- if section.settings.desktop_image != blank -%}
          <img
            src="{{ section.settings.desktop_image | image_url: width: 900 }}"
            alt="{{ section.settings.desktop_image.alt | escape }}"
            class="gnrl-journey__image"
            loading="lazy"
            style="border-radius: {{ section.settings.image_border_radius }}px;"
          >
        {%- elsif section.settings.mobile_image != blank -%}
          <img
            src="{{ section.settings.mobile_image | image_url: width: 900 }}"
            alt="{{ section.settings.mobile_image.alt | escape }}"
            class="gnrl-journey__image"
            loading="lazy"
            style="border-radius: {{ section.settings.image_border_radius }}px;"
          >
        {%- endif -%}
      </div>

      {%- comment -%} ── Content column ── {%- endcomment -%}
      <div class="gnrl-journey__content-col">

        {%- comment -%} Mobile-only hero image {%- endcomment -%}
        {%- if section.settings.mobile_image != blank -%}
          <div class="gnrl-journey__mobile-hero" style="margin-bottom: {{ section.settings.hero_margin_bottom }}px;">
            <img
              src="{{ section.settings.mobile_image | image_url: width: 800 }}"
              alt="{{ section.settings.mobile_image.alt | escape }}"
              style="width:100%;height:auto;display:block;border-radius:{{ section.settings.image_border_radius }}px;object-fit:cover;"
              loading="lazy"
            >
          </div>
        {%- endif -%}

        {%- comment -%} Section header {%- endcomment -%}
        {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtext != blank -%}
          <div
            class="gnrl-journey__header"
            style="
              text-align: {{ section.settings.header_alignment }};
              margin-bottom: {{ section.settings.header_margin_bottom }}px;
            "
          >
            {%- if section.settings.eyebrow != blank -%}
              <p class="gnrl-journey__eyebrow" style="color:{{ section.settings.eyebrow_color }};font-size:{{ section.settings.eyebrow_font_size }}px;font-weight:{{ section.settings.eyebrow_font_weight }};font-family:var(--font-heading-family);margin:0 0 6px;line-height:1.2;letter-spacing:0.04em;text-transform:uppercase;">{{ section.settings.eyebrow }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2 class="gnrl-journey__heading" style="color:{{ section.settings.heading_color }};font-size:{{ section.settings.heading_font_size }}px;font-weight:{{ section.settings.heading_font_weight }};font-family:var(--font-heading-family);margin:0 0 12px;line-height:1.2;">{{ section.settings.heading }}</h2>
            {%- endif -%}
            {%- if section.settings.subtext != blank -%}
              <p class="gnrl-journey__subtext" style="color:{{ section.settings.subtext_color }};font-size:{{ section.settings.subtext_font_size }}px;font-family:var(--font-body-family);line-height:1.6;margin:0;">{{ section.settings.subtext }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} Timeline {%- endcomment -%}
        <div
          class="gnrl-journey__timeline"
          id="gnrlTimeline-{{ section.id }}"
          style="
            --active-color: {{ active_color }};
            --inactive-color: {{ inactive_color }};
            --line-color: {{ line_color }};
            --inactive-line-color: {{ inactive_line }};
            --point-size: {{ section.settings.point_size_mobile }}px;
            --line-thickness: {{ section.settings.line_thickness }}px;
            --line-point-spacing: {{ section.settings.line_point_spacing }}px;
            --items-spacing-vertical: {{ section.settings.step_gap }}px;
            --timeline-active-transition: {{ section.settings.active_transition }}s;
            --inactive-item-opacity: {{ section.settings.inactive_opacity | divided_by: 100.0 }};
          "
        >
          {%- for block in section.blocks -%}
            {%- if block.type == 'timeline_step' -%}
              <div
                class="gnrl-journey__step{% if forloop.last %} gnrl-journey__step--last{% endif %}"
                {{ block.shopify_attributes }}
              >
                {%- comment -%} Left: dot + line {%- endcomment -%}
                <div class="gnrl-journey__step-track">
                  <div class="gnrl-journey__step-dot">
                    <span class="gnrl-journey__check-ring"></span>
                    {%- comment -%} Checkmark SVG {%- endcomment -%}
                    <svg class="gnrl-journey__check-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M5 13L9 17L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                  <div class="gnrl-journey__step-line"><span class="gnrl-journey__step-line-fill"></span></div>
                </div>

                {%- comment -%} Right: step content {%- endcomment -%}
                <div class="gnrl-journey__step-body" style="padding-bottom: {{ section.settings.step_gap }}px;">
                  {%- if block.settings.label_eyebrow != blank -%}
                    <p class="gnrl-journey__step-eyebrow" style="color:{{ section.settings.step_eyebrow_color }};font-size:{{ section.settings.step_eyebrow_font_size }}px;font-weight:{{ section.settings.step_eyebrow_font_weight }};font-family:var(--font-heading-family);margin:0 0 4px;line-height:1.2;text-transform:uppercase;letter-spacing:0.05em;">{{ block.settings.label_eyebrow }}</p>
                  {%- endif -%}
                  {%- if block.settings.label != blank -%}
                    <p class="gnrl-journey__step-title" style="color:{{ section.settings.step_title_color }};font-size:{{ section.settings.step_title_font_size }}px;font-weight:{{ section.settings.step_title_font_weight }};font-family:var(--font-heading-family);margin:0 0 8px;line-height:1.3;">{{ block.settings.label }}</p>
                  {%- endif -%}
                  {%- if block.settings.items != blank -%}
                    {%- assign item_lines = block.settings.items | newline_to_br | split: '<br />' -%}
                    <ul class="gnrl-journey__items" style="font-size:{{ section.settings.item_font_size }}px;color:{{ section.settings.item_text_color }};">
                      {%- for item in item_lines -%}
                        {%- assign item_clean = item | strip_html | strip -%}
                        {%- if item_clean != blank -%}
                          <li>
                            {{ item_clean }}
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- comment -%} Tagline {%- endcomment -%}
        {%- if section.settings.tagline != blank -%}
          <p style="color:{{ section.settings.tagline_color }};font-size:{{ section.settings.tagline_font_size }}px;font-style:{{ section.settings.tagline_font_style }};font-family:var(--font-body-family);line-height:1.5;margin:{{ section.settings.tagline_margin_top }}px 0 0;text-align:{{ section.settings.header_alignment }};">{{ section.settings.tagline }}</p>
        {%- endif -%}

        {%- comment -%} CTA {%- endcomment -%}
        {%- if section.settings.button_label != blank -%}
          <div style="margin-top: {{ section.settings.cta_margin_top }}px;">
            <a
              href="{{ section.settings.button_url }}"
              style="display:flex;align-items:center;justify-content:center;gap:10px;width:100%;padding:{{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;background:{{ section.settings.button_background }};color:{{ section.settings.button_text_color }};border-radius:{{ section.settings.button_border_radius }}px;font-size:{{ section.settings.button_font_size }}px;font-weight:{{ section.settings.button_font_weight }};font-family:var(--font-body-family);text-decoration:none;box-sizing:border-box;transition:opacity 0.2s;"
            >
              {{ section.settings.button_label }}
              {%- if section.settings.button_show_arrow -%}
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- endif -%}
            </a>
            {%- if section.settings.guarantee_text != blank -%}
              <p style="text-align:center;margin:{{ section.settings.guarantee_margin_top }}px 0 0;color:{{ section.settings.guarantee_color }};font-size:{{ section.settings.guarantee_font_size }}px;font-family:var(--font-body-family);">{{ section.settings.guarantee_text }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>{%- comment -%} /.gnrl-journey__content-col {%- endcomment -%}
    </div>{%- comment -%} /.gnrl-journey__layout {%- endcomment -%}
  </div>{%- comment -%} /.gnrl-journey__inner {%- endcomment -%}
</section>

<style>
/* ─────────────────────────────────────────
   GNRL Journey Timeline
   ───────────────────────────────────────── */
#GnrlJourney-{{ section.id }} {
  box-sizing: border-box;
  width: 100%;
  position: relative;
  isolation: isolate;
}

/* ── Dotted background (applied directly to section) ── */
#GnrlJourney-{{ section.id }}.gnrl-journey--dotted {
  background-image: radial-gradient(circle, rgba({{ dot_bg_rgba }}, {{ dot_bg_alpha }}) {{ section.settings.dot_bg_size }}px, transparent {{ section.settings.dot_bg_size }}px) !important;
  background-size: {{ section.settings.dot_bg_spacing }}px {{ section.settings.dot_bg_spacing }}px !important;
  background-repeat: repeat !important;
  background-position: 0 0 !important;
  background-color: {{ section.settings.background_color }} !important;
}

#GnrlJourney-{{ section.id }} .gnrl-journey__inner {
  position: relative;
  z-index: 1;
}

/* ── Outer layout ── */
#GnrlJourney-{{ section.id }} .gnrl-journey__layout {
  display: flex;
  flex-direction: column;
  gap: {{ section.settings.desktop_col_gap }}px;
  align-items: flex-start;
}

/* ── Image column — hidden on mobile ── */
#GnrlJourney-{{ section.id }} .gnrl-journey__image-col {
  display: none;
}
#GnrlJourney-{{ section.id }} .gnrl-journey__image {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
}

/* ── Content column ── */
#GnrlJourney-{{ section.id }} .gnrl-journey__content-col {
  width: 100%;
  min-width: 0;
}

/* ── Mobile hero: visible on mobile only ── */
#GnrlJourney-{{ section.id }} .gnrl-journey__mobile-hero {
  display: block;
}

/* ─── Timeline container ─── */
#GnrlJourney-{{ section.id }} .gnrl-journey__timeline {
  display: flex;
  flex-direction: column;
}

/* ─── Single step ─── */
#GnrlJourney-{{ section.id }} .gnrl-journey__step {
  display: flex;
  gap: {{ section.settings.dot_content_gap }}px;
  align-items: stretch;
  opacity: var(--inactive-item-opacity);
  transition: opacity var(--timeline-active-transition) ease;
}

#GnrlJourney-{{ section.id }} .gnrl-journey__step.is-active {
  opacity: 1;
}

/* ─── Track: dot + line ─── */
#GnrlJourney-{{ section.id }} .gnrl-journey__step-track {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: var(--point-size);
}

/* ─── Dot ─── */
#GnrlJourney-{{ section.id }} .gnrl-journey__step-dot {
  width: var(--point-size);
  height: var(--point-size);
  border-radius: 50%;
  background: var(--inactive-color);
  border: 2px solid var(--inactive-color);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  transition:
    background var(--timeline-active-transition) ease,
    border-color var(--timeline-active-transition) ease;
  position: relative;
  z-index: 1;
}

#GnrlJourney-{{ section.id }} .gnrl-journey__step.is-active .gnrl-journey__step-dot {
  background: var(--active-color);
  border-color: var(--active-color);
}

/* ─── White ring around checkmark (active state) ─── */
#GnrlJourney-{{ section.id }} .gnrl-journey__check-ring {
  position: absolute;
  inset: calc(var(--point-size) * 0.12);
  border-radius: 50%;
  border: 1.5px solid #ffffff;
  opacity: 0;
  transition: opacity var(--timeline-active-transition) ease;
  pointer-events: none;
}

#GnrlJourney-{{ section.id }} .gnrl-journey__step.is-active .gnrl-journey__check-ring {
  opacity: 1;
}

/* ─── Checkmark icon (SVG) ─── */
#GnrlJourney-{{ section.id }} .gnrl-journey__check-icon {
  position: relative;
  width: calc(var(--point-size) * 0.45);
  height: calc(var(--point-size) * 0.45);
  color: #ffffff;
  display: block;
  opacity: 0;
  transition: opacity var(--timeline-active-transition) ease;
}

#GnrlJourney-{{ section.id }} .gnrl-journey__step.is-active .gnrl-journey__check-icon {
  opacity: 1;
}

/* ─── Connecting line ─── */
#GnrlJourney-{{ section.id }} .gnrl-journey__step-line {
  flex: 1 1 auto;
  width: var(--line-thickness);
  min-height: 24px;
  background: var(--inactive-line-color);
  margin-top: var(--line-point-spacing);
  position: relative;
  overflow: hidden;
}

#GnrlJourney-{{ section.id }} .gnrl-journey__step-line-fill {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 0%;
  background: var(--line-color);
  transition: height var(--timeline-active-transition) ease;
  display: block;
}

#GnrlJourney-{{ section.id }} .gnrl-journey__step.is-active .gnrl-journey__step-line-fill {
  height: 100%;
}

/* ─── Step body ─── */
#GnrlJourney-{{ section.id }} .gnrl-journey__step-body {
  flex: 1;
  min-width: 0;
  padding-top: calc(var(--point-size) * 0.15);
}

/* ─── Step eyebrow ─── */
#GnrlJourney-{{ section.id }} .gnrl-journey__step-eyebrow {
  display: block;
}

/* ─── Step title ─── */
#GnrlJourney-{{ section.id }} .gnrl-journey__step-title {
  display: block;
}

/* ─── Bullet list ─── */
#GnrlJourney-{{ section.id }} .gnrl-journey__items {
  list-style: none;
  padding: {{ section.settings.items_padding_top }}px 0 {{ section.settings.items_padding_bottom }}px;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-family: var(--font-body-family);
  line-height: 1.5;
}

#GnrlJourney-{{ section.id }} .gnrl-journey__items li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}

#GnrlJourney-{{ section.id }} .gnrl-journey__item-check {
  font-weight: 700;
  flex-shrink: 0;
  line-height: 1.5;
}

/* ─────────────────────────────────────────
   Desktop (≥ 750 px)
   ───────────────────────────────────────── */
@media screen and (min-width: 750px) {

  /* Hide mobile hero */
  #GnrlJourney-{{ section.id }} .gnrl-journey__mobile-hero {
    display: none;
  }

  /* Show image column */
  #GnrlJourney-{{ section.id }} .gnrl-journey__image-col {
    display: flex;
    flex-shrink: 0;
    width: {{ section.settings.desktop_image_width }}%;
    align-items: flex-start;
    position: sticky;
    bottom: {{ section.settings.desktop_image_sticky_bottom }}px;
    align-self: flex-end;
  }

  /* Row layout */
  #GnrlJourney-{{ section.id }} .gnrl-journey__layout {
    flex-direction: row;
    align-items: flex-start;
  }

  /* Image-right variant */
  #GnrlJourney-{{ section.id }} .gnrl-journey__layout--image-right {
    flex-direction: row-reverse;
  }

  /* Content col takes remaining space */
  #GnrlJourney-{{ section.id }} .gnrl-journey__content-col {
    flex: 1;
  }

  /* Larger dots on desktop */
  #GnrlJourney-{{ section.id }} .gnrl-journey__timeline {
    --point-size: {{ section.settings.point_size_desktop }}px;
  }

  /* Hide image col if toggled off */
  {% if section.settings.hide_image_on_desktop %}
  #GnrlJourney-{{ section.id }} .gnrl-journey__image-col {
    display: none !important;
  }
  #GnrlJourney-{{ section.id }} .gnrl-journey__layout {
    justify-content: center;
  }
  #GnrlJourney-{{ section.id }} .gnrl-journey__content-col {
    max-width: {{ section.settings.desktop_content_max_width }}px;
  }
  {% endif %}
}
</style>

<script>
(function () {
  function initGnrlJourney() {
    var section = document.getElementById('GnrlJourney-{{ section.id }}');
    if (!section) return;

    var timeline = section.querySelector('.gnrl-journey__timeline');
    if (!timeline) return;

    var steps = Array.from(section.querySelectorAll('.gnrl-journey__step'));
    if (!steps.length) return;

    function activate(index) {
      steps.forEach(function (step, i) {
        if (i <= index) {
          step.classList.add('is-active');
        } else {
          step.classList.remove('is-active');
        }
      });
    }

    function onScroll() {
      var windowH = window.innerHeight;
      var activeIndex = 0; // Always keep at least the first active
      steps.forEach(function (step, i) {
        var dot = step.querySelector('.gnrl-journey__step-dot');
        var target = dot || step;
        var rect = target.getBoundingClientRect();
        // A step becomes active once its dot has crossed ~72% down the viewport
        var trigger = rect.top + rect.height * 0.5;
        if (trigger < windowH * 0.72) {
          activeIndex = i;
        }
      });
      activate(activeIndex);
    }

    // Activate first step immediately, then run once to set correct state
    steps[0].classList.add('is-active');
    onScroll();

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGnrlJourney);
  } else {
    initGnrlJourney();
  }

  document.addEventListener('shopify:section:load', function (e) {
    if (e.target.querySelector('#GnrlJourney-{{ section.id }}')) {
      initGnrlJourney();
    }
  });
})();
</script>

{% schema %}
{
  "name": " GNRL Journey timeline",
  "tag": "section",
  "class": "gnrl-journey-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width (px)",
      "min": 400,
      "max": 1600,
      "step": 20,
      "default": 1100
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding left/right (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 20
    },
    {
      "type": "header",
      "content": "Background pattern"
    },
    {
      "type": "checkbox",
      "id": "show_dot_background",
      "label": "Show dotted background",
      "default": false
    },
    {
      "type": "color",
      "id": "dot_bg_color",
      "label": "Dot color",
      "default": "#d9d9d9"
    },
    {
      "type": "range",
      "id": "dot_bg_size",
      "label": "Dot size (px)",
      "min": 1,
      "max": 4,
      "step": 0.5,
      "default": 1.5
    },
    {
      "type": "range",
      "id": "dot_bg_spacing",
      "label": "Dot spacing (px)",
      "min": 10,
      "max": 60,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "dot_bg_opacity",
      "label": "Dot background opacity (%)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 100
    },
    {
      "type": "header",
      "content": "Image column"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Shown at the top on mobile. Also used as desktop column fallback."
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop column image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image column position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "desktop_image_width",
      "label": "Desktop image column width (%)",
      "min": 20,
      "max": 60,
      "step": 5,
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "hide_image_on_desktop",
      "label": "Hide image on desktop",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_content_max_width",
      "label": "Max content width when image hidden (px)",
      "min": 400,
      "max": 1000,
      "step": 20,
      "default": 700
    },
    {
      "type": "range",
      "id": "desktop_col_gap",
      "label": "Column gap (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "desktop_image_sticky_bottom",
      "label": "Sticky image: offset from bottom (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius (px)",
      "min": 0,
      "max": 40,
      "step": 2,
