{% render 'oc-assets' %}
{%- assign s = section.settings -%}
{%- assign steps = section.blocks | where: 'type', 'step' -%}
<div class="lm">
  <section class="wrap rr" style="--rr-bg: {{ s.background | default: '#F8F9FA' }}; --rr-accent: {{ s.accent | default: '#289383' }}">
    <div class="rr-i">
      <div class="rr-h">
        {%- if s.heading != blank %}<h2 class="rr-h2">{{ s.heading }}</h2>{% endif -%}
        {%- if s.intro != blank %}<p class="rr-intro">{{ s.intro }}</p>{% endif -%}
      </div>
      {%- if steps.size > 0 -%}
        <ol class="rr-tl">
          {%- for block in steps -%}
            <li class="rr-st" {{ block.shopify_attributes }}>
              <span class="rr-node" aria-hidden="true"></span>
              {%- if block.settings.label != blank %}<span class="rr-pill">{{ block.settings.label }}</span>{% endif -%}
              {%- if block.settings.title != blank %}<h3 class="rr-t">{{ block.settings.title }}</h3>{% endif -%}
              {%- assign lines = block.settings.points | newline_to_br | split: '<br />' -%}
              <div class="rr-pts">
                {%- for line in lines -%}
                  {%- assign l = line | strip -%}
                  {%- if l != blank -%}
                    <p class="rr-pt"><span aria-hidden="true">&#10003;</span> {{ l }}</p>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
      {%- if s.footnote != blank %}<p class="rr-note">{{ s.footnote }}</p>{% endif -%}
    </div>
  </section>
</div>

<style>
  .lm.lm .rr{background:var(--rr-bg);padding:48px 20px}
  .lm.lm .rr-i{max-width:800px;margin:0 auto;display:flex;flex-direction:column;gap:40px}
  .lm.lm .rr-h{display:flex;flex-direction:column;align-items:center;gap:16px;text-align:center}
  .lm.lm .rr-h2{font-family:var(--font-heading-family);font-weight:var(--font-heading-weight);font-size:28px;line-height:36px;color:#121212;text-align:center;margin:0;padding:0}
  .lm.lm .rr-h2 em{font-style:normal;color:var(--rr-accent)}
  .lm.lm .rr-intro{font-size:16px;line-height:24px;color:#121212;text-align:center;max-width:640px;margin:0;padding:0}
  .lm.lm .rr-tl{position:relative;list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:32px;max-width:450px;width:100%}
  .lm.lm .rr-tl::before{content:"";position:absolute;left:14px;top:15px;bottom:0;width:2px;background:#d4d4d4}
  .lm.lm .rr-st{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:8px;padding:0 0 0 50px;margin:0}
  .lm.lm .rr-node{position:absolute;left:0;top:0;width:30px;height:30px;border-radius:50%;background:var(--rr-accent)}
  .lm.lm .rr-node::after{content:"";position:absolute;left:9px;top:9px;width:12px;height:12px;border-radius:50%;background:#fff}
  .lm.lm .rr-pill{display:inline-block;padding:4px 12px;border-radius:50px;background:var(--rr-accent);color:#fff;font-size:12px;line-height:18px;font-weight:700;letter-spacing:.02em;text-transform:uppercase}
  .lm.lm .rr-t{font-family:var(--font-heading-family);font-weight:var(--font-heading-weight);font-size:20px;line-height:28px;color:#121212;margin:0;padding:0}
  .lm.lm .rr-pts{display:flex;flex-direction:column;gap:8px}
  .lm.lm .rr-pt{font-size:15px;line-height:24px;color:#666;margin:0;padding:0}
  .lm.lm .rr-note{font-size:14px;line-height:20px;color:#666;text-align:center;margin:0;padding:0}
  @media screen and (min-width:990px){
    .lm.lm .rr{padding:60px 20px}
    .lm.lm .rr-i{gap:44px}
    .lm.lm .rr-h2{font-size:36px;line-height:47px}
    .lm.lm .rr-tl{align-self:flex-start;margin-left:0}
    .lm.lm .rr-t{font-size:24px;line-height:31px}
    .lm.lm .rr-pt{font-size:16px;line-height:26px}
  }
</style>

{% schema %}
{
  "name": "OC: Routine timeline",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Wrap the accent part in italic (em) to colour it. Empty hides the heading.", "default": "Your simple <em>daily routine</em>" },
    { "type": "textarea", "id": "intro", "label": "Intro line", "info": "Empty hides the line.", "default": "A steady habit works best. Here is an easy way to begin." },
    { "type": "text", "id": "footnote", "label": "Footnote", "info": "Small text under the timeline. Empty hides it.", "default": "Individual results may vary." },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background", "label": "Background colour", "info": "Empty = light grey.", "default": "#F8F9FA" },
    { "type": "color", "id": "accent", "label": "Accent colour", "info": "Heading accent, nodes and labels. Empty = teal.", "default": "#289383" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "info": "Short pill above the title. Empty hides it.", "default": "Weeks 1-2" },
        { "type": "text", "id": "title", "label": "Title", "default": "Start simple" },
        { "type": "textarea", "id": "points", "label": "Points", "info": "One per line, each gets a check mark.", "default": "Take it at the same time each day\nKeep it where you will see it" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OC: Routine timeline",
      "blocks": [
        { "type": "step", "settings": { "label": "Weeks 1-2", "title": "Start simple", "points": "Take it at the same time each day\nKeep it where you will see it" } },
        { "type": "step", "settings": { "label": "Weeks 3-4", "title": "Stay consistent", "points": "Pair it with water and balanced meals\nAdd a little movement" } },
        { "type": "step", "settings": { "label": "Weeks 5-8", "title": "Make it a habit", "points": "Daily use becomes part of your day\nKeep your routine steady" } },
        { "type": "step", "settings": { "label": "Week 8+", "title": "Keep going", "points": "Stay with your daily routine\nCheck in with your doctor" } }
      ]
    }
  ]
}
{% endschema %}
