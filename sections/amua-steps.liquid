<section class="amua-section amua-center" style="--bg:{{ section.settings.background }};--fg:{{ section.settings.text_color }};--accent:{{ section.settings.accent }};--heading-size:{{ section.settings.heading_size }}px;--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
  <div class="amua-page">
    <h2 class="amua-heading">{{ section.settings.heading }} <span class="amua-accent">{{ section.settings.accent_heading }}</span></h2>
    <div class="amua-subheading rte">{{ section.settings.subheading }}</div>
    <div class="amua-grid" style="--columns:{{ section.settings.columns }}">
      {% for block in section.blocks %}<article class="amua-card" style="--card-bg:{{ section.settings.card_background }};--border:{{ section.settings.border_color }};--card-radius:{{ section.settings.card_radius }}px" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300,500,800' }}{% else %}<div class="amua-placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}<div class="amua-card__body" style="text-align:left"><div style="display:flex;align-items:center;gap:12px"><span class="amua-check">{{ forloop.index }}</span><h3>{{ block.settings.heading }}</h3></div><div class="rte">{{ block.settings.text }}</div></div></article>{% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Anua: How to use steps","settings":[{"type":"text","id":"heading","label":"Heading","default":"The Morning Ritual"},{"type":"text","id":"accent_heading","label":"Accent heading","default":"That Builds Your Curves"},{"type":"richtext","id":"subheading","label":"Subheading","default":"<p>Follow these simple steps to get started.</p>"},{"type":"range","id":"columns","label":"Desktop columns","min":2,"max":4,"step":1,"default":3},{"type":"color","id":"background","label":"Background","default":"#FFFFFF"},{"type":"color","id":"text_color","label":"Text","default":"#000000"},{"type":"color","id":"accent","label":"Accent","default":"#FECD4D"},{"type":"color","id":"card_background","label":"Card background","default":"#FFFFFF"},{"type":"color","id":"border_color","label":"Card border","default":"#E6E6E6"},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":30,"step":1,"unit":"px","default":10},{"type":"range","id":"heading_size","label":"Heading size","min":28,"max":64,"step":2,"unit":"px","default":40},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":120,"step":4,"unit":"px","default":60},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":120,"step":4,"unit":"px","default":60}],"blocks":[{"type":"step","name":"Step","settings":[{"type":"image_picker","id":"image","label":"Image or GIF"},{"type":"text","id":"heading","label":"Heading","default":"Squeeze & Fill"},{"type":"richtext","id":"text","label":"Description","default":"<p>Use the dropper as directed every morning.</p>"}]}],"max_blocks":6,"presets":[{"name":" Anua: How to use steps","blocks":[{"type":"step","settings":{"heading":"Squeeze & Fill"}},{"type":"step","settings":{"heading":"Drop & Absorb"}},{"type":"step","settings":{"heading":"Stay the Course"}}]}]}
{% endschema %}
