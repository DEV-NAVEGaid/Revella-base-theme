{% render 'oc-assets' %}
{%- assign s = section.settings -%}
{%- assign btn_variant = s.button_style | replace: 'light', '' -%}
{%- assign cards = section.blocks | where: 'type', 'card' -%}
{%- assign stats = section.blocks | where: 'type', 'stat' -%}
{%- assign start = s.start_slide -%}
{%- if start > cards.size %}{% assign start = 1 %}{% endif -%}
<div class="lm">
  <section class="wrap mis"{% if s.background != blank %} style="background: {{ s.background }}"{% endif %}>
    <div class="inner">
      <div class="hd">
        {%- if s.eyebrow != blank %}<span class="eb">{{ s.eyebrow }}</span>{% endif -%}
        {%- if s.heading != blank %}<h2 class="h2">{{ s.heading }}</h2>{% endif -%}
      </div>
      {%- if cards.size > 0 -%}
        <lm-carousel data-start="{{ start }}">
          <div class="hscroll mis-cards">
            {%- for block in cards -%}
              <article class="mc" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <div class="img">{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '320, 480, 640, 820, 1000', sizes: '(min-width: 990px) 33vw, 310px', alt: block.settings.image.alt }}</div>
                {%- else -%}
                  <div class="img ph">{{ block.settings.image_placeholder }}</div>
                {%- endif -%}
                <div class="shade"></div>
                <div class="cb">
                  <div>
                    {%- if block.settings.name != blank %}<p class="cn">{{ block.settings.name }}</p>{% endif -%}
                    {%- if block.settings.role != blank %}<p class="cr">{{ block.settings.role }}</p>{% endif -%}
                  </div>
                  {%- if block.settings.quote != blank %}<p class="cq">{{ block.settings.quote }}</p>{% endif -%}
                </div>
              </article>
            {%- endfor -%}
          </div>
          {%- if s.show_dots -%}
            {% render 'oc-dots', count: cards.size, start: start, style: 'margin-top: -24px', prev_icon: s.prev_icon, next_icon: s.next_icon %}
          {%- endif -%}
        </lm-carousel>
      {%- endif -%}
      {%- if stats.size > 0 -%}
        <div class="mis-stats">
          {%- for block in stats -%}
            {%- unless forloop.first %}<div class="st-div"></div>{% endunless -%}
            <div class="st" {{ block.shopify_attributes }}>
              {%- if block.settings.show_stars -%}
                <div class="row">{% render 'oc-stars' %}<p class="num">{{ block.settings.number }}</p></div>
              {%- else -%}
                <p class="num">{{ block.settings.number }}</p>
              {%- endif -%}
              {%- if block.settings.label != blank %}<p class="lbl">{{ block.settings.label }}</p>{% endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {% render 'oc-cta', label: s.button_label, link: s.button_link, variant: btn_variant, guarantee: s.guarantee, show_guarantee: s.show_guarantee, guarantee_icon: s.guarantee_icon, arrow_icon: s.arrow_icon, dark: true %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "OC: Trusted / mission",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow badge", "default": "Trusted by the world's best" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Athletes. Coaches. [3M+] Servings Delivered. <em>They all use Lymphgem.</em>", "info": "Italic text is shown in the blue accent color." },
    { "type": "header", "content": "Cards carousel (mobile)" },
    { "type": "checkbox", "id": "show_dots", "label": "Show dots & arrows", "default": true },
    { "type": "image_picker", "id": "prev_icon", "label": "Previous arrow icon", "info": "Optional. Replaces the default left arrow. Square PNG/SVG." },
    { "type": "image_picker", "id": "next_icon", "label": "Next arrow icon", "info": "Optional. Replaces the default right arrow. Square PNG/SVG." },
    { "type": "range", "id": "start_slide", "label": "Start on card", "min": 1, "max": 6, "step": 1, "default": 2 },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Try Lymphgem Today" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Empty = scroll to the featured product (#product)." },
    { "type": "image_picker", "id": "arrow_icon", "label": "Button arrow icon", "info": "Optional. Replaces the default arrow inside the button. Square PNG/SVG, shown at 20x20px." },
    { "type": "select", "id": "button_style", "label": "Button style", "default": "dk", "options": [ { "value": "light", "label": "Light" }, { "value": "dk", "label": "Dark" }, { "value": "gh", "label": "Outline" } ] },
    { "type": "text", "id": "guarantee", "label": "Guarantee text", "default": "60-day Money-Back Guarantee" },
    { "type": "checkbox", "id": "show_guarantee", "label": "Show guarantee line", "default": true },
    { "type": "image_picker", "id": "guarantee_icon", "label": "Guarantee icon", "info": "Square PNG/SVG, shown 20 px. Empty = shield icon." },
    { "type": "header", "content": "Style" },
    { "type": "color_background", "id": "background", "label": "Background override", "info": "Empty = design gradient (#DCE6F0 → #F1F5F9)." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Testimonial card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Portrait, 310 × 420 px on mobile." },
        { "type": "text", "id": "image_placeholder", "label": "Placeholder text", "default": "[Photo]" },
        { "type": "text", "id": "name", "label": "Name", "default": "[Customer name]" },
        { "type": "text", "id": "role", "label": "Role", "default": "Loyal Customer" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "\"[Short testimonial about why they take Lymphgem every morning.]\"" }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "checkbox", "id": "show_stars", "label": "Show stars", "default": false },
        { "type": "text", "id": "number", "label": "Number", "default": "[3,255]" },
        { "type": "text", "id": "label", "label": "Label", "default": "Verified reviews" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OC: Trusted / mission",
      "blocks": [
        { "type": "card" },
        { "type": "card", "settings": { "name": "[Expert name]", "role": "[Expert title]", "quote": "\"[Short note from the founder or expert on why the product exists.]\"" } },
        { "type": "card", "settings": { "quote": "\"[Short testimonial about sticking with it for months.]\"" } },
        { "type": "stat", "settings": { "show_stars": true, "number": "[4.8]", "label": "out of 5 Star Reviews" } },
        { "type": "stat" },
        { "type": "stat", "settings": { "number": "[70K+]", "label": "Customer purchases" } }
      ]
    }
  ]
}
{% endschema %}
