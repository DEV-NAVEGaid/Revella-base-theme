{% render 'oc-assets' %}
{%- assign s = section.settings -%}
<div class="lm">
  <section class="stx">
    <div class="stx-i">
      <div class="stx-img">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '375, 600, 900, 1200', sizes: '(min-width: 990px) 600px, 100vw', alt: s.image.alt }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'stx-ph' }}
        {%- endif -%}
      </div>
      <div class="stx-c">
        {%- if s.heading != blank %}<h2>{{ s.heading }}</h2>{% endif -%}
        {%- if s.body != blank %}<div class="stx-b">{{ s.body }}</div>{% endif -%}
        {%- if section.blocks.size > 0 -%}
          <div class="stx-l">
            {%- for block in section.blocks -%}
              <details class="stx-d" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
                <summary>
                  <span>{{ block.settings.title }}</span>
                  <span class="stx-pm" aria-hidden="true"></span>
                </summary>
                {%- if block.settings.content != blank %}<div class="stx-a">{{ block.settings.content }}</div>{% endif -%}
              </details>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

<style>
  .lm.lm .stx{background:#fff;color:#333}
  .lm.lm .stx-i{max-width:1320px;margin:0 auto;padding:40px 20px;display:flex;flex-direction:column;gap:32px}
  .lm.lm .stx-img{width:100%;aspect-ratio:1/1;border-radius:8px;overflow:hidden;background:#f1f1f1}
  .lm.lm .stx-img img,.lm.lm .stx-img svg{display:block;width:100%;height:100%;object-fit:cover}
  .lm.lm .stx-img svg{background:#f1f1f1;fill:#999}
  .lm.lm .stx-c{display:flex;flex-direction:column;gap:20px;min-width:0}
  .lm.lm .stx h2{font-size:32px;line-height:1.2;font-weight:700;text-align:left;color:#333}
  .lm.lm .stx-b{font-size:18px;line-height:28.8px;color:#333}
  .lm.lm .stx-b p{margin:0 0 15px}
  .lm.lm .stx-b p:last-child{margin-bottom:0}
  .lm.lm .stx-l{display:flex;flex-direction:column;gap:10px}
  .lm.lm .stx-d{border:1px solid #202329;border-radius:8px;background:#fff}
  .lm.lm .stx-d summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 20px;cursor:pointer;font-size:18px;line-height:27px;font-weight:600;color:#333}
  .lm.lm .stx-d summary::-webkit-details-marker{display:none}
  .lm.lm .stx-pm{position:relative;flex:none;width:14px;height:14px}
  .lm.lm .stx-pm::before,.lm.lm .stx-pm::after{content:"";position:absolute;background:#333;left:0;top:6px;width:14px;height:2px}
  .lm.lm .stx-pm::after{transform:rotate(90deg)}
  .lm.lm .stx-d[open] .stx-pm::after{display:none}
  .lm.lm .stx-a{padding:0 20px 16px;font-size:16px;line-height:24px;color:#333}
  .lm.lm .stx-a p{margin:0 0 10px}
  .lm.lm .stx-a p:last-child{margin-bottom:0}
  @media (min-width:990px){
    .lm.lm .stx-i{flex-direction:row;align-items:flex-start;gap:40px;padding:60px 20px}
    .lm.lm .stx-img,.lm.lm .stx-c{flex:1 1 0;width:50%}
    .lm.lm .stx h2{font-size:48px;line-height:57.6px}
  }
</style>

{% schema %}
{
  "name": "OC: Story with accordions",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Square works best. Empty = a placeholder picture is shown in the same frame." },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why we made this", "info": "Empty = no heading." },
    { "type": "richtext", "id": "body", "label": "Text", "default": "<p>Tell the story behind the product in a few short sentences.</p><p>Add a second paragraph about what makes it different.</p>", "info": "Empty = no text." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Accordion item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Who it is for" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add the details that open under this title.</p>", "info": "Empty = the item opens with nothing inside." },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "OC: Story with accordions",
      "blocks": [
        { "type": "item", "settings": { "title": "Who it is for", "content": "<p>Describe who gets the most from this product.</p>" } },
        { "type": "item", "settings": { "title": "How it works", "content": "<p>Explain in a sentence or two how to use it.</p>" } },
        { "type": "item", "settings": { "title": "Our promise", "content": "<p>Say what customers can count on.</p>" } }
      ]
    }
  ]
}
{% endschema %}
