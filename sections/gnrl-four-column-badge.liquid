{% comment %}
  GNRL Four Column Badge Section
  Cloned from the original "Four Column Badge" section.
  Adds: a top headline with full font-style controls, and a gradient-capable
  section background.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    --fcb-icon-color: {{ section.settings.icon_color }};
    --fcb-heading-color: {{ section.settings.heading_color }};
    --fcb-para-color: {{ section.settings.paragraph_color }};
    --fcb-divider-color: {{ section.settings.divider_color }};
  }

  #shopify-section-{{ section.id }} .gnrl-fcb-section {
    background: {{ section.settings.section_background }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .gnrl-fcb-container {
    max-width: {{ section.settings.container_max_width }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.container_padding }}px;
  }

  /* ─── Section Headline ─── */
  #shopify-section-{{ section.id }} .gnrl-fcb-headline-wrap {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: {{ section.settings.heading_gap }}px;
  }

  #shopify-section-{{ section.id }} .gnrl-fcb-headline {
    margin: 0;
    font-family: {{ section.settings.heading_font_family }};
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    line-height: {{ section.settings.heading_line_height }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    color: {{ section.settings.heading_text_color }};
  }

  #shopify-section-{{ section.id }} .gnrl-fcb-headline em {
    font-style: normal;
    color: {{ section.settings.heading_highlight_color }};
  }

  /* ─── Grid ─── */
  #shopify-section-{{ section.id }} .gnrl-fcb-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.column_gap }}px {{ section.settings.column_gap_h }}px;
    align-items: center;
  }

  /* ─── Section image (below the grid) ─── */
  #shopify-section-{{ section.id }} .gnrl-fcb-image-wrap {
    margin-top: {{ section.settings.section_image_gap }}px;
    display: flex;
    justify-content: {{ section.settings.section_image_alignment }};
  }

  #shopify-section-{{ section.id }} .gnrl-fcb-image {
    display: block;
    width: 100%;
    max-width: {{ section.settings.section_image_width }}px;
    height: auto;
    border-radius: {{ section.settings.section_image_radius }}px;
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .gnrl-fcb-image-wrap {
      margin-top: {{ section.settings.section_image_gap_mobile }}px;
    }
  }

  {%- if section.settings.side_by_side_desktop and section.settings.section_image != blank -%}
  /* ─── Desktop: badges left, image right ─── */
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .gnrl-fcb-content {
      display: grid;
      grid-template-columns: 1fr {{ section.settings.image_column_ratio }}fr;
      align-items: stretch;
      gap: {{ section.settings.column_gap_h }}px;
    }

    #shopify-section-{{ section.id }} .gnrl-fcb-content .gnrl-fcb-image-wrap {
      margin-top: 0;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .gnrl-fcb-content .gnrl-fcb-image {
      height: 100%;
      max-width: 100%;
      object-fit: cover;
    }
  }
  {%- endif -%}

  /* ─── Column Item ─── */
  #shopify-section-{{ section.id }} .gnrl-fcb-item {
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.content_alignment }};
    text-align: {{ section.settings.content_alignment }};
    gap: {{ section.settings.item_gap }}px;
  }

  /* ─── Divider between columns ─── */
  {%- if section.settings.show_dividers -%}
  #shopify-section-{{ section.id }} .gnrl-fcb-item + .gnrl-fcb-item {
    border-left: {{ section.settings.divider_width }}px {{ section.settings.divider_style }} var(--fcb-divider-color);
    padding-left: {{ section.settings.column_gap_h }}px;
    margin-left: -{{ section.settings.column_gap_h }}px;
  }
  {%- endif -%}

  /* ─── Icon ─── */
  #shopify-section-{{ section.id }} .gnrl-fcb-icon-wrap {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .gnrl-fcb-icon-wrap svg {
    width: 100%;
    height: 100%;
    fill: var(--fcb-icon-color);
    color: var(--fcb-icon-color);
  }

  #shopify-section-{{ section.id }} .gnrl-fcb-icon-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* ─── Heading ─── */
  #shopify-section-{{ section.id }} .gnrl-fcb-heading {
    margin: 0;
    font-family: {{ section.settings.column_heading_font_family }};
    font-size: {{ section.settings.column_heading_font_size }}px;
    font-weight: {{ section.settings.column_heading_font_weight }};
    line-height: {{ section.settings.column_heading_line_height }};
    color: var(--fcb-heading-color);
  }

  /* ─── Paragraph ─── */
  #shopify-section-{{ section.id }} .gnrl-fcb-paragraph {
    margin: 0;
    font-family: {{ section.settings.paragraph_font_family }};
    font-size: {{ section.settings.paragraph_font_size }}px;
    font-weight: {{ section.settings.paragraph_font_weight }};
    line-height: {{ section.settings.paragraph_line_height }};
    color: var(--fcb-para-color);
  }

  #shopify-section-{{ section.id }} .gnrl-fcb-paragraph p { margin: 0; }

  /* ─── Mobile ─── */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .gnrl-fcb-section {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .gnrl-fcb-container {
      padding: 0 {{ section.settings.container_padding_mobile }}px;
    }

    #shopify-section-{{ section.id }} .gnrl-fcb-headline {
      font-size: {{ section.settings.heading_font_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .gnrl-fcb-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: {{ section.settings.column_gap_mobile }}px;
    }

    #shopify-section-{{ section.id }} .gnrl-fcb-heading {
      font-size: {{ section.settings.column_heading_font_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .gnrl-fcb-paragraph {
      font-size: {{ section.settings.paragraph_font_size_mobile }}px;
    }

    /* Remove dividers on mobile to avoid layout issues */
    #shopify-section-{{ section.id }} .gnrl-fcb-item + .gnrl-fcb-item {
      border-left: none;
      padding-left: 0;
      margin-left: 0;
    }
  }

  @media (min-width: 750px) and (max-width: 989px) {
    #shopify-section-{{ section.id }} .gnrl-fcb-grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
    }

    #shopify-section-{{ section.id }} .gnrl-fcb-item + .gnrl-fcb-item {
      border-left: none;
      padding-left: 0;
      margin-left: 0;
    }
  }
</style>

<section class="gnrl-fcb-section" id="gnrl-fcb-{{ section.id }}">
  <div class="gnrl-fcb-container">

    {%- if section.settings.heading != blank -%}
      <div class="gnrl-fcb-headline-wrap">
        <{{ section.settings.heading_tag }} class="gnrl-fcb-headline">
          {{ section.settings.heading }}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    <div class="gnrl-fcb-content">
      <div class="gnrl-fcb-grid">
        {%- for block in section.blocks -%}
        {%- if block.type == 'badge_column' -%}
          <div class="gnrl-fcb-item" {{ block.shopify_attributes }}>

            {%- comment %} ── Icon ── {%- endcomment %}
            {%- if block.settings.custom_icon != blank -%}
              <div class="gnrl-fcb-icon-wrap">
                <img
                  src="{{ block.settings.custom_icon | image_url: width: 120 }}"
                  alt="{{ block.settings.heading }}"
                  loading="lazy"
                  width="{{ section.settings.icon_size }}"
                  height="{{ section.settings.icon_size }}">
              </div>
            {%- elsif block.settings.icon != 'none' -%}
              <div class="gnrl-fcb-icon-wrap">
                {%- case block.settings.icon -%}
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2L3 6v6c0 5.25 3.75 10.15 9 11.35C17.25 22.15 21 17.25 21 12V6L12 2zm0 2.18l7 3.12V12c0 4.25-2.9 8.2-7 9.43C7.9 20.2 5 16.25 5 12V7.3l7-3.12zM11 7v2H9v2h2v2h2v-2h2V9h-2V7h-2z"/>
                    </svg>
                  {%- when 'shield_check' -%}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2L3 6v6c0 5.25 3.75 10.15 9 11.35C17.25 22.15 21 17.25 21 12V6L12 2zm0 2.18l7 3.12V12c0 4.25-2.9 8.2-7 9.43C7.9 20.2 5 16.25 5 12V7.3l7-3.12zm-1 9.24l-2.5-2.5-1.42 1.42L11 16.25l6.5-6.5-1.41-1.41L11 13.42z"/>
                    </svg>
                  {%- when 'cell' -%}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
                    </svg>
                  {%- when 'gear' -%}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M19.14 12.94c.04-.3.06-.61.06-.94s-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                    </svg>
                  {%- when 'flask' -%}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M9 2v8.5L4.5 19c-.83 1.33.08 3 1.5 3h12c1.42 0 2.33-1.67 1.5-3L15 10.5V2H9zm0 2h6v7h.26l3.94 7H4.8l3.94-7H9V4zm2 1v1h2V5h-2zm0 2v1h2V7h-2z"/>
                    </svg>
                  {%- when 'leaf' -%}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M17 8C8 10 5.9 16.17 3.82 21.34L5.71 22l1-2.3A4.49 4.49 0 008 20C19 20 22 3 22 3c-1 2-8 2-5 8z"/>
                    </svg>
                  {%- when 'heart' -%}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </svg>
                  {%- when 'star' -%}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                    </svg>
                  {%- when 'award' -%}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2L9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2zM12 5.66L13.77 9.8l4.48.38-3.39 2.94 1.01 4.36L12 15.12 8.13 17.48l1.01-4.36L5.75 10.18l4.48-.38L12 5.66z"/>
                    </svg>
                  {%- when 'clock' -%}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/>
                    </svg>
                  {%- when 'check_circle' -%}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                  {%- when 'bolt' -%}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M7 2v11h3v9l7-12h-4l4-8z"/>
                    </svg>
                  {%- when 'drop' -%}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2c-5.33 4.55-8 8.48-8 11.8 0 4.98 3.8 8.2 8 8.2s8-3.22 8-8.2c0-3.32-2.67-7.25-8-11.8z"/>
                    </svg>
                  {%- when 'magnify' -%}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                    </svg>
                  {%- when 'recycle' -%}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M7.93 10.58l-1.5-2.6H8V6H4.5L3 8.37l1.5 2.6-1.5.03V13h3.5L8 10.58h-.07zM12 3L9.27 7.77l1.5 2.6H12v1.77L9.27 7.77 12 3zm2.73 4.77L12 3l-2.73 4.77 1.5 2.6H12V9l2.73 4.77zM20.5 8H17V6h1.57l-1.5 2.6L18.5 11H15v1.37l2.5-4.37L20.5 13H22v-1.6l-1.5-.03 1.5-2.6L20.5 6.37V8zM9 16l1.5 2.6H9v2h3.5l1.5-2.37-1.5-2.6 1.5-.03V14H10.5L9 16.37zm6 0l-1.5-2.37H12v-1.77l2.73 4.77L12 21l2.73-4.77 1.5 2.6L15 21h3.5v-2h-1.57L18.5 16H15z"/>
                    </svg>
                  {%- when 'users' -%}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                    </svg>
                  {%- when 'globe' -%}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm6.93 6h-2.95c-.32-1.25-.78-2.45-1.38-3.56 1.84.63 3.37 1.91 4.33 3.56zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2s.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56-1.84-.63-3.37-1.9-4.33-3.56zm2.95-8H5.08c.96-1.66 2.49-2.93 4.33-3.56C8.81 5.55 8.35 6.75 8.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.09-.66-.16-1.32-.16-2s.07-1.35.16-2h4.68c.09.65.16 1.32.16 2s-.07 1.34-.16 2zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95c-.96 1.65-2.49 2.93-4.33 3.56zM16.36 14c.08-.66.14-1.32.14-2s-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z"/>
                    </svg>
                {%- endcase -%}
              </div>
            {%- endif -%}

            {%- comment %} ── Heading ── {%- endcomment %}
            {%- if block.settings.heading != blank -%}
              <{{ block.settings.heading_tag }} class="gnrl-fcb-heading">
                {{ block.settings.heading }}
              </{{ block.settings.heading_tag }}>
            {%- endif -%}

            {%- comment %} ── Paragraph ── {%- endcomment %}
            {%- if block.settings.text != blank -%}
              <div class="gnrl-fcb-paragraph">
                {{ block.settings.text }}
              </div>
            {%- endif -%}

          </div>
        {%- endif -%}
      {%- endfor -%}
      </div>

      {%- if section.settings.section_image != blank -%}
        <div class="gnrl-fcb-image-wrap">
          <img
            class="gnrl-fcb-image"
            src="{{ section.settings.section_image | image_url: width: 1600 }}"
            srcset="
              {{ section.settings.section_image | image_url: width: 400 }} 400w,
              {{ section.settings.section_image | image_url: width: 800 }} 800w,
              {{ section.settings.section_image | image_url: width: 1200 }} 1200w,
              {{ section.settings.section_image | image_url: width: 1600 }} 1600w
            "
            sizes="(min-width: 750px) {{ section.settings.section_image_width }}px, 100vw"
            alt="{{ section.settings.section_image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.section_image.width }}"
            height="{{ section.settings.section_image.height }}"
          >
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GNRL_Four Column Badge",
  "tag": "div",
  "class": "shopify-section--gnrl-four-column-badge",
  "settings": [
    {
      "type": "header",
      "content": "Section Headline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Comprehensive <em>Wellness</em> Benefits",
      "info": "Wrap text in <em></em> tags to apply the highlight color."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML tag",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h1", "label": "H1" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left",   "label": "Left"   },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right"  }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "heading_font_family",
      "label": "Heading font family",
      "default": "system-ui, sans-serif"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size (desktop)",
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading font size (mobile)",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading font weight",
      "options": [
        { "value": "400", "label": "Regular (400)"    },
        { "value": "500", "label": "Medium (500)"     },
        { "value": "600", "label": "Semi-bold (600)"  },
        { "value": "700", "label": "Bold (700)"       },
        { "value": "800", "label": "Extra-bold (800)" }
      ],
      "default": "700"
    },
    {
      "type": "text",
