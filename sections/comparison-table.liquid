      "default": "#7a2b35"
    },
    {
      "type": "color",
      "id": "product2_name_color",
      "label": "Product 2 name color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Table Column 1 (Your Product)"
    },
    {
      "type": "color",
      "id": "col1_table_bg_color",
      "label": "Column 1 background",
      "default": "#7a2b35"
    },
    {
      "type": "color",
      "id": "col1_table_text_color",
      "label": "Column 1 text color",
      "default": "#ffffff"
