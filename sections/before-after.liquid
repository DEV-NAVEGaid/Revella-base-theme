{% comment %}
  Before After Section (Dawn) — with Shrine styling ported in
  Category: Template
  A two-column section with a draggable before/after image comparison.
{% endcomment %}

{%- liquid
  assign image_position = section.settings.image_position
  assign layout_class = 'ba-layout--' | append: image_position

  # Resolve heading size (preset or custom)
  case section.settings.heading_size
    when 'h3'
      assign heading_size_desktop = 24
      assign heading_size_mobile  = 20
    when 'h2'
      assign heading_size_desktop = 30
      assign heading_size_mobile  = 24
    when 'h1'
      assign heading_size_desktop = 39
      assign heading_size_mobile  = 28
    when 'h0'
      assign heading_size_desktop = 52
      assign heading_size_mobile  = 36
    when 'custom'
      assign heading_size_desktop = section.settings.custom_desktop_size
      assign heading_size_mobile  = section.settings.custom_mobile_size
  endcase
-%}

<style>
  #shopify-section-{{ section.id }} {
    --ba-bg: {{ section.settings.background_color }};
    --ba-accent: {{ section.settings.accent_color }};
    --ba-heading-color: {{ section.settings.heading_color }};
    --ba-heading-accent-color: {{ section.settings.heading_accent_color }};
    --ba-para-color: {{ section.settings.paragraph_color }};
    --ba-label-bg: {{ section.settings.label_background_color }};
    --ba-label-color: {{ section.settings.label_text_color }};
    --ba-handle-color: {{ section.settings.handle_color }};
    --ba-border-radius: {{ section.settings.border_radius }}px;
    --ba-section-padding-top: {{ section.settings.padding_top }}px;
    --ba-section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --ba-gap: {{ section.settings.column_gap }}px;
    --ba-margin-top: {{ section.settings.margin_top }}px;
    --ba-margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  /* ─── Visibility ─── */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }}.ba-visibility--mobile-hidden { display: none !important; }
  }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }}.ba-visibility--desktop-hidden { display: none !important; }
  }

  .ba-section {
    {% if section.settings.custom_gradient_background != blank %}
      background: {{ section.settings.custom_gradient_background }};
    {% else %}
      background-color: var(--ba-bg);
    {% endif %}
    {% if section.settings.custom_image_background != blank %}
      background: url('{{ section.settings.custom_image_background | image_url: width: 2400 }}') center center / cover no-repeat;
    {% endif %}
    padding-top: var(--ba-section-padding-top);
    padding-bottom: var(--ba-section-padding-bottom);
    margin-top: var(--ba-margin-top);
    margin-bottom: var(--ba-margin-bottom);
    width: 100%;
  }

  {% if section.settings.custom_mobile_image_background != blank %}
    @media (max-width: 749px) {
      .ba-section {
        background: url('{{ section.settings.custom_mobile_image_background | image_url: width: 1200 }}') center center / cover no-repeat;
      }
    }
  {% endif %}

  .ba-container {
    max-width: {{ section.settings.container_max_width }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.container_padding }}px;
  }

  /* ─── Section ID badge ─── */
  .ba-section-id-badge {
    display: inline-block;
    margin: 0 auto 1rem;
    padding: 4px 10px;
    font-size: 12px;
    font-family: monospace;
    background: rgba(0,0,0,0.08);
    border-radius: 4px;
    cursor: copy;
    user-select: all;
  }

  /* ─── Layout Grid ─── */
  .ba-layout {
    display: grid;
    align-items: center;
    gap: var(--ba-gap);
  }

  .ba-layout--above,
  .ba-layout--below {
    grid-template-columns: 1fr;
    max-width: {{ section.settings.stacked_max_width }}px;
    margin-left: auto;
    margin-right: auto;
  }

  .ba-layout--above .ba-image-col { order: 1; }
  .ba-layout--above .ba-text-col  { order: 2; }
  .ba-layout--below .ba-image-col { order: 2; }
  .ba-layout--below .ba-text-col  { order: 1; }

  @media (min-width: 750px) {
    .ba-layout--right,
    .ba-layout--left {
      grid-template-columns: 1fr 1fr;
    }
    .ba-layout--right .ba-image-col  { order: 2; }
    .ba-layout--right .ba-text-col   { order: 1; }
    .ba-layout--left  .ba-image-col  { order: 1; }
    .ba-layout--left  .ba-text-col   { order: 2; }
  }

  /* ─── Text Column ─── */
  .ba-text-col {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.text_gap }}px;
    text-align: {{ section.settings.text_alignment }};
  }

  /* ─── Heading ─── */
  .ba-heading {
    margin: 0;
    font-family: {{ section.settings.heading_font_family }};
    font-size: {{ heading_size_desktop }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    line-height: {{ section.settings.heading_line_height }};
    color: var(--ba-heading-color);
  }

  .ba-heading .ba-heading-accent {
    color: var(--ba-heading-accent-color);
    font-style: {{ section.settings.accent_font_style }};
    position: relative;
    display: inline-block;
  }

  /* ─── Accent Highlight Styles (ported from Shrine) ─── */
  {%- assign hl = section.settings.heading_highlight -%}

  {%- if hl == 'solid-color' -%}
    .ba-heading .ba-heading-accent {
      color: {{ section.settings.highlight_color }};
    }
  {%- endif -%}

  {%- if hl == 'gradient-color' -%}
    .ba-heading .ba-heading-accent {
      background: {{ section.settings.highlight_gradient }};
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }
  {%- endif -%}

  {%- if hl == 'bg-color' -%}
    .ba-heading .ba-heading-accent {
      color: {{ section.settings.highlight_color }};
      background-color: {{ section.settings.highlight_bg_color }};
      padding: {{ section.settings.highlight_padding_block | times: 100 }}% {{ section.settings.highlight_padding_inline | times: 100 }}%;
      border-radius: {{ section.settings.highlight_border_radius }}px;
      {% if section.settings.highlight_border_width > 0 %}
        border: {{ section.settings.highlight_border_width }}px {{ section.settings.highlight_border_style }} {{ section.settings.highlight_border_color }};
      {% endif %}
    }
  {%- endif -%}

  {%- if hl == 'underline-solid' -%}
    .ba-heading .ba-heading-accent {
      text-decoration: underline;
      text-decoration-color: {{ section.settings.highlight_underline_color }};
      text-decoration-thickness: {{ section.settings.highlight_underline_thickness }}px;
      text-underline-offset: {{ section.settings.highlight_underline_position | divided_by: 4 }}px;
      text-decoration-skip-ink: none;
    }
  {%- endif -%}

  {%- if hl == 'underline-gradient' -%}
    .ba-heading .ba-heading-accent {
      background-image: {{ section.settings.highlight_underline_gradient }};
      background-repeat: no-repeat;
      background-size: 100% {{ section.settings.highlight_underline_thickness }}px;
      background-position: 0 calc(100% - {{ section.settings.highlight_underline_position }}%);
      padding-bottom: 0.1em;
    }
  {%- endif -%}

  {%- if hl == 'line-1' or hl == 'line-2' or hl == 'line-3' -%}
    .ba-heading .ba-heading-accent {
      padding-bottom: 0.15em;
    }
    .ba-heading .ba-heading-accent svg.ba-heading-line {
      position: absolute;
      left: 0;
      width: 100%;
      height: auto;
      top: {{ section.settings.highlight_line_position }}%;
      stroke: {{ section.settings.highlight_line_color }};
      stroke-width: {{ section.settings.highlight_line_stroke }};
      fill: none;
      pointer-events: none;
    }
  {%- endif -%}

  /* ─── Paragraph ─── */
  .ba-paragraph {
    margin: 0;
    font-family: {{ section.settings.paragraph_font_family }};
    font-size: {{ section.settings.paragraph_font_size }}px;
    font-weight: {{ section.settings.paragraph_font_weight }};
    line-height: {{ section.settings.paragraph_line_height }};
    color: var(--ba-para-color);
  }

  .ba-paragraph p { margin: 0 0 0.5em; }
  .ba-paragraph p:last-child { margin-bottom: 0; }

  /* ─── Buttons ─── */
  .ba-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
    justify-content: {% if section.settings.text_alignment == 'center' %}center{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  .ba-button {
    display: inline-block;
    padding: 12px 24px;
    border-radius: {{ section.settings.button_border_radius }}px;
    font-family: {{ section.settings.paragraph_font_family }};
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    cursor: pointer;
    border: 2px solid {{ section.settings.button_color }};
  }

  .ba-button:hover { opacity: 0.85; transform: translateY(-1px); }

  .ba-button--primary {
    background: {{ section.settings.button_color }};
    color: {{ section.settings.button_text_color }};
  }

  .ba-button--secondary {
    background: transparent;
    color: {{ section.settings.button_color }};
  }

  /* ─── Comparison Widget ─── */
  .ba-comparison {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--ba-border-radius);
    user-select: none;
    touch-action: none;
    cursor: col-resize;
    box-shadow: {{ section.settings.image_shadow }};
  }

  .ba-comparison__after,
  .ba-comparison__before {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    pointer-events: none;
  }

  .ba-comparison__before-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    width: 50%;
  }

  .ba-comparison__before-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    max-width: none;
    min-width: calc(100vw);
  }

  /* Handle */
  .ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: {{ section.settings.handle_width }}px;
    background: var(--ba-handle-color);
    cursor: col-resize;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ba-handle__circle {
    width: {{ section.settings.handle_circle_size }}px;
    height: {{ section.settings.handle_circle_size }}px;
    border-radius: 50%;
    background: var(--ba-handle-color);
    {% if section.settings.arrows_style == 'circle' %}
      border: 3px solid #fff;
      box-shadow: 0 2px 12px rgba(0,0,0,0.25);
    {% else %}
      border: none;
      box-shadow: 0 2px 6px rgba(0,0,0,0.2);
      background: transparent;
    {% endif %}
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ba-handle__arrows {
    display: flex;
    gap: 3px;
    align-items: center;
    color: {% if section.settings.arrows_style == 'circle' %}#fff{% else %}var(--ba-handle-color){% endif %};
  }

  .ba-handle__arrows svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
  }

  /* Labels */
  .ba-label {
    position: absolute;
    top: {{ section.settings.label_offset_top }}px;
    padding: {{ section.settings.label_padding_v }}px {{ section.settings.label_padding_h }}px;
    background: var(--ba-label-bg);
    color: var(--ba-label-color);
    font-family: {{ section.settings.label_font_family }};
    font-size: {{ section.settings.label_font_size }}px;
    font-weight: {{ section.settings.label_font_weight }};
    border-radius: {{ section.settings.label_border_radius }}px;
    letter-spacing: {{ section.settings.label_letter_spacing }}px;
    text-transform: {{ section.settings.label_text_transform }};
    z-index: 5;
    pointer-events: none;
  }

  .ba-label--before { left: {{ section.settings.label_offset_side }}px; }
  .ba-label--after  { right: {{ section.settings.label_offset_side }}px; }

  /* ─── Mobile ─── */
  @media (max-width: 749px) {
    .ba-layout--right,
    .ba-layout--left {
      grid-template-columns: 1fr;
    }

    .ba-layout--right .ba-image-col,
    .ba-layout--left  .ba-image-col {
      order: {% if section.settings.mobile_image_position == 'top' %}1{% else %}2{% endif %} !important;
    }

    .ba-layout--right .ba-text-col,
    .ba-layout--left  .ba-text-col {
      order: {% if section.settings.mobile_image_position == 'top' %}2{% else %}1{% endif %} !important;
    }

    .ba-heading {
      font-size: {{ heading_size_mobile }}px;
    }

    .ba-paragraph {
      font-size: {{ section.settings.paragraph_font_size_mobile }}px;
    }

    .ba-container {
      padding: 0 {{ section.settings.container_padding_mobile }}px;
    }

    .ba-section {
      --ba-section-padding-top: {{ section.settings.padding_top_mobile }}px;
      --ba-section-padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
</style>

<section class="ba-section ba-visibility--{{ section.settings.visibility }}" id="ba-{{ section.id }}">
  <div class="ba-container">

    {%- if section.settings.display_id -%}
      <div style="text-align:center;">
        <span class="ba-section-id-badge" title="Copy this ID">#shopify-section-{{ section.id }}</span>
      </div>
    {%- endif -%}

    <div class="ba-layout {{ layout_class }}">

      {%- comment %} ── Text Column ── {%- endcomment %}
      <div class="ba-text-col">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'dual_tone_heading' -%}
              <h{{ block.settings.heading_tag }}
                class="ba-heading"
                {{ block.shopify_attributes }}>
                {%- if block.settings.heading_before != blank -%}
                  {{ block.settings.heading_before }}{% if block.settings.heading_accent != blank %} {% endif %}
                {%- endif -%}
                {%- if block.settings.heading_accent != blank -%}
                  <span class="ba-heading-accent">
                    {{- block.settings.heading_accent -}}
                    {%- if section.settings.heading_highlight == 'line-1' -%}
                      <svg class="ba-heading-line" viewBox="0 0 300 12" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M2 6 Q 75 2, 150 6 T 298 6" />
                      </svg>
                    {%- elsif section.settings.heading_highlight == 'line-2' -%}
                      <svg class="ba-heading-line" viewBox="0 0 300 12" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M2 8 Q 50 1, 100 7 T 200 6 T 298 8" />
                      </svg>
                    {%- elsif section.settings.heading_highlight == 'line-3' -%}
                      <svg class="ba-heading-line" viewBox="0 0 300 16" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M5 4 Q 80 14, 150 6 T 295 10" />
                      </svg>
                    {%- endif -%}
                  </span>
                {%- endif -%}
              </h{{ block.settings.heading_tag }}>

            {%- when 'paragraph' -%}
              <div class="ba-paragraph" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>

          {%- endcase -%}
        {%- endfor -%}

        {%- if section.settings.button_label != blank -%}
          <div class="ba-buttons">
            <a
              {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
              class="ba-button {% if section.settings.button_style_secondary %}ba-button--secondary{% else %}ba-button--primary{% endif %}">
              {{ section.settings.button_label | escape }}
            </a>
          </div>
        {%- endif -%}
      </div>

      {%- comment %} ── Image Comparison Column ── {%- endcomment %}
      <div class="ba-image-col">
        {%- for block in section.blocks -%}
          {%- if block.type == 'before_after_image' -%}
            <div
              class="ba-comparison"
              id="ba-comp-{{ block.id }}"
              data-block-id="{{ block.id }}"
              {{ block.shopify_attributes }}>

              {%- if block.settings.after_image != blank -%}
                {{
                  block.settings.after_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'ba-comparison__after',
                    alt: block.settings.after_image.alt | default: section.settings.label_after,
                    loading: 'lazy',
                    widths: '400,600,800,1000,1200'
                }}
              {%- else -%}
                <img
                  src="{{ 'placeholder.svg' | asset_url }}"
                  class="ba-comparison__after"
                  alt="{{ section.settings.label_after }}"
                  style="min-height:300px;background:#e5f0f0;">
              {%- endif -%}

              <div class="ba-comparison__before-wrap" id="ba-before-{{ block.id }}">
                {%- if block.settings.before_image != blank -%}
                  {{
                    block.settings.before_image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'ba-comparison__before',
                      alt: block.settings.before_image.alt | default: section.settings.label_before,
                      loading: 'lazy',
                      widths: '400,600,800,1000,1200'
                  }}
                {%- else -%}
                  <img
                    src="{{ 'placeholder.svg' | asset_url }}"
                    class="ba-comparison__before"
                    alt="{{ section.settings.label_before }}"
                    style="min-height:300px;background:#f5e0d0;">
                {%- endif -%}
              </div>

              <div class="ba-handle" id="ba-handle-{{ block.id }}">
                <div class="ba-handle__circle">
                  <div class="ba-handle__arrows">
                    <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
                    <svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
                  </div>
                </div>
              </div>

              {%- if section.settings.show_labels -%}
                <span class="ba-label ba-label--before">{{ section.settings.label_before }}</span>
                <span class="ba-label ba-label--after">{{ section.settings.label_after }}</span>
              {%- endif -%}

            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</section>

<script>
(function () {
  function initComparison(compEl) {
    var beforeWrap = compEl.querySelector('.ba-comparison__before-wrap');
    var handle     = compEl.querySelector('.ba-handle');
    var beforeImg  = beforeWrap ? beforeWrap.querySelector('img') : null;
    if (!beforeWrap || !handle) return;

    var isDragging = false;

    function setPosition(x) {
      var rect = compEl.getBoundingClientRect();
      var pct  = Math.min(Math.max((x - rect.left) / rect.width, 0), 1);
      var pctPx = (pct * 100).toFixed(3) + '%';
      beforeWrap.style.width = pctPx;
      handle.style.left      = pctPx;
      if (beforeImg) {
        beforeImg.style.width    = compEl.offsetWidth + 'px';
        beforeImg.style.minWidth = 'unset';
      }
    }

    function onMouseMove(e) { if (isDragging) setPosition(e.clientX); }
    function onTouchMove(e) { if (isDragging) { e.preventDefault(); setPosition(e.touches[0].clientX); } }
    function startDrag()    { isDragging = true; }
    function stopDrag()     { isDragging = false; }

    compEl.addEventListener('mousedown',  startDrag);
    compEl.addEventListener('touchstart', startDrag, { passive: true });
    window.addEventListener('mousemove',  onMouseMove);
    window.addEventListener('touchmove',  onTouchMove, { passive: false });
    window.addEventListener('mouseup',    stopDrag);
    window.addEventListener('touchend',   stopDrag);

    if (beforeImg) {
      if (compEl.offsetWidth) {
        beforeImg.style.width    = compEl.offsetWidth + 'px';
        beforeImg.style.minWidth = 'unset';
      } else {
        window.addEventListener('load', function () {
          beforeImg.style.width    = compEl.offsetWidth + 'px';
          beforeImg.style.minWidth = 'unset';
        }, { once: true });
      }
    }
  }

  document.querySelectorAll('[id^="ba-comp-"]').forEach(initComparison);

  document.addEventListener('shopify:block:select', function (e) {
    var comp = document.getElementById('ba-comp-' + e.detail.blockId);
    if (comp) initComparison(comp);
  });

  // Section ID badge copy-on-click
  document.querySelectorAll('#ba-{{ section.id }} .ba-section-id-badge').forEach(function (el) {
    el.addEventListener('click', function () {
      navigator.clipboard && navigator.clipboard.writeText(el.textContent.trim());
    });
  });
})();
</script>

{% schema %}
{
  "name": "Before After",
  "tag": "div",
  "class": "shopify-section--before-after",
  "settings": [
    {
      "type": "checkbox",
      "id": "display_id",
      "label": "Display section ID",
      "info": "Shows the section ID as a small badge. Click to copy.",
      "default": false
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Display on",
      "options": [
        { "value": "desktop-hidden", "label": "Mobile only" },
        { "value": "mobile-hidden",  "label": "Desktop only" },
        { "value": "always-display", "label": "All devices" }
      ],
      "default": "always-display"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Before-After Image Position",
      "options": [
        { "value": "right",  "label": "Right column (slider second)" },
        { "value": "left",   "label": "Left column (slider first)"  },
        { "value": "above",  "label": "Above text"   },
        { "value": "below",  "label": "Below text"   }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile: Image position (side-by-side layouts only)",
      "options": [
        { "value": "top",    "label": "Image on top"    },
        { "value": "bottom", "label": "Image on bottom" }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "text_gap",
      "label": "Gap between text blocks",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left",   "label": "Left"   },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right"  }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Container"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "label": "Max width (side-by-side)",
      "min": 800,
      "max": 1600,
      "step": 40,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "stacked_max_width",
      "label": "Max width (stacked layouts)",
      "min": 400,
      "max": 1000,
      "step": 40,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "container_padding",
      "label": "Side padding (desktop)",
      "min": 0,
      "max": 80,
