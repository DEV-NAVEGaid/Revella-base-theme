    { "type": "color", "id": "heading_color", "label": "Heading & text", "default": "#111111" },
    { "type": "color", "id": "accent_color", "label": "Accent (active tab background)", "default": "#F0C36A" },
    { "type": "color", "id": "heading_gradient_start", "label": "Heading highlight gradient — left", "default": "#FCE18A" },
