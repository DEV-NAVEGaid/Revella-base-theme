    { "type": "header", "content": "Font size" },
    { "type": "range", "id": "heading_font_size", "min": 24, "max": 60, "step": 1, "unit": "px", "label": "Heading size", "default": 38 },
    { "type": "range", "id": "subheading_font_size", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Subheading size", "default": 16 },
    { "type": "range", "id": "tab_font_size", "min": 10, "max": 18, "step": 1, "unit": "px", "label": "Tab label size", "default": 13 },
    { "type": "range", "id": "content_heading_font_size", "min": 18, "max": 36, "step": 1, "unit": "px", "label": "Content heading size", "default": 24 },
    { "type": "range", "id": "content_text_font_size", "min": 13, "max": 20, "step": 1, "unit": "px", "label": "Content text size", "default": 16 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 40 },
    { "type": "range", "id": "tab_gap", "min": 4, "max": 24, "step": 1, "unit": "px", "label": "Gap between tabs", "default": 10 },
    { "type": "range", "id": "tab_padding_vertical", "min": 8, "max": 28, "step": 1, "unit": "px", "label": "Tab vertical padding", "default": 16 },
    { "type": "range", "id": "content_gap", "min": 12, "max": 60, "step": 2, "unit": "px", "label": "Gap between text & image", "default": 24 },
    { "type": "header", "content": "Image" },
    { "type": "range", "id": "image_radius", "min": 0, "max": 30, "step": 1, "unit": "px", "label": "Image corner radius", "default": 6 }
  ],
  "blocks": [
    {
