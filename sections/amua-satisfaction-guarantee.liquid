{%- style -%}
  #shopify-section-{{ section.id }} .amua-guarantee {
    --amua-gt-bg: {{ section.settings.background_color }};
    --amua-gt-card-bg: {{ section.settings.card_background }};
    --amua-gt-heading-color: {{ section.settings.heading_color }};
    --amua-gt-accent-start: {{ section.settings.accent_gradient_start }};
    --amua-gt-accent-end: {{ section.settings.accent_gradient_end }};
    --amua-gt-accent-angle: {{ section.settings.accent_gradient_angle }}deg;
    --amua-gt-desc-color: {{ section.settings.description_color }};
    --amua-gt-btn-bg-start: {{ section.settings.button_bg_start }};
    --amua-gt-btn-bg-end: {{ section.settings.button_bg_end }};
    --amua-gt-btn-text: {{ section.settings.button_text_color }};
    --amua-gt-btn-radius: {{ section.settings.button_border_radius }}px;
    --amua-gt-badge-color: {{ section.settings.badge_text_color }};
    --amua-gt-check-color: {{ section.settings.badge_check_color }};
    --amua-gt-icon-color: {{ section.settings.shield_icon_color }};
    --amua-gt-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --amua-gt-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --amua-gt-desc-size-mobile: {{ section.settings.description_size_mobile }}px;
    --amua-gt-desc-size-desktop: {{ section.settings.description_size_desktop }}px;
    --amua-gt-btn-size-mobile: {{ section.settings.button_font_size_mobile }}px;
    --amua-gt-btn-size-desktop: {{ section.settings.button_font_size_desktop }}px;
    --amua-gt-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --amua-gt-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --amua-gt-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --amua-gt-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;

    background-color: var(--amua-gt-bg);
    padding-top: var(--amua-gt-padding-top-mobile);
    padding-bottom: var(--amua-gt-padding-bottom-mobile);
  }

  #shopify-section-{{ section.id }} .amua-guarantee__card {
    background-color: var(--amua-gt-card-bg);
    border-radius: 20px;
    max-width: 640px;
    margin: 0 auto;
    padding: 40px 24px 36px;
    text-align: center;
  }

  /* Shield icon */
  #shopify-section-{{ section.id }} .amua-guarantee__icon {
    display: flex;
    justify-content: center;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .amua-guarantee__icon svg {
    width: {{ section.settings.shield_icon_size }}px;
    height: {{ section.settings.shield_icon_size }}px;
  }

  /* Heading */
  #shopify-section-{{ section.id }} .amua-guarantee__heading {
    font-size: var(--amua-gt-heading-size-mobile);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 16px;
    color: var(--amua-gt-heading-color);
  }

  #shopify-section-{{ section.id }} .amua-guarantee__heading-accent {
    display: block;
    background: linear-gradient(
      var(--amua-gt-accent-angle),
      var(--amua-gt-accent-start),
      var(--amua-gt-accent-end)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Description */
  #shopify-section-{{ section.id }} .amua-guarantee__desc {
    color: var(--amua-gt-desc-color);
    font-size: var(--amua-gt-desc-size-mobile);
    font-weight: 400;
    line-height: 1.6;
    margin: 0 auto 28px;
    max-width: 480px;
  }

  /* CTA button */
  #shopify-section-{{ section.id }} .amua-guarantee__cta {
    display: inline-block;
    width: 100%;
    max-width: 420px;
    padding: 18px 32px;
    background: linear-gradient(135deg, var(--amua-gt-btn-bg-start), var(--amua-gt-btn-bg-end));
    color: var(--amua-gt-btn-text);
    font-size: var(--amua-gt-btn-size-mobile);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    border: none;
    border-radius: var(--amua-gt-btn-radius);
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  #shopify-section-{{ section.id }} .amua-guarantee__cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
  }

  /* Benefits */
  #shopify-section-{{ section.id }} .amua-guarantee__benefits {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin-top: 24px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .amua-guarantee__benefit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: var(--amua-gt-badge-color);
    font-size: 14px;
    font-weight: 500;
    text-align: center;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .amua-guarantee__benefit-check {
    color: var(--amua-gt-check-color);
  }

  #shopify-section-{{ section.id }} .amua-guarantee__benefit-check svg {
    width: 20px;
    height: 20px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .amua-guarantee {
      padding-top: var(--amua-gt-padding-top-desktop);
      padding-bottom: var(--amua-gt-padding-bottom-desktop);
    }

    #shopify-section-{{ section.id }} .amua-guarantee__card {
      padding: 52px 48px 44px;
    }

    #shopify-section-{{ section.id }} .amua-guarantee__heading {
      font-size: var(--amua-gt-heading-size-desktop);
    }

    #shopify-section-{{ section.id }} .amua-guarantee__desc {
      font-size: var(--amua-gt-desc-size-desktop);
    }

    #shopify-section-{{ section.id }} .amua-guarantee__cta {
      font-size: var(--amua-gt-btn-size-desktop);
    }

    #shopify-section-{{ section.id }} .amua-guarantee__benefits {
      gap: 40px;
    }
  }
{%- endstyle -%}

{%- assign benefit_blocks = section.blocks | where: "type", "benefit" -%}

<div class="amua-guarantee">
  <div class="amua-guarantee__card" style="margin-left: {{ section.settings.card_margin_mobile }}px; margin-right: {{ section.settings.card_margin_mobile }}px;">

    {%- if section.settings.show_shield_icon -%}
      <div class="amua-guarantee__icon">
        <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M28 4L8 14V26C8 39.2 16.6 51.4 28 54C39.4 51.4 48 39.2 48 26V14L28 4Z" fill="var(--amua-gt-icon-color)"/>
          <path d="M22 28L26 32L34 24" stroke="white" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    {%- endif -%}

    {%- if section.settings.heading_accent != blank or section.settings.heading_main != blank -%}
      <h2 class="amua-guarantee__heading">
        {%- if section.settings.heading_accent != blank -%}
          <span class="amua-guarantee__heading-accent">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
        {%- if section.settings.heading_main != blank -%}
          {{ section.settings.heading_main }}
        {%- endif -%}
      </h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="amua-guarantee__desc">{{ section.settings.description }}</p>
    {%- endif -%}

    {%- if section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_link }}" class="amua-guarantee__cta">
        {{ section.settings.button_text }}
      </a>
    {%- endif -%}

    {%- if benefit_blocks.size > 0 -%}
      <div class="amua-guarantee__benefits">
        {%- for block in benefit_blocks -%}
          <div class="amua-guarantee__benefit" {{ block.shopify_attributes }}>
            <span class="amua-guarantee__benefit-check">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span>{{ block.settings.text }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Amua: Guarantee",
  "tag": "section",
  "class": "section-amua-guarantee",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent line (gradient)",
      "default": "Love Your Results"
    },
    {
      "type": "text",
      "id": "heading_main",
      "label": "Heading main line",
      "default": "Guaranteed"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Main heading color",
      "default": "#000000"
    },
    {
