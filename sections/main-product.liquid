{%- liquid
  assign hide_image = section.settings.hide_image
  if product != blank and product.media.size == 0
    assign hide_image = true
  endif
-%}
<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}


  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}


  {%- style -%}

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    /* ── Mobile swiper ── */
    .cfp-mobile-swiper-wrap { display: none; }
    @media (max-width: 749px) {
      .cfp-desktop-gallery { display: none; }
      .cfp-mobile-swiper-wrap { display: block; }
      .cfp-mobile-swiper {
        width: 100vw;
        margin-left: 50%;
        transform: translateX(-50%);
        position: relative;
        overflow: hidden;
        aspect-ratio: 1 / 1;
        background: #f5f5f5;
      }
    }
    .cfp-mobile-track {
      display: flex;
      height: 100%;
      transition: transform 0.35s ease;
      will-change: transform;
    }
    .cfp-mobile-slide {
      flex: 0 0 100%;
      width: 100%;
      height: 100%;
      overflow: hidden;
    }
    .cfp-mobile-slide img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .cfp-mobile-dots {
      position: absolute;
      bottom: 12px;
      left: 0; right: 0;
      display: flex;
      justify-content: center;
      gap: 6px;
      z-index: 2;
    }
    .cfp-mobile-dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: #999999;
      border: none; padding: 0;
      cursor: pointer;
      transition: background 0.2s;
      margin-right: 3px;
      margin-left: 3px;
    }
    .cfp-mobile-dot.is-active { background: #000000; }

    /* ── Desktop custom gallery ── */
    .cfp-dt-thumb {
      width: calc((100% - 32px) / 5); height: auto; aspect-ratio: 1/1;
      border: 2px solid transparent;
      border-radius: 4px;
      overflow: hidden;
      cursor: pointer;
      flex-shrink: 0;
      transition: border-color 0.2s;
    }
    .cfp-dt-thumb.is-active { border-color: #8C3A3A; }
    .cfp-dt-thumb img { width:100%;height:100%;object-fit:cover;display:block; }

    /* ── FAQ ── */
    .cfp-faq-item[open] .cfp-faq-arrow { transform: rotate(45deg); }
    .cfp-faq-summary::-webkit-details-marker { display: none; }
    .cfp-faq-summary::marker { display: none; }

    /* tighten buy box */
    #shopify-section-{{ section.id }} .product__info-container .product-form,
    #shopify-section-{{ section.id }} .product__info-container .icon-with-text {
      margin: 0 !important;
    }

    #ProductInfo-{{ section.id }} .cfp-faq-summary { padding-top: 6px !important; padding-bottom: 6px !important; }
    #ProductInfo-{{ section.id }} .shopify-app-block { margin: 2px 0 !important; }

    @media screen and (min-width: 990px) {
      #shopify-section-{{ section.id }} .product__media-wrapper.cfp-sticky-media {
        position: sticky;
        top: 2rem;
        align-self: start;
      }
    }

    .cfp-mobile-dots {
      position: absolute;
      bottom: 12px;
      left: 0; right: 0;
      display: flex;
      justify-content: center;
      gap: 6px;
      z-index: 2;
    }
    .cfp-mobile-dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: #999999;
      border: none; padding: 0;
      cursor: pointer;
      transition: background 0.2s;
      margin-right: 3px;
      margin-left: 3px;
    }
    .cfp-mobile-dot.is-active { background: #000000; }

    .cfp-mobile-thumbs {
      display: flex;
      gap: 4px;
      margin-top: 10px;
      padding: 0 12px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .cfp-mobile-thumbs::-webkit-scrollbar { display: none; }
    .cfp-mobile-thumb {
      flex: 0 0 calc((100% - 16px) / 5);
      aspect-ratio: 1/1;
      border: 1px solid transparent;
      /* border-radius: 4px; */
      overflow: hidden;
      cursor: pointer;
      background: #f5f5f5;
      padding: 0;
    }
    .cfp-mobile-thumb.is-active { border-color: #8C3A3A; }
    .cfp-mobile-thumb img { width:100%;height:100%;object-fit:cover;display:block; }

    /* Toggle which nav style shows, driven by data attribute on the swiper wrap */
    .cfp-mobile-swiper-wrap[data-nav-style="dots"] .cfp-mobile-thumbs { display: none; }
    .cfp-mobile-swiper-wrap[data-nav-style="thumbnails"] .cfp-mobile-dots { display: none; }

    {%- for block in section.blocks -%}
      {%- if block.type == 'rating' -%}
        #shopify-section-{{ section.id }} .rating-wrapper .rating-star {
          --font-size: {{ block.settings.star_size | divided_by: 10.0 }};
          --letter-spacing: {{ block.settings.star_gap | divided_by: 10.0 }};
        }
      {%- endif -%}
{%- if block.type == 'buy_buttons' -%}
  #shopify-section-{{ section.id }} .product-form__submit {
    --btn-fill: {{ block.settings.btn_bg_color }};
    --btn-fill-text: {{ block.settings.btn_text_color }};
    --btn-border-width: 0px;
    position: relative;
    isolation: isolate;
    background-color: transparent !important;
    border: var(--btn-border-width) solid var(--btn-fill) !important;
    color: var(--btn-fill-text) !important;
    font-size: {{ block.settings.btn_font_size }}px !important;
    font-weight: {{ block.settings.btn_font_weight }} !important;
    border-radius: {{ block.settings.btn_radius }}px !important;
    padding-top: {{ block.settings.btn_padding_v }}px !important;
    padding-bottom: {{ block.settings.btn_padding_v }}px !important;
    text-transform: {{ block.settings.btn_text_transform }} !important;
    letter-spacing: {{ block.settings.btn_letter_spacing }}px !important;
    transition: color var(--transition-duration, 0.35s) ease !important;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .product-form__submit::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--btn-fill);
    border-radius: calc({{ block.settings.btn_radius }}px - var(--btn-border-width));
    z-index: -1;
    transform: scaleX(1);
    transform-origin: center;
    transition: transform var(--transition-duration, 0.35s) ease;
  }
  #shopify-section-{{ section.id }} .product-form__submit:hover {
    color: var(--btn-fill) !important;
  }
  #shopify-section-{{ section.id }} .product-form__submit:hover::before {
    transform: scaleX(0);
  }
{%- endif -%}
    {%- endfor -%}

        /* Force product form + ATC button full width */
    #ProductInfo-{{ section.id }} product-form,
    #ProductInfo-{{ section.id }} product-form .form,
    #ProductInfo-{{ section.id }} .product-form__buttons,
    #ProductInfo-{{ section.id }} .product-form__submit {
      width: 100% !important;
      max-width: 100% !important;
    }

    .payment-badges-{{ block.id }} .list-payment__item svg[aria-labelledby="pi-master"] rect[stroke="#fff"] {
    stroke-opacity: 0 !important;
  }

  .cfp-dt-thumbs-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
  position: relative;
}
.cfp-dt-thumbs-scroll {
  display: flex;
  gap: 8px;
  overflow: hidden;
  flex: 1;
  scroll-behavior: smooth;
}
.cfp-dt-arrow {
  width: 24px;
  height: 24px;
  border: none;
  background: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 0;
  color: #999;
  transition: color 0.2s;
}
.cfp-dt-arrow:hover { color: #121212; }
.cfp-dt-arrow svg { width: 18px; height: 18px; }

.cfp-mobile-arrow {
  /* width: 20px;
  height: 20px; */
  border: none;
  background: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 0;
  color: #3c3c3cff;
}
/* .cfp-mobile-arrow svg { width: 16px; height: 16px; } */

.cfp-dt-arrow:hover { border-color: #8C3A3A; }
.cfp-dt-arrow svg { width: 14px; height: 14px; }

.cfp-mobile-thumbs-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
  margin: 8px -1.5%;
  /* padding: 0 4px; */
}
.cfp-mobile-thumbs-wrap .cfp-mobile-thumbs {
  margin-top: 0;
  padding: 0;
  flex: 1;
  overflow: hidden;
  scroll-behavior: smooth;
}
.cfp-mobile-arrow {
  width: 14px;
  height: 14px;
  /* border-radius: 50%; */
  /* border: 1px solid #ccc; */
  background: #fff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 0;
}
.cfp-mobile-arrow svg { width: 16px; height: 16px; }

.cfp-mobile-swiper-wrap[data-nav-style="dots"] .cfp-mobile-thumbs-wrap { display: none; }

    {%- if template.suffix contains 'listicle' -%}
      #shopify-section-{{ section.id }},
      #shopify-section-{{ section.id }} *,
      #shopify-section-{{ section.id }} *::before,
      #shopify-section-{{ section.id }} *::after {
        box-sizing: border-box;
      }

      #shopify-section-{{ section.id }} {
        --grid-desktop-horizontal-spacing: 0px;
        --grid-desktop-vertical-spacing: 0px;
        --grid-mobile-horizontal-spacing: 0px;
        --grid-mobile-vertical-spacing: 0px;
      }

      #shopify-section-{{ section.id }} .page-width {
        max-width: 1200px;
        padding-left: 15px;
        padding-right: 15px;
        margin-left: auto;
        margin-right: auto;
      }

      @media screen and (min-width: 750px) {
        #shopify-section-{{ section.id }} .page-width {
          padding-left: 50px;
          padding-right: 50px;
        }
      }

      @media screen and (min-width: 990px) {
        #shopify-section-{{ section.id }} .product--large:not(.product--no-media) .product__info-wrapper {
          padding: 0 0 0 40px;
          max-width: 35%;
          width: 35%;
        }

        #shopify-section-{{ section.id }} .product--large:not(.product--no-media) .product__media-wrapper {
          max-width: 65%;
          width: 65%;
          padding-left: 0;
        }

        #shopify-section-{{ section.id }} .product__media-wrapper.cfp-sticky-media {
          top: 20px;
        }
      }
    {%- endif -%}

  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link id="ModelViewerStyle" rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print" onload="this.media='all'">
    <link id="ModelViewerOverride" rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print" onload="this.media='all'">
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}

  <div class="page-width">
    <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if hide_image %}product--no-media{% else %}grid--2-col-tablet{% endif %}">

      {%- unless hide_image -%}
      <div class="grid__item product__media-wrapper{% if section.settings.enable_sticky_info %} cfp-sticky-media{% endif %}"{% if template.suffix contains 'listicle' %} data-listicle-grid{% endif %}>

        <div class="cfp-desktop-gallery">
          <div style="position:relative;overflow:hidden;border-radius:8px;background:#f5f5f5;aspect-ratio:1/1;" id="cfp-main-wrap-{{ section.id }}">
            {%- assign first_img = product.images | first -%}
            {%- comment -%} On phones this hidden copy resolves to the same 800px file as the first mobile slide, so it downloads once {%- endcomment -%}
            <picture style="display:contents">
              <source media="(max-width: 749px)" srcset="{{ first_img | image_url: width: 800 }}">
              <img id="cfp-main-img-{{ section.id }}"
                   src="{{ first_img | image_url: width: 1200 }}"
                   alt="{{ first_img.alt | escape | default: product.title }}"
                   loading="eager" fetchpriority="high" width="1200" height="1200"
                   style="width:100%;height:100%;object-fit:contain;display:block;transition:opacity 0.3s;">
            </picture>
          </div>
          {%- if product.images.size > 1 -%}
            <div class="cfp-dt-thumbs-wrap">
              <button class="cfp-dt-arrow" id="cfp-arrow-left-{{ section.id }}" aria-label="Previous">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
              <div class="cfp-dt-thumbs-scroll" id="cfp-thumbs-{{ section.id }}">
                {%- for img in product.images -%}
                  <div class="cfp-dt-thumb{% if forloop.first %} is-active{% endif %}"
                      data-src="{{ img | image_url: width: 1200 }}"
                      data-alt="{{ img.alt | escape | default: product.title }}">
                    <img src="{{ img | image_url: width: 200 }}"
                        alt="{{ img.alt | escape }}"
                        loading="lazy">
                  </div>
                {%- endfor -%}
              </div>
              <button class="cfp-dt-arrow" id="cfp-arrow-right-{{ section.id }}" aria-label="Next">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 6 15 12 9 18"/></svg>
              </button>
            </div>
          {%- endif -%}
        </div>

        {%- if product.images.size > 0 -%}
          <div class="cfp-mobile-swiper-wrap" data-nav-style="{{ section.settings.cfp_mobile_gallery_style }}">
            <div class="cfp-mobile-swiper" id="cfp-ms-{{ section.id }}">
              <div class="cfp-mobile-track" id="cfp-mt-{{ section.id }}">
                {%- for img in product.images -%}
                  <div class="cfp-mobile-slide">
                    {%- comment -%} On desktop this hidden first slide resolves to the same 1200px file as the main image {%- endcomment -%}
                    {%- if forloop.first -%}<picture style="display:contents"><source media="(min-width: 750px)" srcset="{{ img | image_url: width: 1200 }}">{%- endif -%}
                    <img src="{{ img | image_url: width: 800 }}"
                         alt="{{ img.alt | escape | default: product.title }}"
                         loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                         {% if forloop.first %}fetchpriority="high"{% endif %}
                         width="800" height="800">
                    {%- if forloop.first -%}</picture>{%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
              {%- if product.images.size > 1 -%}
                <div class="cfp-mobile-dots" id="cfp-md-{{ section.id }}">
                  {%- for img in product.images -%}
                    <button class="cfp-mobile-dot{% if forloop.first %} is-active{% endif %}"
                            data-index="{{ forloop.index0 }}"
                            aria-label="Image {{ forloop.index }}"></button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
            {%- if product.images.size > 1 -%}
              <div class="cfp-mobile-thumbs-wrap">
                <button class="cfp-mobile-arrow" id="cfp-marrow-left-{{ section.id }}" aria-label="Previous" type="button">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
                </button>
                <div class="cfp-mobile-thumbs" id="cfp-mt-thumbs-{{ section.id }}">
                  {%- for img in product.images -%}
                    <button class="cfp-mobile-thumb{% if forloop.first %} is-active{% endif %}"
                            data-index="{{ forloop.index0 }}"
                            aria-label="Image {{ forloop.index }}" type="button">
                      <img src="{{ img | image_url: width: 200 }}"
                          alt="{{ img.alt | escape | default: product.title }}"
                          loading="lazy">
                    </button>
                  {%- endfor -%}
                </div>
                <button class="cfp-mobile-arrow" id="cfp-marrow-right-{{ section.id }}" aria-label="Next" type="button">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 6 15 12 9 18"/></svg>
                </button>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>
      {%- endunless -%}

      <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == 'small' %} product__info-wrapper--extra-padding{% endif %}"{% if template.suffix contains 'listicle' %} data-listicle-grid{% endif %}>
        <section id="ProductInfo-{{ section.id }}" class="product__info-container">
          {%- assign product_form_id = 'product-form-' | append: section.id -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}

              {%- when '@app' -%}
                {% render block %}

              {%- when 'text' -%}
                <p class="product__text inline-richtext{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                   style="font-size:{{ block.settings.font_size }}px;font-weight:{{ block.settings.font_weight }} !important;color:{{ block.settings.text_color }};text-align:{{ block.settings.alignment | default: 'left' }};margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;"
                   {{ block.shopify_attributes }}>
                  {{- block.settings.text -}}
                </p>

              {%- when 'checklist' -%}
                {{ 'terrastrike.css' | asset_url | stylesheet_tag }}
                <ul class="ts-list" style="--tsl-icon-size:{{ block.settings.icon_size }}px;--tsl-icon-gap:{{ block.settings.icon_gap }}px;--tsl-row-gap:{{ block.settings.row_spacing }}px;--tsl-text-size:{{ block.settings.text_size }}px;--tsl-icon-color:{{ block.settings.icon_color }};--tsl-text-color:{{ block.settings.text_color | default: '#121212' }};list-style:none;margin:0;margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;padding:0;"
                    {{ block.shopify_attributes }}>
                  {%- for i in (1..6) -%}
                    {%- assign item_key = 'item_' | append: i -%}
                    {%- assign item_val = block.settings[item_key] -%}
                    {%- if item_val != blank -%}
                      <li class="ts-list__item">
                        {% render 'terrastrike-icon', name: 'check', class: 'ts-list__icon' %}
                        <div class="ts-list__text">{{ item_val }}</div>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>

              {%- when 'custom_button' -%}
                <div style="margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;text-align:{{ block.settings.alignment }};"
                     {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.link | default: '#' }}"
                     {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
                     class="cfp-custom-button"
                     style="display:inline-block;{% if block.settings.width == 'full' %}width:100%;{% endif %}box-sizing:border-box;background-color:{{ block.settings.background_color }};color:{{ block.settings.text_color }};border:2px solid {{ block.settings.border_color | default: block.settings.background_color }};font-size:{{ block.settings.font_size }}px;font-weight:{{ block.settings.font_weight }};text-transform:{{ block.settings.text_transform }};letter-spacing:{{ block.settings.letter_spacing }}px;border-radius:{{ block.settings.border_radius }}px;padding:{{ block.settings.padding_v }}px {{ block.settings.padding_h }}px;text-align:center;text-decoration:none;transition:opacity 0.2s;">
                    {{ block.settings.label }}
                  </a>
                </div>

              {%- when 'image' -%}
                <div style="margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;text-align:{{ block.settings.alignment }};"
                     {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
                    <img src="{{ block.settings.image | image_url: width: 1500 }}"
                         alt="{{ block.settings.image.alt | escape | default: block.settings.alt_text | escape }}"
                         width="{{ block.settings.image.width }}"
                         height="{{ block.settings.image.height }}"
                         loading="lazy"
                         style="display:inline-block;max-width:100%;width:{{ block.settings.max_width }}px;height:auto;border-radius:{{ block.settings.border_radius }}px;">
                    {%- if block.settings.link != blank -%}</a>{%- endif -%}
                  {%- endif -%}
                </div>

              {%- when 'title' -%}
                <div class="product__title"
                     style="margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;"
                     {{ block.shopify_attributes }}>
                  <h1 style="font-size:{{ block.settings.font_size_mobile }}px;font-weight:{{ block.settings.font_weight }};color:{{ block.settings.text_color }};letter-spacing:{{ block.settings.letter_spacing }}px;">{{ product.title | escape }}</h1>
                  <a href="{{ product.url }}" class="product__title">
                    <h2 class="h1" style="font-size:{{ block.settings.font_size_mobile }}px;font-weight:{{ block.settings.font_weight }};color:{{ block.settings.text_color }};letter-spacing:{{ block.settings.letter_spacing }}px;">{{ product.title | escape }}</h2>
                  </a>
                </div>

              {%- when 'price' -%}
                <div id="price-{{ section.id }}" role="status"
                     style="margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;"
                     {{ block.shopify_attributes }}>
                  {%- if block.settings.show_custom_price -%}
                    <div style="display:flex;align-items:center;justify-content:space-between;width:100%;">
                      <div style="display:flex;align-items:center;">
                        <span style="font-size:{{ block.settings.price_size }}px;font-weight:700;color:{{ block.settings.price_color }};">
                          {{ product.selected_or_first_available_variant.price | money }}
                        </span>
                        {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
                          <span style="font-size:{{ block.settings.compare_size }}px;color:{{ block.settings.compare_color }};text-decoration:line-through;">
                            {{ product.selected_or_first_available_variant.compare_at_price | money }}
                          </span>
                        {%- endif -%}
                      </div>
                      {%- if block.settings.badge_text != blank and product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
                        <span style="background:{{ block.settings.badge_bg }};color:{{ block.settings.badge_text_color }};font-size:{{ block.settings.badge_font_size }}px;font-weight:600;padding:4px 10px;border-radius:{{ block.settings.badge_radius }}px;white-space:nowrap;">
                          {{ block.settings.badge_text }}
                        </span>
                      {%- endif -%}
                    </div>
                  {%- else -%}
                    {%- render 'price', product: product, use_variant: true, show_badges: true, price_class: 'price--large' -%}
                  {%- endif -%}
                </div>
                {%- if product.quantity_price_breaks_configured? -%}
                  <div class="volume-pricing-note" id="Volume-Note-{{ section.id }}">
                    <span>{{ 'products.product.volume_pricing.note' | t }}</span>
                  </div>
                {%- endif -%}
                {%- if cart.taxes_included or cart.duties_included or shop.shipping_policy.body != blank -%}
                  <div class="product__tax caption rte">
                    {%- if cart.duties_included and cart.taxes_included -%}{{ 'products.product.duties_and_taxes_included' | t }}
                    {%- elsif cart.taxes_included -%}{{ 'products.product.taxes_included' | t }}
                    {%- elsif cart.duties_included -%}{{ 'products.product.duties_included' | t }}
                    {%- endif -%}
                    {%- if shop.shipping_policy.body != blank -%}{{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}{%- endif -%}
                  </div>
                {%- endif -%}
                <div {{ block.shopify_attributes }}>
                  {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                  {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    {{ form | payment_terms }}
                  {%- endform -%}
                </div>

              {%- when 'inventory' -%}
                <p class="product__inventory{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.inventory_management != 'shopify' %} visibility-hidden{% endif %}"
                   {{ block.shopify_attributes }} id="Inventory-{{ section.id }}" role="status">
                  {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
                    {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                      {%- if product.selected_or_first_available_variant.inventory_quantity <= block.settings.inventory_threshold -%}
                        <span class="svg-wrapper" style="color:rgb(238,148,65)">{{- 'icon-inventory-status.svg' | inline_asset_content -}}</span>
                        {%- if block.settings.show_inventory_quantity -%}{{- 'products.product.inventory_low_stock_show_count' | t: quantity: product.selected_or_first_available_variant.inventory_quantity -}}{%- else -%}{{- 'products.product.inventory_low_stock' | t -}}{%- endif -%}
                      {%- else -%}
                        <span class="svg-wrapper" style="color:rgb(62,214,96)">{{- 'icon-inventory-status.svg' | inline_asset_content -}}</span>
                        {%- if block.settings.show_inventory_quantity -%}{{- 'products.product.inventory_in_stock_show_count' | t: quantity: product.selected_or_first_available_variant.inventory_quantity -}}{%- else -%}{{- 'products.product.inventory_in_stock' | t -}}{%- endif -%}
                      {%- endif -%}
                    {%- else -%}
                      {%- if product.selected_or_first_available_variant.inventory_policy == 'continue' -%}
                        <span class="svg-wrapper" style="color:rgb(62,214,96)">{{- 'icon-inventory-status.svg' | inline_asset_content -}}</span>
                        {{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}
                      {%- else -%}
                        <span class="svg-wrapper" style="color:rgb(200,200,200)">{{- 'icon-inventory-status.svg' | inline_asset_content -}}</span>
                        {{- 'products.product.inventory_out_of_stock' | t -}}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endif -%}
                </p>

              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="product__description rte quick-add-hidden"
                       style="font-size:{{ block.settings.font_size_mobile }}px;font-weight:{{ block.settings.font_weight }};color:{{ block.settings.text_color }};line-height:{{ block.settings.line_height | times: 0.1 | plus: 1.0 }};margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;"
                       {{ block.shopify_attributes }}>
                    {{ product.description }}
                  </div>
                {%- endif -%}

              {%- when 'sku' -%}
                <p class="product__sku{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.sku.size == 0 %} visibility-hidden{% endif %}"
                   id="Sku-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
                  <span class="visually-hidden">{{ 'products.product.sku' | t }}:</span>
                  {{- product.selected_or_first_available_variant.sku -}}
                </p>

              {%- when 'custom_liquid' -%}
                {{ block.settings.custom_liquid }}

              {%- when 'collapsible_tab' -%}
                <div class="product__accordion accordion quick-add-hidden"
                     style="margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;"
                     {{ block.shopify_attributes }}>
                  <details id="Details-{{ block.id }}-{{ section.id }}">
                    <summary>
                      <div class="summary__title">
                        {% render 'icon-accordion', icon: block.settings.icon %}
                        <h2 class="h4 accordion__title inline-richtext"
                            style="font-size:{{ block.settings.heading_size }}px;font-weight:{{ block.settings.heading_weight }}!important;color:{{ block.settings.heading_color }};">
                          {{ block.settings.heading | default: block.settings.page.title | escape }}
                        </h2>
                      </div>
                      {{- 'icon-caret.svg' | inline_asset_content -}}
                    </summary>
                    <div class="accordion__content rte"
                         style="font-size:{{ block.settings.content_size }}px;color:{{ block.settings.content_color }};"
                         id="ProductAccordion-{{ block.id }}-{{ section.id }}">
                      {{ block.settings.content }}
                      {{ block.settings.page.content }}
                    </div>
                  </details>
                </div>

              {%- when 'quantity_selector' -%}
                <div id="Quantity-Form-{{ section.id }}"
                     class="product-form__input product-form__quantity{% if settings.inputs_shadow_vertical_offset != 0 and settings.inputs_shadow_vertical_offset < 0 %} product-form__quantity-top{% endif %}"
                     {{ block.shopify_attributes }}>
                  {% # theme-check-disable %}
                  {%- assign cart_qty = cart | item_count_for_variant: product.selected_or_first_available_variant.id -%}
                  {% # theme-check-enable %}
                  <span class="visually-hidden" id="quantity-label-{{ section.id }}">
                    {%- if cart_qty > 0 -%}{{- 'products.product.quantity.in_cart_aria_label' | t: quantity: cart_qty -}}{%- else -%}{{- 'products.product.quantity.label' | t -}}{%- endif -%}
                  </span>
                  <label class="quantity__label form__label" for="Quantity-{{ section.id }}" aria-labelledby="quantity-label-{{ section.id }}">
                    <span aria-hidden="true">{{ 'products.product.quantity.label' | t }}</span>
                    <span class="quantity__rules-cart{% if cart_qty == 0 %} hidden{% endif %}" aria-hidden="true">
                      {%- render 'loading-spinner' -%}
                      <span>({{- 'products.product.quantity.in_cart_html' | t: quantity: cart_qty -}})</span>
                    </span>
                  </label>
                  <div class="price-per-item__container">
                    <quantity-input class="quantity" data-url="{{ product.url }}" data-section="{{ section.id }}">
                      <button class="quantity__button" name="minus" type="button">
                        <span class="visually-hidden">{{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}</span>
                        <span class="svg-wrapper">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
                      </button>
                      <input class="quantity__input" type="number" name="quantity"
                             id="Quantity-{{ section.id }}"
                             data-cart-quantity="{{ cart_qty }}"
                             data-min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                             min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                             {% if product.selected_or_first_available_variant.quantity_rule.max != null %}
                               data-max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                               max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                             {% endif %}
                             step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
                             value="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                             form="{{ product_form_id }}">
                      <button class="quantity__button" name="plus" type="button">
                        <span class="visually-hidden">{{- 'products.product.quantity.increase' | t: product: product.title | escape -}}</span>
                        <span class="svg-wrapper">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
                      </button>
                    </quantity-input>
                    {%- liquid
                      assign volume_pricing_array = product.selected_or_first_available_variant.quantity_price_breaks | sort: 'quantity' | reverse
                      assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.min
                      if cart_qty > 0
                        assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.increment
                      endif
                    -%}
                    {%- if product.quantity_price_breaks_configured? -%}
                      <price-per-item id="Price-Per-Item-{{ section.id }}"
                                      data-section-id="{{ section.id }}"
                                      data-variant-id="{{ product.selected_or_first_available_variant.id }}">
                        {%- if product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                          {%- assign variant_price_compare = product.selected_or_first_available_variant.compare_at_price -%}
                          <div class="price-per-item">
                            {%- if variant_price_compare -%}
                              <dl class="price-per-item--current">
                                <dt class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</dt>
                                <dd><s class="variant-item__old-price">{{ variant_price_compare | money_with_currency }}</s></dd>
                              </dl>
                            {%- endif -%}
                            {%- if current_qty_for_volume_pricing < volume_pricing_array.last.minimum_quantity -%}
                              {%- assign variant_price = product.selected_or_first_available_variant.price | money_with_currency -%}
                              <span class="price-per-item--current">{{- 'products.product.volume_pricing.price_at_each_html' | t: price: variant_price -}}</span>
                            {%- else -%}
                              {%- for price_break in volume_pricing_array -%}
                                {%- if current_qty_for_volume_pricing >= price_break.minimum_quantity -%}
                                  {%- assign price_break_price = price_break.price | money_with_currency -%}
                                  <span class="price-per-item--current">{{- 'products.product.volume_pricing.price_at_each_html' | t: price: price_break_price -}}</span>
                                  {%- break -%}
                                {%- endif -%}
                              {%- endfor -%}
                            {%- endif -%}
                          </div>
                        {%- else -%}
                          {%- assign variant_price = product.selected_or_first_available_variant.price | money_with_currency -%}
                          {%- assign variant_price_compare = product.selected_or_first_available_variant.compare_at_price -%}
                          <div class="price-per-item">
                            {%- if variant_price_compare -%}
                              <dl class="price-per-item--current">
                                <dt class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</dt>
                                <dd><s class="variant-item__old-price">{{ variant_price_compare | money_with_currency }}</s></dd>
                                <dt class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</dt>
                                <dd><span class="price-per-item--current">{{- 'products.product.volume_pricing.price_at_each_html' | t: price: variant_price -}}</span></dd>
                              </dl>
                            {%- else -%}
                              <span class="price-per-item--current">{{- 'products.product.volume_pricing.price_at_each_html' | t: price: variant_price -}}</span>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      </price-per-item>
                    {%- endif -%}
                  </div>
                  <div class="quantity__rules caption" id="Quantity-Rules-{{ section.id }}">
                    {%- if product.selected_or_first_available_variant.quantity_rule.increment > 1 -%}
                      <span class="divider">{{- 'products.product.quantity.multiples_of' | t: quantity: product.selected_or_first_available_variant.quantity_rule.increment -}}</span>
                    {%- endif -%}
                    {%- if product.selected_or_first_available_variant.quantity_rule.min > 1 -%}
                      <span class="divider">{{- 'products.product.quantity.minimum_of' | t: quantity: product.selected_or_first_available_variant.quantity_rule.min -}}</span>
                    {%- endif -%}
                    {%- if product.selected_or_first_available_variant.quantity_rule.max != null -%}
                      <span class="divider">{{- 'products.product.quantity.maximum_of' | t: quantity: product.selected_or_first_available_variant.quantity_rule.max -}}</span>
                    {%- endif -%}
                  </div>
                  {%- if product.quantity_price_breaks_configured? -%}
                    <volume-pricing class="parent-display" id="Volume-{{ section.id }}">
                      {%- if product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                        <span class="caption-large">{{ 'products.product.volume_pricing.title' | t }}</span>
                        <ul class="list-unstyled">
                          <li>
                            <span>{{ product.selected_or_first_available_variant.quantity_rule.min }}+</span>
                            {%- assign price = product.selected_or_first_available_variant.price | money_with_currency -%}
                            <span data-text="{{ 'products.product.volume_pricing.price_at_each_html' | t: price: variant_price }}">{{- 'sections.quick_order_list.each' | t: money: price -}}</span>
                          </li>
                          {%- for price_break in product.selected_or_first_available_variant.quantity_price_breaks -%}
                            {%- assign price_break_price = price_break.price | money_with_currency -%}
                            <li class="{%- if forloop.index >= 3 -%}show-more-item hidden{%- endif -%}">
                              <span>{{- price_break.minimum_quantity -}}<span aria-hidden="true">+</span></span>
                              <span data-text="{{ 'products.product.volume_pricing.price_at_each_html' | t: price: price_break_price }}">{{- 'sections.quick_order_list.each' | t: money: price_break_price -}}</span>
                            </li>
                          {%- endfor -%}
                        </ul>
                        {%- if product.selected_or_first_available_variant.quantity_price_breaks.size >= 3 -%}
                          <show-more-button>
                            <button class="button-show-more link underlined-link" id="Show-More-{{ section.id }}" type="button">
                              <span class="label-show-more label-text"><span aria-hidden="true">+ </span>{{ 'products.facets.show_more' | t }}</span>
                            </button>
                          </show-more-button>
                        {%- endif -%}
                      {%- endif -%}
                    </volume-pricing>
                  {%- endif -%}
                </div>

              {%- when 'popup' -%}
                <modal-opener class="product-popup-modal__opener quick-add-hidden"
                              data-modal="#PopupModal-{{ block.id }}"
                              {{ block.shopify_attributes }}>
                  <button id="ProductPopup-{{ block.id }}" class="product-popup-modal__button link"
                          type="button" aria-haspopup="dialog">
                    {{ block.settings.text | default: block.settings.page.title | escape }}
                  </button>
                </modal-opener>

              {%- when 'share' -%}
                {% liquid
                  assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin
                  render 'share-button', block: block, share_link: share_url
                %}

              {%- when 'variant_picker' -%}
                {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}

              {%- when 'buy_buttons' -%}
                <div style="margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;">
                  {%- render 'buy-buttons', block: block, product: product, product_form_id: product_form_id, section_id: section.id, show_pickup_availability: true -%}
                </div>

              {%- when 'gnrl_shipping_estimate' -%}
                <style>
                    .gnrl-shipping-{{ block.id }} {
                      display: flex;
                      align-items: center;
                      justify-content: space-between;
                      margin-top: {{ block.settings.margin_top }}px;
                      margin-bottom: {{ block.settings.margin_bottom }}px;
                      font-size: 14px;
                      font-family: 'Plus Jakarta Sans', sans-serif !important;
                      color: #1A1A1A;
                    }
                    .gnrl-shipping-{{ block.id }} .gnrl-shipping-item {
                      display: flex;
                      align-items: center;
                      gap: 7px;
                    }
                    .gnrl-shipping-{{ block.id }} .gnrl-shipping-item span {
                      font-weight: 400;
                    }
                    .gnrl-shipping-{{ block.id }} .gnrl-shipping-item strong {
                      font-weight: 700;
                    }
                    .gnrl-shipping-{{ block.id }} .gnrl-shipping-dot {
                      position: relative;
                      width: 8px;
                      height: 8px;
                      border-radius: 50%;
                      background-color: {{ block.settings.dot_color }};
                      flex-shrink: 0;
                    }
                    .gnrl-shipping-{{ block.id }} .gnrl-shipping-dot::after {
                      content: '';
                      position: absolute;
                      top: 0;
                      left: 0;
                      width: 100%;
                      height: 100%;
                      border-radius: 50%;
                      background-color: {{ block.settings.dot_color }};
                      animation: gnrlShippingPing-{{ block.id }} 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
                    }
                    @keyframes gnrlShippingPing-{{ block.id }} {
                      0%   { transform: scale(1);   opacity: 0.7; }
                      75%, 100% { transform: scale(2.5); opacity: 0; }
                    }
                    .gnrl-shipping-{{ block.id }} .gnrl-shipping-flag {
                      display: flex;
                      flex-shrink: 0;
                    }
                    .gnrl-shipping-{{ block.id }} .gnrl-shipping-flag img {
                      display: block;
                      width: 20px;
                      height: 14px;
                      object-fit: cover;
                      border-radius: 2px;
                    }
                </style>
                    <div class="gnrl-shipping-{{ block.id }}" {{ block.shopify_attributes }}>
                      <div class="gnrl-shipping-item">
                        <span class="gnrl-shipping-dot"></span>
                        {%- assign two_days_from_now = 'now' | date: '%s' | plus: 172800 | date: '%b. %-d' -%}
                        <span>{{ block.settings.ships_by_label }} <strong>{{ two_days_from_now }}</strong></span>
                      </div>
                      <div class="gnrl-shipping-item">
                        <span class="gnrl-shipping-flag">
                          {%- if block.settings.flag_image != blank -%}
                            <img src="{{ block.settings.flag_image | image_url: width: 64 }}"
                                alt="{{ block.settings.flag_image.alt | escape | default: block.settings.ships_from_value }}"
                                width="20" height="14"
                                loading="lazy">
                          {%- endif -%}
                        </span>
                        <span>{{ block.settings.ships_from_label }} <strong>{{ block.settings.ships_from_value }}</strong></span>
                      </div>
                    </div>

              {%- when 'rating' -%}
                {%- if product.metafields.reviews.rating.value != blank -%}
                  <div class="rating-wrapper"
                       style="margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;">
                    {% liquid
                      assign rating_decimal = 0
                      assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
                      if decimal >= 0.3 and decimal <= 0.7
                        assign rating_decimal = 0.5
                      elsif decimal > 0.7
                        assign rating_decimal = 1
                      endif
                    %}
                    <div class="rating" role="img"
                         aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}">
                      <span aria-hidden="true" class="rating-star"
                            style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"></span>
                    </div>
                    <p class="rating-text caption" style="font-size:{{ block.settings.text_size }}px;color:{{ block.settings.text_color }};">
                      <span aria-hidden="true">{{- product.metafields.reviews.rating.value }} / {{ product.metafields.reviews.rating.value.scale_max -}}</span>
                    </p>
                    <p class="rating-count caption" style="font-size:{{ block.settings.text_size }}px;color:{{ block.settings.text_color }};">
                      <span aria-hidden="true">({{ product.metafields.reviews.rating_count }})</span>
                      <span class="visually-hidden">{{- product.metafields.reviews.rating_count }} {{ 'accessibility.total_reviews' | t -}}</span>
                    </p>
                  </div>
                {%- endif -%}

              {%- when 'complementary' -%}
                <product-recommendations
                  class="complementary-products quick-add-hidden{% if block.settings.make_collapsible_row %} is-accordion{% endif %}{% if block.settings.enable_quick_add %} complementary-products-contains-quick-add{% endif %}"
                  data-url="{{ routes.product_recommendations_url }}?limit={{ block.settings.product_list_limit }}&intent=complementary"
                  data-section-id="{{ section.id }}"
                  data-product-id="{{ product.id }}">
                  {%- if recommendations.performed and recommendations.products_count > 0 -%}
                    <aside aria-label="{{ 'accessibility.complementary_products' | t }}" {{ block.shopify_attributes -}}
                           {% if block.settings.make_collapsible_row %}class="product__accordion accordion"{% endif %}>
                      <div class="complementary-products__container">
                        {%- if block.settings.make_collapsible_row -%}<details id="Details-{{ block.id }}-{{ section.id }}" open><summary>{%- endif %}
                        <div class="summary__title">
                          {%- if block.settings.make_collapsible_row -%}{% render 'icon-accordion', icon: block.settings.icon %}<h2 class="h4 accordion__title">{{ block.settings.block_heading }}</h2>
                          {%- else -%}<h2 class="h3 accordion__title">{{ block.settings.block_heading }}</h2>{%- endif -%}
                        </div>
                        {%- if block.settings.make_collapsible_row -%}{{- 'icon-caret.svg' | inline_asset_content -}}</summary>{%- endif -%}
                        <slideshow-component class="slider-mobile-gutter">
                          {%- assign number_of_slides = recommendations.products_count | plus: 0.0 | divided_by: block.settings.products_per_page | ceil -%}
                          <div id="Slider-{{ block.id }}" class="contains-card contains-card--product complementary-slider grid grid--1-col slider slider--everywhere" role="list" {% if number_of_slides > 1 %}aria-label="{{ 'general.slider.name' | t }}"{% endif %}>
                            {% assign skip_card_product_styles = false %}
                            {%- for i in (1..number_of_slides) -%}
                              <div id="Slide-{{ block.id }}-{{ forloop.index }}" class="complementary-slide complementary-slide--{{ settings.card_style }} grid__item slider__slide slideshow__slide" tabindex="-1" role="group" {% if number_of_slides > 1 %}aria-roledescription="{{ 'sections.slideshow.slide' | t }}" aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"{% endif %}>
                                <ul class="list-unstyled" role="list">
                                  {%- for product in recommendations.products limit: block.settings.products_per_page offset: continue -%}
                                    <li>
                                      {%- if block.settings.enable_quick_add -%}{%- assign quick_add = 'standard' -%}{%- else -%}{%- assign quick_add = 'none' -%}{%- endif -%}
                                      {% render 'card-product', card_product: product, media_aspect_ratio: block.settings.image_ratio, show_secondary_image: false, lazy_load: false, skip_styles: skip_card_product_styles, quick_add: quick_add, section_id: section.id, horizontal_class: true, horizontal_quick_add: true %}
                                    </li>
                                    {%- assign skip_card_product_styles = true -%}
                                  {%- endfor -%}
                                </ul>
                              </div>
                            {%- endfor -%}
                          </div>
                          {%- if number_of_slides > 1 -%}
                            <div class="slider-buttons">
                              <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}"><span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span></button>
                              <div class="slider-counter slider-counter--{{ block.settings.pagination_style }}{% if block.settings.pagination_style == 'counter' or block.settings.pagination_style == 'numbers' %} caption{% endif %}">
                                {%- if block.settings.pagination_style == 'counter' -%}
                                  <span class="slider-counter--current">1</span><span aria-hidden="true"> / </span><span class="visually-hidden">{{ 'general.slider.of' | t }}</span><span class="slider-counter--total">{{ number_of_slides }}</span>
                                {%- else -%}
                                  <div class="slideshow__control-wrapper">
                                    {%- for i in (1..number_of_slides) -%}
                                      <button class="slider-counter__link slider-counter__link--{{ block.settings.pagination_style }} link" aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}" aria-controls="Slider-{{ block.id }}">
                                        {%- if block.settings.pagination_style == 'numbers' -%}{{ forloop.index -}}{%- else -%}<span class="dot"></span>{%- endif -%}
                                      </button>
                                    {%- endfor -%}
                                  </div>
                                {%- endif -%}
                              </div>
                              <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}"><span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span></button>
                            </div>
                          {%- endif -%}
                        </slideshow-component>
                        {%- if block.settings.make_collapsible_row -%}</details>{%- endif -%}
                      </div>
                    </aside>
                  {%- endif -%}
                  {{ 'component-card.css' | asset_url | stylesheet_tag }}
                  {{ 'component-complementary-products.css' | asset_url | stylesheet_tag }}
                  {%- if block.settings.enable_quick_add -%}
                    {{ 'quick-add.css' | asset_url | stylesheet_tag }}
                    <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
                  {%- endif -%}
                </product-recommendations>

              {%- when 'icon-with-text' -%}
                <div style="margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;">
                  {% render 'icon-with-text', block: block %}
                </div>

              {%- when 'gnrl-icon-with-content' -%}
                <div {{ block.shopify_attributes }}
                  style="margin-bottom:{{ block.settings.margin_bottom }}px;">
                  {%- for i in (1..6) -%}
                    {%- assign text_key = 'item_' | append: i -%}
                    {%- assign text_val = block.settings[text_key] -%}
                    {%- if text_val != blank -%}
                      <div style="display:flex;align-items:center;gap:{{ block.settings.icon_gap }}px;margin-bottom:{{ block.settings.item_gap }}px;">
                        {%- if block.settings.custom_icon != blank -%}
                          <img src="{{ block.settings.custom_icon | image_url: width: 48 }}"
                              alt="" width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}"
                              style="width:{{ block.settings.icon_size }}px;height:{{ block.settings.icon_size }}px;object-fit:contain;flex-shrink:0;">
                        {%- elsif block.settings.use_material_icon -%}
                          <svg width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}" viewBox="0 0 24 24" fill="{{ block.settings.icon_color }}" style="flex-shrink:0;">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5l-4-4 1.41-1.41L10 13.67l6.59-6.59L18 8.5l-8 8z"/>
                          </svg>
                        {%- else -%}
                          <svg width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}" viewBox="0 0 24 24"
                              fill="none" stroke="{{ block.settings.icon_color }}" stroke-width="2.5"
                              stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                            <polyline points="22 4 12 14.01 9 11.01"/>
                          </svg>
                        {%- endif -%}
                        <span style="font-size:{{ block.settings.text_size }}px;color:{{ block.settings.text_color }};font-weight:{{ block.settings.text_weight }};line-height:1.3;">{{ text_val }}</span>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>  

              {%- when 'gnrl-icon-with-text-grid' -%}
                <div style="margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;">
                  {% render 'gnrl-icon-with-text-grid', block: block %}
                </div>  

              {%- when 'star_rating_custom' -%}
                {%- assign filled = block.settings.rating | round -%}
                <div {{ block.shopify_attributes }}
                     style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:{{ block.settings.margin_bottom }}px;">
                  <div style="display:flex;">
                    {%- for i in (1..5) -%}
                      <svg width="{{ block.settings.star_size }}" height="{{ block.settings.star_size }}" viewBox="0 0 24 24">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
                          fill="{% if i <= filled %}{{ block.settings.star_color }}{% else %}{{ block.settings.star_empty_color }}{% endif %}" stroke="none"/>
                      </svg>
                    {%- endfor -%}
                  </div>
                  {%- if block.settings.meta_text != blank -%}
                    <div style="margin:4px 0px 0px 0px;font-size:{{ block.settings.text_size }}px;color:{{ block.settings.text_color }};line-height:1.4;">{{ block.settings.meta_text | replace: '<p>', '<p style="margin:0;">' }}</div>
                  {%- endif -%}
                </div>

              {%- when 'benefit_icon_grid' -%}
                <style>
                  .benefit-grid-{{ block.id }} {
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                    column-gap: {{ block.settings.col_gap }}px;
                    row-gap: {{ block.settings.row_gap }}px;
                  }
                  .benefit-grid-{{ block.id }} .bg-item {
                    display: flex;
                    align-items: center;
                    gap: {{ block.settings.icon_gap }}px;
                  }
                  .benefit-grid-{{ block.id }} .bg-icon {
                    flex-shrink: 0;
                    width: {{ block.settings.icon_size }}px;
                    height: {{ block.settings.icon_size }}px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                  }
                  .benefit-grid-{{ block.id }} .bg-icon img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                    display: block;
                  }
                  .benefit-grid-{{ block.id }} .bg-label {
                    font-size: {{ block.settings.font_size }}px;
                    font-weight: {{ block.settings.font_weight }};
                    line-height: 1.3;
                    color: {{ block.settings.text_color }};
                  }
                  @media screen and (max-width: 749px) {
                    .benefit-grid-{{ block.id }} {
                      grid-template-columns: 1fr 1fr;
                      column-gap: {{ block.settings.col_gap | times: 0.6 }}px;
                      row-gap: {{ block.settings.row_gap | times: 0.8 }}px;
                    }
                    .benefit-grid-{{ block.id }} .bg-icon {
                      width: {{ block.settings.icon_size | times: 0.85 }}px;
                      height: {{ block.settings.icon_size | times: 0.85 }}px;
                    }
                    .benefit-grid-{{ block.id }} .bg-label {
                      font-size: 10px;
                    }
                  }
                </style>
                <div class="benefit-grid-{{ block.id }}"
                     {{ block.shopify_attributes }}
                     style="margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;">
                  {%- for i in (1..6) -%}
                    {%- assign icon_key = 'icon_' | append: i -%}
                    {%- assign label_key = 'label_' | append: i -%}
                    {%- assign icon_val = block.settings[icon_key] -%}
                    {%- assign label_val = block.settings[label_key] -%}
                    {%- if label_val != blank -%}
                      <div class="bg-item">
                        <span class="bg-icon">
                          {%- if icon_val != blank -%}
                            <img src="{{ icon_val | image_url: width: 96 }}" alt="{{ label_val | strip_html | escape }}" loading="lazy" width="48" height="48">
                          {%- endif -%}
                        </span>
                        <span class="bg-label">{{ label_val }}</span>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

              {%- when 'icon_with_content' -%}
                <div {{ block.shopify_attributes }}
                  style="margin-bottom:{{ block.settings.margin_bottom }}px;text-align:{{ block.settings.alignment }};">
                  {%- for i in (1..6) -%}
                    {%- assign text_key = 'item_' | append: i -%}
                    {%- assign text_val = block.settings[text_key] -%}
                    {%- if text_val != blank -%}
                      <div style="display:flex;align-items:center;gap:{{ block.settings.icon_gap }}px;margin-bottom:{{ block.settings.item_gap }}px;justify-content:{% case block.settings.alignment %}{% when 'left' %}flex-start{% when 'center' %}center{% when 'right' %}flex-end{% endcase %};">
                        {%- if block.settings.custom_icon != blank -%}
                          <img src="{{ block.settings.custom_icon | image_url: width: 48 }}"
                               alt="" width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}"
                               style="width:{{ block.settings.icon_size }}px;height:{{ block.settings.icon_size }}px;object-fit:contain;flex-shrink:0;">
                        {%- else -%}
                          <svg width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}" viewBox="0 0 24 24"
                               fill="none" stroke="{{ block.settings.icon_color }}" stroke-width="2.5"
                               stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                            <polyline points="22 4 12 14.01 9 11.01"/>
                          </svg>
                        {%- endif -%}
                        <span style="font-size:{{ block.settings.text_size }}px;color:{{ block.settings.text_color }};font-weight:{{ block.settings.text_weight }};">{{ text_val }}</span>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

              {%- when 'social_proof_bar' -%}
                <div {{ block.shopify_attributes }}
                    style="background:{{ block.settings.bg_color }};border-radius:{{ block.settings.radius }}px;padding:{{ block.settings.padding_v }}px {{ block.settings.padding_h }}px;margin-bottom:{{ block.settings.margin_bottom }}px;display:flex;align-items:center;gap:1.6rem;">
                  <div style="display:flex;flex-shrink:0;padding-right:7px;">
                    {%- for i in (1..5) -%}
                      {%- assign img_key = 'avatar_' | append: i -%}
                      {%- assign img_val = block.settings[img_key] -%}
                      {%- if img_val != blank -%}
                        <img src="{{ img_val | image_url: width: 80 }}" alt="Customer {{ i }}"
                            style="width:{{ block.settings.avatar_size }}px;height:{{ block.settings.avatar_size }}px;border-radius:50%;object-fit:cover;border:2px solid {{ block.settings.bg_color }};{% unless forloop.first %}margin-left:-{{ block.settings.avatar_overlap }}px;{% endunless %}flex-shrink:0;">
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  <div>
                    {%- if block.settings.heading != blank -%}
                      <p style="margin:0;font-size:{{ block.settings.heading_size }}px;font-weight:{{ block.settings.heading_weight }}!important;color:{{ block.settings.heading_color }};line-height:{{ block.settings.heading_line_height }};">{{ block.settings.heading }}</p>
                    {%- endif -%}
                    {%- if block.settings.subtext != blank -%}
                      <p style="margin:0;font-size:{{ block.settings.subtext_size }}px;color:{{ block.settings.subtext_color }};line-height:{{ block.settings.subtext_line_height }};">{{ block.settings.subtext }}</p>
                    {%- endif -%}
                  </div>
                </div>

              {%- when 'gnrl_social_proof_bar' -%}
                <div {{ block.shopify_attributes }}
                  style="display:flex;align-items:center;justify-content:center;margin-bottom:{{ block.settings.margin_bottom }}px;">

                  <div style="display:flex;flex-shrink:0;position:relative;z-index:1;margin-right:-{{ block.settings.avatar_bleed }}px;">

                    {%- assign last_avatar_index = 0 -%}
                    {%- for i in (1..5) -%}
                      {%- assign img_key = 'avatar_' | append: i -%}
                      {%- if block.settings[img_key] != blank -%}
                        {%- assign last_avatar_index = i -%}
                      {%- endif -%}
                    {%- endfor -%}

                    {%- for i in (1..5) -%}
                      {%- assign img_key = 'avatar_' | append: i -%}
                      {%- assign img_val = block.settings[img_key] -%}
                      {%- if img_val != blank -%}
                        <div style="position:relative;flex-shrink:0;z-index:{{ forloop.index }};{% unless forloop.first %}margin-left:-{{ block.settings.avatar_overlap }}px;{% endunless %}">
                          <img
                            src="{{ img_val | image_url: width: 80 }}"
                            alt="Customer {{ i }}"
                            style="width:{{ block.settings.avatar_size }}px;height:{{ block.settings.avatar_size }}px;border-radius:50%;object-fit:cover;border:2px solid white;display:block;">
                          {%- if i == last_avatar_index and block.settings.badge_svg != blank -%}
                            <span style="position:absolute;top:-2px;right:-2px;display:flex;align-items:center;justify-content:center;width:{{ block.settings.badge_size }}px;height:{{ block.settings.badge_size }}px;z-index:10;">
                              {{ block.settings.badge_svg }}
                            </span>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    {%- endfor -%}

                  </div>

                  <div style="background:{{ block.settings.bg_color }};border-radius:{{ block.settings.radius }}px;padding:{{ block.settings.padding_v }}px {{ block.settings.padding_h }}px {{ block.settings.padding_v }}px {{ block.settings.pill_padding_left }}px;">

                    {%- if block.settings.heading != blank -%}
                      <p style="margin:0;font-size:{{ block.settings.heading_size }}px;font-weight:{{ block.settings.heading_weight }};color:{{ block.settings.heading_color }};line-height:{{ block.settings.heading_line_height }};">{{ block.settings.heading }}</p>
                    {%- endif -%}
                    {%- if block.settings.subtext != blank -%}
                      <p style="margin:0;font-size:{{ block.settings.subtext_size }}px;color:{{ block.settings.subtext_color }};line-height:{{ block.settings.subtext_line_height }};">{{ block.settings.subtext }}</p>
                    {%- endif -%}
                  </div>

                </div>

              {%- when 'collapsible_row_custom' -%}
                <div {{ block.shopify_attributes }} style="margin-bottom:{{ block.settings.margin_bottom }}px;">
                  {%- for i in (1..10) -%}
                    {%- assign q_key = 'q_' | append: i -%}
                    {%- assign a_key = 'a_' | append: i -%}
                    {%- assign icon_key = 'icon_' | append: i -%}
                    {%- assign q_val = block.settings[q_key] -%}
                    {%- assign a_val = block.settings[a_key] -%}
                    {%- assign icon_val = block.settings[icon_key] -%}
                    {%- if q_val != blank -%}
                      <details class="cfp-faq-item" style="border-bottom:{{ block.settings.border_width }}px {{ block.settings.border_style }} {{ block.settings.border_color }};">
                        <summary class="cfp-faq-summary"
                                 style="display:flex;justify-content:space-between;align-items:center;padding:{{ block.settings.padding_v }}px {{ block.settings.padding_h }}px;cursor:pointer;gap:8px;background:{{ block.settings.header_bg }};">
                          <div style="display:flex;align-items:center;gap:10px;">
                            {%- if icon_val != blank -%}
                              <img src="{{ icon_val | image_url: width: 48 }}" alt=""
                                   style="width:20px;height:20px;object-fit:contain;flex-shrink:0;">
                            {%- endif -%}
                            <span style="font-size:{{ block.settings.heading_size }}px;font-weight:{{ block.settings.heading_weight }} !important;color:{{ block.settings.heading_color }};">{{ q_val }}</span>
                          </div>
                              <svg class="cfp-faq-arrow" width="16" height="16" viewBox="0 0 24 24"
                                  fill="none" stroke="{{ block.settings.heading_color }}" stroke-width="2"
                                  stroke-linecap="round" stroke-linejoin="round"
                                  style="flex-shrink:0;transition:transform 0.25s;transform-origin:center;">
                                <line x1="12" y1="5" x2="12" y2="19"/>
                                <line x1="5" y1="12" x2="19" y2="12"/>
                              </svg>
                        </summary>
                        <div style="padding:{{ block.settings.content_padding_v }}px {{ block.settings.padding_h }}px;background:{{ block.settings.content_bg }};">
                          <div style="font-size:{{ block.settings.content_size }}px;color:{{ block.settings.content_color }};line-height:1.6;" class="rte">{{ a_val }}</div>
                        </div>
                      </details>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

              {%- when 'urgency_bar' -%}
                <div {{ block.shopify_attributes }} style="margin-bottom:{{ block.settings.margin_bottom }}px;">
                  <div style="background:{{ block.settings.bg_color }};border-radius:{{ block.settings.wrap_radius }}px;padding:{{ block.settings.wrap_padding }}px 12px;display:flex;align-items:center;gap:{{ block.settings.gap }}px;">
                    {%- if block.settings.label_position == 'left' and block.settings.label_after != blank -%}
                      <span style="font-size:{{ block.settings.label_size }}px;color:{{ block.settings.label_color }};white-space:nowrap;font-weight:500;">{{ block.settings.percentage }}{{ block.settings.label_after }}</span>
                    {%- endif -%}
                    <div style="flex:1;min-width:0;height:{{ block.settings.bar_height }}px;background:{{ block.settings.track_color }};border-radius:{{ block.settings.bar_radius }}px;display:flex;align-items:stretch;">
                      <div style="width:{{ block.settings.percentage }}%;height:{{ block.settings.bar_height }}px;background:{{ block.settings.fill_color }};border-radius:{{ block.settings.bar_radius }}px;flex-shrink:0;">&nbsp;</div>
                    </div>
                    {%- if block.settings.label_position == 'right' and block.settings.label_after != blank -%}
                      <span style="font-size:{{ block.settings.label_size }}px;color:{{ block.settings.label_color }};white-space:nowrap;font-weight:500;">{{ block.settings.percentage }}{{ block.settings.label_after }}</span>
                    {%- endif -%}
                  </div>
                </div>

              {%- when 'payment_badges' -%}
                <style>
                  .payment-badges-{{ block.id }} { gap: {{ block.settings.badge_gap }}px; }
                  .payment-badges-{{ block.id }} .list-payment__item svg { height: {{ block.settings.badge_size }}px; width: auto; }
                </style>
                <div class="payment-badges-block"
                     style="margin-top:{{ block.settings.margin_top | divided_by: 10.0 }}rem;margin-bottom:{{ block.settings.margin_bottom | divided_by: 10.0 }}rem;"
                     role="region"
                     {{ block.shopify_attributes }}>
                  <ul class="payment-badges payment-badges-{{ block.id }}" role="list"
                      style="display:flex;flex-wrap:wrap;list-style:none;padding:0;margin:0;justify-content:{{ block.settings.alignment }};">
                    {%- assign enabled_payment_types = shop.enabled_payment_types -%}
                    {%- if block.settings.enabled_payment_types != blank -%}
                      {%- assign enabled_payment_types = block.settings.enabled_payment_types | remove: ' ' | split: ',' -%}
                    {%- endif -%}
                    {%- for type in enabled_payment_types -%}
                      {%- assign payment_type = type | strip -%}
                      <li class="list-payment__item">
                        <span class="visually-hidden">{{ payment_type | replace: '_', ' ' | capitalize }} payment method</span>
                        {{ payment_type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>

              {%- when 'gnrl_guarantee' -%}
                <style>
                  .gnrl-guarantee-section-{{ block.id }} {
                    background-color: {{ block.settings.bg_color }};
                    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
                    border-radius: {{ block.settings.border_radius }}px;
                    padding: {{ block.settings.padding_v }}px {{ block.settings.padding_h }}px;
                    margin-top: {{ block.settings.margin_top }}px;
                    margin-bottom: {{ block.settings.margin_bottom }}px;
                  }
                  .gnrl-guarantee-inner { display: flex; align-items: center; gap: {{ block.settings.gap }}px; }
                  .gnrl-guarantee-badge { flex-shrink: 0; }
                  .gnrl-guarantee-badge img { width: {{ block.settings.badge_size }}px; height: {{ block.settings.badge_size }}px; object-fit: contain; display: block; }
                  .gnrl-guarantee-text { display: flex; flex-direction: column; gap: {{ block.settings.text_gap }}px; }
                  @media (max-width: 480px) {
                    .gnrl-guarantee-section-{{ block.id }} { padding: {{ block.settings.padding_v_mobile }}px {{ block.settings.padding_h_mobile }}px; border-radius: {{ block.settings.border_radius_mobile }}px; }
                    .gnrl-guarantee-section-{{ block.id }} .gnrl-guarantee-heading { font-size: {{ block.settings.heading_size_mobile }}px !important; }
                    .gnrl-guarantee-section-{{ block.id }} .gnrl-guarantee-subtext { font-size: {{ block.settings.subtext_size_mobile }}px !important; }
                    .gnrl-guarantee-inner { gap: {{ block.settings.gap_mobile }}px; }
                    .gnrl-guarantee-badge img { width: {{ block.settings.badge_size_mobile }}px; height: {{ block.settings.badge_size_mobile }}px; }
                  }
                </style>
                <div class="gnrl-guarantee-section-{{ block.id }}" {{ block.shopify_attributes }}>
                  <div class="gnrl-guarantee-inner">
                    {%- if block.settings.badge_image != blank -%}
                      <div class="gnrl-guarantee-badge">
                        <img src="{{ block.settings.badge_image | image_url: width: 150 }}"
                            alt="{{ block.settings.badge_image.alt | escape | default: 'Guarantee badge' }}"
                            width="{{ block.settings.badge_size }}"
                            height="{{ block.settings.badge_size }}"
                            loading="lazy">
                      </div>
                    {%- endif -%}
                    <div class="gnrl-guarantee-text">
                      {%- if block.settings.heading != blank -%}
                        <p class="gnrl-guarantee-heading"
                          style="font-size:{{ block.settings.heading_size }}px;font-weight:{{ block.settings.heading_weight }};color:{{ block.settings.heading_color }};margin:0;line-height:1.3;">
                          {{ block.settings.heading }}
                        </p>
                      {%- endif -%}
                      {%- if block.settings.subtext != blank -%}
                        <p class="gnrl-guarantee-subtext"
                          style="font-size:{{ block.settings.subtext_size }}px;color:{{ block.settings.subtext_color }};margin:0;line-height:1.5;">
                          {{ block.settings.subtext }}
                        </p>
                      {%- endif -%}
                    </div>
                  </div>
                </div>

            {%- endcase -%}
          {%- endfor -%}

          <a href="{{ product.url }}" class="link product__view-details animate-arrow">
            {{ 'products.product.view_full_details' | t }}
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </a>
        </section>
      </div>
    </div>

    {% render 'product-media-modal', variant_images: variant_images %}

    {% assign popups = section.blocks | where: 'type', 'popup' %}
    {%- for block in popups -%}
      <modal-dialog id="PopupModal-{{ block.id }}" class="product-popup-modal" {{ block.shopify_attributes }}>
        <div role="dialog" aria-label="{{ block.settings.text }}" aria-modal="true"
             class="product-popup-modal__content" tabindex="-1">
          <button id="ModalClose-{{ block.id }}" type="button" class="product-popup-modal__toggle"
                  aria-label="{{ 'accessibility.close' | t }}">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </button>
          <div class="product-popup-modal__content-info">
            <h1 class="h2">{{ block.settings.page.title | escape }}</h1>
            {{ block.settings.page.content }}
          </div>
        </div>
      </modal-dialog>
    {%- endfor -%}

    {%- if product.media.size > 0 -%}
      <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {%- if first_3d_model -%}
      <script type="application/json" id="ProductJSON-{{ product.id }}">{{ product.media | where: 'media_type', 'model' | json }}</script>
      <script src="{{ 'product-model.js' | asset_url }}" defer></script>
    {%- endif -%}
    {%- liquid
      if product.selected_or_first_available_variant.featured_media
        assign seo_media = product.selected_or_first_available_variant.featured_media
      else
        assign seo_media = product.featured_media
      endif
    -%}
  <script type="application/ld+json">{{ product | structured_data }}</script>
  </div>

  <script>
  (function() {
    var sid = '{{ section.id }}';

    // ── Desktop thumbnail click ──
    var thumbsWrap = document.getElementById('cfp-thumbs-' + sid);
    if (thumbsWrap) {
      thumbsWrap.addEventListener('click', function(e) {
        var thumb = e.target.closest('.cfp-dt-thumb');
        if (!thumb) return;
        var mainImg = document.getElementById('cfp-main-img-' + sid);
        if (!mainImg) return;
        mainImg.style.opacity = '0.5';
        mainImg.src = thumb.dataset.src;
        mainImg.alt = thumb.dataset.alt || '';
        mainImg.onload = function() { mainImg.style.opacity = '1'; };
        thumbsWrap.querySelectorAll('.cfp-dt-thumb').forEach(function(t) { t.classList.remove('is-active'); });
        thumb.classList.add('is-active');
      });
    }

    // ── Desktop thumbnail arrows ──
    var thumbsScroll = document.getElementById('cfp-thumbs-' + sid);
    var arrowL = document.getElementById('cfp-arrow-left-' + sid);
    var arrowR = document.getElementById('cfp-arrow-right-' + sid);
    if (thumbsScroll && arrowL && arrowR) {
      var scrollAmt = 160;
      arrowL.addEventListener('click', function() {
        thumbsScroll.scrollBy({ left: -scrollAmt, behavior: 'smooth' });
      });
      arrowR.addEventListener('click', function() {
        thumbsScroll.scrollBy({ left: scrollAmt, behavior: 'smooth' });
      });
    }

    // ── Mobile swiper + dual nav (dots / thumbnails) ──
    var swiper    = document.getElementById('cfp-ms-' + sid);
    var track     = document.getElementById('cfp-mt-' + sid);
    var dotsEl    = document.getElementById('cfp-md-' + sid);
    var thumbsEl  = document.getElementById('cfp-mt-thumbs-' + sid);
    var current   = 0;
    var total     = track ? track.querySelectorAll('.cfp-mobile-slide').length : 0;

    function gotoSlide(idx) {
      current = idx;
      track.style.transform = 'translateX(-' + (idx * 100) + '%)';
      if (dotsEl) {
        dotsEl.querySelectorAll('.cfp-mobile-dot').forEach(function(d) {
          d.classList.toggle('is-active', parseInt(d.dataset.index) === idx);
        });
      }
      if (thumbsEl) {
        thumbsEl.querySelectorAll('.cfp-mobile-thumb').forEach(function(t) {
          t.classList.toggle('is-active', parseInt(t.dataset.index) === idx);
        });
        var activeThumb = thumbsEl.querySelector('.cfp-mobile-thumb.is-active');
        if (activeThumb) {
          activeThumb.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }
      }
    }

    if (dotsEl) {
      dotsEl.addEventListener('click', function(e) {
        var dot = e.target.closest('.cfp-mobile-dot');
        if (dot) gotoSlide(parseInt(dot.dataset.index, 10));
      });
    }

    if (thumbsEl) {
      thumbsEl.addEventListener('click', function(e) {
        var thumb = e.target.closest('.cfp-mobile-thumb');
        if (thumb) gotoSlide(parseInt(thumb.dataset.index, 10));
      });
    }

    if (swiper && total > 1) {
      var startX = 0, startY = 0, isHoriz = null, dragging = false;
      swiper.addEventListener('touchstart', function(e) {
        startX = e.touches[0].clientX; startY = e.touches[0].clientY;
        isHoriz = null; dragging = true;
      }, { passive: true });
      swiper.addEventListener('touchmove', function(e) {
        if (!dragging) return;
        var dx = e.touches[0].clientX - startX, dy = e.touches[0].clientY - startY;
        if (isHoriz === null && (Math.abs(dx) > 5 || Math.abs(dy) > 5)) isHoriz = Math.abs(dx) > Math.abs(dy);
        if (isHoriz) e.preventDefault();
      }, { passive: false });
      swiper.addEventListener('touchend', function(e) {
        if (!dragging || !isHoriz) return;
        dragging = false;
        var dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) < 40) return;
        if (dx < 0 && current < total - 1) gotoSlide(current + 1);
        else if (dx > 0 && current > 0) gotoSlide(current - 1);
      }, { passive: true });
      swiper.addEventListener('touchcancel', function() { dragging = false; });
    }
    // ── Mobile thumbnail arrows ──
    var mThumbsScroll = document.getElementById('cfp-mt-thumbs-' + sid);
    var mArrowL = document.getElementById('cfp-marrow-left-' + sid);
    var mArrowR = document.getElementById('cfp-marrow-right-' + sid);
    if (mThumbsScroll && mArrowL && mArrowR) {
      var mScrollAmt = 130;
      mArrowL.addEventListener('click', function() {
        mThumbsScroll.scrollBy({ left: -mScrollAmt, behavior: 'smooth' });
      });
      mArrowR.addEventListener('click', function() {
        mThumbsScroll.scrollBy({ left: mScrollAmt, behavior: 'smooth' });
      });
    }
  })();
  
  </script>

</product-info>

