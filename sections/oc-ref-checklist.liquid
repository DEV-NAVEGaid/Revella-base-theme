{% render 'oc-assets' %}
{%- assign s = section.settings -%}
<div class="lm">
  <section class="rc-sec" style="--rc-bg: {{ s.background }}; --rc-accent: {{ s.accent }}">
    <div class="rc-in">
      <div class="rc-hd">
        {%- if s.heading != blank %}<h2 class="rc-h2">{{ s.heading }}</h2>{% endif -%}
        {%- if s.subline != blank %}<p class="rc-sub">{{ s.subline }}</p>{% endif -%}
      </div>
      <table class="rc-tb">
        <thead>
          <tr>
            <th scope="col" class="rc-fh"><span class="rc-vh">{{ s.feature_label }}</span></th>
            <th scope="col" class="rc-ch">{{ s.column_title }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row" class="rc-f">{{ block.settings.feature }}</th>
              <td class="rc-c"><span class="rc-ic">{% render 'oc-icon', icon: 'yes' %}</span><span class="rc-vh">{{ s.yes_label }}</span></td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </section>
</div>

<style>
  .lm.lm .rc-sec{background:var(--rc-bg);padding:40px 16px}
  .lm.lm .rc-in{display:flex;flex-direction:column;gap:28px;max-width:1100px;margin:0 auto}
  .lm.lm .rc-h2{font-family:var(--font-heading-family);font-weight:var(--font-heading-weight);font-size:32px;line-height:38px;letter-spacing:-0.02em;text-align:left;color:#181B1D}
  .lm.lm .rc-h2 em{color:var(--rc-accent)}
  .lm.lm .rc-sub{margin-top:12px;font-size:16px;line-height:24px;color:#616161}
  .lm.lm .rc-tb{width:100%;border-collapse:separate;border-spacing:0;table-layout:fixed}
  .lm.lm .rc-vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .lm.lm .rc-fh{padding:0}
  .lm.lm .rc-ch{width:96px;padding:18px 8px;background:var(--rc-accent);color:#fff;font-family:inherit;font-size:16px;line-height:24px;font-weight:700;text-align:center;border-radius:8px 8px 0 0;box-shadow:0 -4px 15px rgba(0,0,0,.05)}
  .lm.lm .rc-f{padding:14px 10px 14px 0;font-size:14px;line-height:20px;font-weight:500;text-align:left;color:#181B1D}
  .lm.lm .rc-c{padding:14px 8px;background:var(--rc-accent);text-align:center;vertical-align:middle;border-bottom:1px solid rgba(255,255,255,.2)}
  .lm.lm .rc-tb tbody tr:last-child .rc-c{border-bottom:0;border-radius:0 0 8px 8px;padding-bottom:20px;box-shadow:0 4px 15px rgba(0,0,0,.05)}
  .lm.lm .rc-ic{display:inline-flex;width:26px;height:26px;color:#fff;vertical-align:middle}
  .lm.lm .rc-ic svg{width:26px;height:26px}
  .lm.lm .rc-ic .ci path{stroke:var(--rc-accent)}
  @media (min-width:990px){
    .lm.lm .rc-sec{padding:60px 20px}
    .lm.lm .rc-in{flex-direction:row;align-items:center;gap:40px}
    .lm.lm .rc-hd{flex:1 1 0;min-width:0}
    .lm.lm .rc-h2{font-size:42px;line-height:50px}
    .lm.lm .rc-tb{flex:1 1 0;width:auto;min-width:0}
    .lm.lm .rc-ch{width:141px;padding:25px 10px;font-size:22px;line-height:33px}
    .lm.lm .rc-f{font-size:15px;line-height:20px;padding:16px 10px}
    .lm.lm .rc-c{padding:16px 10px}
    .lm.lm .rc-tb tbody tr:last-child .rc-c{padding-bottom:25px}
  }
</style>

{% schema %}
{
  "name": "OC: Checklist",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "What you <em>get</em>", "info": "Italic text is shown in the accent color." },
    { "type": "text", "id": "subline", "label": "Subline", "default": "Everything included with your order.", "info": "Empty = no subline." },
    { "type": "header", "content": "Table" },
    { "type": "text", "id": "column_title", "label": "Column title", "default": "Our product", "info": "Shown at the top of the colored column." },
    { "type": "text", "id": "feature_label", "label": "Feature column label", "default": "Feature", "info": "Read by screen readers only." },
    { "type": "text", "id": "yes_label", "label": "Check label", "default": "Yes", "info": "Read by screen readers after each feature." },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "accent", "label": "Accent color", "default": "#289383" },
    { "type": "color", "id": "background", "label": "Background color", "default": "#F8FAFC" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "A feature of the product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OC: Checklist",
      "blocks": [
        { "type": "row", "settings": { "feature": "First feature of the product" } },
        { "type": "row", "settings": { "feature": "Second feature of the product" } },
        { "type": "row", "settings": { "feature": "Third feature of the product" } },
        { "type": "row", "settings": { "feature": "Fourth feature of the product" } },
        { "type": "row", "settings": { "feature": "Fifth feature of the product" } }
      ]
    }
  ]
}
{% endschema %}
