{%- comment -%} Bio announcement bar — simple single-message bar (Dawn-style) {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --bio-ab-bg: {{ section.settings.background_color }};
    --bio-ab-text: {{ section.settings.text_color }};
  }
  .bio-ab {
    background: var(--bio-ab-bg);
    color: var(--bio-ab-text);
    text-align: center;
    padding: {{ section.settings.padding_vertical_mobile }}px 16px;
  }
  .bio-ab__message {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }
  .bio-ab__link {
    color: inherit;
    text-decoration: none;
  }
  .bio-ab__link:hover {
    text-decoration: underline;
  }
  @media screen and (min-width: 750px) {
    .bio-ab {
      padding-top: {{ section.settings.padding_vertical_desktop }}px;
      padding-bottom: {{ section.settings.padding_vertical_desktop }}px;
    }
    .bio-ab__message {
      font-size: 1.5rem;
    }
  }
</style>

{%- if section.settings.text != blank -%}
  <div class="bio-ab" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
    <p class="bio-ab__message">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="bio-ab__link">{{ section.settings.text }}</a>
      {%- else -%}
        {{ section.settings.text }}
      {%- endif -%}
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bio: Announcement Bar",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "text", "label": "Message", "default": "Summer Sale — Up To 75% Off" },
    { "type": "url", "id": "link", "label": "Link (optional)" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#0F5132" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_vertical_desktop", "min": 4, "max": 40, "step": 1, "unit": "px", "label": "Vertical padding (desktop)", "default": 12 },
    { "type": "range", "id": "padding_vertical_mobile", "min": 4, "max": 32, "step": 1, "unit": "px", "label": "Vertical padding (mobile)", "default": 10 }
  ],
  "presets": [
    { "name": "Bio: Announcement Bar" }
  ]
}
{% endschema %}
