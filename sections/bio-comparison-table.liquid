{%- comment -%} Comparison table — highlighted brand column (Dawn 16) {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }}{
    background:{{ section.settings.section_bg }};
    margin-top:0 !important;
    --bio-ct-fs:{{ section.settings.font_scale }};
  }
  .bio-ct{ padding:{{ section.settings.padding_top | times: 0.7 | round }}px 0 {{ section.settings.padding_bottom | times: 0.7 | round }}px; overflow-x:clip; }
  .bio-ct *,.bio-ct *::before,.bio-ct *::after{ box-sizing:border-box; min-width:0; }

  .bio-ct__title{ margin:0 0 {{ section.settings.head_gap }}px; text-align:{{ section.settings.text_align }};
    font-size:calc({{ section.settings.heading_size }}rem * var(--bio-ct-fs)); line-height:1.15; font-weight:800; letter-spacing:-.02em; }

  .bio-ct__row{ display:flex; align-items:stretch; }
  .bio-ct__row+.bio-ct__row .bio-ct__label,
  .bio-ct__row+.bio-ct__row .bio-ct__other{ border-top:1px solid {{ section.settings.divider_color }}; }

  .bio-ct__label{ flex:1 1 auto; min-width:0; display:flex; align-items:center; padding:{{ section.settings.row_padding }}px 12px {{ section.settings.row_padding }}px 0;
    font-size:calc({{ section.settings.label_size }}rem * var(--bio-ct-fs)); font-weight:800; line-height:1.25; }
  .bio-ct__brand,.bio-ct__other{ flex:0 0 {{ section.settings.col_width }}px; width:{{ section.settings.col_width }}px;
    display:flex; align-items:center; justify-content:center; text-align:center;
    padding:{{ section.settings.row_padding }}px 4px; font-size:calc({{ section.settings.value_size }}rem * var(--bio-ct-fs)); font-weight:800; line-height:1.2; }
  .bio-ct__brand{ background:{{ section.settings.brand_col_bg }}; color:{{ section.settings.brand_color }};
    border-left:{{ section.settings.col_border }}px solid {{ section.settings.brand_color }};
    border-right:{{ section.settings.col_border }}px solid {{ section.settings.brand_color }}; }
  .bio-ct__other{ color:{{ section.settings.other_color }}; }
  .bio-ct__row+.bio-ct__row .bio-ct__brand{ border-top:1px solid {{ section.settings.brand_divider }}; }

  /* header row: top of the floating pill */
  .bio-ct__row--head .bio-ct__label{ padding:0; border:0; }
  .bio-ct__row--head .bio-ct__brand{ background:{{ section.settings.brand_color }}; color:{{ section.settings.brand_head_text }};
    border-top:{{ section.settings.col_border }}px solid {{ section.settings.brand_color }};
    border-radius:{{ section.settings.col_radius }}px {{ section.settings.col_radius }}px 0 0;
    font-size:calc({{ section.settings.head_size }}rem * var(--bio-ct-fs)); padding:{{ section.settings.head_padding }}px 6px;
    box-shadow:0 -6px 16px rgba(0,0,0,.06); }
  .bio-ct__row--head .bio-ct__other{ border:0; font-size:calc({{ section.settings.head_size }}rem * var(--bio-ct-fs));
    letter-spacing:.06em; color:{{ section.settings.other_head_color }}; padding:{{ section.settings.head_padding }}px 6px; }

  /* last row: bottom of the floating pill */
  .bio-ct__row--last .bio-ct__brand{ border-bottom:{{ section.settings.col_border }}px solid {{ section.settings.brand_color }};
    border-radius:0 0 {{ section.settings.col_radius }}px {{ section.settings.col_radius }}px;
    box-shadow:0 6px 16px rgba(0,0,0,.06); }

  @media screen and (min-width:750px){
    .bio-ct{ padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
    .bio-ct__brand,.bio-ct__other{ flex-basis:{{ section.settings.col_width_desktop }}px; width:{{ section.settings.col_width_desktop }}px; }
    .bio-ct__table{ max-width:{{ section.settings.max_width }}px; margin:0 auto; }
  }
</style>

<div class="bio-ct" id="bio-ct-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<h2 class="bio-ct__title">{{ section.settings.heading }}</h2>{%- endif -%}

    <div class="bio-ct__table">
      <div class="bio-ct__row bio-ct__row--head">
        <div class="bio-ct__label">&nbsp;</div>
        <div class="bio-ct__brand">{{ section.settings.brand_label }}</div>
        <div class="bio-ct__other">{{ section.settings.other_label }}</div>
      </div>

      {%- for block in section.blocks -%}
        <div class="bio-ct__row{% if forloop.last %} bio-ct__row--last{% endif %}" {{ block.shopify_attributes }}>
          <div class="bio-ct__label">{{ block.settings.label }}</div>
          <div class="bio-ct__brand">{{ block.settings.brand_value }}</div>
          <div class="bio-ct__other">{{ block.settings.other_value }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bio: Comparison Table",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#F4F2EF" },
    { "type": "range", "id": "font_scale", "min": 0.6, "max": 1.2, "step": 0.1, "label": "Font scale", "default": 1 },

    { "type": "header", "content": "Header" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Choose BioRoot?" },
    { "type": "select", "id": "text_align", "label": "Heading alignment", "default": "center",
      "options": [ {"value":"left","label":"Left"},{"value":"center","label":"Center"} ] },
    { "type": "range", "id": "heading_size", "min": 2.0, "max": 5.0, "step": 0.1, "unit": "rem", "label": "Heading size", "default": 3.2 },
    { "type": "range", "id": "head_gap", "min": 8, "max": 80, "step": 4, "unit": "px", "label": "Space below heading", "default": 36 },

    { "type": "header", "content": "Columns" },
    { "type": "text", "id": "brand_label", "label": "Brand column label", "default": "BioRoot" },
    { "type": "text", "id": "other_label", "label": "Other column label", "default": "OTHERS" },
    { "type": "color", "id": "brand_color", "label": "Brand color", "default": "#1F4D3A" },
    { "type": "color", "id": "brand_col_bg", "label": "Brand column background", "default": "#FFFFFF" },
    { "type": "color", "id": "brand_head_text", "label": "Brand header text", "default": "#FFFFFF" },
    { "type": "color", "id": "brand_divider", "label": "Brand column divider", "default": "#EDEDEA" },
    { "type": "color", "id": "other_color", "label": "Other value color", "default": "#2A2A2A" },
    { "type": "color", "id": "other_head_color", "label": "Other header color", "default": "#2A2A2A" },
    { "type": "range", "id": "col_width", "min": 60, "max": 160, "step": 5, "unit": "px", "label": "Column width (mobile)", "default": 90 },
    { "type": "range", "id": "col_width_desktop", "min": 90, "max": 220, "step": 5, "unit": "px", "label": "Column width (desktop)", "default": 120 },
    { "type": "range", "id": "col_radius", "min": 0, "max": 30, "step": 1, "unit": "px", "label": "Brand column radius", "default": 14 },
    { "type": "range", "id": "col_border", "min": 0, "max": 6, "step": 1, "unit": "px", "label": "Brand column border", "default": 2 },

    { "type": "header", "content": "Rows" },
    { "type": "range", "id": "max_width", "min": 500, "max": 1200, "step": 20, "unit": "px", "label": "Table max width (desktop)", "default": 820 },
    { "type": "range", "id": "row_padding", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Row padding", "default": 18 },
    { "type": "range", "id": "head_padding", "min": 6, "max": 30, "step": 2, "unit": "px", "label": "Header row padding", "default": 12 },
    { "type": "range", "id": "label_size", "min": 1.2, "max": 2.6, "step": 0.1, "unit": "rem", "label": "Label size", "default": 1.7 },
    { "type": "range", "id": "value_size", "min": 1.2, "max": 2.6, "step": 0.1, "unit": "rem", "label": "Value size", "default": 1.7 },
    { "type": "range", "id": "head_size", "min": 1.1, "max": 2.2, "step": 0.1, "unit": "rem", "label": "Column header size", "default": 1.4 },
    { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#DDDAD4" },

    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    { "type": "row", "name": "Row", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Curcumin Strength" },
      { "type": "text", "id": "brand_value", "label": "Brand value", "default": "Yes" },
      { "type": "text", "id": "other_value", "label": "Other value", "default": "No" } ] }
  ],
  "presets": [
    { "name": "Bio: Comparison Table",
      "blocks": [
        { "type": "row", "settings": { "label": "Curcumin Strength", "brand_value": "95%", "other_value": "2%" } },
        { "type": "row", "settings": { "label": "Absorption Boost", "brand_value": "Yes", "other_value": "No" } },
        { "type": "row", "settings": { "label": "3rd Part Lab Tested", "brand_value": "Yes", "other_value": "No" } },
        { "type": "row", "settings": { "label": "Clinically Dosed Extract", "brand_value": "Yes", "other_value": "No" } },
        { "type": "row", "settings": { "label": "Filler Free Formula", "brand_value": "Yes", "other_value": "No" } }
      ]
    }
  ]
}
{% endschema %}