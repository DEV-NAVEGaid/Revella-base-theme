{% comment %}
  Reviews Grid Section — nvgd-reviews-grid.liquid
  Each block holds up to 5 reviews. Add "Review group" blocks to add more.
{% endcomment %}

{%- liquid
  assign safe_sid = section.id | replace: '-', '_'
-%}

<section class="custom-reviews-robust" id="ReviewsGrid-{{ section.id }}">
  <div class="reviews-header">
    <div class="summary-box">
      <h2 class="rating-number">{{ section.settings.average_rating }}</h2>
      <div class="stars-display">★★★★★</div>
      <p class="total-text">Based on {{ section.settings.total_reviews }} Reviews</p>
    </div>
    <div class="distribution-bars">
      <div class="dist-row"><span>5 ★</span><div class="bar"><div class="fill" style="width: {{ section.settings.pct_5 }}%;"></div></div><span>{{ section.settings.count_5 }}</span></div>
      <div class="dist-row"><span>4 ★</span><div class="bar"><div class="fill" style="width: {{ section.settings.pct_4 }}%;"></div></div><span>{{ section.settings.count_4 }}</span></div>
      <div class="dist-row"><span>3 ★</span><div class="bar"><div class="fill" style="width: {{ section.settings.pct_3 }}%;"></div></div><span>{{ section.settings.count_3 }}</span></div>
      <div class="dist-row"><span>2 ★</span><div class="bar"><div class="fill" style="width: {{ section.settings.pct_2 }}%;"></div></div><span>{{ section.settings.count_2 }}</span></div>
      <div class="dist-row"><span>1 ★</span><div class="bar"><div class="fill" style="width: {{ section.settings.pct_1 }}%;"></div></div><span>{{ section.settings.count_1 }}</span></div>
    </div>
    <div class="action-box">
      <button class="write-review-btn" onclick="openReviewModal_{{ safe_sid }}()">Write a Review</button>
    </div>
  </div>


  <div class="review-filters">
    <select id="reviewSort-{{ section.id }}" onchange="currentPage_{{ safe_sid }}=1; renderReviews_{{ safe_sid }}();">
      <option value="default">Default order</option>
      <option value="highest">Highest Rating</option>
      <option value="lowest">Lowest Rating</option>
    </select>
    {% comment %}
    <select id="reviewFilter-{{ section.id }}" onchange="currentPage_{{ safe_sid }}=1; renderReviews_{{ safe_sid }}();">
      <option value="0">All stars</option>
      <option value="5">★★★★★ 5 stars</option>
      <option value="4">★★★★☆ 4 stars</option>
      <option value="3">★★★☆☆ 3 stars</option>
      <option value="2">★★☆☆☆ 2 stars</option>
      <option value="1">★☆☆☆☆ 1 star</option>
    </select>
    {% endcomment %}

    <p class="review-disclosure">📷 Photos may be cropped based on device</p>
  </div>


  <div id="reviews-grid-{{ section.id }}" class="reviews-grid"></div>

  <div class="pagination-container">
    <button onclick="changePage_{{ safe_sid }}(-1)" id="prevBtn-{{ section.id }}">Previous</button>
    <span id="pageInfo-{{ section.id }}">Page 1</span>
    <button onclick="changePage_{{ safe_sid }}(1)" id="nextBtn-{{ section.id }}">Next</button>
  </div>
</section>

<div id="reviewModal-{{ section.id }}" class="nvgd-review-modal">
  <div class="modal-content">
    <span class="close" onclick="closeReviewModal_{{ safe_sid }}()">&times;</span>
    <h2>Write a Review</h2>
    <p style="color:#555;font-size:13px;margin-bottom:20px;">Share your experience with Revella Astaxanthin</p>
    <form id="reviewForm-{{ section.id }}" onsubmit="submitReview_{{ safe_sid }}(event)">
      <div class="form-group">
        <label>Your Name *</label>
        <input type="text" id="reviewerName-{{ section.id }}" required placeholder="Enter your name">
      </div>
      <div class="form-group">
        <label>Your Rating *</label>
        <div class="star-rating-input" id="starInput-{{ section.id }}">
          <span class="star-input" data-rating="1">☆</span>
          <span class="star-input" data-rating="2">☆</span>
          <span class="star-input" data-rating="3">☆</span>
          <span class="star-input" data-rating="4">☆</span>
          <span class="star-input" data-rating="5">☆</span>
        </div>
        <input type="hidden" id="selectedRating-{{ section.id }}" required>
      </div>
      <div class="form-group">
        <label>Your Review *</label>
        <textarea id="reviewText-{{ section.id }}" required placeholder="Tell us about your experience..." rows="5"></textarea>
      </div>
      <button type="submit" class="submit-review-btn">Submit Review</button>
    </form>
  </div>
</div>

<style>
  #ReviewsGrid-{{ section.id }} { max-width: 1100px; margin: 30px auto; font-family: var(--font-body-family); padding: 0 15px; }
  #ReviewsGrid-{{ section.id }} .reviews-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e5e5e5; padding-bottom: 24px; gap: 30px; }
  #ReviewsGrid-{{ section.id }} .rating-number { font-size: 42px; margin: 0; font-weight: 800; line-height: 1; color: #1a1a1a; }
  #ReviewsGrid-{{ section.id }} .stars-display { color: #f5a623; font-size: 18px; margin: 6px 0; }
  #ReviewsGrid-{{ section.id }} .total-text { font-size: 12px; color: #888; margin: 0; }
  #ReviewsGrid-{{ section.id }} .distribution-bars { flex-grow: 1; max-width: 350px; }
  #ReviewsGrid-{{ section.id }} .dist-row { display: flex; align-items: center; gap: 8px; font-size: 12px; margin-bottom: 5px; color: #555; }
  #ReviewsGrid-{{ section.id }} .dist-row span:first-child { min-width: 32px; font-weight: 600; color: #1a1a1a; }
  #ReviewsGrid-{{ section.id }} .dist-row span:last-child { min-width: 45px; text-align: right; font-size: 11px; color: #888; }
  #ReviewsGrid-{{ section.id }} .dist-row .bar { background: #f0f0f0; height: 6px; flex-grow: 1; border-radius: 10px; overflow: hidden; position: relative; min-width: 150px; }
  #ReviewsGrid-{{ section.id }} .dist-row .bar .fill { background: #1a1a1a; height: 6px; border-radius: 10px; display: block; position: absolute; top: 0; left: 0; }
  #ReviewsGrid-{{ section.id }} .write-review-btn { background: {{ section.settings.button_color }}; color: #fff; padding: 11px 20px; border: none; cursor: pointer; font-weight: 600; border-radius: 6px; font-size: 13px; font-family: var(--font-body-family); }
  #ReviewsGrid-{{ section.id }} .review-filters { margin: 20px 0; }
  #ReviewsGrid-{{ section.id }} .review-disclosure { font-size: 11px; color: #aaa; margin: 6px 0 0; font-style: italic; display: block; }
  #ReviewsGrid-{{ section.id }} #reviewSort-{{ section.id }},
  #ReviewsGrid-{{ section.id }} #reviewFilter-{{ section.id }} { padding: 8px 14px; border: 1px solid #e5e5e5; border-radius: 6px; font-size: 13px; cursor: pointer; background: white; font-family: var(--font-body-family); color: #1a1a1a; }
  #ReviewsGrid-{{ section.id }} .reviews-grid { display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr); gap: 14px; margin-top: 20px; }
  #ReviewsGrid-{{ section.id }} .review-card { border: 1px solid #e5e5e5; padding: 18px; border-radius: 10px; background: white; }
  #ReviewsGrid-{{ section.id }} .review-stars { color: #f5a623; font-size: 13px; margin-bottom: 8px; }
  #ReviewsGrid-{{ section.id }} .reviewer-name { font-weight: 700; font-size: 13px; margin: 0 0 8px; color: #1a1a1a; }
  #ReviewsGrid-{{ section.id }} .verified-badge { color: #2ecc71; font-size: 11px; font-weight: 600; margin-left: 6px; }
  #ReviewsGrid-{{ section.id }} .review-text { font-size: 13px; line-height: 1.6; color: #555; margin: 0; }
  #ReviewsGrid-{{ section.id }} .read-more-btn { background: none; border: none; color: {{ section.settings.button_color }}; font-size: 12px; font-weight: 600; cursor: pointer; padding: 4px 0 0; font-family: var(--font-body-family); display: block; margin-top: 4px; }
  #ReviewsGrid-{{ section.id }} .image-container { margin-top: 14px; border-radius: 8px; overflow: hidden; height: 220px; }
  #ReviewsGrid-{{ section.id }} .review-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #ReviewsGrid-{{ section.id }} .pagination-container { display: flex; justify-content: center; align-items: center; gap: 20px; margin-top: 30px; }
  #ReviewsGrid-{{ section.id }} .pagination-container button { padding: 9px 20px; border: 1px solid #e5e5e5; background: white; cursor: pointer; border-radius: 6px; font-weight: 500; font-size: 13px; color: #1a1a1a; font-family: var(--font-body-family); }
  #ReviewsGrid-{{ section.id }} .pagination-container button:disabled { opacity: 0.3; cursor: not-allowed; }
  #ReviewsGrid-{{ section.id }} #pageInfo-{{ section.id }} { font-size: 13px; color: #888; }
  .nvgd-review-modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.4); overflow: auto; }
  .nvgd-review-modal .modal-content { background: white; margin: 5% auto; padding: 30px; border-radius: 10px; width: 90%; max-width: 600px; position: relative; }
  .nvgd-review-modal .close { color: #aaa; float: right; font-size: 28px; font-weight: bold; cursor: pointer; line-height: 20px; }
  .nvgd-review-modal h2 { margin: 0 0 8px; font-size: 20px; font-weight: 800; color: #1a1a1a; }
  .nvgd-review-modal .form-group { margin-bottom: 18px; }
  .nvgd-review-modal .form-group label { display: block; margin-bottom: 6px; font-weight: 600; color: #1a1a1a; font-size: 13px; }
  .nvgd-review-modal .form-group input[type="text"],
  .nvgd-review-modal .form-group textarea { width: 100%; padding: 10px; border: 1px solid #e5e5e5; border-radius: 6px; font-size: 13px; font-family: var(--font-body-family); box-sizing: border-box; }
  .nvgd-review-modal .star-rating-input { font-size: 28px; color: #ddd; cursor: pointer; }
  .nvgd-review-modal .star-input.selected { color: #FFCC00; }
  .nvgd-review-modal .submit-review-btn { background: {{ section.settings.button_color }}; color: white; padding: 13px 28px; border: none; border-radius: 6px; font-size: 14px; font-weight: 700; cursor: pointer; width: 100%; font-family: var(--font-body-family); }
  @media (max-width: 768px) {
    #ReviewsGrid-{{ section.id }} .reviews-grid { grid-template-columns: 1fr; }
    #ReviewsGrid-{{ section.id }} .reviews-header { flex-direction: column; text-align: center; }
    #ReviewsGrid-{{ section.id }} .dist-row .bar { min-width: 100px; }
  }
</style>

<script>
(function() {
  var sid = '{{ section.id }}';
  var safeSid = '{{ safe_sid }}';
  var TRUNCATE_AT = 220;
  var reviewsPerPage = {{ section.settings.reviews_per_page }};

  window['currentPage_' + safeSid] = 1;

  // Build reviewData from blocks (each block holds up to 5 reviews)
  var reviewData = [];
  {%- for block in section.blocks -%}
    {%- if block.type == 'review_group' -%}

      {%- comment -%} Slot 1 {%- endcomment -%}
      {%- if block.settings.name_1 != blank and block.settings.text_1 != blank -%}
        {%- if block.settings.image_1 != blank -%}{%- assign img1 = block.settings.image_1 | image_url: width: 800 -%}
        {%- elsif block.settings.image_url_1 != blank -%}{%- assign img1 = block.settings.image_url_1 -%}
        {%- else -%}{%- assign img1 = '' -%}{%- endif -%}
        reviewData.push({ name: {{ block.settings.name_1 | json }}, rating: {{ block.settings.rating_1 }}, text: {{ block.settings.text_1 | json }}, img: {{ img1 | json }} });
      {%- endif -%}

      {%- comment -%} Slot 2 {%- endcomment -%}
      {%- if block.settings.name_2 != blank and block.settings.text_2 != blank -%}
        {%- if block.settings.image_2 != blank -%}{%- assign img2 = block.settings.image_2 | image_url: width: 800 -%}
        {%- elsif block.settings.image_url_2 != blank -%}{%- assign img2 = block.settings.image_url_2 -%}
        {%- else -%}{%- assign img2 = '' -%}{%- endif -%}
        reviewData.push({ name: {{ block.settings.name_2 | json }}, rating: {{ block.settings.rating_2 }}, text: {{ block.settings.text_2 | json }}, img: {{ img2 | json }} });
      {%- endif -%}

      {%- comment -%} Slot 3 {%- endcomment -%}
      {%- if block.settings.name_3 != blank and block.settings.text_3 != blank -%}
        {%- if block.settings.image_3 != blank -%}{%- assign img3 = block.settings.image_3 | image_url: width: 800 -%}
        {%- elsif block.settings.image_url_3 != blank -%}{%- assign img3 = block.settings.image_url_3 -%}
        {%- else -%}{%- assign img3 = '' -%}{%- endif -%}
        reviewData.push({ name: {{ block.settings.name_3 | json }}, rating: {{ block.settings.rating_3 }}, text: {{ block.settings.text_3 | json }}, img: {{ img3 | json }} });
      {%- endif -%}

      {%- comment -%} Slot 4 {%- endcomment -%}
      {%- if block.settings.name_4 != blank and block.settings.text_4 != blank -%}
        {%- if block.settings.image_4 != blank -%}{%- assign img4 = block.settings.image_4 | image_url: width: 800 -%}
        {%- elsif block.settings.image_url_4 != blank -%}{%- assign img4 = block.settings.image_url_4 -%}
        {%- else -%}{%- assign img4 = '' -%}{%- endif -%}
        reviewData.push({ name: {{ block.settings.name_4 | json }}, rating: {{ block.settings.rating_4 }}, text: {{ block.settings.text_4 | json }}, img: {{ img4 | json }} });
      {%- endif -%}

      {%- comment -%} Slot 5 {%- endcomment -%}
      {%- if block.settings.name_5 != blank and block.settings.text_5 != blank -%}
        {%- if block.settings.image_5 != blank -%}{%- assign img5 = block.settings.image_5 | image_url: width: 800 -%}
        {%- elsif block.settings.image_url_5 != blank -%}{%- assign img5 = block.settings.image_url_5 -%}
        {%- else -%}{%- assign img5 = '' -%}{%- endif -%}
        reviewData.push({ name: {{ block.settings.name_5 | json }}, rating: {{ block.settings.rating_5 }}, text: {{ block.settings.text_5 | json }}, img: {{ img5 | json }} });
      {%- endif -%}

    {%- endif -%}
  {%- endfor -%}

  function renderReviews() {
    var currentPage = window['currentPage_' + safeSid];
    var container = document.getElementById('reviews-grid-' + sid);
    var filteredData = reviewData.slice();
    var sortEl = document.getElementById('reviewSort-' + sid);
    var sortVal = sortEl ? sortEl.value : 'default';    var filterEl = document.getElementById('reviewFilter-' + sid);
    var filterVal = filterEl ? parseInt(filterEl.value, 10) : 0;
    if (filterVal > 0) filteredData = filteredData.filter(function(r){ return r.rating === filterVal; });
    if (sortVal === 'highest') filteredData.sort(function(a,b){ return b.rating - a.rating; });
    if (sortVal === 'lowest')  filteredData.sort(function(a,b){ return a.rating - b.rating; });
    var start = (currentPage - 1) * reviewsPerPage;
    var end = start + reviewsPerPage;
    var paginatedItems = filteredData.slice(start, end);

    container.innerHTML = paginatedItems.map(function(rev, i) {
      var needsTruncation = rev.text.length > TRUNCATE_AT;
      var shortText = needsTruncation ? rev.text.slice(0, TRUNCATE_AT).trim() + '\u2026' : rev.text;
      var id = 'rev-' + sid + '-' + (start + i);
      var stars = '\u2605'.repeat(rev.rating) + '\u2606'.repeat(5 - rev.rating);
      var escapedText = rev.text.replace(/\\/g, '\\\\').replace(/'/g, "\\'");
      return '<div class="review-card">' +
        '<div class="review-stars">' + stars + '</div>' +
        '<p class="reviewer-name">' + rev.name + '<span class="verified-badge">\u2713 Verified</span></p>' +
        '<p class="review-text" id="' + id + '">"' + shortText + '"</p>' +
        (needsTruncation ? '<button class="read-more-btn" onclick="toggleReview_' + safeSid + '(\'' + id + '\', \'' + escapedText + '\')">Read more</button>' : '') +
        (rev.img ? '<div class="image-container"><img src="' + rev.img + '" class="review-img" loading="lazy" decoding="async" alt="' + rev.name + '"></div>' : '') +
        '</div>';
    }).join('');

    document.getElementById('pageInfo-' + sid).innerText = 'Page ' + currentPage;
    document.getElementById('prevBtn-' + sid).disabled = currentPage === 1;
    document.getElementById('nextBtn-' + sid).disabled = end >= filteredData.length;
  }

  window['renderReviews_' + safeSid] = renderReviews;

  window['toggleReview_' + safeSid] = function(id, fullText) {
    var el = document.getElementById(id);
    var btn = el.nextElementSibling;
    if (btn.innerText === 'Read more') {
      el.innerText = '"' + fullText + '"';
      btn.innerText = 'Read less';
    } else {
      el.innerText = '"' + fullText.slice(0, TRUNCATE_AT).trim() + '\u2026"';
      btn.innerText = 'Read more';
    }
  };

  window['changePage_' + safeSid] = function(step) {
    window['currentPage_' + safeSid] += step;
    renderReviews();
    window.scrollTo({ top: document.getElementById('ReviewsGrid-' + sid).offsetTop - 100, behavior: 'smooth' });
  };

  window['openReviewModal_' + safeSid] = function() {
    document.getElementById('reviewModal-' + sid).style.display = 'block';
    document.body.style.overflow = 'hidden';
  };

  window['closeReviewModal_' + safeSid] = function() {
    document.getElementById('reviewModal-' + sid).style.display = 'none';
    document.body.style.overflow = 'auto';
    document.getElementById('reviewForm-' + sid).reset();
    document.querySelectorAll('#starInput-' + sid + ' .star-input').forEach(function(s) {
      s.classList.remove('selected'); s.textContent = '\u2606';
    });
  };

  window['submitReview_' + safeSid] = function(event) {
    event.preventDefault();
    var name = document.getElementById('reviewerName-' + sid).value;
    var rating = document.getElementById('selectedRating-' + sid).value;
    window['closeReviewModal_' + safeSid]();
    alert('Thank you ' + name + '! Your ' + rating + '-star review has been submitted and will appear after approval.');
  };

  window.addEventListener('click', function(event) {
    var modal = document.getElementById('reviewModal-' + sid);
    if (event.target === modal) window['closeReviewModal_' + safeSid]();
  });

  document.addEventListener('DOMContentLoaded', function() {
    var stars = document.querySelectorAll('#starInput-' + sid + ' .star-input');
    stars.forEach(function(star) {
      star.addEventListener('click', function() {
        var rating = this.getAttribute('data-rating');
        document.getElementById('selectedRating-' + sid).value = rating;
        stars.forEach(function(s) {
          var active = s.getAttribute('data-rating') <= rating;
          s.classList.toggle('selected', active);
          s.textContent = active ? '\u2605' : '\u2606';
        });
      });
      star.addEventListener('mouseenter', function() {
        var rating = this.getAttribute('data-rating');
        stars.forEach(function(s) { s.textContent = s.getAttribute('data-rating') <= rating ? '\u2605' : '\u2606'; });
      });
    });
    var starWrap = document.getElementById('starInput-' + sid);
    if (starWrap) {
      starWrap.addEventListener('mouseleave', function() {
        var r = document.getElementById('selectedRating-' + sid).value;
        stars.forEach(function(s) { s.textContent = s.getAttribute('data-rating') <= r ? '\u2605' : '\u2606'; });
      });
    }
    renderReviews();
  });
})();
</script>

{% schema %}
