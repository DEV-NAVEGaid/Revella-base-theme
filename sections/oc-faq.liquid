{% render 'oc-assets' %}
{%- assign s = section.settings -%}
{%- assign btn_variant = s.button_style | replace: 'light', '' -%}
<div class="lm">
  <section class="faq"{% if s.background != blank %} style="background: {{ s.background }}"{% endif %}>
    <div class="faq-i">
      <div class="faq-l">
        {%- if s.heading != blank %}<h2>{{ s.heading }}</h2>{% endif -%}
        <div class="fl">
          {%- for block in section.blocks -%}
            <details class="qi" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
              <summary>
                <span>{{ block.settings.question }}</span>
                {%- if s.icon_closed != blank -%}
                  <span class="ic ic-up">
                    {{- s.icon_closed | image_url: width: 96 | image_tag: loading: 'lazy', class: 'ic-c', alt: '' -}}
                    {%- if s.icon_open != blank %}{{ s.icon_open | image_url: width: 96 | image_tag: loading: 'lazy', class: 'ic-o', alt: '' }}{% endif -%}
                  </span>
                {%- else -%}
                  <span class="ic">{% render 'oc-icon', icon: 'faq' %}</span>
                {%- endif -%}
              </summary>
              <div class="an">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
      {%- if s.image != blank -%}
        <div class="faq-img">{{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '375, 750, 1100, 1400', sizes: '(min-width: 990px) calc(100vw - 720px), 100vw', alt: s.image.alt }}</div>
      {%- elsif s.image_placeholder != blank -%}
        <div class="faq-img ph">{{ s.image_placeholder }}</div>
      {%- endif -%}
      {% render 'oc-cta', label: s.button_label, link: s.button_link, variant: btn_variant, guarantee: s.guarantee, show_guarantee: s.show_guarantee, guarantee_icon: s.guarantee_icon, arrow_icon: s.arrow_icon, style: 'padding: 0' %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "OC: FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQs" },
    { "type": "image_picker", "id": "image", "label": "Lifestyle image", "info": "Full width on mobile (400 px tall), right column on desktop." },
    { "type": "text", "id": "image_placeholder", "label": "Image placeholder text", "info": "Optional. Empty = no image area when no image is set." },
    { "type": "header", "content": "Question icons" },
    { "type": "image_picker", "id": "icon_closed", "label": "Icon (closed)", "info": "Optional. Used for every question. Square PNG/SVG, shown at 28x28px. Empty = default plus/minus icon." },
    { "type": "image_picker", "id": "icon_open", "label": "Icon (open)", "info": "Optional. Shown when a question is open. Empty = the closed icon is used." },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Empty = scroll to the featured product (#product)." },
    { "type": "image_picker", "id": "arrow_icon", "label": "Button arrow icon", "info": "Optional. Replaces the default arrow inside the button. Square PNG/SVG, shown at 20x20px." },
    { "type": "select", "id": "button_style", "label": "Button style", "default": "light", "options": [ { "value": "light", "label": "Light" }, { "value": "dk", "label": "Dark" }, { "value": "gh", "label": "Outline" } ] },
    { "type": "text", "id": "guarantee", "label": "Guarantee text", "default": "60-day Money-Back Guarantee" },
    { "type": "checkbox", "id": "show_guarantee", "label": "Show guarantee line", "default": true },
    { "type": "image_picker", "id": "guarantee_icon", "label": "Guarantee icon", "info": "Square PNG/SVG, shown 20 px. Empty = shield icon." },
    { "type": "header", "content": "Style" },
    { "type": "color_background", "id": "background", "label": "Background override", "info": "Empty = design gradient (#193B68 → #0D1E39)." }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "OC: FAQ",
      "blocks": [
        { "type": "question", "settings": { "open": true } },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
