<style>
  .faq-accordion-section-{{ section.id }} {
    padding: 4rem 2rem;
  }

  .faq-accordion-section-{{ section.id }} .faq-accordion-section__inner {
    max-width: 640px;
    margin: 0 auto;
  }

  /* ── Heading ── */
  .faq-accordion-section-{{ section.id }} .faq-accordion-section__heading {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-weight: {{ section.settings.heading_weight }};
    font-style: {{ section.settings.heading_style }};
    font-size: {{ section.settings.heading_size_mobile }}px;
    line-height: {{ section.settings.heading_line_height | times: 0.1 | plus: 1.0 }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    text-transform: {{ section.settings.heading_transform }};
    text-align: {{ section.settings.heading_align_mobile }};
    color: {{ section.settings.heading_color }};
    margin: 0 0 2.4rem;
  }

  /* ── Question ── */
  .faq-accordion-section-{{ section.id }} .faq-accordion__question {
    font-family: {{ section.settings.question_font.family }}, {{ section.settings.question_font.fallback_families }};
    font-weight: {{ section.settings.question_weight }};
    font-style: {{ section.settings.question_style }};
    font-size: {{ section.settings.question_size_mobile }}px;
    line-height: {{ section.settings.question_line_height | times: 0.1 | plus: 1.0 }};
    letter-spacing: {{ section.settings.question_letter_spacing }}px;
    text-transform: {{ section.settings.question_transform }};
    color: {{ section.settings.question_color }};
  }

  /* ── Answer ── */
  .faq-accordion-section-{{ section.id }} .faq-accordion__content-inner,
  .faq-accordion-section-{{ section.id }} .faq-accordion__content-inner p {
    font-family: {{ section.settings.answer_font.family }}, {{ section.settings.answer_font.fallback_families }};
    font-weight: {{ section.settings.answer_weight }};
    font-style: {{ section.settings.answer_style }};
    font-size: {{ section.settings.answer_size_mobile }}px;
    line-height: {{ section.settings.answer_line_height | times: 0.1 | plus: 1.0 }};
    letter-spacing: {{ section.settings.answer_letter_spacing }}px;
    text-transform: {{ section.settings.answer_transform }};
    text-align: {{ section.settings.answer_align_mobile }};
    color: {{ section.settings.answer_color }};
  }

  @media (min-width: 750px) {
    .faq-accordion-section-{{ section.id }} .faq-accordion-section__heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
      text-align: {{ section.settings.heading_align_desktop }};
    }

    .faq-accordion-section-{{ section.id }} .faq-accordion__question {
      font-size: {{ section.settings.question_size_desktop }}px;
    }

    .faq-accordion-section-{{ section.id }} .faq-accordion__content-inner,
    .faq-accordion-section-{{ section.id }} .faq-accordion__content-inner p {
      font-size: {{ section.settings.answer_size_desktop }}px;
      text-align: {{ section.settings.answer_align_desktop }};
    }
  }

  .faq-accordion-section-{{ section.id }} .faq-accordion {
    display: flex;
    flex-direction: column;
  }

  .faq-accordion-section-{{ section.id }} .faq-accordion__item {
    border-bottom: 1px solid rgba(31, 27, 46, 0.12);
    padding: 1.6rem 0;
  }

  .faq-accordion-section-{{ section.id }} .faq-accordion__item:first-child {
    border-top: 1px solid rgba(31, 27, 46, 0.12);
  }

  .faq-accordion-section-{{ section.id }} .faq-accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    cursor: pointer;
    list-style: none;
  }

  .faq-accordion-section-{{ section.id }} .faq-accordion__summary::-webkit-details-marker {
    display: none;
  }

  .faq-accordion-section-{{ section.id }} .faq-accordion__icon {
    flex-shrink: 0;
    width: 1.6rem;
    height: 1.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1F1B2E;
  }

  .faq-accordion-section-{{ section.id }} .faq-accordion__icon-plus,
  .faq-accordion-section-{{ section.id }} .faq-accordion__icon-caret {
    width: 1rem;
    height: 1rem;
    transition: transform 0.2s ease;
  }

  .faq-accordion-section-{{ section.id }} .faq-accordion__icon-caret {
    display: none;
  }

  .faq-accordion-section-{{ section.id }} .faq-accordion__item[data-icon="caret"] .faq-accordion__icon-plus {
    display: none;
  }
  .faq-accordion-section-{{ section.id }} .faq-accordion__item[data-icon="caret"] .faq-accordion__icon-caret {
    display: block;
  }

  .faq-accordion-section-{{ section.id }} .faq-accordion__item[open] .faq-accordion__icon-plus {
    transform: rotate(45deg);
  }

  .faq-accordion-section-{{ section.id }} .faq-accordion__content {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.3s ease;
  }

  .faq-accordion-section-{{ section.id }} .faq-accordion__item[open] .faq-accordion__content {
    max-height: 60rem;
  }

  .faq-accordion-section-{{ section.id }} .faq-accordion__content-inner {
    padding-top: 1.2rem;
  }

  .faq-accordion-section-{{ section.id }} .faq-accordion__content-inner p {
    margin: 0 0 1em;
  }

  .faq-accordion-section-{{ section.id }} .faq-accordion__content-inner p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .faq-accordion-section-{{ section.id }} {
      padding: 3rem 1.6rem;
    }
  }
</style>

<div class="faq-accordion-section faq-accordion-section-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="faq-accordion-section__inner">
    <h2 class="faq-accordion-section__heading">{{ section.settings.heading }}</h2>

    <div class="faq-accordion">
      {% for block in section.blocks %}
        {% if block.type == 'question' %}
          <details class="faq-accordion__item" data-icon="{{ block.settings.icon_style }}" {{ block.shopify_attributes }}>
            <summary class="faq-accordion__summary">
              <span class="faq-accordion__question">{{ block.settings.question }}</span>
              <span class="faq-accordion__icon">
                <svg class="faq-accordion__icon-plus" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M1 4.51a.5.5 0 000 1h3.5l.01 3.5a.5.5 0 001-.01V5.5l3.5-.01a.5.5 0 00-.01-1H5.5L5.49.99a.5.5 0 00-1 .01v3.5l-3.5.01H1z" fill="currentColor"/>
                </svg>
                <svg class="faq-accordion__icon-caret" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"/>
                </svg>
              </span>
            </summary>
            <div class="faq-accordion__content">
              <div class="faq-accordion__content-inner">{{ block.settings.answer }}</div>
            </div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

