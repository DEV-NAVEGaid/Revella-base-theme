{% render 'oc-assets' %}
{%- assign s = section.settings -%}
{%- assign sid = section.id -%}
{%- assign accent = s.accent_color | default: '#289383' -%}
<div class="lm">
  <section class="bt bt-{{ sid }}" id="bt-{{ sid }}" style="--bt-accent: {{ accent }}">
    <div class="bt-i">
      {%- if s.heading != blank or s.heading_accent != blank -%}
        <h2 class="bt-h">{{ s.heading }}{% if s.heading_accent != blank %} <span class="bt-ac">{{ s.heading_accent }}</span>{% endif %}</h2>
      {%- endif -%}
      {%- if s.intro != blank -%}<p class="bt-in">{{ s.intro }}</p>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="bt-tabs" role="tablist" aria-label="{{ s.heading | strip_html | escape }}">
          {%- for block in section.blocks -%}
            <button type="button" class="bt-tab" role="tab" id="bt-{{ sid }}-t{{ forloop.index }}" aria-controls="bt-{{ sid }}-p{{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
          {%- endfor -%}
        </div>
        {%- for block in section.blocks -%}
          <div class="bt-panel" role="tabpanel" id="bt-{{ sid }}-p{{ forloop.index }}" aria-labelledby="bt-{{ sid }}-t{{ forloop.index }}"{% unless forloop.first %} hidden{% endunless %}>{{ block.settings.text }}</div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- assign strip = s.strip_items | strip | newline_to_br | split: '<br />' -%}
    {%- if s.strip_items != blank -%}
      <div class="bt-strip">
        <div class="bt-track">
          {%- for copy in (1..2) -%}
            <ul class="bt-grp"{% if copy == 2 %} aria-hidden="true"{% endif %}>
              {%- for item in strip -%}
                {%- assign t = item | strip -%}
                {%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </section>
</div>

<style>
  .lm.lm .bt-{{ sid }}{background:#fff;color:#181B1D;padding:40px 0 0}
  .lm.lm .bt-{{ sid }} .bt-i{max-width:1040px;margin:0 auto;padding:0 16px 40px;display:flex;flex-direction:column;align-items:center;text-align:center}
  .lm.lm .bt-{{ sid }} .bt-h{font-size:28px;line-height:34px;font-weight:700;color:#000;margin-bottom:12px}
  .lm.lm .bt-{{ sid }} .bt-ac{color:var(--bt-accent)}
  .lm.lm .bt-{{ sid }} .bt-in{font-size:15px;line-height:22.5px;color:#181B1D;margin-bottom:32px}
  .lm.lm .bt-{{ sid }} .bt-in strong,.lm.lm .bt-{{ sid }} .bt-in b{font-weight:700;color:#000}
  .lm.lm .bt-{{ sid }} .bt-tabs{display:grid;grid-template-columns:1fr 1fr;gap:12px;width:100%}
  .lm.lm .bt-{{ sid }} .bt-tab{min-height:56px;padding:12px 16px;border-radius:0;border:1px solid #000;background:#fff;color:#181B1D;font-size:16px;line-height:24px;font-weight:500;text-align:center}
  .lm.lm .bt-{{ sid }} .bt-tab[aria-selected="true"]{background:var(--bt-accent);border-color:var(--bt-accent);color:#fff}
  .lm.lm .bt-{{ sid }} .bt-tab:focus-visible{outline:2px solid #000;outline-offset:2px}
  .lm.lm .bt-{{ sid }} .bt-panel{max-width:800px;margin-top:40px;font-size:16px;line-height:25.6px;color:#333}
  .lm.lm .bt-{{ sid }} .bt-panel[hidden]{display:none}
  .lm.lm .bt-{{ sid }} .bt-panel p{margin:0}
  .lm.lm .bt-{{ sid }} .bt-panel p+p{margin-top:12px}
  .lm.lm .bt-{{ sid }} .bt-strip{background:var(--bt-accent);color:#fff;overflow:hidden}
  .lm.lm .bt-{{ sid }} .bt-track{display:flex;width:max-content;animation:bt-{{ sid }}-m 40s linear infinite}
  .lm.lm .bt-{{ sid }} .bt-grp{display:flex;flex:none;min-width:100vw;justify-content:space-around;align-items:center;margin:0;padding:0}
  .lm.lm .bt-{{ sid }} .bt-grp li{flex:none;padding:14px 24px;font-size:14px;line-height:20px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap}
  @keyframes bt-{{ sid }}-m{to{transform:translateX(-50%)}}
  @media (prefers-reduced-motion:reduce){
    .lm.lm .bt-{{ sid }} .bt-track{animation:none;width:auto;justify-content:center}
    .lm.lm .bt-{{ sid }} .bt-grp{flex-wrap:wrap;min-width:0;justify-content:center}
    .lm.lm .bt-{{ sid }} .bt-grp[aria-hidden]{display:none}
  }
  @media (min-width:990px){
    .lm.lm .bt-{{ sid }}{padding-top:60px}
    .lm.lm .bt-{{ sid }} .bt-i{padding-bottom:60px}
    .lm.lm .bt-{{ sid }} .bt-h{font-size:36px;line-height:43px;margin-bottom:10px}
    .lm.lm .bt-{{ sid }} .bt-in{margin-bottom:40px}
    .lm.lm .bt-{{ sid }} .bt-tab{font-size:20px;line-height:30px}
    .lm.lm .bt-{{ sid }} .bt-panel{font-size:18px;line-height:28.8px}
  }
</style>

<script>
  (function () {
    var root = document.getElementById('bt-{{ sid }}');
    if (!root) return;
    var tabs = [].slice.call(root.querySelectorAll('[role="tab"]'));
    function pick(i, focus) {
      tabs.forEach(function (t, j) {
        var on = i === j;
        t.setAttribute('aria-selected', on);
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
      });
      if (focus) tabs[i].focus();
    }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { pick(i); });
      t.addEventListener('keydown', function (e) {
        var n = tabs.length, k = e.key, j = null;
        if (k === 'ArrowRight' || k === 'ArrowDown') j = (i + 1) % n;
        else if (k === 'ArrowLeft' || k === 'ArrowUp') j = (i - 1 + n) % n;
        else if (k === 'Home') j = 0;
        else if (k === 'End') j = n - 1;
        if (j !== null) { e.preventDefault(); pick(j, true); }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "OC: Benefit tabs",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How Each Ingredient" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent part", "default": "Supports You.", "info": "Shown in the accent colour after the heading. Empty = heading only." },
    { "type": "inline_richtext", "id": "intro", "label": "Intro line", "default": "<strong>Our formula</strong> brings together well-known ingredients to support everyday wellbeing.", "info": "Bold is allowed. Empty = no intro line." },
    { "type": "header", "content": "Strip" },
    { "type": "textarea", "id": "strip_items", "label": "Strip labels", "default": "Made in small batches\nThird-party tested\nNo artificial colours", "info": "One short label per line. Scrolls slowly under the tabs. Empty = no strip." },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#289383", "info": "Used for the heading accent, the active tab and the strip." }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Benefit" },
        { "type": "richtext", "id": "text", "label": "Panel text", "default": "<p>Describe how this group of ingredients supports the benefit.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OC: Benefit tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "First benefit", "text": "<p>Describe how this group of ingredients supports the first benefit.</p>" } },
        { "type": "tab", "settings": { "label": "Second benefit", "text": "<p>Describe how this group of ingredients supports the second benefit.</p>" } },
        { "type": "tab", "settings": { "label": "Third benefit", "text": "<p>Describe how this group of ingredients supports the third benefit.</p>" } },
        { "type": "tab", "settings": { "label": "Fourth benefit", "text": "<p>Describe how this group of ingredients supports the fourth benefit.</p>" } }
      ]
    }
  ]
}
{% endschema %}
