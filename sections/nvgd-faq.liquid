{% comment %}
  FAQ Section — nvgd-faq.liquid
{% endcomment %}

{%- style -%}
  #FAQ-{{ section.id }} {
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section id="FAQ-{{ section.id }}" class="faq-layout-{{ section.settings.layout }}">
  <div class="faq-inner" style="max-width: {{ section.settings.max_width }}px; margin: 0 auto;">
    <div class="faq-content">

      {%- comment -%} Header {%- endcomment -%}
      {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
        <div class="faq-header-col">
          <div class="faq-header" style="text-align: {{ section.settings.header_alignment }};">
            {% if section.settings.eyebrow != blank %}
              <p class="faq-eyebrow">{{ section.settings.eyebrow }}</p>
            {% endif %}
            {% if section.settings.heading != blank %}
              <h2 class="faq-heading">{{ section.settings.heading | newline_to_br }}</h2>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {%- comment -%} FAQ items {%- endcomment -%}
      <div class="faq-list-col">
        <div class="faq-list" style="display: flex; flex-direction: column; gap: {{ section.settings.item_gap }}px;">
          {% for block in section.blocks %}
            {% if block.type == 'faq_item' %}
              <div class="faq-item" {{ block.shopify_attributes }}>
                <button class="faq-trigger" aria-expanded="false">
                  <span class="faq-question">{{ block.settings.question }}</span>
                  <span class="faq-icon" aria-hidden="true">
                    <svg class="faq-icon-plus" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <line x1="9" y1="1" x2="9" y2="17" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="faq-icon-v"/>
                      <line x1="1" y1="9" x2="17" y2="9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  </span>
                </button>
                {% if block.settings.answer != blank %}
                  <div class="faq-body">
                    <div class="faq-answer">{{ block.settings.answer }}</div>
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #FAQ-{{ section.id }} { box-sizing: border-box; width: 100%; }
  #FAQ-{{ section.id }} * { box-sizing: border-box; }

  #FAQ-{{ section.id }} .faq-inner {}

  #FAQ-{{ section.id }} .faq-content {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.header_margin_bottom }}px;
  }

  #FAQ-{{ section.id }}.faq-layout-split .faq-content {
    flex-direction: row;
    align-items: flex-start;
    gap: {{ section.settings.split_column_gap }}px;
  }

  #FAQ-{{ section.id }}.faq-layout-split .faq-header-col {
    flex: 0 0 {{ section.settings.split_header_width }}%;
    max-width: {{ section.settings.split_header_width }}%;
  }

  #FAQ-{{ section.id }}.faq-layout-split .faq-list-col {
    flex: 1;
    min-width: 0;
  }

  /* Split layout renders items as a divided list rather than bordered boxes */
  #FAQ-{{ section.id }}.faq-layout-split .faq-item {
    border: none;
    border-radius: 0;
    background: none;
  }

  #FAQ-{{ section.id }}.faq-layout-split .faq-item:not(:last-child) {
    border-bottom: {{ section.settings.item_border_width }}px solid {{ section.settings.item_border_color }};
  }

  #FAQ-{{ section.id }}.faq-layout-split .faq-trigger,
  #FAQ-{{ section.id }}.faq-layout-split .faq-body {
    padding-left: 0;
    padding-right: 0;
  }

  @media screen and (max-width: 768px) {
    #FAQ-{{ section.id }}.faq-layout-split .faq-content {
      flex-direction: column;
    }

    #FAQ-{{ section.id }}.faq-layout-split .faq-header-col {
      flex: none;
      max-width: 100%;
    }
  }

  #FAQ-{{ section.id }} .faq-eyebrow {
    font-family: var(--font-body-family);
    font-size: {{ section.settings.eyebrow_font_size }}px;
    font-weight: {{ section.settings.eyebrow_font_weight }};
    color: {{ section.settings.eyebrow_color }};
    margin: 0 0 8px;
    line-height: 1.2;
  }

  #FAQ-{{ section.id }} .faq-heading {
    font-family: var(--font-heading-family);
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    color: {{ section.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
  }

  #FAQ-{{ section.id }} .faq-item {
    border: {{ section.settings.item_border_width }}px solid {{ section.settings.item_border_color }};
    border-radius: {{ section.settings.item_border_radius }}px;
    background: {{ section.settings.item_background }};
    overflow: hidden;
  }

  #FAQ-{{ section.id }} .faq-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: {{ section.settings.item_padding_vertical }}px {{ section.settings.item_padding_horizontal }}px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
  }

  #FAQ-{{ section.id }} .faq-question {
    font-family: var(--font-body-family);
    font-size: {{ section.settings.question_font_size }}px;
    font-weight: {{ section.settings.question_font_weight }};
    color: {{ section.settings.question_color }};
    line-height: 1.4;
    flex: 1;
    min-width: 0;
  }

  #FAQ-{{ section.id }} .faq-icon {
    flex-shrink: 0;
    color: {{ section.settings.icon_color }};
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #FAQ-{{ section.id }} .faq-icon svg {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
  }

  #FAQ-{{ section.id }} .faq-icon-v {
    transform-origin: center;
    transition: transform 0.3s ease;
  }

  #FAQ-{{ section.id }} .faq-item.is-open .faq-icon-v {
    transform: scaleY(0);
  }

  #FAQ-{{ section.id }} .faq-body {
    display: none;
    padding: 0 {{ section.settings.item_padding_horizontal }}px {{ section.settings.item_padding_vertical }}px;
  }

  #FAQ-{{ section.id }} .faq-item.is-open .faq-body {
    display: block;
  }

  #FAQ-{{ section.id }} .faq-answer {
    font-family: var(--font-body-family);
    font-size: {{ section.settings.answer_font_size }}px;
    color: {{ section.settings.answer_color }};
    line-height: 1.6;
  }

  #FAQ-{{ section.id }} .faq-answer p { margin: 0 0 8px; }
  #FAQ-{{ section.id }} .faq-answer p:last-child { margin-bottom: 0; }
</style>

{% comment %}
<script>
(function() {
  var section = document.getElementById('FAQ-{{ section.id }}');
  if (!section) return;

  section.querySelectorAll('.faq-trigger').forEach(function(trigger) {
    trigger.addEventListener('click', function() {
      var item = trigger.closest('.faq-item');
      var isOpen = item.classList.contains('is-open');

      {% if section.settings.accordion_mode %}
      // Close all others
      section.querySelectorAll('.faq-item.is-open').forEach(function(openItem) {
        openItem.classList.remove('is-open');
        openItem.querySelector('.faq-trigger').setAttribute('aria-expanded', 'false');
      });
      {% endif %}

      if (!isOpen) {
        item.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });
})();
</script>
{% endcomment %}

<script>
(function() {
  var section = document.getElementById('FAQ-{{ section.id }}');
  if (!section) return;

  section.querySelectorAll('.faq-trigger').forEach(function(trigger) {
    trigger.addEventListener('click', function() {
      var item = trigger.closest('.faq-item');
      var isOpen = item.classList.contains('is-open');

      {% if section.settings.accordion_mode %}
      section.querySelectorAll('.faq-item.is-open').forEach(function(openItem) {
        openItem.classList.remove('is-open');
        openItem.querySelector('.faq-trigger').setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
      }
      {% else %}
      if (isOpen) {
        item.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
      } else {
        item.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
      }
      {% endif %}
    });
  });
})();
</script>

