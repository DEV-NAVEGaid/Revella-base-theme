        { "type": "checkbox", "id": "button_style_secondary_2", "default": false, "label": "Use outline style" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GNRL Rich Text",
      "blocks": [
        { "type": "caption" },
        { "type": "heading" },
        { "type": "text"    },
        { "type": "button"  }
      ]
    }
  ]
