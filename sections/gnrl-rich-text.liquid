    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        { "type": "header", "content": "Button 1" },
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "Label",
          "info": "Leave blank to hide."
