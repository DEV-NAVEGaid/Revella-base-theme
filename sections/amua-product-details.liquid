{%- liquid
  assign product_form_id = 'amua-pd-form-' | append: section.id
-%}

{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- unless product.has_only_default_variant -%}
  {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
  {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
  {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #amua-pd-{{ section.id }},
  #amua-pd-{{ section.id }} * { box-sizing: border-box; }

  #amua-pd-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    --amua-thumb-count: {{ section.settings.thumbs_per_view }};
    --amua-thumb-gap: 6px;

  }

  .amua-pd {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0;
  }

  .amua-pd__info {
    padding: 0 16px;
  }

  /* ── Gallery ── */
  .amua-pd__swiper {
    width: 100%;
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: {{ section.settings.gallery_bg }};
  }
  .amua-pd__track {
    display: flex;
    height: 100%;
    transition: transform 0.35s ease;
    will-change: transform;
  }
  .amua-pd__slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .amua-pd__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Thumbnails ── */
  .amua-pd__thumbs-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 10px 16px 0;
  }
  .amua-pd__thumbs {
    display: flex;
    gap: var(--amua-thumb-gap, 6px);
    flex: 1;
    overflow: hidden;
    scroll-behavior: smooth;
  }
  .amua-pd__thumb {
    flex: 0 0 calc((100% - (var(--amua-thumb-count, 5) - 1) * var(--amua-thumb-gap, 6px)) / var(--amua-thumb-count, 5));
    aspect-ratio: 1 / 1;
    border: 2px solid transparent;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    background: #f5f5f5;
    padding: 0;
  }
  .amua-pd__thumb.is-active { border-color: {{ section.settings.thumb_active_color }}; }
  .amua-pd__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .amua-pd__thumb-arrow {
  border: 1px solid #e0e0e0;
  border-radius: 0;
  background: #ffffff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 0;
  color: #000000;
  width: 40px;
  height: 40px;
    opacity: 0.5;
    box-shadow: 0 2px 6px 0 rgba(0, 0, 0, 0.1);
    transition: 0.2s;
  }

  /* ── Social Proof ── */
  .amua-pd__social {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }
  .amua-pd__avatars {
    display: flex;
    flex-shrink: 0;
  }
  .amua-pd__avatar {
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #fff;
    display: block;
  }
  .amua-pd__social-text {
    text-decoration: none;
    color: inherit;
  }
  .amua-pd__social-text span {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .amua-pd__stars { display: flex; gap: 0px; flex-shrink: 0; }

  /* ── Title ── */
  .amua-pd__title {
    margin: 0;
    line-height: 1.15;
  }

  /* ── Subtitle ── */
  .amua-pd__subtitle {
    margin: 0;
    line-height: 1.5;
  }

  /* ── Checklist ── */
  .amua-pd__checklist {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .amua-pd__check-item {
    display: flex;
    align-items: center;
  }
  .amua-pd__check-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Shipping Estimate ── */
  .amua-pd__shipping {
    display: flex;
    align-items: center;
  }
  .amua-pd__shipping-dot {
    position: relative;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .amua-pd__shipping-dot::after {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    border-radius: 50%;
    animation: amua-ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes amua-ping {
    0% { transform: scale(1); opacity: 0.7; }
    75%, 100% { transform: scale(2.5); opacity: 0; }
  }

  /* ── ATC Button ── */
  .amua-pd__atc {
    width: 100%;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: opacity 0.2s;
    font-family: inherit;
    position: relative;
  }
  .amua-pd__atc:hover { opacity: 0.9; }
  .amua-pd__atc.is-loading {
  opacity: 0.55;
  pointer-events: none;
  position: relative;
}
.amua-pd__atc.is-loading::after {
  content: '';
  width: 20px; height: 20px;
  border: 3px solid rgba(0,0,0,0.15);
  border-top-color: currentColor;
  border-radius: 50%;
  animation: amua-spin 0.6s linear infinite;
}
@keyframes amua-spin { to { transform: rotate(360deg); } }
  .amua-pd__atc .loading__spinner { display: none; }
  .amua-pd__atc.loading .loading__spinner { display: block; }

  /* ── Buy Subtext ── */
  .amua-pd__buy-sub {
    margin: 0;
  }

  /* ── Review Card ── */
  .amua-pd__review-card {
    overflow: hidden;
  }
  .amua-pd__review-inner {
    display: flex;
    gap: 14px;
  }
  .amua-pd__review-avatar {
    flex-shrink: 0;
    border-radius: 100%;
    object-fit: cover;
    display: block;
  }
  .amua-pd__review-header {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }
  .amua-pd__review-name {
    margin: 0;
    line-height: 1.2;
  }
  .amua-pd__review-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .amua-pd__review-text {
    margin: 0;
    line-height: 1.55;
  }

  /* ── FAQ ── */
  .amua-pd__faq-item {
    border-bottom-style: solid;
  }
  .amua-pd__faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    gap: 10px;
    list-style: none;
    background: none;
  }
  .amua-pd__faq-summary::-webkit-details-marker { display: none; }
  .amua-pd__faq-summary::marker { display: none; }
  .amua-pd__faq-plus {
    flex-shrink: 0;
    transition: transform 0.25s;
    transform-origin: center;
  }
  .amua-pd__faq-item[open] .amua-pd__faq-plus {
    transform: rotate(45deg);
  }
  .amua-pd__faq-content {
    line-height: 1.6;
  }
  .amua-pd__faq-content p { margin: 0 0 8px; }
  .amua-pd__faq-content p:last-child { margin-bottom: 0; }

  /* ══════════════════════════════════
     BUNDLE SELECTOR
     ══════════════════════════════════ */
  .amua-pd__bundle {
    display: flex;
    flex-direction: column;
    gap: var(--amua-b-gap, 10px);
  }
  .amua-pd__bopt {
    position: relative;
    border: var(--amua-b-bw, 2px) solid var(--amua-b-idle-border, #e5e5e5);
    border-radius: var(--amua-b-radius, 10px);
    padding: var(--amua-b-pad, 6px);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: var(--amua-b-imggap, 14px);
    transition: border-color 0.2s, background-color 0.2s;
    background: var(--amua-b-idle-bg, #fff);
  }
  .amua-pd__bopt.is-sel {
    border-color: var(--amua-b-active, #edba2a);
    background: var(--amua-b-sel-bg, #fdf6e3);
  }
  .amua-pd__bopt:has(.amua-pd__bopt-radio:checked) {
    border-color: var(--amua-b-active, #edba2a);
    background: var(--amua-b-sel-bg, #fdf6e3);
  }
  .amua-pd__bopt-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .amua-pd__bopt-badge {
    position: absolute;
    top: var(--amua-b-badge-top, -10px);
    right: var(--amua-b-badge-right, 12px);
    font-weight: 700;
    line-height: 1;
    border-radius: var(--amua-b-badge-radius, 4px);
    padding: 4px 10px;
    white-space: nowrap;
    pointer-events: none;
  }
  .amua-pd__bopt-imgs {
    display: flex;
    flex-shrink: 0;
    align-items: center;
  }
  .amua-pd__bopt-imgs img {
    object-fit: contain;
    display: block;
  }
  .amua-pd__bopt-body {
    flex: 1;
    min-width: 0;
  }
  .amua-pd__bopt-name {
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
  }
  .amua-pd__bopt-save {
    margin: 2px 0 0;
    line-height: 1.4;
  }
  .amua-pd__bopt-perks {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
  }
  .amua-pd__bopt-perks li {
    display: flex;
    align-items: center;
    gap: 5px;
    line-height: 1.55;
  }
  .amua-pd__bopt-perks svg { flex-shrink: 0; }
  .amua-pd__bopt-pricing {
    text-align: right;
    flex-shrink: 0;
  }
  .amua-pd__bopt-price {
    font-weight: 800;
    line-height: 1;
    margin: 0;
  }
  .amua-pd__bopt-cmp {
    text-decoration: line-through;
    opacity: 0.5;
    margin: 3px 0 0;
  }

  /* ── Subscription checkbox
  .amua-pd__sub-row {
    border-width: var(--amua-sub-bw, 2px);
    border-style: var(--amua-sub-bstyle, dashed);
    border-color: var(--amua-sub-bcolor, #edba2a);
    border-radius: var(--amua-sub-radius, 10px);
    padding: var(--amua-sub-pad, 14px) 16px;
    cursor: pointer;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    transition: border-color 0.2s, background-color 0.2s;
    background: var(--amua-sub-bg, #fff);
  }
  */
  .amua-pd__sub-row {
    display: none;
  }
  .amua-pd__sub-row.is-on {
    border-color: var(--amua-sub-bcolor-on, #edba2a);
    background: var(--amua-sub-bg-on, #fff);
  }
  .amua-pd__sub-box {
    width: var(--amua-sub-box, 22px);
    height: var(--amua-sub-box, 22px);
    border: 2px solid var(--amua-sub-box-border, #edba2a);
    border-radius: var(--amua-sub-box-radius, 5px);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
    transition: background 0.2s, border-color 0.2s;
    background: var(--amua-sub-box-bg, #fff);
  }
  .amua-pd__sub-row.is-on .amua-pd__sub-box {
    background: var(--amua-sub-box-bg-on, #fff);
    border-color: var(--amua-sub-box-border-on, #edba2a);
  }
  .amua-pd__sub-box svg {
    opacity: 0;
    transition: opacity 0.15s;
  }
  .amua-pd__sub-row.is-on .amua-pd__sub-box svg {
    opacity: 1;
  }
  .amua-pd__sub-title {
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
  }
  .amua-pd__sub-desc {
    margin: 2px 0 0;
    line-height: 1.4;
  }

    /* ── Video Carousel ── */
  .amua-pd__vid-heading { margin: 0; line-height: 1.3; }
  .amua-pd__vid-badge {
    display: inline-flex; align-items: center; gap: 6px;
    border: var(--amua-vb-bw, 1px) solid transparent;
    border-radius: var(--amua-vb-radius, 20px);
    padding: 0px 6px;
    text-decoration: none; width: fit-content;
    background:
      linear-gradient(var(--amua-vb-bg, #fff), var(--amua-vb-bg, #fff)) padding-box,
      linear-gradient(var(--amua-vb-angle, 90deg), var(--amua-vb-c1, #EDBA2A), var(--amua-vb-c2, #E06A6A)) border-box;
  }
  .amua-pd__vid-badge svg { flex-shrink: 0; }
  .amua-pd__vid-scroll {
    display: flex; gap: 10px; overflow-x: auto;
    -webkit-overflow-scrolling: touch; scrollbar-width: none;
    padding-bottom: 8px;
  }
  .amua-pd__vid-scroll::-webkit-scrollbar { display: none; }
  .amua-pd__vid-thumb {
    flex: 0 0 28%; aspect-ratio: 9 / 16; border-radius: 8px;
    overflow: hidden; position: relative; background: #f0f0f0; cursor: pointer;
  }
  .amua-pd__vid-thumb img,
  .amua-pd__vid-thumb video {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .amua-pd__vid-thumb::after {
    content: ''; position: absolute; inset: 0;
    background: rgba(0,0,0,0.08); pointer-events: none;
  }
  .amua-pd__vid-sound {
    position: absolute; right: 8px; bottom: 8px; z-index: 2;
    width: 28px; height: 28px; border-radius: 50%;
    background: rgba(0,0,0,0.45);
    display: flex; align-items: center; justify-content: center;
    pointer-events: none;
  }
  .amua-pd__vid-progress {
    height: 3px; border-radius: 2px; overflow: hidden; margin-top: 4px;
  }

  /* ── Video Modal ── */
  .amua-pd__vid-modal {
    position: fixed; inset: 0; z-index: 9999;
    background: rgba(0,0,0,0.92);
    display: flex; align-items: center; justify-content: center;
    padding: 20px;
  }
  .amua-pd__vid-modal[hidden] { display: none; }
  .amua-pd__vid-stage {
    width: min(100%, 440px); aspect-ratio: 9 / 16;
    border-radius: 10px; overflow: hidden; background: #000;
  }
  .amua-pd__vid-stage video { width: 100%; height: 100%; object-fit: contain; display: block; }
  .amua-pd__vid-close {
    position: absolute; top: 16px; right: 16px;
    width: 36px; height: 36px; border-radius: 50%;
    border: none; background: rgba(255,255,255,0.15); color: #fff;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
  }

  /* ── Replica Warning ── */
  .amua-pd__replica { display: flex; gap: 12px; align-items: flex-start; }
  .amua-pd__replica-icon { flex-shrink: 0; display: flex; align-items: center; margin-top: 2px; }
  .amua-pd__replica-heading { margin: 0 0 4px; line-height: 1.3; }
  .amua-pd__replica-text { margin: 0; line-height: 1.5; }

  /* ── Desktop ── */
  @media (min-width: 990px) {
    .amua-pd {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      padding: 0 50px;
    }
    .amua-pd__media {
      position: sticky;
      top: 20px;
      align-self: start;
    }
    .amua-pd__info {
      padding: 0;
    }
    .amua-pd__swiper {
      border-radius: 12px;
    }
    .amua-pd__thumbs-wrap {
      margin-left: 0;
      margin-right: 0;
    }
  }
{%- endstyle -%}

<product-info
  id="amua-pd-{{ section.id }}"
  class="section-{{ section.id }}-padding"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-url="{{ product.url }}"
>
  <div class="amua-pd" id="amua-pd-wrap-{{ section.id }}">

    {%- comment -%}═══ GALLERY ═══{%- endcomment -%}
    {%- if product.images.size > 0 -%}
    <div class="amua-pd__media">
      <div class="amua-pd__swiper" id="amua-swiper-{{ section.id }}">
        <div class="amua-pd__track" id="amua-track-{{ section.id }}">
          {%- for img in product.images -%}
            <div class="amua-pd__slide">
              <img
                src="{{ img | image_url: width: 900 }}"
                alt="{{ img.alt | escape | default: product.title }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                width="900" height="900"
                style="border-radius: 10px;"
              >
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- if product.images.size > 1 -%}
      <div class="amua-pd__thumbs-wrap">
        <button class="amua-pd__thumb-arrow" id="amua-arrow-l-{{ section.id }}" type="button" aria-label="Previous thumbnails">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <div class="amua-pd__thumbs" id="amua-thumbs-{{ section.id }}">
          {%- for img in product.images -%}
            <button
              class="amua-pd__thumb{% if forloop.first %} is-active{% endif %}"
              data-index="{{ forloop.index0 }}"
              type="button"
              aria-label="View image {{ forloop.index }}"
            >
              <img src="{{ img | image_url: width: 200 }}" alt="{{ img.alt | escape | default: product.title }}" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
        <button class="amua-pd__thumb-arrow" id="amua-arrow-r-{{ section.id }}" type="button" aria-label="Next thumbnails">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
        </button>
      </div>
      {%- endif -%}
    </div>
    {%- endif -%}

    {%- comment -%}═══ INFO BLOCKS ═══{%- endcomment -%}
    <div class="amua-pd__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- comment -%}── Social Proof ──{%- endcomment -%}
          {%- when 'social_proof' -%}
            <div class="amua-pd__social" style="margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;" {{ block.shopify_attributes }}>
              <div class="amua-pd__avatars">
                {%- for i in (1..4) -%}
                  {%- assign av_key = 'avatar_' | append: i -%}
                  {%- assign av = block.settings[av_key] -%}
                  {%- if av != blank -%}
                    <img class="amua-pd__avatar" src="{{ av | image_url: width: 80 }}" alt="Customer {{ i }}" width="{{ block.settings.avatar_size }}" height="{{ block.settings.avatar_size }}" style="width:{{ block.settings.avatar_size }}px;height:{{ block.settings.avatar_size }}px;{% unless forloop.first %}margin-left:-{{ block.settings.avatar_overlap }}px;{% endunless %}" loading="lazy">
                  {%- endif -%}
                {%- endfor -%}
              </div>
              <a href="#amua-rwrc-template--20366408482998__amua_real_woman_real_curves_brVNnH" class="amua-pd__social-text" style="font-size:{{ block.settings.text_size }}px;color:{{ block.settings.text_color }};">
                {{ block.settings.rating_text }} <span>{{ block.settings.review_count_text }}</span>
              </a>
              <div class="amua-pd__stars">
                {%- assign filled_stars = block.settings.star_count | round -%}
                {%- for i in (1..5) -%}
                  <svg width="{{ block.settings.star_size }}" height="{{ block.settings.star_size }}" viewBox="0 0 24 24">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="{% if i <= filled_stars %}{{ block.settings.star_color }}{% else %}#E0E0E0{% endif %}" stroke="none"/>
                  </svg>
                {%- endfor -%}
              </div>
            </div>

          {%- comment -%}── Title ──{%- endcomment -%}
          {%- when 'title' -%}
            <h1 class="amua-pd__title" style="font-size:{{ block.settings.font_size }}px;font-weight:{{ block.settings.font_weight }};color:{{ block.settings.text_color }};margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;" {{ block.shopify_attributes }}>
              {{ product.title | escape }}
            </h1>

          {%- comment -%}── Subtitle ──{%- endcomment -%}
          {%- when 'subtitle' -%}
            <p class="amua-pd__subtitle" style="font-size:{{ block.settings.font_size }}px;font-weight:{{ block.settings.font_weight }};color:{{ block.settings.text_color }};margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </p>

          {%- comment -%}── Checklist ──{%- endcomment -%}
          {%- when 'checklist' -%}
            <ul class="amua-pd__checklist" style="margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;" {{ block.shopify_attributes }}>
              {%- for i in (1..6) -%}
                {%- assign item_key = 'item_' | append: i -%}
                {%- assign item_val = block.settings[item_key] -%}
                {%- if item_val != blank -%}
                  <li class="amua-pd__check-item" style="gap:{{ block.settings.icon_gap }}px;margin-bottom:{{ block.settings.row_gap }}px;">
                    <span class="amua-pd__check-icon">
                      <svg width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
