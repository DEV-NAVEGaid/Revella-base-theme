          {%- comment -%}── App Block ──{%- endcomment -%}
          {%- when '@app' -%}
            {% render block %}

          
                    {%- comment -%}── Variant Picker (bundle-styled, native add-to-cart) ──{%- endcomment -%}
          {%- when 'variant_picker' -%}
            {%- assign sel_variant = product.variants[1] | default: product.selected_or_first_available_variant -%}
            <product-form class="amua-pd__product-form">
              {%- form 'product', product, id: product_form_id, class: 'amua-pd__vform' -%}
                <div
                  class="amua-pd__bundle"
                  id="amua-vpick-{{ section.id }}"
                  style="--amua-b-active:#EDBA2A;--amua-b-idle-border:#E8E8E8;--amua-b-idle-bg:#FFFFFF;--amua-b-sel-bg:#FDF6E3;--amua-b-radius:10px;--amua-b-pad:6px;--amua-b-gap:10px;--amua-b-bw:2px;--amua-b-imggap:14px;--amua-b-badge-top:-10px;--amua-b-badge-right:12px;--amua-b-badge-radius:4px;margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;"
                  {{ block.shopify_attributes }}
                >
                  {%- for variant in product.variants -%}
                    {%- liquid
                      assign idx = forloop.index
                      assign v_img = blank
                      assign v_badge = blank
                      assign v_img_w = 56
                      assign v_img_h = 56
                      if idx == 1
                        assign v_img = block.settings.tier1_image
                        assign v_badge = block.settings.tier1_badge
                        assign v_img_w = block.settings.tier1_img_width
                        assign v_img_h = block.settings.tier1_img_height
                      elsif idx == 2
                        assign v_img = block.settings.tier2_image
                        assign v_badge = block.settings.tier2_badge
                        assign v_img_w = block.settings.tier2_img_width
                        assign v_img_h = block.settings.tier2_img_height
                      endif
                      assign is_sel = false
                      if variant.id == sel_variant.id
                        assign is_sel = true
                      endif
                    -%}
                    <label class="amua-pd__bopt">
                      <input type="radio" name="id" class="amua-pd__bopt-radio" value="{{ variant.id }}" {% if is_sel %}checked{% endif %}>

                      {%- if v_badge != blank -%}
                        <span class="amua-pd__bopt-badge" style="background:#EDBA2A;color:#121212;font-size:11px;">{{ v_badge }}</span>
                      {%- endif -%}

                      {%- if v_img != blank -%}
                        <div class="amua-pd__bopt-imgs">
                          <img src="{{ v_img | image_url: width: 500 }}" alt="{{ variant.title | escape }}" style="width:{{ v_img_w }}px;height:{{ v_img_h }}px;" loading="lazy">
                        </div>
                      {%- endif -%}

                      <div class="amua-pd__bopt-body">
                        <p class="amua-pd__bopt-name" style="font-size:16px;color:#121212;">{{ variant.title }}</p>

                        {%- if idx == 2 -%}
                          <ul class="amua-pd__bopt-perks" style="font-size:13px;">
                            {%- if block.settings.tier2_show_save and variant.compare_at_price > variant.price -%}
                              <li>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17L4 12" stroke="#E8B92E" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                <span style="color:#333333;">You save {{ variant.compare_at_price | minus: variant.price | money }}</span>
                              </li>
                            {%- endif -%}
                            {%- for p in (1..3) -%}
                              {%- assign pk = 'tier2_perk_' | append: p -%}
                              {%- if block.settings[pk] != blank -%}
                                <li>
                                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17L4 12" stroke="#E8B92E" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                  <span style="color:#333333;">{{ block.settings[pk] }}</span>
                                </li>
                              {%- endif -%}
                            {%- endfor -%}
                          </ul>
                        {%- elsif variant.compare_at_price > variant.price -%}
                          <p class="amua-pd__bopt-save" style="font-size:12px;color:#777777;">You save {{ variant.compare_at_price | minus: variant.price | money }}</p>
                        {%- endif -%}
                      </div>

                      <div class="amua-pd__bopt-pricing">
                        <p class="amua-pd__bopt-price" style="font-size:20px;color:#121212;">{{ variant.price | money }}</p>
                        {%- if variant.compare_at_price > variant.price -%}
                          <p class="amua-pd__bopt-cmp" style="font-size:13px;color:#121212;">{{ variant.compare_at_price | money }}</p>
                        {%- endif -%}
                      </div>
                    </label>
                  {%- endfor -%}
                </div>

                {%- comment -%} Hidden native submit so product-form.js wires up. The visible "Add to Cart Button" block triggers this form via form="{{ product_form_id }}". {%- endcomment -%}
                <button type="submit" name="add" class="amua-pd__vform-submit" aria-hidden="true" tabindex="-1"
                        style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;">
                  <span>{{ 'products.product.add_to_cart' | t }}</span>
                  <span class="loading__spinner hidden"><svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg"><circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle></svg></span>
                </button>
              {%- endform -%}

            </product-form>
          
          
          
          
           {%- comment -%}── Shipping Estimate ──{%- endcomment -%}
          {%- when 'shipping_estimate' -%}
            {%- assign ship_date = 'now' | date: '%s' | plus: 86400 | date: '%B %-d' -%}
            <div class="amua-pd__shipping" style="gap:{{ block.settings.dot_gap }}px;margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;font-size:{{ block.settings.font_size }}px;color:{{ block.settings.text_color }};" {{ block.shopify_attributes }}>
              <span class="amua-pd__shipping-dot" style="width:{{ block.settings.dot_size }}px;height:{{ block.settings.dot_size }}px;background:{{ block.settings.dot_color }};"></span>
              <span>{{ block.settings.label_before }} <strong>{{ ship_date }}</strong></span>
            </div>

          {%- comment -%}── Buy Button ──{%- endcomment -%}
          {%- when 'buy_button' -%}
            <div style="margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;" {{ block.shopify_attributes }}>
              <button
                type="button"
                id="amua-atc-{{ section.id }}"
                class="amua-pd__atc"
                style="background:{{ block.settings.btn_bg }};color:{{ block.settings.btn_text_color }};font-size:{{ block.settings.btn_font_size }}px;font-weight:{{ block.settings.btn_font_weight }};border-radius:{{ block.settings.btn_radius }}px;padding:{{ block.settings.btn_padding_v }}px {{ block.settings.btn_padding_h }}px;text-transform:{{ block.settings.btn_text_transform }};letter-spacing:{{ block.settings.btn_letter_spacing }}px;"
              >
                <span>{{ block.settings.btn_text }}</span>
              </button>
            </div>

          {%- comment -%}── Buy Subtext ──{%- endcomment -%}
          {%- when 'buy_subtext' -%}
            <p class="amua-pd__buy-sub" style="font-size:{{ block.settings.font_size }}px;color:{{ block.settings.text_color }};text-align:{{ block.settings.alignment }};margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </p>

          {%- comment -%}── Review Card ──{%- endcomment -%}
          {%- when 'review_card' -%}
            <div class="amua-pd__review-card" style="border:{{ block.settings.border_width }}px solid {{ block.settings.border_color }};border-radius:{{ block.settings.border_radius }}px;padding:{{ block.settings.padding }}px;margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;" {{ block.shopify_attributes }}>
              <div class="amua-pd__review-inner">
                {%- if block.settings.reviewer_image != blank -%}
                  <img class="amua-pd__review-avatar" src="{{ block.settings.reviewer_image | image_url: width: 160 }}" alt="{{ block.settings.reviewer_name | escape }}" width="{{ block.settings.avatar_size }}" height="{{ block.settings.avatar_size }}" style="width:{{ block.settings.avatar_size }}px;height:{{ block.settings.avatar_size }}px;" loading="lazy">
                {%- endif -%}
                <div style="flex:1;min-width:0;">
                  <div class="amua-pd__review-header">
                    <p class="amua-pd__review-name" style="font-size:{{ block.settings.name_size }}px;font-weight:700;color:{{ block.settings.name_color }};">{{ block.settings.reviewer_name }}</p>
                    {%- if block.settings.show_verified -%}
                      <span class="amua-pd__review-badge"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="{{ block.settings.verified_color }}"/><path d="M8 12l3 3 5-5" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                    {%- endif -%}
                    <div class="amua-pd__stars">
                      {%- assign rc_filled = block.settings.rating | round -%}
                      {%- for i in (1..5) -%}
                        <svg width="{{ block.settings.star_size }}" height="{{ block.settings.star_size }}" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="{% if i <= rc_filled %}{{ block.settings.star_color }}{% else %}#E0E0E0{% endif %}" stroke="none"/></svg>
                      {%- endfor -%}
                    </div>
                  </div>
                  <p class="amua-pd__review-text" style="font-size:{{ block.settings.text_size }}px;color:{{ block.settings.text_color }};">{{ block.settings.review_text }}</p>
                </div>
              </div>
            </div>

          {%- comment -%}── FAQ ──{%- endcomment -%}
          {%- when 'faq' -%}
            <div style="margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;" {{ block.shopify_attributes }}>
              {%- for i in (1..6) -%}
                {%- assign q_key = 'q_' | append: i -%}
                {%- assign a_key = 'a_' | append: i -%}
                {%- assign q_val = block.settings[q_key] -%}
                {%- assign a_val = block.settings[a_key] -%}
                {%- if q_val != blank -%}
                  <details class="amua-pd__faq-item" style="border-bottom-width:{{ block.settings.border_width }}px;border-bottom-color:{{ block.settings.border_color }};">
                    <summary class="amua-pd__faq-summary" style="padding:{{ block.settings.padding_v }}px 0;">
                      <span style="font-size:{{ block.settings.heading_size }}px;color:{{ block.settings.heading_color }};">{{ q_val }}</span>
                      <svg class="amua-pd__faq-plus" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="{{ block.settings.heading_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    </summary>
                    <div class="amua-pd__faq-content" style="padding-bottom:{{ block.settings.padding_v }}px;font-size:{{ block.settings.content_size }}px;color:{{ block.settings.content_color }};">{{ a_val }}</div>
