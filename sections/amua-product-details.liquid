{%- comment -%}═══ SWIPER + BUNDLE JS ═══{%- endcomment -%}
<script>
(function() {
  var sid = '{{ section.id }}';

  /* ── Gallery Swiper ── */
  var swiper = document.getElementById('amua-swiper-' + sid);
  var track = document.getElementById('amua-track-' + sid);
  var thumbsEl = document.getElementById('amua-thumbs-' + sid);
  var current = 0;
  var total = track ? track.querySelectorAll('.amua-pd__slide').length : 0;

  function gotoSlide(idx) {
    if (idx < 0 || idx >= total) return;
    current = idx;
    track.style.transform = 'translateX(-' + (idx * 100) + '%)';
    if (thumbsEl) {
      thumbsEl.querySelectorAll('.amua-pd__thumb').forEach(function(t) {
        t.classList.toggle('is-active', parseInt(t.dataset.index) === idx);
      });
      var active = thumbsEl.querySelector('.amua-pd__thumb.is-active');
      if (active) active.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    }
  }

  if (thumbsEl) {
    thumbsEl.addEventListener('click', function(e) {
      var thumb = e.target.closest('.amua-pd__thumb');
      if (thumb) gotoSlide(parseInt(thumb.dataset.index, 10));
    });
  }

  var aL = document.getElementById('amua-arrow-l-' + sid);
  var aR = document.getElementById('amua-arrow-r-' + sid);
  if (thumbsEl && aL && aR) {
    aL.addEventListener('click', function() { thumbsEl.scrollBy({ left: -120, behavior: 'smooth' }); });
    aR.addEventListener('click', function() { thumbsEl.scrollBy({ left: 120, behavior: 'smooth' }); });
  }

  if (swiper && total > 1) {
    var startX = 0, startY = 0, isH = null, dragging = false;
    swiper.addEventListener('touchstart', function(e) { startX = e.touches[0].clientX; startY = e.touches[0].clientY; isH = null; dragging = true; }, { passive: true });
    swiper.addEventListener('touchmove', function(e) { if (!dragging) return; var dx = e.touches[0].clientX - startX, dy = e.touches[0].clientY - startY; if (isH === null && (Math.abs(dx) > 5 || Math.abs(dy) > 5)) isH = Math.abs(dx) > Math.abs(dy); if (isH) e.preventDefault(); }, { passive: false });
    swiper.addEventListener('touchend', function(e) { if (!dragging || !isH) return; dragging = false; var dx = e.changedTouches[0].clientX - startX; if (Math.abs(dx) < 40) return; if (dx < 0 && current < total - 1) gotoSlide(current + 1); else if (dx > 0 && current > 0) gotoSlide(current - 1); }, { passive: true });
    swiper.addEventListener('touchcancel', function() { dragging = false; });
  }

    /* ── Video Carousel Modal ── */
  var vidScroll = document.getElementById('amua-vid-scroll-' + sid);
  var vidModal = document.getElementById('amua-vid-modal-' + sid);
  if (vidScroll && vidModal) {
    var vidStage = vidModal.querySelector('.amua-pd__vid-stage');
    var vidClose = vidModal.querySelector('.amua-pd__vid-close');

    function closeVid() {
      var v = vidStage.querySelector('video');
      if (v) { v.pause(); }
      vidStage.innerHTML = '';
      vidModal.setAttribute('hidden', '');
      document.body.style.overflow = '';
    }

    vidScroll.addEventListener('click', function(e) {
      var cell = e.target.closest('[data-amua-vid]');
      if (!cell) return;
      var src = cell.querySelector('video');
      if (!src) return;

      var clone = src.cloneNode(true);
      clone.muted = false;
      clone.controls = true;
      clone.loop = true;
      clone.setAttribute('playsinline', '');
      clone.removeAttribute('hidden');

      vidStage.innerHTML = '';
      vidStage.appendChild(clone);
      vidModal.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';

      var p = clone.play();
      if (p && p.catch) p.catch(function() {});
    });

    if (vidClose) vidClose.addEventListener('click', closeVid);
    vidModal.addEventListener('click', function(e) {
      if (e.target === vidModal) closeVid();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !vidModal.hasAttribute('hidden')) closeVid();
    });
  }

  /* ── Lazy play video ── */
var lazyVids = document.querySelectorAll('#amua-vid-scroll-' + sid + ' [data-amua-autoplay] video');
if (lazyVids.length && 'IntersectionObserver' in window) {
  var vidObs = new IntersectionObserver(function(entries) {
    entries.forEach(function(en) {
      var v = en.target;
      if (en.isIntersecting) {
        v.preload = 'auto';
        var p = v.play();
        if (p && p.catch) p.catch(function() {});
      } else {
        v.pause();
      }
    });
  }, { rootMargin: '100px', threshold: 0.25 });
  lazyVids.forEach(function(v) { vidObs.observe(v); });
}

/* ── ATC proxy with loading state ── */
var atcBtn = document.getElementById('amua-atc-' + sid);
if (atcBtn) {
  atcBtn.addEventListener('click', function(e) {
    e.preventDefault();
    if (atcBtn.classList.contains('is-loading')) return;

    var btnSpan = atcBtn.querySelector('span');
    var origText = btnSpan ? btnSpan.textContent : '';

    atcBtn.classList.add('is-loading');
    if (btnSpan) btnSpan.textContent = '';

    var formEl = document.getElementById('{{ product_form_id }}');
    var hiddenSubmit = formEl ? formEl.querySelector('button[type="submit"]') : null;
    if (hiddenSubmit) hiddenSubmit.click();

    var pf = formEl ? formEl.closest('product-form') : null;
    var timeout = setTimeout(reset, 6000);

    if (pf) {
      var obs = new MutationObserver(function() {
        var hs = pf.querySelector('.loading__spinner');
        if (hs && hs.classList.contains('hidden')) {
          reset();
          obs.disconnect();
        }
      });
      obs.observe(pf, { subtree: true, attributes: true, attributeFilter: ['class'] });
    }

    function reset() {
      clearTimeout(timeout);
      atcBtn.classList.remove('is-loading');
      if (btnSpan) btnSpan.textContent = origText;
    }
  });
}

  /* ── Bundle Logic ── */
  var bundleWrap = document.getElementById('amua-bundle-' + sid);
  if (!bundleWrap) return;

  var subRow = document.getElementById('amua-sub-' + sid);
  var atcBtn = document.getElementById('amua-atc-' + sid);
  var variantId = bundleWrap.dataset.variantId;
  var selectedTier = bundleWrap.dataset.default || '2';
  var subOn = bundleWrap.dataset.subDefault === '1';

  var subPct = parseFloat(bundleWrap.dataset.subPercent);
  if (isNaN(subPct)) subPct = 0;
  var curSym = bundleWrap.dataset.currency || '';
  var curPos = bundleWrap.dataset.currencyPos || 'before';
  var saveLabel = bundleWrap.dataset.saveLabel || '';

    /* Discount codes: 1=buy1, 2=buy1+sub, 3=buy2, 4=buy2+sub */
  function attr(name) {
    var v = bundleWrap.getAttribute(name);
    return v ? v.trim() : '';
  }

  var codes = {
    '1_off': attr('data-discount-1'),
    '1_on':  attr('data-discount-2'),
    '2_off': attr('data-discount-3'),
    '2_on':  attr('data-discount-4')
  };

  var opts = bundleWrap.querySelectorAll('.amua-pd__bopt');

  /* Ubah teks harga dari settings jadi angka (toleran terhadap "$", spasi, koma) */
  function toNum(v) {
    if (!v) return 0;
    var s = String(v).replace(/[^0-9.,]/g, '');
    if (s.indexOf(',') > -1 && s.indexOf('.') === -1) s = s.replace(/,/g, '.');
    else s = s.replace(/,/g, '');
    var n = parseFloat(s);
    return isNaN(n) ? 0 : n;
  }

  function money(n) {
    var s = n.toFixed(2);
    return curPos === 'after' ? s + curSym : curSym + s;
  }

  function updatePrices() {
    opts.forEach(function(o) {
      var base = toNum(o.dataset.price);
      var cmp = toNum(o.dataset.compare);

      var shown = subOn ? base * (1 - subPct / 100) : base;
      shown = Math.round(shown * 100) / 100;

      var priceEl = o.querySelector('[data-amua-price]');
      if (priceEl) priceEl.textContent = money(shown);

      var cmpEl = o.querySelector('[data-amua-cmp]');
      if (cmpEl) {
        if (cmp > shown) {
          cmpEl.textContent = money(cmp);
          cmpEl.style.display = '';
        } else {
          cmpEl.style.display = 'none';
        }
      }

      var saveEl = o.querySelector('[data-amua-save]');
      if (saveEl) {
        var diff = Math.round((cmp - shown) * 100) / 100;
        var holder = saveEl.closest('li') || saveEl;
        if (cmp > 0 && diff > 0) {
          saveEl.textContent = (saveLabel ? saveLabel + ' ' : '') + money(diff);
          holder.style.display = '';
        } else {
          holder.style.display = 'none';
        }
      }
    });
  }

  function updateUI() {
    opts.forEach(function(o) {
      var isSel = o.dataset.tier === selectedTier;
      o.classList.toggle('is-sel', isSel);
      var radio = o.querySelector('input[type="radio"]');
      if (radio) radio.checked = isSel;
    });
    if (subRow) subRow.classList.toggle('is-on', subOn);
    updatePrices();
  }

  opts.forEach(function(o) {
    o.addEventListener('click', function() {
      selectedTier = o.dataset.tier;
      updateUI();
    });
  });

  if (subRow) {
    subRow.addEventListener('click', function() {
      subOn = !subOn;
      updateUI();
    });
  }

  /* ATC handler */
  if (atcBtn) {
    atcBtn.addEventListener('click', function() {
      var opt = bundleWrap.querySelector('.amua-pd__bopt.is-sel');
      var qty = opt ? parseInt(opt.dataset.qty, 10) : 1;
      var codeKey = selectedTier + '_' + (subOn ? 'on' : 'off');
      var discountCode = codes[codeKey] || '';

      var props = {};
      if (subOn) {
        props['_auto_refill'] = 'Yes';
        props['Subscription'] = 'Save ' + subPct + '% — Auto Refill';
      }

      var body = {
        items: [{
          id: parseInt(variantId, 10),
          quantity: qty,
          properties: props
        }]
      };

      atcBtn.style.opacity = '0.6';
      atcBtn.style.pointerEvents = 'none';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      })
      .then(function(r) { return r.json(); })
            .then(function() {
        if (discountCode) {
          window.location.href = '/discount/' + encodeURIComponent(discountCode) + '?redirect=/cart';
        } else {
          window.location.href = '/cart';
        }
      })
      .catch(function() {
        atcBtn.style.opacity = '1';
        atcBtn.style.pointerEvents = 'auto';
        alert('Something went wrong. Please try again.');
      });
    });
  }

  updateUI();
})();
</script>

