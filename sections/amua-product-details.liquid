            <div class="amua-pd__vid-modal" id="amua-vid-modal-{{ section.id }}" hidden>
              <button class="amua-pd__vid-close" type="button" aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
              <div class="amua-pd__vid-stage"></div>
            </div>

          {%- comment -%}── Replica Warning ──{%- endcomment -%}
          {%- when 'replica_warning' -%}
            <div class="amua-pd__replica" style="border:{{ block.settings.border_width }}px {{ block.settings.border_style }} {{ block.settings.border_color }};border-radius:{{ block.settings.border_radius }}px;padding:{{ block.settings.padding }}px;background:{{ block.settings.bg_color }};margin-top:{{ block.settings.margin_top }}px;margin-bottom:{{ block.settings.margin_bottom }}px;" {{ block.shopify_attributes }}>
              <span class="amua-pd__replica-icon">
                <svg width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}" viewBox="0 0 24 24" fill="none" stroke="{{ block.settings.icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              </span>
              <div>
                {%- if block.settings.heading != blank -%}
                  <p class="amua-pd__replica-heading" style="font-size:{{ block.settings.heading_size }}px;font-weight:{{ block.settings.heading_weight }};color:{{ block.settings.heading_color }};">{{ block.settings.heading }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="amua-pd__replica-text" style="font-size:{{ block.settings.text_size }}px;color:{{ block.settings.text_color }};">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            </div>

          {%- when 'custom_liquid' -%}
            <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</product-info>
