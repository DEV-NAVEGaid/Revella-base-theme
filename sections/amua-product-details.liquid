                  style="
                    margin-bottom:{{ block.settings.badge_gap }}px;
                    font-size:{{ block.settings.badge_font_size }}px;
                    color:{{ block.settings.badge_text_color }};
                    --amua-vb-c1:{{ block.settings.badge_border_color }};
                    --amua-vb-c2:{{ block.settings.badge_border_color_2 }};
                    --amua-vb-angle:{{ block.settings.badge_border_angle }}deg;
                    --amua-vb-bg:{{ block.settings.badge_bg }};
                    --amua-vb-bw:{{ block.settings.badge_border_width }}px;
                    --amua-vb-radius:{{ block.settings.badge_radius }}px;
