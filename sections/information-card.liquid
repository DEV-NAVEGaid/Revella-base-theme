{% comment %}
  Static cards (slider) — ported from Shrine to Dawn
  Layout and styling preserved 1:1. Only Shrine-specific helpers were swapped
  for Dawn equivalents (page-width class, inline copy badge, removed animate-*).
{% endcomment %}

<link rel="stylesheet" href="{{ 'component-article-card.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'section-featured-blog.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>{{ 'component-article-card.css' | asset_url | stylesheet_tag }}</noscript>
{{ 'section-featured-blog.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Visibility */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }}.sc-visibility--mobile-hidden { display: none !important; }
  }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }}.sc-visibility--desktop-hidden { display: none !important; }
  }

  /* Section ID badge (replacement for Shrine's <copy-button>) */
  #shopify-section-{{ section.id }} .sc-section-id-badge {
    display: inline-block;
    margin: 0 1rem 1rem;
    padding: 4px 10px;
    font-size: 12px;
    font-family: monospace;
    background: rgba(0,0,0,0.08);
    border-radius: 4px;
    cursor: copy;
    user-select: all;
  }

  /* Section heading */
  #shopify-section-{{ section.id }} .blog__title {
    font-size: 20px;
  }
  #shopify-section-{{ section.id }} .title-wrapper-with-link {
    justify-content: center;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .title-wrapper-with-link .blog__title {
    width: 100%;
    text-align: center;
  }

  /* Card wrapper */
  #shopify-section-{{ section.id }} .blog__post.slider__slide {
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .article-card-wrapper {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* Slide gap */
  #shopify-section-{{ section.id }} .slider {
    gap: {{ section.settings.card_gap }}px;
  }
  #shopify-section-{{ section.id }} .slider.grid--peek {
    column-gap: {{ section.settings.card_gap }}px;
  }
  #shopify-section-{{ section.id }} .slider .slider__slide {
    margin-right: 0;
  }

  /* Force correct slide widths on desktop (Dawn's grid classes cap below 4) */
  @media screen and (min-width: 990px) {
    {%- assign _gap_total = section.settings.columns_desktop | minus: 1 | times: section.settings.card_gap -%}
    #shopify-section-{{ section.id }} .slider .slider__slide {
      width: calc((100% - {{ _gap_total }}px) / {{ section.settings.columns_desktop }}) !important;
      max-width: calc((100% - {{ _gap_total }}px) / {{ section.settings.columns_desktop }}) !important;
      min-width: 0 !important;
      flex-shrink: 0;
    }
  }

  /* Card base */
  #shopify-section-{{ section.id }} .static-card {
    background: {{ section.settings.card_bg_color }};
    border-radius: {{ section.settings.card_border_radius }}px;
    overflow: hidden;
    min-height: {{ section.settings.card_height }}px;
    display: flex;
    flex-direction: column;
    padding: 10px;
    {% if section.settings.card_show_border %}
      border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    {% endif %}
    {% if section.settings.card_show_shadow %}
      box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    {% endif %}
  }

  /* Image wrapper */
  #shopify-section-{{ section.id }} .static-card__image-wrapper {
    width: 100%;
    overflow: hidden;
    flex-shrink: 0;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    border-radius: 12px !important;
  }

  #shopify-section-{{ section.id }} .static-card__image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .static-card__image-placeholder {
    width: 100%;
    height: 100%;
    background: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .static-card__image-placeholder svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  /* Card content */
  #shopify-section-{{ section.id }} .static-card__content {
    padding: 0px !important;
    margin-top: {{ section.settings.card_content_gap }}px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: {{ section.settings.card_content_gap }}px;
    overflow: hidden;
  }

  /* Eyebrow */
  #shopify-section-{{ section.id }} .static-card__eyebrow {
    font-size: {{ section.settings.eyebrow_font_size }}px;
    font-weight: {{ section.settings.eyebrow_font_weight }};
    color: {{ section.settings.eyebrow_color }};
    text-transform: {{ section.settings.eyebrow_text_transform }};
    letter-spacing: 0.05em;
    margin: 0;
    text-align: center;
    flex-shrink: 0;
  }

  /* Title */
  #shopify-section-{{ section.id }} .static-card__title {
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: {{ section.settings.title_font_weight }};
    color: {{ section.settings.title_color }};
    margin: 0;
    line-height: 1.3;
    text-align: center;
    flex-shrink: 0;
  }

  /* Body text */
  #shopify-section-{{ section.id }} .static-card__text {
    font-size: {{ section.settings.text_font_size }}px;
    color: {{ section.settings.text_color }};
    margin: 0;
    line-height: 1.6;
    text-align: center;
    flex: 1;
    overflow-y: auto;
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .slider__slide {
      width: calc(100% / {{ section.settings.columns_mobile }}) !important;
      max-width: calc(100% / {{ section.settings.columns_mobile }}) !important;
    }
    #shopify-section-{{ section.id }} .static-card__image-wrapper {
      aspect-ratio: 1 / 1 !important;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .slider-mobile-gutter {
      position: relative;
    }
    #shopify-section-{{ section.id }} .slider-buttons {
      position: absolute;
      top: {{ section.settings.card_height | divided_by: 2 }}px;
      left: 0;
      right: 0;
      transform: translateY(-50%);
      display: flex;
      align-items: center;
      justify-content: space-between;
      pointer-events: none;
      padding: 0 0.8rem;
      z-index: 2;
    }
    #shopify-section-{{ section.id }} .slider-buttons .slider-button {
      pointer-events: auto;
      opacity: {{ section.settings.chevron_opacity | divided_by: 100.0 }};
      background: rgba({{ section.settings.chevron_bg_color | color_extract: 'red' }}, {{ section.settings.chevron_bg_color | color_extract: 'green' }}, {{ section.settings.chevron_bg_color | color_extract: 'blue' }}, {{ section.settings.chevron_bg_opacity | divided_by: 100.0 }});
      border-radius: {{ section.settings.chevron_border_radius }}px;
      width: {{ section.settings.chevron_size }}px;
      height: {{ section.settings.chevron_size }}px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: {{ section.settings.chevron_icon_color }};
    }
    #shopify-section-{{ section.id }} .slider-buttons .slider-counter {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .slider-buttons {
      display: none;
    }
  }

  #shopify-section-{{ section.id }} .static-card__text--collapsed {
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}
#shopify-section-{{ section.id }} .static-card__text--expanded {
  overflow: visible;
  display: block;
  -webkit-line-clamp: unset;
}
#shopify-section-{{ section.id }} .static-card__text-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
#shopify-section-{{ section.id }} .static-card__read-more {
  background: none;
  border: none;
  padding: 4px 0 0;
  font-size: {{ section.settings.text_font_size }}px;
  color: {{ section.settings.eyebrow_color }};
  cursor: pointer;
  text-decoration: underline;
  text-align: center;
  flex-shrink: 0;
}
{%- endstyle -%}

<div class="blog color-{{ section.settings.color_scheme }} gradient{% if section.settings.title == blank %} no-heading{% endif %} sc-visibility--{{ section.settings.visibility }}">
  {% if section.settings.display_id %}
    <span class="sc-section-id-badge" title="Click to copy">#shopify-section-{{ section.id }}</span>
  {% endif %}

  <div class="page-width isolate section-{{ section.id }}-padding">
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link{% if section.blocks.size > 2 %} title-wrapper--self-padded-tablet-down{% else %} title-wrapper--self-padded-mobile{% endif %} title-wrapper--no-top-margin">
        <h2 class="blog__title {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
      </div>
    {%- endunless -%}

    {%- if section.blocks.size > 0 -%}
      <slider-component class="slider-mobile-gutter">
        <ul
          id="Slider-{{ section.id }}"
          class="blog__posts articles-wrapper contains-card grid grid--peek grid--2-col-tablet grid--{{ section.settings.columns_desktop }}-col-desktop slider {% if section.blocks.size > 2 %}slider--tablet{% else %}slider--mobile{% endif %}"
          role="list"
        >
          {%- for block in section.blocks -%}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="blog__post grid__item article slider__slide slider__slide--full-width"
              {{ block.shopify_attributes }}
            >
              <div class="article-card-wrapper">
                <div class="static-card">
                  {%- if section.settings.show_image -%}
                    <div class="static-card__image-wrapper">
                      {%- if block.settings.image != blank -%}
                        {{
                          block.settings.image
                          | image_url: width: 800
                          | image_tag: loading: 'lazy', alt: block.settings.title
                        }}
                      {%- else -%}
                        <div class="static-card__image-placeholder">
                          {{ 'image' | placeholder_svg_tag }}
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  <div class="static-card__content">
                    {%- if block.settings.eyebrow != blank -%}
                      <p class="static-card__eyebrow">{{ block.settings.eyebrow }}</p>
                    {%- endif -%}
                    {%- if block.settings.title != blank -%}
                      <h3 class="static-card__title">{{ block.settings.title }}</h3>
                    {%- endif -%}

                     {% comment %}
                    {%- if block.settings.text != blank -%}
                      <div class="static-card__text rte">{{ block.settings.text }}</div>
                    {%- endif -%}
                    {% endcomment %}

                      {%- if block.settings.text != blank -%}
  <div class="static-card__text-wrap">
    <div class="static-card__text rte static-card__text--collapsed">{{ block.settings.text }}</div>
    <button class="static-card__read-more" type="button">Read more</button>
  </div>
{%- endif -%}
                  </div>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- assign _cols_desktop = section.settings.columns_desktop | plus: 0 -%}

        {% comment %}
        {%- if section.blocks.size > _cols_desktop -%}
          <div class="slider-buttons no-js-hidden">
            <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}">
              <svg viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon icon-caret" aria-hidden="true" focusable="false">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"></path>
              </svg>
            </button>
            <div class="slider-counter caption">
              <span class="slider-counter--current">1</span>
              <span aria-hidden="true"> / </span>
              <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
              <span class="slider-counter--total">{{ section.blocks.size }}</span>
            </div>
            <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">
              <svg viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon icon-caret" aria-hidden="true" focusable="false">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor"></path>
              </svg>
            </button>
          </div>
        {%- endif -%}
        {% endcomment %}


        {%- assign _cols_desktop = section.settings.columns_desktop | plus: 0 -%}

  <div class="slider-buttons no-js-hidden">
    <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}">
      <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
    </button>
    <div class="slider-counter caption">
      <span class="slider-counter--current">1</span>
      <span aria-hidden="true"> / </span>
      <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
      <span class="slider-counter--total">{{ section.blocks.size }}</span>
    </div>
    <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">
      <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
    </button>
  </div>



      </slider-component>
    {%- else -%}
      <div class="blog-placeholder">
        <div class="placeholder media media--landscape">
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
        <div class="blog-placeholder__content">
          <h2>Add your first card</h2>
          <p class="rte-width">Click "Add block" in the theme editor to add cards to this section.</p>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  document.querySelectorAll('#shopify-section-{{ section.id }} .static-card__read-more').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var text = btn.previousElementSibling;
    var card = btn.closest('.static-card');
    var isCollapsed = text.classList.contains('static-card__text--collapsed');
    if (isCollapsed) {
      text.classList.remove('static-card__text--collapsed');
      text.classList.add('static-card__text--expanded');
      btn.textContent = 'Read less';
      card.style.height = 'auto';
    } else {
      text.classList.remove('static-card__text--expanded');
      text.classList.add('static-card__text--collapsed');
      btn.textContent = 'Read more';
      card.style.minHeight = '{{ section.settings.card_height }}px';
      card.style.height = '';
    }
  });
});
</script>

{% schema %}
{
  "name": "Static cards",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "display_id",
      "label": "Display section ID",
      "default": false
    },
    {
      "type": "select",
      "id": "visibility",
      "options": [
        { "value": "desktop-hidden", "label": "Mobile only" },
        { "value": "mobile-hidden", "label": "Desktop only" },
        { "value": "always-display", "label": "All devices" }
      ],
      "label": "Display on",
      "default": "always-display"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Our highlights",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h3", "label": "Extra small" },
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background-1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns on desktop"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "default": 1,
      "label": "Columns on mobile",
      "info": "Use decimals (e.g. 1.2) to show a peek of the next card."
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Gap between cards",
      "default": 16
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "Show images"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "3 / 2", "label": "Photo (3:2)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" }
      ],
      "default": "16 / 9"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "range",
      "id": "card_height",
      "min": 200,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Card height",
      "default": 500
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_content_gap",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Content gap",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "card_show_border",
      "label": "Show border",
      "default": false
    },
    {
      "type": "range",
      "id": "card_border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Border width",
      "default": 1
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Border color",
      "default": "#e0e0e0"
    },
    {
      "type": "checkbox",
      "id": "card_show_shadow",
      "label": "Show drop shadow",
      "default": true
    },
    { "type": "header", "content": "Mobile chevrons" },
    { "type": "range", "id": "chevron_size", "label": "Button size (px)", "min": 24, "max": 60, "step": 2, "default": 36 },
    { "type": "range", "id": "chevron_opacity", "label": "Opacity (%)", "min": 10, "max": 100, "step": 5, "default": 50 },
    { "type": "color", "id": "chevron_bg_color", "label": "Background color", "default": "#ffffff" },
    { "type": "range", "id": "chevron_bg_opacity", "label": "Background opacity (%)", "min": 0, "max": 100, "step": 5, "default": 80 },
    { "type": "color", "id": "chevron_icon_color", "label": "Icon color", "default": "#121212" },
    { "type": "range", "id": "chevron_border_radius", "label": "Border radius (px)", "min": 0, "max": 30, "step": 2, "default": 18 },
    {
      "type": "header",
      "content": "Eyebrow typography"
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 12
    },
    {
      "type": "select",
      "id": "eyebrow_font_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Color",
      "default": "#888888"
    },
    {
      "type": "select",
      "id": "eyebrow_text_transform",
      "label": "Text transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "uppercase"
    },
    {
      "type": "header",
      "content": "Title typography"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 20
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Body text typography"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color",
      "default": "#4a4a4a"
    },
