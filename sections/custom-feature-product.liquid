{% comment %}
  Custom Feature Product Section
  Category: Template
  Two-column: product gallery left, content blocks right
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign selected_product = section.settings.product
  assign overlay_dir = section.settings.overlay_direction
  assign image_col = section.settings.image_column
  assign hide_image = section.settings.hide_image
  if selected_product != blank and selected_product.images.size == 0
    assign hide_image = true
  endif
-%}

<style>
  /* ── Section ── */
  .cfp-section-{{ sid }} {
    position: relative;
    background-color: {{ section.settings.background_color }};
    {% if section.settings.background_image != blank %}
    background-image: url('{{ section.settings.background_image | image_url: width: 1800 }}');
    background-size: {{ section.settings.bg_size }};
    background-position: {{ section.settings.bg_position }};
    background-repeat: no-repeat;
    {% endif %}
    overflow: clip; /* was hidden — hidden on this ancestor killed sticky content */
  }

  /* ── Overlay ── */
  .cfp-overlay-{{ sid }} {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    {%- assign oc = section.settings.overlay_color -%}
    {%- assign oo = section.settings.overlay_opacity | times: 0.01 -%}
    {%- if overlay_dir == 'left' -%}
      background: linear-gradient(to right, {{ oc }}, transparent); opacity: {{ oo }};
    {%- elsif overlay_dir == 'right' -%}
      background: linear-gradient(to left, {{ oc }}, transparent); opacity: {{ oo }};
    {%- elsif overlay_dir == 'top' -%}
      background: linear-gradient(to bottom, {{ oc }}, transparent); opacity: {{ oo }};
    {%- elsif overlay_dir == 'bottom' -%}
      background: linear-gradient(to top, {{ oc }}, transparent); opacity: {{ oo }};
    {%- elsif overlay_dir == 'full' -%}
      background: {{ oc }}; opacity: {{ oo }};
    {%- endif -%}
  }

  /* ── Page-width wrapper ── */
  .cfp-page-width-{{ sid }} {
    max-width: var(--page-width, 1200px);
    margin-left: auto;
    margin-right: auto;
    padding-left: {{ section.settings.section_padding_x_mobile }}px;
    padding-right: {{ section.settings.section_padding_x_mobile }}px;
    padding-top: {{ section.settings.section_padding_y_mobile }}px;
    padding-bottom: {{ section.settings.section_padding_y_mobile }}px;
  }

  @media (min-width: 768px) {
    .cfp-page-width-{{ sid }} {
      padding-left: {{ section.settings.section_padding_x_desktop }}px;
      padding-right: {{ section.settings.section_padding_x_desktop }}px;
      padding-top: {{ section.settings.section_padding_y_desktop }}px;
      padding-bottom: {{ section.settings.section_padding_y_desktop }}px;
    }
  }

  /* ── Grid ── */
  .cfp-grid-{{ sid }} {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .cfp-grid-{{ sid }} {
      grid-template-columns: {% if hide_image %}1fr{% else %}{{ section.settings.col_image_width }}fr {{ section.settings.col_content_width }}fr{% endif %};
      min-height: {{ section.settings.min_height_desktop }}px;
      align-items: start;
    }
  }

  /* Mobile ordering */
  @media (max-width: 767px) {
    .cfp-image-side-{{ sid }}  { order: {{ section.settings.gallery_order_mobile }}; }
    .cfp-content-side-{{ sid }} { order: {{ section.settings.content_order_mobile }}; }
  }

  /* ── Sticky content ── */
  @media (min-width: 768px) {
    .cfp-sticky-{{ sid }} {
      position: sticky;
      top: {{ section.settings.sticky_top_offset }}px;
    }
  }

  /* ── Gallery column ── */
  .cfp-image-side-{{ sid }} {
    padding: {{ section.settings.gallery_padding_mobile }}px;
  }

  @media (min-width: 768px) {
    .cfp-image-side-{{ sid }} {
      padding: {{ section.settings.gallery_padding_desktop }}px;
    }
  }

  /* ── Main image (desktop) ── */
  .cfp-main-img-wrap-{{ sid }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.img_radius }}px;
    background-color: {{ section.settings.img_bg_color }};
    aspect-ratio: {{ section.settings.img_ratio }};
  }

  .cfp-main-img-wrap-{{ sid }} img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.img_fit }};
    object-position: center;
    display: block;
    transition: opacity 0.3s;
  }

  /* ── Thumbnails (desktop) ── */
  .cfp-thumbs-{{ sid }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin-top: {{ section.settings.thumb_margin_top }}px;
  }

  .cfp-thumbs-track-{{ sid }} {
    display: flex;
    gap: {{ section.settings.thumb_gap }}px;
    overflow: hidden;
    scroll-behavior: smooth;
    max-width: 100%;
    padding: 2px;
  }

  .cfp-thumb-{{ sid }} {
    width: {{ section.settings.thumb_size }}px;
    height: {{ section.settings.thumb_size }}px;
    border-radius: {{ section.settings.thumb_radius }}px;
    overflow: hidden;
    cursor: pointer;
    border: {{ section.settings.thumb_border_width }}px solid transparent;
    transition: border-color 0.2s;
    flex-shrink: 0;
    background-color: {{ section.settings.img_bg_color }};
  }

  .cfp-thumb-{{ sid }}.is-active {
    border-color: {{ section.settings.thumb_active_color }};
  }

  .cfp-thumb-{{ sid }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cfp-thumb-arrow-{{ sid }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #333;
    flex-shrink: 0;
    opacity: 0.6;
    transition: opacity 0.2s;
  }
  .cfp-thumb-arrow-{{ sid }}:hover { opacity: 1; }
  .cfp-thumb-arrow-{{ sid }}.hidden { visibility: hidden; }

  /* ── Mobile swiper ── */
  .cfp-swiper-{{ sid }} {
  position: relative;
  overflow: hidden;
  touch-action: pan-y;
  border-radius: 0;
  aspect-ratio: {{ section.settings.img_ratio }};
  background-color: {{ section.settings.img_bg_color }};
  width: 100%;
  max-width: 100%;
}

.cfp-swiper-track-{{ sid }} {
  display: flex;
  height: 100%;
  transition: transform 0.35s ease;
  will-change: transform;
}

.cfp-swiper-slide-{{ sid }} {
  flex: 0 0 100%;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

  .cfp-swiper-slide-{{ sid }} img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.img_fit }};
    object-position: center;
    display: block;
  }

  .cfp-dots-{{ sid }} {
  position: absolute;
  bottom: 12px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 6px;
  z-index: 2;
}

.cfp-dot-{{ sid }} {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #999999;
  border: none;
  padding: 0;
  cursor: pointer;
  transition: background 0.2s;
  margin-right: 3px;
  margin-left: 3px;
}

.cfp-dot-{{ sid }}.is-active {
  background: #121212;
}

  /* ── Show/hide desktop vs mobile gallery ── */
  .cfp-gallery-desktop-{{ sid }} { display: none; }
  .cfp-gallery-mobile-{{ sid }}  { display: block; }

  @media (min-width: 768px) {
    .cfp-gallery-desktop-{{ sid }} { display: block; }
    .cfp-gallery-mobile-{{ sid }}  { display: none; }
  }

  /* ── Mobile: remove gallery padding so image is edge-to-edge ── */
  @media (max-width: 767px) {
    .cfp-image-side-{{ sid }} {
      padding: 0 !important;
    }
  }

  /* ── Content column ── */
  .cfp-content-side-{{ sid }} {
    padding-top: {{ section.settings.content_padding_top_mobile }}px;
    padding-bottom: {{ section.settings.content_padding_bottom_mobile }}px;
    padding-left: {{ section.settings.content_padding_x_mobile }}px;
    padding-right: {{ section.settings.content_padding_x_mobile }}px;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 768px) {
    .cfp-content-side-{{ sid }} {
      padding-top: {{ section.settings.content_padding_top_desktop }}px;
      padding-bottom: {{ section.settings.content_padding_bottom_desktop }}px;
      padding-left: {{ section.settings.content_padding_x_desktop }}px;
      padding-right: {{ section.settings.content_padding_x_desktop }}px;
    }
  }

  .cfp-content-inner-{{ sid }} {
    max-width: {{ section.settings.content_max_width }}px;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 767px) {
    .cfp-content-inner-{{ sid }} {
      max-width: 100%;
    }
  }

  /* ── Star rating block ── */
  .cfp-stars-{{ sid }} {
    display: flex;
    align-items: center;
    gap: {{ section.settings.star_item_gap }}px;
    margin-bottom: {{ section.settings.stars_margin_bottom }}px;
    flex-wrap: wrap;
  }

  .cfp-stars-row-{{ sid }} {
    display: flex;
    align-items: center;
    gap: {{ section.settings.star_gap }}px;
  }

  .cfp-stars-row-{{ sid }} svg {
    width: {{ section.settings.star_size_mobile }}px;
    height: {{ section.settings.star_size_mobile }}px;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .cfp-stars-row-{{ sid }} svg {
      width: {{ section.settings.star_size_desktop }}px;
      height: {{ section.settings.star_size_desktop }}px;
    }
  }

  .cfp-stars-meta-{{ sid }} {
    font-family: {{ section.settings.stars_meta_font.family }}, {{ section.settings.stars_meta_font.fallback_families }};
    font-size: {{ section.settings.stars_meta_size }}px;
    color: {{ section.settings.stars_meta_color }};
    margin: 0;
    line-height: 1.3;
  }

  .cfp-stars-meta-{{ sid }} strong {
    font-weight: {{ section.settings.stars_meta_bold_weight }};
    color: {{ section.settings.stars_meta_bold_color }};
  }

  /* ── Product title block ── */
  .cfp-title-{{ sid }} {
    margin-bottom: {{ section.settings.title_margin_bottom }}px;
  }

  .cfp-title-{{ sid }} .cfp-title-tag {
    font-family: {{ section.settings.title_font.family }}, {{ section.settings.title_font.fallback_families }};
    font-weight: {{ section.settings.title_font_weight }};
    font-size: {{ section.settings.title_size_mobile }}px;
    color: {{ section.settings.title_color }};
    letter-spacing: {{ section.settings.title_letter_spacing }}px;
    line-height: {{ section.settings.title_line_height | times: 0.1 | plus: 1.0 }};
    margin: 0;
  }

  @media (min-width: 768px) {
    .cfp-title-{{ sid }} .cfp-title-tag {
      font-size: {{ section.settings.title_size_desktop }}px;
    }
  }

  /* ── Product subtitle ── */
  .cfp-subtitle-{{ sid }} {
    margin-bottom: {{ section.settings.subtitle_margin_bottom }}px;
  }

  .cfp-subtitle-{{ sid }} p {
    font-family: {{ section.settings.subtitle_font.family }}, {{ section.settings.subtitle_font.fallback_families }};
    font-weight: {{ section.settings.subtitle_font_weight }};
    font-size: {{ section.settings.subtitle_size_mobile }}px;
    color: {{ section.settings.subtitle_color }};
    letter-spacing: {{ section.settings.subtitle_letter_spacing }}px;
    margin: 0;
    line-height: 1.4;
  }

  @media (min-width: 768px) {
    .cfp-subtitle-{{ sid }} p {
      font-size: {{ section.settings.subtitle_size_desktop }}px;
    }
  }

  /* ── Product description ── */
  .cfp-description-{{ sid }} {
    margin-bottom: {{ section.settings.description_margin_bottom }}px;
  }

  .cfp-description-{{ sid }} p,
  .cfp-description-{{ sid }} .cfp-desc-text {
    font-family: {{ section.settings.description_font.family }}, {{ section.settings.description_font.fallback_families }};
    font-weight: {{ section.settings.description_font_weight }};
    font-size: {{ section.settings.description_size_mobile }}px;
    color: {{ section.settings.description_color }};
    letter-spacing: {{ section.settings.description_letter_spacing }}px;
    line-height: {{ section.settings.description_line_height | times: 0.1 | plus: 1.0 }};
    margin: 0;
  }

  @media (min-width: 768px) {
    .cfp-description-{{ sid }} p,
    .cfp-description-{{ sid }} .cfp-desc-text {
      font-size: {{ section.settings.description_size_desktop }}px;
    }
  }

  .cfp-description-{{ sid }} strong {
    font-weight: {{ section.settings.description_bold_weight }};
    color: {{ section.settings.description_bold_color }};
  }

  /* ── CTA ── */
  .cfp-cta-{{ sid }} {
    margin-bottom: {{ section.settings.cta_margin_bottom }}px;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.cta_gap }}px;
  }

  .cfp-btn-{{ sid }} {
    display: block;
    width: 100%;
    text-align: center;
    text-decoration: none;
    font-family: {{ section.settings.btn_font.family }}, {{ section.settings.btn_font.fallback_families }};
    font-weight: {{ section.settings.btn_font_weight }};
    font-size: {{ section.settings.btn_size_mobile }}px;
    color: {{ section.settings.btn_text_color }};
    background-color: {{ section.settings.btn_bg_color }};
    border: {{ section.settings.btn_border_width }}px solid {{ section.settings.btn_border_color }};
    border-radius: {{ section.settings.btn_radius }}px;
    padding: {{ section.settings.btn_padding_v }}px {{ section.settings.btn_padding_h }}px;
    letter-spacing: {{ section.settings.btn_letter_spacing }}px;
    text-transform: {{ section.settings.btn_transform }};
    transition: opacity 0.2s;
    cursor: pointer;
  }

  .cfp-btn-{{ sid }}:hover { opacity: 0.88; }

  @media (min-width: 768px) {
    .cfp-btn-{{ sid }} { font-size: {{ section.settings.btn_size_desktop }}px; }
  }

  .cfp-guarantee-{{ sid }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-family: {{ section.settings.guarantee_font.family }}, {{ section.settings.guarantee_font.fallback_families }};
    font-weight: {{ section.settings.guarantee_font_weight }};
    font-size: {{ section.settings.guarantee_size }}px;
    color: {{ section.settings.guarantee_color }};
    margin: 0;
  }

  .cfp-guarantee-{{ sid }} svg {
    width: {{ section.settings.guarantee_icon_size }}px;
    height: {{ section.settings.guarantee_icon_size }}px;
    stroke: {{ section.settings.guarantee_color }};
    fill: none;
    flex-shrink: 0;
  }

  product-form,
product-form .form,
.product-form__buttons,
.product-form__submit {
  width: 100% !important;
  max-width: 100% !important;
}
</style>

<div class="cfp-section-{{ sid }}">
  {% if overlay_dir != 'none' %}
    <div class="cfp-overlay-{{ sid }}"></div>
  {% endif %}

  <div class="cfp-page-width-{{ sid }}">
    <div class="cfp-grid-{{ sid }}">

      {%- unless hide_image -%}
      {%- comment -%} ── Gallery Column ── {%- endcomment -%}
      {%- if image_col == 'left' -%}
      <div class="cfp-image-side-{{ sid }}">
      {%- else -%}
      <div class="cfp-image-side-{{ sid }}" style="order: 2;">
      {%- endif -%}

        {%- if selected_product != blank -%}
          {%- assign product_images = selected_product.images -%}
          {%- assign first_image = product_images | first -%}

          {% comment %} {{-- DESKTOP gallery --}} {% endcomment %}
          <div class="cfp-gallery-desktop-{{ sid }}">
            <div class="cfp-main-img-wrap-{{ sid }}">
              {%- if first_image != blank -%}
                <img id="cfp-main-img-el-{{ sid }}"
                     src="{{ first_image | image_url: width: 1200 }}"
                     alt="{{ first_image.alt | escape | default: selected_product.title }}"
                     loading="eager" width="1200" height="1200" fetchpriority="high">
              {%- endif -%}
            </div>

            {%- if product_images.size > 1 -%}
              <div class="cfp-thumbs-{{ sid }}">
                <button class="cfp-thumb-arrow-{{ sid }} hidden" id="cfp-arr-prev-{{ sid }}" aria-label="Previous">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                </button>
                <div class="cfp-thumbs-track-{{ sid }}" id="cfp-thumbs-track-{{ sid }}">
                  {%- for img in product_images -%}
                    <div class="cfp-thumb-{{ sid }}{% if forloop.first %} is-active{% endif %}"
     data-src="{{ img | image_url: width: 1200 }}"
     data-alt="{{ img.alt | escape | default: selected_product.title }}">
                      <img src="{{ img | image_url: width: 200 }}"
                           alt="{{ img.alt | escape | default: selected_product.title }}"
                           loading="lazy" width="200" height="200">
                    </div>
                  {%- endfor -%}
                </div>
                <button class="cfp-thumb-arrow-{{ sid }}" id="cfp-arr-next-{{ sid }}" aria-label="Next">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
              </div>
            {%- endif -%}
          </div>

          {% comment %} {{-- MOBILE gallery --}} {% endcomment %}
          <div class="cfp-gallery-mobile-{{ sid }}">
            <div class="cfp-swiper-{{ sid }}" id="cfp-swiper-{{ sid }}">
              <div class="cfp-swiper-track-{{ sid }}" id="cfp-swiper-track-{{ sid }}">
                {%- for img in product_images -%}
                  <div class="cfp-swiper-slide-{{ sid }}">
                    <img src="{{ img | image_url: width: 800 }}"
                        alt="{{ img.alt | escape | default: selected_product.title }}"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                        {% if forloop.first %}fetchpriority="high"{% endif %}
                        width="800" height="800">
                  </div>
                {%- endfor -%}
              </div>

              {%- if product_images.size > 1 -%}
                <div class="cfp-dots-{{ sid }}" id="cfp-dots-{{ sid }}">
                  {%- for img in product_images -%}
                    <button class="cfp-dot-{{ sid }}{% if forloop.first %} is-active{% endif %}"
                            data-index="{{ forloop.index0 }}"
                            aria-label="Image {{ forloop.index }}"></button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          </div>


        {%- elsif section.settings.fallback_image != blank -%}
          <div class="cfp-gallery-desktop-{{ sid }}">
            <div class="cfp-main-img-wrap-{{ sid }}">
              <img src="{{ section.settings.fallback_image | image_url: width: 1200 }}"
                   alt="{{ section.settings.fallback_image.alt | escape }}"
                   loading="eager" width="1200" height="1200">
            </div>
          </div>
          <div class="cfp-gallery-mobile-{{ sid }}">
            <div class="cfp-swiper-{{ sid }}">
              <div class="cfp-swiper-track-{{ sid }}">
                <div class="cfp-swiper-slide-{{ sid }}">
                  <img src="{{ section.settings.fallback_image | image_url: width: 800 }}"
                       alt="{{ section.settings.fallback_image.alt | escape }}"
                       loading="eager" width="800" height="800">
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}

      </div>
      {%- endunless -%}

      {%- comment -%} ── Content Column ── {%- endcomment -%}
      {%- if section.settings.enable_sticky_info -%}{%- assign cfp_sticky_class = ' cfp-sticky-' | append: sid -%}{%- else -%}{%- assign cfp_sticky_class = '' -%}{%- endif -%}
      {%- if image_col == 'left' -%}
      <div class="cfp-content-side-{{ sid }}{{ cfp_sticky_class }}">
      {%- else -%}
      <div class="cfp-content-side-{{ sid }}{{ cfp_sticky_class }}" style="order: 1;">
      {%- endif -%}
        <div class="cfp-content-inner-{{ sid }}">

          {%- for block in section.blocks -%}

            {%- if block.type == 'star_rating' -%}
              {%- assign rating = block.settings.rating -%}
              {%- assign filled = rating | round -%}
              <div class="cfp-stars-{{ sid }}" {{ block.shopify_attributes }}>
                <div class="cfp-stars-row-{{ sid }}">
                  {%- for i in (1..5) -%}
                    {%- if i <= filled -%}
                      <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="{{ section.settings.star_color_filled }}" stroke="none"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="{{ section.settings.star_color_empty }}" stroke="none"/></svg>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                {%- if block.settings.meta_text != blank -%}
                  <p class="cfp-stars-meta-{{ sid }}">{{ block.settings.meta_text }}</p>
                {%- endif -%}
              </div>

            {%- elsif block.type == 'product_title' -%}
              <div class="cfp-title-{{ sid }}" {{ block.shopify_attributes }}>
                {%- if block.settings.use_dynamic and selected_product != blank -%}
                  <{{ block.settings.heading_tag }} class="cfp-title-tag">{{ selected_product.title }}</{{ block.settings.heading_tag }}>
                {%- elsif block.settings.custom_title != blank -%}
                  <{{ block.settings.heading_tag }} class="cfp-title-tag">{{ block.settings.custom_title | escape }}</{{ block.settings.heading_tag }}>
                {%- elsif selected_product != blank -%}
                  <{{ block.settings.heading_tag }} class="cfp-title-tag">{{ selected_product.title }}</{{ block.settings.heading_tag }}>
                {%- endif -%}
              </div>

            {%- elsif block.type == 'product_subtitle' -%}
              <div class="cfp-subtitle-{{ sid }}" {{ block.shopify_attributes }}>
                {%- if block.settings.use_dynamic and selected_product != blank -%}
                  <p>{{ selected_product.metafields.custom.subtitle | default: selected_product.vendor }}</p>
                {%- else -%}
                  <p>{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </div>

            {%- elsif block.type == 'product_description' -%}
              <div class="cfp-description-{{ sid }}" {{ block.shopify_attributes }}>
                {%- if block.settings.use_dynamic and selected_product != blank -%}
                  <div class="cfp-desc-text">{{ selected_product.description }}</div>
                {%- else -%}
                  <p>{{ block.settings.custom_text }}</p>
                {%- endif -%}
              </div>

            {%- elsif block.type == 'cta' -%}
              <div class="cfp-cta-{{ sid }}" {{ block.shopify_attributes }}>
                {%- if block.settings.btn_label != blank -%}
                  {%- assign btn_url = block.settings.btn_url -%}
                  {%- if block.settings.use_product_url and selected_product != blank -%}
                    {%- assign btn_url = selected_product.url -%}
                  {%- endif -%}
                  <a href="{{ btn_url | default: '#' }}" class="cfp-btn-{{ sid }}">
                    {{ block.settings.btn_label | escape }}
                  </a>
                {%- endif -%}
                {%- if block.settings.guarantee_text != blank -%}
