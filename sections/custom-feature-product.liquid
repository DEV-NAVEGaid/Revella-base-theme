                      {%- endcase -%}
                    {%- endif -%}
                    {{ block.settings.guarantee_text | escape }}
                  </p>
                {%- endif -%}
              </div>

            {%- endif -%}

          {%- endfor -%}

        </div>
      </div>

    </div>
  </div>
</div>

<script>
(function() {
  var sid = '{{ sid }}';

  function cfpInit() {

    // ── DESKTOP: thumbnail click ──
    var thumbsTrack = document.getElementById('cfp-thumbs-track-' + sid);
    if (thumbsTrack) {
      thumbsTrack.addEventListener('click', function(e) {
        var thumb = e.target.closest('[data-src]');
        if (!thumb) return;
        var mainImg = document.getElementById('cfp-main-img-el-' + sid);
        if (!mainImg) return;
        mainImg.style.opacity = '0.5';
        mainImg.src = thumb.dataset.src;
        mainImg.alt = thumb.dataset.alt || '';
        mainImg.onload = function() { mainImg.style.opacity = '1'; };
        thumbsTrack.querySelectorAll('[data-src]').forEach(function(t) {
          t.classList.remove('is-active');
        });
        thumb.classList.add('is-active');
      });
    }

    // ── DESKTOP: arrows ──
    var track = document.getElementById('cfp-thumbs-track-' + sid);
    var prev  = document.getElementById('cfp-arr-prev-' + sid);
    var next  = document.getElementById('cfp-arr-next-' + sid);

    function updateArrows() {
      if (!track || !prev || !next) return;
      prev.classList.toggle('hidden', track.scrollLeft <= 2);
      next.classList.toggle('hidden', track.scrollLeft + track.clientWidth >= track.scrollWidth - 2);
    }

    if (prev) prev.addEventListener('click', function() {
      track.scrollLeft -= {{ section.settings.thumb_size | plus: section.settings.thumb_gap | times: 2 }};
      setTimeout(updateArrows, 350);
    });
    if (next) next.addEventListener('click', function() {
      track.scrollLeft += {{ section.settings.thumb_size | plus: section.settings.thumb_gap | times: 2 }};
      setTimeout(updateArrows, 350);
    });
    if (track) {
      track.addEventListener('scroll', updateArrows);
      updateArrows();
    }

    // ── MOBILE: swiper ──
    var swiperEl = document.getElementById('cfp-swiper-' + sid);
    var trackEl  = document.getElementById('cfp-swiper-track-' + sid);
    var dotsEl   = document.getElementById('cfp-dots-' + sid);
    var current  = 0;
    var slides   = trackEl ? trackEl.querySelectorAll('.cfp-swiper-slide-' + sid) : [];
    var total    = slides.length;

    function getSlideWidth() {
      return swiperEl ? swiperEl.offsetWidth : 0;
    }

    function gotoSlide(idx) {
  if (!trackEl) return;
  current = idx;
  trackEl.style.transform = 'translateX(-' + (idx * 100) + '%)';
  if (dotsEl) {
    dotsEl.querySelectorAll('[data-index]').forEach(function(d) {
      d.classList.toggle('is-active', parseInt(d.dataset.index) === idx);
    });
  }
}

    // recalc on resize (orientation change)
    window.addEventListener('resize', function() {
      gotoSlide(current);
    });

    if (dotsEl) {
      dotsEl.addEventListener('click', function(e) {
        var dot = e.target.closest('[data-index]');
        if (!dot) return;
        gotoSlide(parseInt(dot.dataset.index, 10));
      });
    }

    if (swiperEl && total > 1) {
      var startX = 0, startY = 0, isHoriz = null, dragging = false;

      swiperEl.addEventListener('touchstart', function(e) {
        startX   = e.touches[0].clientX;
        startY   = e.touches[0].clientY;
        isHoriz  = null;
        dragging = true;
      }, { passive: true });

      swiperEl.addEventListener('touchmove', function(e) {
        if (!dragging) return;
        var dx = e.touches[0].clientX - startX;
        var dy = e.touches[0].clientY - startY;
        if (isHoriz === null && (Math.abs(dx) > 5 || Math.abs(dy) > 5)) {
          isHoriz = Math.abs(dx) > Math.abs(dy);
        }
        if (isHoriz) e.preventDefault();
      }, { passive: false });

      swiperEl.addEventListener('touchend', function(e) {
        if (!dragging || !isHoriz) return;
        dragging = false;
        var dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) < 40) return;
        if (dx < 0 && current < total - 1) gotoSlide(current + 1);
        else if (dx > 0 && current > 0)    gotoSlide(current - 1);
      }, { passive: true });

      swiperEl.addEventListener('touchcancel', function() {
        dragging = false;
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', cfpInit);
  } else {
    cfpInit();
  }

})();
</script>

