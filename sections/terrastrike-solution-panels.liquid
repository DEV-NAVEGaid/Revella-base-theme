{%- comment -%}
  Any number of alternating image + copy panels, plus an optional CTA underneath.
  Each panel is a block, so panels can be added, reordered and removed.
{%- endcomment -%}

{{ 'terrastrike.css' | asset_url | stylesheet_tag }}
{% render 'terrastrike-section-style', section: section %}

{%- assign st = section.settings -%}

<div class="ts-landing">
  <div class="ts-container">
    {%- for block in section.blocks -%}
      {%- liquid
        assign split_class = 'ts-split'

        comment
          "Alternate" flips every second panel; the other options pin the image side.
        endcomment
        assign media_position = block.settings.media_position
        assign is_even_panel = forloop.index0 | modulo: 2
        if media_position == 'alternate'
          if is_even_panel == 0
            assign media_position = 'right'
          else
            assign media_position = 'left'
          endif
        endif
        if media_position == 'left'
          assign split_class = split_class | append: ' media-left'
        endif
      -%}
      <div class="{{ split_class }}" {{ block.shopify_attributes }}>
        <div class="ts-split__copy">
          {%- if block.settings.eyebrow != blank -%}
            <div class="ts-eyebrow">{{ block.settings.eyebrow }}</div>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="ts-heading-xl">{{ block.settings.heading }}</h2>
          {%- endif -%}
          <div class="ts-body">{{ block.settings.text }}</div>
        </div>
        <div class="ts-split__media">
          {% render 'terrastrike-image',
            image: block.settings.image,
            alt: block.settings.heading,
            width: 900,
            lazy: true
          %}
        </div>
      </div>
    {%- endfor -%}

    {% render 'terrastrike-promo-banner',
      product: st.featured_product,
      button_text: st.button_text,
      button_link: st.button_link
    %}
  </div>
</div>

{% schema %}
{
  "name": "TS: Solution panels",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Button" },
    { "type": "product", "id": "featured_product", "label": "Product to add to cart" },
    { "type": "url", "id": "button_link", "label": "Custom link", "info": "Overrides the add-to-cart button." },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SAVE UP TO 55% 👉",
      "info": "Leave blank to hide the button."
    },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#121212" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#f39c12" },
    { "type": "color", "id": "button_background_hover", "label": "Button background (hover)", "default": "#e67e22" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },

    { "type": "header", "content": "Typography" },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font",
      "options": [
        { "value": "theme", "label": "Theme default" },
        { "value": "var(--font-body--family)", "label": "Body" },
        { "value": "var(--font-heading--family)", "label": "Heading" },
        { "value": "var(--font-subheading--family)", "label": "Subheading" },
        { "value": "var(--font-accent--family)", "label": "Accent" }
      ],
      "default": "theme"
    },
    {
      "type": "range",
      "id": "type_scale",
      "min": 70,
      "max": 140,
      "step": 5,
      "unit": "%",
      "label": "Text size",
      "default": 100
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "content_width",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Content width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Gap between columns",
      "default": 24
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Image corner radius",
      "default": 12
    },

    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top", "default": 48 },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top (mobile)",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom (mobile)",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Body" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "media_position",
          "label": "Image position (desktop)",
          "info": "On mobile the image always comes first.",
          "options": [
            { "value": "alternate", "label": "Alternate" },
            { "value": "right", "label": "Right" },
            { "value": "left", "label": "Left" }
          ],
          "default": "alternate"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TS: Solution panels",
      "blocks": [
        {
          "type": "panel",
          "settings": {
            "eyebrow": "Join Thousands Who Carry With Confidence",
            "heading": "Introducing TerraStrike: The Tiny Escape Tool Firefighters Wish Every Driver Had",
            "text": "<p>This little escape tool exists for one reason: <strong>firefighters kept responding to the same tragedy.</strong></p><p>Rollovers where the driver was conscious, hanging from the belt, unable to reach the buckle under her own body weight. Doors so crushed they would not move. Submersions where families drowned in three feet of water because no one could break the glass.</p><p><strong>TerraStrike uses a spring-loaded tungsten-tipped striker.</strong></p><p>Press it into the corner of the window and the spring fires the tungsten tip with a glass-shattering force.</p><p>Same spring force every time, whether your hand is calm or shaking, whether you're holding the tool level or upside down. Plus, <strong>hidden stainless blade</strong> gives the seatbelt one clean path through the cutter.</p>"
          }
        },
        {
          "type": "panel",
          "settings": {
            "eyebrow": "🏆 Join Thousands Who Carry With Confidence",
            "heading": "So Simple And Effective That Anyone Can Use It",
            "text": "<p>1. <strong>Press the striker into the corner of the window</strong>. The spring instantly fires the tungsten tip, even if your hand is shaking. No strength needed.</p><p>2. <strong>Pull the cutter cover.</strong> Feed the belt into the recessed channel and do one easy swipe through the webbing.</p><p><strong>TerraStrike</strong> was developed to be so easy and fast to use that it <strong>works even if you are under shock</strong>, shaking and basically have zero strength.</p>"
          }
        },
        {
          "type": "panel",
          "settings": {
            "heading": "Why This 34.5g Tool Turns a Car Window to Pebbles in One Easy Press",
            "text": "<p>The physics here is simple. <strong>Force in one tiny point breaks tempered glass.</strong></p><p>Force spread across a fist or an elbow doesn't.</p><p>That's why TerraStrike has three things working together.</p><ol><li><strong>A tungsten tip</strong> that's harder than the glass.</li><li><strong>A point so small</strong> the force has nowhere to go but through.</li><li><strong>A spring that fires</strong> the same way every time, whether your hand is steady or not.</li></ol><p>It's the same physics professional rescue crews use - in a tool smaller than most car key fobs.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
