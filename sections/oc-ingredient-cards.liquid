{% render 'oc-assets' %}
{%- assign s = section.settings -%}
<style>
  .lm.lm .oic{background:{{ s.background }};color:{{ s.text_color }};padding:40px 20px}
  .lm.lm .oic-i{max-width:1200px;margin:0 auto}
  .lm.lm .oic h2{font-family:var(--font-heading-family);font-style:var(--font-heading-style);font-size:32px;line-height:38px;font-weight:700;letter-spacing:-.02em;color:{{ s.text_color }};text-align:center;margin:0 0 28px}
  .lm.lm .oic-g{display:grid;grid-template-columns:minmax(0,1fr);gap:20px}
  .lm.lm .oic-c{display:flex;border:1px solid {{ s.border_color }};border-radius:12px;overflow:hidden;min-width:0}
  .lm.lm .oic-img{flex:0 0 38%;aspect-ratio:1/1;background:#F8F9FA;overflow:hidden}
  .lm.lm .oic-img img,.lm.lm .oic-img svg{display:block;width:100%;height:100%;object-fit:cover}
  .lm.lm .oic-t{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:center;padding:16px}
  .lm.lm .oic-t h3{font-family:var(--font-heading-family);font-style:var(--font-heading-style);font-size:18px;line-height:22px;font-weight:700;color:{{ s.text_color }};margin:0 0 8px}
  .lm.lm .oic-t div{font-size:14px;line-height:20px;color:{{ s.text_color }}}
  .lm.lm .oic-t div p{margin:0}
  @media (min-width:990px){
    .lm.lm .oic{padding:60px 20px}
    .lm.lm .oic h2{font-size:42px;line-height:50px;margin-bottom:40px}
    .lm.lm .oic-g{grid-template-columns:repeat(2,minmax(0,1fr));gap:30px}
    .lm.lm .oic-img{flex-basis:210px;width:210px}
    .lm.lm .oic-t{padding:25px}
    .lm.lm .oic-t h3{font-size:24px;line-height:29px;margin-bottom:12px}
    .lm.lm .oic-t div{font-size:16px;line-height:24px}
  }
</style>
<div class="lm">
  <section class="oic">
    <div class="oic-i">
      {%- if s.heading != blank %}<h2>{{ s.heading }}</h2>{% endif -%}
      <div class="oic-g">
        {%- for block in section.blocks -%}
          <div class="oic-c" {{ block.shopify_attributes }}>
            <div class="oic-img">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 400, 600', sizes: '(min-width: 990px) 210px, 38vw', alt: block.settings.image.alt }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="oic-t">
              {%- if block.settings.title != blank %}<h3>{{ block.settings.title }}</h3>{% endif -%}
              {%- if block.settings.text != blank %}<div>{{ block.settings.text }}</div>{% endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "OC: Ingredient cards",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's inside", "info": "Empty = no heading." },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background", "label": "Background colour", "default": "#289383" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Card border colour", "default": "#FDFFFF" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Square, at least 600 x 600 px. Empty = placeholder image." },
        { "type": "text", "id": "title", "label": "Title", "default": "Ingredient name" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A short description of this ingredient and what it does.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OC: Ingredient cards",
      "blocks": [
        { "type": "card", "settings": { "title": "First ingredient" } },
        { "type": "card", "settings": { "title": "Second ingredient" } },
        { "type": "card", "settings": { "title": "Third ingredient" } },
        { "type": "card", "settings": { "title": "Fourth ingredient" } }
      ]
    }
  ]
}
{% endschema %}
