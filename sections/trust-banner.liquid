{%- liquid
  assign sid = section.id
  assign border_radius = section.settings.border_radius
-%}

<style>
  #shopify-section-{{ sid }} {
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
    background-color: {{ section.settings.section_bg_color }};
    --tb-padding-top-d:    {{ section.settings.padding_top_desktop }}px;
    --tb-padding-bottom-d: {{ section.settings.padding_bottom_desktop }}px;
    --tb-padding-top-m:    {{ section.settings.padding_top_mobile }}px;
    --tb-padding-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
    --tb-padding-x-d:      {{ section.settings.padding_x_desktop }}px;
    --tb-padding-x-m:      {{ section.settings.padding_x_mobile }}px;
    --tb-radius:           {{ border_radius }}px;
    --tb-max-width:        {{ section.settings.max_width }}px;
    --tb-icon-col-gap-d:   {{ section.settings.icon_col_gap_desktop }}px;
    --tb-icon-col-gap-m:   {{ section.settings.icon_col_gap_mobile }}px;
    --tb-icon-row-gap-d:   {{ section.settings.icon_row_gap_desktop }}px;
    --tb-icon-row-gap-m:   {{ section.settings.icon_row_gap_mobile }}px;
    --tb-icon-size-d:      {{ section.settings.icon_size_desktop }}px;
    --tb-icon-size-m:      {{ section.settings.icon_size_mobile }}px;
    --tb-icon-gap:         {{ section.settings.icon_text_gap }}px;
    --tb-icon-color:       {{ section.settings.icon_color }};
  }

  /* ── Banner container ── */
  .tb-banner-{{ sid }} {
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
    border-radius: var(--tb-radius);
    background-color: {{ section.settings.background_color }};
    padding-top: var(--tb-padding-top-m);
    padding-bottom: var(--tb-padding-bottom-m);
    padding-left: var(--tb-padding-x-m);
    padding-right: var(--tb-padding-x-m);
    {% if section.settings.banner_height_mobile > 0 or section.settings.banner_height_desktop > 0 %}
      display: flex;
      flex-direction: column;
      justify-content: center;
    {% endif %}
    {% if section.settings.banner_height_mobile > 0 %}
      height: {{ section.settings.banner_height_mobile }}px;
    {% endif %}
  }

  @media (min-width: 750px) {
    .tb-banner-{{ sid }} {
      padding-top: var(--tb-padding-top-d);
      padding-bottom: var(--tb-padding-bottom-d);
      padding-left: var(--tb-padding-x-d);
      padding-right: var(--tb-padding-x-d);
      {% if section.settings.banner_height_desktop > 0 %}
        height: {{ section.settings.banner_height_desktop }}px;
      {% endif %}
    }
  }

  /* ── Background images ── */
  .tb-bg-img-{{ sid }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .tb-bg-img-{{ sid }}--desktop {
    display: none;
  }

  {% if section.settings.desktop_image != blank %}
    @media (min-width: 750px) {
      .tb-bg-img-{{ sid }}--mobile  { display: none; }
      .tb-bg-img-{{ sid }}--desktop { display: block; }
    }
  {% endif %}

  /* ── Overlay via ::after ── */
  .tb-banner-{{ sid }}::after {
    content: '';
    position: absolute;
    inset: 0;
    background: {% if section.settings.overlay_gradient != blank %}{{ section.settings.overlay_gradient }}{% else %}{{ section.settings.overlay_color }}{% endif %};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
    pointer-events: none;
  }

  /* ── Content ── */
  .tb-content-{{ sid }} {
    position: relative;
    z-index: 2;
    max-width: var(--tb-max-width);
    margin-left: auto;
    margin-right: auto;
    text-align: {{ section.settings.content_align_mobile }};
  }

  @media (min-width: 750px) {
    .tb-content-{{ sid }} {
      text-align: {{ section.settings.content_align_desktop }};
    }
  }

  /* ── Heading ── */
  .tb-heading-{{ sid }} {
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px;
  }

  .tb-heading-{{ sid }} .tb-heading__text {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-weight: {{ section.settings.heading_font_weight }};
    font-size: {{ section.settings.heading_size_mobile }}px;
    color: {{ section.settings.heading_color }};
    line-height: {{ section.settings.heading_line_height | times: 0.1 | plus: 1.0 }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    text-transform: {{ section.settings.heading_transform }};
    margin: 0;
  }

  @media (min-width: 750px) {
    .tb-heading-{{ sid }} .tb-heading__text {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }
  }

  /* ── Icon grid ── */
  .tb-icon-grid-{{ sid }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
    column-gap: var(--tb-icon-col-gap-m);
    row-gap: var(--tb-icon-row-gap-m);
    margin-bottom: {{ section.settings.icon_grid_margin_bottom }}px;
  }

  @media (min-width: 640px) {
    .tb-icon-grid-{{ sid }} {
      grid-template-columns: repeat({{ section.settings.icon_columns_tablet }}, 1fr);
      column-gap: var(--tb-icon-col-gap-d);
      row-gap: var(--tb-icon-row-gap-d);
    }
  }

  @media (min-width: 1024px) {
    .tb-icon-grid-{{ sid }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ── Icon items ── */
  .tb-icon-item-{{ sid }} {
    display: flex;
    align-items: {{ section.settings.icon_align }};
    gap: var(--tb-icon-gap);
    text-align: left;
  }

  .tb-icon-item-{{ sid }} .tb-icon-item__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tb-icon-size-m);
    height: var(--tb-icon-size-m);
    color: var(--tb-icon-color);
  }

  @media (min-width: 750px) {
    .tb-icon-item-{{ sid }} .tb-icon-item__icon {
      width: var(--tb-icon-size-d);
      height: var(--tb-icon-size-d);
    }
  }

  .tb-icon-item-{{ sid }} .tb-icon-item__icon svg {
    width: 100%;
    height: 100%;
    display: block;
    color: inherit;
  }

  .tb-icon-item-{{ sid }} .tb-icon-item__icon img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .tb-icon-item-{{ sid }} .tb-icon-item__text {
    font-family: {{ section.settings.icon_text_font.family }}, {{ section.settings.icon_text_font.fallback_families }};
    font-weight: {{ section.settings.icon_text_font.weight }};
    font-size: {{ section.settings.icon_text_size_mobile }}px;
    color: {{ section.settings.icon_text_color }};
    line-height: 1.4;
    letter-spacing: {{ section.settings.icon_text_letter_spacing }}px;
    margin: 0;
  }

  @media (min-width: 750px) {
    .tb-icon-item-{{ sid }} .tb-icon-item__text {
      font-size: {{ section.settings.icon_text_size_desktop }}px;
    }
  }

  /* ── Paragraph ── */
  .tb-paragraph-{{ sid }} {
    margin-top: {{ section.settings.paragraph_margin_top }}px;
  }

  .tb-paragraph-{{ sid }} .tb-paragraph__text,
  .tb-paragraph-{{ sid }} .tb-paragraph__text p {
    font-family: {{ section.settings.paragraph_font.family }}, {{ section.settings.paragraph_font.fallback_families }};
    font-weight: {{ section.settings.paragraph_font.weight }};
    font-size: {{ section.settings.paragraph_size_mobile }}px;
    color: {{ section.settings.paragraph_color }};
    font-style: {{ section.settings.paragraph_style }};
    line-height: {{ section.settings.paragraph_line_height | times: 0.1 | plus: 1.0 }};
    letter-spacing: {{ section.settings.paragraph_letter_spacing }}px;
    margin: 0;
  }

  @media (min-width: 750px) {
    .tb-paragraph-{{ sid }} .tb-paragraph__text,
    .tb-paragraph-{{ sid }} .tb-paragraph__text p {
      font-size: {{ section.settings.paragraph_size_desktop }}px;
    }
  }
</style>

{% if section.blocks.size > 0 %}
<div class="page-width">
  <div class="tb-banner-{{ sid }}">

    {% if section.settings.mobile_image != blank %}
      <img
        src="{{ section.settings.mobile_image | image_url: width: 1200 }}"
        alt="{{ section.settings.mobile_image.alt | escape }}"
        class="tb-bg-img-{{ sid }} tb-bg-img-{{ sid }}--mobile"
        loading="lazy"
        width="{{ section.settings.mobile_image.width }}"
        height="{{ section.settings.mobile_image.height }}"
      >
    {% endif %}
    {% if section.settings.desktop_image != blank %}
      <img
        src="{{ section.settings.desktop_image | image_url: width: 2000 }}"
        alt="{{ section.settings.desktop_image.alt | escape }}"
        class="tb-bg-img-{{ sid }} tb-bg-img-{{ sid }}--desktop"
        loading="lazy"
        width="{{ section.settings.desktop_image.width }}"
        height="{{ section.settings.desktop_image.height }}"
      >
    {% endif %}

    <div class="tb-content-{{ sid }}">

      {%- assign heading_blocks = section.blocks | where: 'type', 'heading' -%}
      {%- for block in heading_blocks -%}
        <div class="tb-heading-{{ sid }}" {{ block.shopify_attributes }}>
          <{{ block.settings.heading_tag }} class="tb-heading__text">
            {{ block.settings.text | escape }}
          </{{ block.settings.heading_tag }}>
        </div>
      {%- endfor -%}

      {%- assign icon_blocks = section.blocks | where: 'type', 'icon_text' -%}
      {%- if icon_blocks.size > 0 -%}
        <div class="tb-icon-grid-{{ sid }}">
          {%- for block in icon_blocks -%}
            <div class="tb-icon-item-{{ sid }}" {{ block.shopify_attributes }}>

              {%- if block.settings.custom_icon != blank -%}
                <span class="tb-icon-item__icon">
                  <img src="{{ block.settings.custom_icon | image_url: width: 64 }}" alt="" loading="lazy" width="64" height="64">
                </span>
              {%- elsif block.settings.icon != 'none' -%}
                <span class="tb-icon-item__icon">
                  {%- case block.settings.icon -%}
                    {%- when 'check-circle' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    {%- when 'check-badge' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><path d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
                    {%- when 'check' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                    {%- when 'shield' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    {%- when 'shield-check' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                    {%- when 'star' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    {%- when 'leaf' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 8C8 10 5.9 16.17 3.82 21.34L5.71 22l1-2.3A4.49 4.49 0 0 0 8 20C19 20 22 3 22 3c-1 2-8 2-8 2s-2 0-2 5 5 5 6 7"/></svg>
                    {%- when 'heart' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                    {%- when 'truck' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    {%- when 'award' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>
                    {%- when 'lab' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-3"/><polyline points="9 11 12 14 15 11"/><line x1="12" y1="14" x2="12" y2="3"/></svg>
                    {%- when 'sparkle' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true"><path d="M12 2L9.5 9.5 2 12l7.5 2.5L12 22l2.5-7.5L22 12l-7.5-2.5L12 2z"/></svg>
                    {%- when 'drop' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                    {%- when 'recycle' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><polyline points="23 20 23 14 17 14"/><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/></svg>
                    {%- when 'pill' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7z"/><line x1="8.5" y1="8.5" x2="15.5" y2="15.5"/></svg>
                  {%- endcase -%}
                </span>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <span class="tb-icon-item__text">{{ block.settings.text | escape }}</span>
              {%- endif -%}

            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- assign paragraph_blocks = section.blocks | where: 'type', 'paragraph' -%}
      {%- for block in paragraph_blocks -%}
        <div class="tb-paragraph-{{ sid }}" {{ block.shopify_attributes }}>
          <div class="tb-paragraph__text">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}

    </div>
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Trust Banner",
  "tag": "section",
  "class": "trust-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#5C2A1E",
      "info": "Shown when no image is set, or as a fallback colour behind the image."
    },
    {
      "type": "header",
      "content": "Background images"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop background image",
      "info": "If empty, the mobile image is used on all screen sizes."
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#5C1A0E"
    },
    {
      "type": "color_background",
      "id": "overlay_gradient",
      "label": "Overlay gradient",
      "info": "If set, replaces the solid overlay color."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity (%)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "banner_height_desktop",
      "label": "Banner height – Desktop (px)",
      "min": 0,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "0 = auto height based on content/padding. If set, content taller than this will be clipped."
    },
    {
      "type": "range",
      "id": "banner_height_mobile",
      "label": "Banner height – Mobile (px)",
      "min": 0,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "0 = auto height based on content/padding. If set, content taller than this will be clipped."
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius (px)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width (px)",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1000
    },
    {
      "type": "select",
      "id": "content_align_desktop",
      "label": "Content align – Desktop",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_align_mobile",
      "label": "Content align – Mobile",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "icon_columns_tablet",
      "label": "Icon columns on tablet",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Inner padding — Desktop"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top (px)",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom (px)",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60
    },
    {
      "type": "range",
      "id": "padding_x_desktop",
      "label": "Padding left/right (px)",
      "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60
    },
    {
      "type": "header",
      "content": "Inner padding — Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (px)",
      "min": 0, "max": 80, "step": 4, "unit": "px", "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (px)",
      "min": 0, "max": 80, "step": 4, "unit": "px", "default": 36
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "label": "Padding left/right (px)",
      "min": 0, "max": 60, "step": 4, "unit": "px", "default": 24
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Padding top (px)",
      "min": 0, "max": 100, "step": 4, "unit": "px", "default": 28
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0, "max": 100, "step": 4, "unit": "px", "default": 28
    },
    {
      "type": "header",
      "content": "Heading defaults"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font family",
      "default": "sans-serif"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Font weight",
      "options": [
        { "value": "300", "label": "300 - Light" },
        { "value": "400", "label": "400 - Regular" },
