{%- style -%}
  #shopify-section-{{ section.id }} .amua-stats {
    --amua-st-bg: {{ section.settings.background_color }};
    --amua-st-heading-color: {{ section.settings.heading_color }};
    --amua-st-subtitle-color: {{ section.settings.subtitle_color }};
    --amua-st-title-color: {{ section.settings.stat_title_color }};
    --amua-st-desc-color: {{ section.settings.stat_desc_color }};
    --amua-st-divider-color: {{ section.settings.divider_color }};
    --amua-st-disclaimer-color: {{ section.settings.disclaimer_color }};
    --amua-st-disclaimer-icon-color: {{ section.settings.disclaimer_icon_color }};
    --amua-st-number-gradient-start: {{ section.settings.number_gradient_start }};
    --amua-st-number-gradient-end: {{ section.settings.number_gradient_end }};
    --amua-st-number-gradient-angle: {{ section.settings.number_gradient_angle }}deg;
    --amua-st-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --amua-st-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;
    --amua-st-subtitle-size-mobile: {{ section.settings.subtitle_size_mobile }}px;
    --amua-st-subtitle-size-desktop: {{ section.settings.subtitle_size_desktop }}px;
    --amua-st-number-size-mobile: {{ section.settings.number_size_mobile }}px;
    --amua-st-number-size-desktop: {{ section.settings.number_size_desktop }}px;
    --amua-st-stat-title-size-mobile: {{ section.settings.stat_title_size_mobile }}px;
    --amua-st-stat-title-size-desktop: {{ section.settings.stat_title_size_desktop }}px;
    --amua-st-stat-desc-size-mobile: {{ section.settings.stat_desc_size_mobile }}px;
    --amua-st-stat-desc-size-desktop: {{ section.settings.stat_desc_size_desktop }}px;
    --amua-st-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --amua-st-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --amua-st-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --amua-st-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;

    background-color: var(--amua-st-bg);
    padding-top: var(--amua-st-padding-top-mobile);
    padding-bottom: var(--amua-st-padding-bottom-mobile);
  }

  #shopify-section-{{ section.id }} .amua-stats__inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Header */
  #shopify-section-{{ section.id }} .amua-stats__heading {
    color: var(--amua-st-heading-color);
    font-size: var(--amua-st-heading-size-mobile);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-align: center;
    margin: 0 0 12px;
  }

  #shopify-section-{{ section.id }} .amua-stats__subtitle {
    color: var(--amua-st-subtitle-color);
    font-size: var(--amua-st-subtitle-size-mobile);
    font-weight: 400;
    line-height: 1.5;
    text-align: center;
    margin: 0 0 36px;
  }

  /* Stat row */
  #shopify-section-{{ section.id }} .amua-stats__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .amua-stats__item {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    padding: 28px 0;
    border-top: 1px solid var(--amua-st-divider-color);
  }

  #shopify-section-{{ section.id }} .amua-stats__item:last-child {
    border-bottom: none;
  }

  /* Gradient number */
  #shopify-section-{{ section.id }} .amua-stats__number {
    font-size: var(--amua-st-number-size-mobile);
    font-weight: 800;
    line-height: 1;
    flex-shrink: 0;
    min-width: 110px;
    background: linear-gradient(
      var(--amua-st-number-gradient-angle),
      var(--amua-st-number-gradient-start),
      var(--amua-st-number-gradient-end)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Stat text */
  #shopify-section-{{ section.id }} .amua-stats__stat-title {
    color: var(--amua-st-title-color);
    font-size: var(--amua-st-stat-title-size-mobile);
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 6px;
  }

  #shopify-section-{{ section.id }} .amua-stats__stat-desc {
    color: var(--amua-st-desc-color);
    font-size: var(--amua-st-stat-desc-size-mobile);
    font-weight: 400;
    line-height: 1.5;
    margin: 0;
  }

  /* Disclaimer */
  #shopify-section-{{ section.id }} .amua-stats__disclaimer {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: 32px;
    padding-top: 10px;
  }

  #shopify-section-{{ section.id }} .amua-stats__disclaimer-icon {
    flex-shrink: 0;
    color: var(--amua-st-disclaimer-icon-color);
  }

  #shopify-section-{{ section.id }} .amua-stats__disclaimer-icon svg {
    width: 20px;
    height: 20px;
  }

  #shopify-section-{{ section.id }} .amua-stats__disclaimer-text {
    color: var(--amua-st-disclaimer-color);
    font-size: 13px;
    font-style: italic;
    line-height: 1.5;
    margin: 0;
  }

  /* Counter animation */
  #shopify-section-{{ section.id }} .amua-stats__number[data-animated="false"] {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s, transform 0.4s;
  }

  #shopify-section-{{ section.id }} .amua-stats__number[data-animated="true"] {
    opacity: 1;
    transform: translateY(0);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .amua-stats {
      padding-top: var(--amua-st-padding-top-desktop);
      padding-bottom: var(--amua-st-padding-bottom-desktop);
    }

    #shopify-section-{{ section.id }} .amua-stats__heading {
      font-size: var(--amua-st-heading-size-desktop);
    }

    #shopify-section-{{ section.id }} .amua-stats__subtitle {
      font-size: var(--amua-st-subtitle-size-desktop);
    }

    #shopify-section-{{ section.id }} .amua-stats__number {
      font-size: var(--amua-st-number-size-desktop);
      min-width: 150px;
    }

    #shopify-section-{{ section.id }} .amua-stats__stat-title {
      font-size: var(--amua-st-stat-title-size-desktop);
    }

    #shopify-section-{{ section.id }} .amua-stats__stat-desc {
      font-size: var(--amua-st-stat-desc-size-desktop);
    }

    #shopify-section-{{ section.id }} .amua-stats__item {
      gap: 32px;
      padding: 32px 0;
    }
  }
{%- endstyle -%}

{%- assign stat_blocks = section.blocks | where: "type", "stat_item" -%}

<div class="amua-stats" id="amua-stats-{{ section.id }}">
  <div class="amua-stats__inner">

    {%- if section.settings.heading != blank -%}
      <h2 class="amua-stats__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="amua-stats__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    {%- if stat_blocks.size > 0 -%}
      <ul class="amua-stats__list">
        {%- for block in stat_blocks -%}
          <li class="amua-stats__item" {{ block.shopify_attributes }}>
            <div class="amua-stats__number"
                 data-amua-counter
                 data-target="{{ block.settings.number }}"
                 data-suffix="{{ block.settings.suffix }}"
                 data-animated="false">
              0{{ block.settings.suffix }}
            </div>
            <div class="amua-stats__text">
              {%- if block.settings.title != blank -%}
                <h3 class="amua-stats__stat-title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="amua-stats__stat-desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.disclaimer != blank -%}
      <div class="amua-stats__disclaimer">
        {%- if section.settings.show_disclaimer_icon -%}
          <div class="amua-stats__disclaimer-icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><line x1="12" y1="16" x2="12" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="8" r="1" fill="currentColor"/></svg>
          </div>
        {%- endif -%}
        <p class="amua-stats__disclaimer-text">{{ section.settings.disclaimer }}</p>
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  (function(){
    var root = document.getElementById('amua-stats-{{ section.id }}');
    if (!root) return;
    var counters = root.querySelectorAll('[data-amua-counter]');
    if (!counters.length) return;

    var duration = {{ section.settings.counter_duration }};
    var animated = false;

    function animateCounters() {
      if (animated) return;
      animated = true;
      counters.forEach(function(el) {
        var target = parseInt(el.dataset.target, 10) || 0;
        var suffix = el.dataset.suffix || '';
        var start = 0;
        var startTime = null;
        el.setAttribute('data-animated', 'true');

        function step(ts) {
          if (!startTime) startTime = ts;
          var progress = Math.min((ts - startTime) / duration, 1);
          var ease = 1 - Math.pow(1 - progress, 3);
          var current = Math.round(ease * target);
          el.textContent = current + suffix;
          if (progress < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      });
    }

    new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) animateCounters();
      });
    }, { threshold: 0.3 }).observe(root);
  })();
</script>

