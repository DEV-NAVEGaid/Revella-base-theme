{% render 'oc-assets' %}
{%- assign s = section.settings -%}
{%- assign rows = section.blocks | where: 'type', 'row' -%}
<div class="lm">
  <section class="wrap sci ixr-s"{% if s.background != blank %} style="background: {{ s.background }}"{% endif %}>
    <span class="sci-bg"></span>
    <div class="inner">
      <div class="sci-h">
        {%- if s.heading != blank %}<h2 class="h2 wt">{{ s.heading }}</h2>{% endif -%}
        {%- if s.subheading != blank %}<p class="sub">{{ s.subheading }}</p>{% endif -%}
      </div>

      {%- if rows.size > 0 -%}
        <div class="ixr" data-ixr="{{ section.id }}">
          <div class="ixr-chips" role="tablist" aria-label="{{ s.chips_label | escape }}">
            {%- assign prev = '' -%}
            {%- for block in rows -%}
              {%- assign key = block.settings.benefit | handle -%}
              {%- if key != prev -%}
                <button type="button" class="ixr-chip" role="tab" data-key="{{ key }}" data-go="{{ forloop.index0 }}">{{ block.settings.benefit }}</button>
              {%- endif -%}
              {%- assign prev = key -%}
            {%- endfor -%}
          </div>

          <div class="ixr-track" data-track>
            {%- for block in rows -%}
              {%- assign b = block.settings -%}
              <article class="ixr-card" data-key="{{ b.benefit | handle }}" {{ block.shopify_attributes }}>
                <div class="ixr-top">
                  <span class="ixr-ic">
                    {%- if b.icon != blank -%}
                      {{ b.icon | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
                    {%- else -%}
                      {% render 'oc-icon', icon: 'trend-18' %}
                    {%- endif -%}
                  </span>
                  <p class="ixr-name">{{ b.benefit }}</p>
                  {%- if b.dose != blank %}<span class="ixr-dose">{{ b.dose }}</span>{% endif -%}
                </div>
                <div class="ixr-row">
                  <p class="ixr-lbl">{{ s.evidence_label | default: 'The study' }}</p>
                  <p class="ixr-ev">{{ b.evidence }}</p>
                </div>
                <div class="ixr-row ixr-res">
                  <p class="ixr-lbl">{{ s.outcome_label | default: 'What they found' }}</p>
                  <p class="ixr-out">{{ b.outcome }}</p>
                </div>
                {%- if b.study != blank -%}
                  {%- if b.study_link != blank -%}
                    <a class="ixr-src" href="{{ b.study_link }}" target="_blank" rel="noopener">{{ b.study }}<span aria-hidden="true">↗</span></a>
                  {%- else -%}
                    <p class="ixr-src">{{ b.study }}</p>
                  {%- endif -%}
                {%- endif -%}
              </article>
            {%- endfor -%}
          </div>

          <div class="ixr-nav">
            <button type="button" class="ixr-arr" data-prev aria-label="Previous ingredient"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            <div class="ixr-dots" data-dots>
              {%- for block in rows -%}<span class="ixr-dotb"></span>{%- endfor -%}
            </div>
            <button type="button" class="ixr-arr" data-next aria-label="Next ingredient"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          </div>
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

<style>
  .lm .ixr{width:100%;min-width:0;max-width:100%;display:flex;flex-direction:column;gap:20px}
  .lm .ixr-chips{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;margin:0;padding:2px 0}
  .lm .ixr-chips::-webkit-scrollbar{display:none}
  .lm .ixr-chip{flex:none;padding:10px 16px;border-radius:999px;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.04);color:rgba(255,255,255,.75);font-size:14px;line-height:18px;font-weight:600;white-space:nowrap;transition:background-color .25s ease,color .25s ease,border-color .25s ease}
  .lm .ixr-chip:hover{border-color:rgba(255,255,255,.4);color:#fff}
  .lm .ixr-chip.on{background:#fff;border-color:#fff;color:#0D1E39}
  .lm .ixr-track{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;-webkit-overflow-scrolling:touch;margin:0;padding:4px 0 8px;overscroll-behavior-x:contain}
  .lm .ixr-track::-webkit-scrollbar{display:none}
  .lm .ixr-card{flex:0 0 100%;min-width:0;scroll-snap-align:start;display:flex;flex-direction:column;gap:18px;padding:22px;border-radius:22px;background:#fff;box-shadow:0 18px 40px -24px rgba(0,0,0,.6);transition:opacity .35s ease;opacity:.55}
  .lm .ixr-card.on{opacity:1}
  .lm .ixr-top{display:flex;align-items:center;gap:12px}
  .lm .ixr-ic{width:40px;height:40px;border-radius:12px;background:#EEF3FA;display:flex;align-items:center;justify-content:center;flex:none;color:#265392}
  .lm .ixr-ic svg,.lm .ixr-ic img{width:20px;height:20px;object-fit:contain}
  .lm .ixr-name{flex:1;font-size:20px;line-height:24px;font-weight:700;color:#0D1E39}
  .lm .ixr-dose{flex:none;padding:6px 10px;border-radius:999px;background:linear-gradient(107deg,#142F54 0%,#0D1E39 100%);color:#F1F5F9;font-size:12px;line-height:14px;font-weight:800;letter-spacing:.04em;text-transform:uppercase}
  .lm .ixr-row{display:flex;flex-direction:column;gap:4px}
  .lm .ixr-lbl{font-size:11px;line-height:14px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(13,30,57,.45)}
  .lm .ixr-ev{font-size:15px;line-height:22px;color:rgba(13,30,57,.75)}
  .lm .ixr-res{padding:14px 16px;border-radius:14px;background:#F5F8FF;border:1px solid rgba(38,83,146,.12)}
  .lm .ixr-out{font-size:17px;line-height:24px;font-weight:700;color:#193B68}
  .lm .ixr-src{margin-top:auto;display:inline-flex;align-items:center;gap:6px;align-self:flex-start;font-size:13px;line-height:18px;font-weight:600;color:#265392;text-decoration:none;border-bottom:1px solid rgba(38,83,146,.3);padding-bottom:1px}
  .lm .ixr-src:hover{color:#193B68;border-color:#193B68}
  .lm .ixr-nav{display:flex;align-items:center;justify-content:center;gap:16px}
  .lm .ixr-arr{width:40px;height:40px;border-radius:50%;border:1px solid rgba(255,255,255,.25);background:transparent;color:#fff;display:none;align-items:center;justify-content:center;transition:background-color .2s ease,opacity .2s ease}
  .lm .ixr-arr svg{width:18px;height:18px}
  .lm .ixr-arr:hover{background:rgba(255,255,255,.1)}
  .lm .ixr-arr[disabled]{opacity:.3;cursor:default}
  .lm .ixr-dots{display:flex;gap:6px}
  .lm .ixr-dotb{width:6px;height:6px;border-radius:999px;background:rgba(255,255,255,.3);transition:width .3s ease,background-color .3s ease}
  .lm .ixr-dotb.on{width:22px;background:#fff}
  @media screen and (min-width:750px){
    .lm .ixr-card{flex-basis:calc((100% - 14px) / 2)}
  }
  @media screen and (min-width:990px){
    .lm .ixr{gap:28px}
    .lm .ixr-chips{justify-content:center;flex-wrap:wrap;overflow:visible;margin:0;padding:0}
    .lm .ixr-track{gap:20px;margin:0;padding:4px 0 8px;scroll-padding:0}
    .lm .ixr-card{flex-basis:calc((100% - 40px) / 3);padding:28px;opacity:1}
    .lm .ixr-arr{display:flex}
  }
  @media (prefers-reduced-motion:reduce){
    .lm .ixr-track{scroll-behavior:auto}
    .lm .ixr-card,.lm .ixr-chip,.lm .ixr-dotb{transition:none}
  }
</style>
<script>
  (function () {
    var root = document.querySelector('[data-ixr="{{ section.id }}"]');
    if (!root) return;
    var track = root.querySelector('[data-track]');
    var cards = [].slice.call(track.querySelectorAll('.ixr-card'));
    var chips = [].slice.call(root.querySelectorAll('.ixr-chip'));
    var chipBar = root.querySelector('.ixr-chips');
    var dots = [].slice.call(root.querySelectorAll('.ixr-dotb'));
    var prev = root.querySelector('[data-prev]');
    var next = root.querySelector('[data-next]');
    var current = -1;
    function go(i) {
      i = Math.max(0, Math.min(cards.length - 1, i));
      track.scrollTo({ left: cards[i].offsetLeft - cards[0].offsetLeft, behavior: 'smooth' });
    }
    function setActive(i) {
      if (i === current) return;
      current = i;
      var key = cards[i].getAttribute('data-key');
      cards.forEach(function (c, n) { c.classList.toggle('on', n === i); });
      dots.forEach(function (d, n) { d.classList.toggle('on', n === i); });
      chips.forEach(function (c) {
        var on = c.getAttribute('data-key') === key;
        c.classList.toggle('on', on);
        c.setAttribute('aria-selected', on ? 'true' : 'false');
        if (on && chipBar.scrollWidth > chipBar.clientWidth) {
          chipBar.scrollTo({ left: c.offsetLeft - chipBar.clientWidth / 2 + c.offsetWidth / 2, behavior: 'smooth' });
        }
      });
      prev.disabled = i === 0;
      var maxLeft = track.scrollWidth - track.clientWidth - 2;
      next.disabled = i === cards.length - 1 || track.scrollLeft >= maxLeft;
    }
    function measure() {
      var left = track.scrollLeft + cards[0].offsetLeft;
      var best = 0, dist = Infinity;
      cards.forEach(function (c, n) {
        var d = Math.abs(c.offsetLeft - left);
        if (d < dist) { dist = d; best = n; }
      });
      if (track.scrollLeft >= track.scrollWidth - track.clientWidth - 2 && window.innerWidth < 990) best = cards.length - 1;
      current = -1;
      setActive(best);
    }
    var raf = 0;
    track.addEventListener('scroll', function () { cancelAnimationFrame(raf); raf = requestAnimationFrame(measure); }, { passive: true });
    chips.forEach(function (c) { c.addEventListener('click', function () { go(+c.getAttribute('data-go')); }); });
    prev.addEventListener('click', function () { go(current - 1); });
    next.addEventListener('click', function () { go(current + 1); });
    window.addEventListener('resize', measure);
    measure();
  })();
</script>

{% schema %}
{
  "name": "OC: Science table",
  "tag": "div",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Every Ingredient, Researched." },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "header", "content": "Card labels" },
    { "type": "text", "id": "chips_label", "label": "Ingredient bar label (screen readers)", "default": "Ingredients" },
    { "type": "text", "id": "evidence_label", "label": "Study label", "default": "The study" },
    { "type": "text", "id": "outcome_label", "label": "Result label", "default": "What they found" },
    { "type": "header", "content": "Style" },
    { "type": "color_background", "id": "background", "label": "Background override", "info": "Empty = #00204B with a soft radial glow." }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Study card",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon", "info": "PNG/SVG, square. Empty = default chart icon." },
        { "type": "text", "id": "benefit", "label": "Ingredient", "default": "Ingredient" },
        { "type": "text", "id": "dose", "label": "Dose pill", "default": "100mg" },
        { "type": "text", "id": "evidence", "label": "The study", "default": "Randomized controlled trial" },
        { "type": "text", "id": "outcome", "label": "What they found", "default": "Outcome" },
        { "type": "text", "id": "study", "label": "Citation", "default": "PMID: 00000000" },
        { "type": "url", "id": "study_link", "label": "Citation link (optional)" }
      ]
    }
  ],
  "presets": [
    { "name": "OC: Science table", "blocks": [ { "type": "row" }, { "type": "row" }, { "type": "row" } ] }
  ]
}
{% endschema %}
