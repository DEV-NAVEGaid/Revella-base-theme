{%- comment -%} Stats with donut rings — Dawn 16 {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }}{
    background:{{ section.settings.section_bg }};
    margin-top:0 !important;
    --bio-sd-fs:{{ section.settings.font_scale }};
    --bio-sd-ring:{{ section.settings.ring_color }};
    --bio-sd-track:{{ section.settings.ring_track }};
    --bio-sd-size:{{ section.settings.ring_size }}px;
  }
  .bio-sd{ padding:{{ section.settings.padding_top | times: 0.7 | round }}px 0 {{ section.settings.padding_bottom | times: 0.7 | round }}px; overflow-x:clip; }
  .bio-sd *,.bio-sd *::before,.bio-sd *::after{ box-sizing:border-box; min-width:0; }
  .bio-sd img{ max-width:100%; display:block; }

  .bio-sd__head{ text-align:{{ section.settings.text_align }}; margin-bottom:18px; }
  .bio-sd__title{ margin:0 0 8px; font-size:calc({{ section.settings.heading_size }}rem * var(--bio-sd-fs)); line-height:1.2; font-weight:800; letter-spacing:-.02em; }
  .bio-sd__intro{ margin:0 auto; max-width:620px; font-size:calc({{ section.settings.intro_size }}rem * var(--bio-sd-fs)); line-height:1.5; opacity:.85; }
  .bio-sd__intro p{ margin:0; }

  .bio-sd__media{ border-radius:{{ section.settings.image_radius }}px; overflow:hidden; margin-bottom:20px;
    position:relative; width:100%; height:0; padding-top:calc({{ section.settings.image_ratio }} * 100%); background:rgba(0,0,0,.06); }
  .bio-sd__media img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }

  .bio-sd__list{ display:grid; grid-template-columns:minmax(0,1fr); }
  .bio-sd__row{ display:flex; align-items:center; gap:{{ section.settings.row_gap }}px; padding:{{ section.settings.row_padding }}px 0;
    border-top:1px solid {{ section.settings.divider_color }}; }
  .bio-sd__row:last-child{ border-bottom:1px solid {{ section.settings.divider_color }}; }
  .bio-sd__ring{ flex:0 0 var(--bio-sd-size); width:var(--bio-sd-size); height:var(--bio-sd-size); position:relative; }
  .bio-sd__ring svg{ width:100%; height:100%; transform:rotate(-90deg); }
  .bio-sd__ring circle{ fill:none; stroke-linecap:round; }
  .bio-sd__ring .bio-sd__bg{ stroke:var(--bio-sd-track); }
  .bio-sd__ring .bio-sd__fg{ stroke:var(--bio-sd-ring); transition:stroke-dashoffset 1.1s ease; }
  .bio-sd__val{ position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    font-size:calc({{ section.settings.value_size }}rem * var(--bio-sd-fs)); font-weight:800; color:{{ section.settings.value_color }}; }
  .bio-sd__txt{ flex:1 1 auto; font-size:calc({{ section.settings.text_size }}rem * var(--bio-sd-fs)); line-height:1.5; }
  .bio-sd__txt p{ margin:0; }

  @media screen and (min-width:750px){
    .bio-sd{ padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
    .bio-sd__grid{ display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:44px; align-items:center; }
    .bio-sd__media{ margin-bottom:0; {% if section.settings.image_position == 'right' %}order:2;{% endif %} }
  }
</style>

<div class="bio-sd color-{{ section.settings.color_scheme }}" id="bio-sd-{{ section.id }}">
  <div class="page-width">
    <div class="bio-sd__head">
      {%- if section.settings.heading != blank -%}<h2 class="bio-sd__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<div class="bio-sd__intro rte">{{ section.settings.intro }}</div>{%- endif -%}
    </div>

    <div class="bio-sd__grid">
      {%- if section.settings.show_image -%}
        <div class="bio-sd__media">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '375,550,750,1100,1200', sizes: '(min-width:750px) 50vw, 100vw', alt: section.settings.heading | escape }}
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="bio-sd__list">
        {%- for block in section.blocks -%}
          {%- assign pct = block.settings.percent -%}
          <div class="bio-sd__row" {{ block.shopify_attributes }}>
            <div class="bio-sd__ring" data-bio-sd-ring data-pct="{{ pct }}">
              <svg viewBox="0 0 42 42" aria-hidden="true">
                <circle class="bio-sd__bg" cx="21" cy="21" r="18" stroke-width="{{ section.settings.ring_thickness }}"></circle>
                <circle class="bio-sd__fg" cx="21" cy="21" r="18" stroke-width="{{ section.settings.ring_thickness }}"
                  stroke-dasharray="113.1" stroke-dashoffset="113.1"></circle>
              </svg>
              <span class="bio-sd__val">{{ pct }}{{ section.settings.value_suffix }}</span>
            </div>
            <div class="bio-sd__txt rte">{{ block.settings.text }}</div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  var id='{{ section.id }}';
  function init(){
    var root=document.getElementById('bio-sd-'+id); if(!root||root.dataset.init)return; root.dataset.init='1';
    var rings=[].slice.call(root.querySelectorAll('[data-bio-sd-ring]'));
    if(!rings.length)return;
    var C=113.1;
    function fill(el){
      var pct=Math.max(0,Math.min(100,parseFloat(el.dataset.pct)||0));
      el.querySelector('.bio-sd__fg').style.strokeDashoffset=C-(C*pct/100);
    }
    if(!('IntersectionObserver' in window)){ rings.forEach(fill); return; }
    var io=new IntersectionObserver(function(en){
      en.forEach(function(e){ if(e.isIntersecting){ fill(e.target); io.unobserve(e.target); } });
    },{threshold:.4});
    rings.forEach(function(r){ io.observe(r); });
  }
  init();
  document.addEventListener('shopify:section:load',function(e){ if(e.detail&&e.detail.sectionId===id)init(); });
})();
</script>

{% schema %}
{
  "name": "Bio: Stats Donut",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#FFFFFF" },
    { "type": "range", "id": "font_scale", "min": 0.6, "max": 1.2, "step": 0.1, "label": "Font scale", "default": 1 },

    { "type": "header", "content": "Header" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Turmeric Isn't Optional Anymore" },
    { "type": "richtext", "id": "intro", "label": "Intro text" },
    { "type": "select", "id": "text_align", "label": "Header alignment", "default": "center",
      "options": [ {"value":"left","label":"Left"},{"value":"center","label":"Center"} ] },
    { "type": "range", "id": "heading_size", "min": 2.0, "max": 5.0, "step": 0.1, "unit": "rem", "label": "Heading size", "default": 2.8 },
    { "type": "range", "id": "intro_size", "min": 1.2, "max": 2.2, "step": 0.1, "unit": "rem", "label": "Intro size", "default": 1.5 },

    { "type": "header", "content": "Image" },
    { "type": "checkbox", "id": "show_image", "label": "Show image", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "image_ratio", "min": 0.5, "max": 1.8, "step": 0.1, "label": "Image height (× width)", "default": 0.9 },
    { "type": "range", "id": "image_radius", "min": 0, "max": 30, "step": 1, "unit": "px", "label": "Image radius", "default": 10 },
    { "type": "select", "id": "image_position", "label": "Image position (desktop)", "default": "left",
      "options": [ {"value":"left","label":"Left"},{"value":"right","label":"Right"} ] },

    { "type": "header", "content": "Stat rows" },
    { "type": "range", "id": "ring_size", "min": 40, "max": 110, "step": 2, "unit": "px", "label": "Ring size", "default": 62 },
    { "type": "range", "id": "ring_thickness", "min": 1, "max": 8, "step": 0.5, "label": "Ring thickness", "default": 3.5 },
    { "type": "color", "id": "ring_color", "label": "Ring color", "default": "#0F5132" },
    { "type": "color", "id": "ring_track", "label": "Ring track color", "default": "#E4E4E1" },
    { "type": "color", "id": "value_color", "label": "Value color", "default": "#0F5132" },
    { "type": "range", "id": "value_size", "min": 1.2, "max": 2.4, "step": 0.1, "unit": "rem", "label": "Value size", "default": 1.5 },
    { "type": "text", "id": "value_suffix", "label": "Value suffix", "default": "%" },
    { "type": "range", "id": "text_size", "min": 1.1, "max": 2.0, "step": 0.1, "unit": "rem", "label": "Text size", "default": 1.4 },
    { "type": "range", "id": "row_gap", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Space ring to text", "default": 16 },
    { "type": "range", "id": "row_padding", "min": 6, "max": 40, "step": 2, "unit": "px", "label": "Row padding", "default": 16 },
    { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#E4E4E1" },

    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    { "type": "stat", "name": "Stat", "settings": [
      { "type": "range", "id": "percent", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Percent", "default": 73 },
      { "type": "richtext", "id": "text", "label": "Text" } ] }
  ],
  "presets": [
    { "name": "Bio: Stats Donut",
      "settings": { "heading": "Why Turmeric Isn't Optional Anymore" },
      "blocks": [
        { "type": "stat", "settings": { "percent": 73, "text": "<p>of adults report experiencing muscle or joint pain at least once a week</p>" } },
        { "type": "stat", "settings": { "percent": 90, "text": "<p>of turmeric supplements contain weak doses or poor-quality powder</p>" } },
        { "type": "stat", "settings": { "percent": 82, "text": "<p>82% of users report feeling less joint stiffness within 30 days</p>" } },
        { "type": "stat", "settings": { "percent": 80, "text": "<p>reduction in inflammation markers shown in clinical trials using curcumin</p>" } }
      ]
    }
  ]
}
{% endschema %}