    { "type": "select", "id": "heading_weight", "label": "Heading weight", "options": [{ "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra Bold" }, { "value": "900", "label": "Black" }], "default": "900" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#000000" },
    { "type": "range", "id": "heading_gap", "label": "Heading gap (px)", "min": 4, "max": 30, "step": 2, "default": 12 },

    { "type": "header", "content": "Subtitle" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Find answers to common questions about our products, shipping, returns, and more." },
    { "type": "range", "id": "subtitle_size", "label": "Subtitle size (px)", "min": 13, "max": 20, "step": 1, "default": 16 },
