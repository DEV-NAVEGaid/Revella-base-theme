{%- style -%}
  #amua-faq-{{ section.id }},
  #amua-faq-{{ section.id }} * { box-sizing: border-box; }

  #amua-faq-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
  }

  .amua-faq { max-width: 800px; margin: 0 auto; }

  /* ── Heading ── */
  .amua-faq__heading {
    text-align: center;
    margin: 0 0 {{ section.settings.heading_gap }}px;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    color: {{ section.settings.heading_color }};
    line-height: 1.15;
  }

  /* ── Subtitle ── */
  .amua-faq__subtitle {
    text-align: center;
    margin: 0 0 {{ section.settings.subtitle_gap }}px;
    font-size: {{ section.settings.subtitle_size }}px;
    color: {{ section.settings.subtitle_color }};
    line-height: 1.55;
  }

  /* ── Container ── */
  .amua-faq__list {
    border: {{ section.settings.container_border_width }}px solid {{ section.settings.container_border_color }};
    border-radius: {{ section.settings.container_radius }}px;
    overflow: hidden;
  }

  /* ── Item ── */
  .amua-faq__item {
    border-bottom: 1px solid {{ section.settings.divider_color }};
  }
  .amua-faq__item:last-child { border-bottom: none; }

  /* ── Question (summary) ── */
  .amua-faq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: {{ section.settings.q_padding_v }}px {{ section.settings.q_padding_h }}px;
    cursor: pointer;
    gap: 12px;
    list-style: none;
    background: {{ section.settings.q_bg }};
    font-size: {{ section.settings.q_size }}px;
    font-weight: {{ section.settings.q_weight }};
    color: {{ section.settings.q_color }};
    line-height: 1.4;
  }
  .amua-faq__q::-webkit-details-marker { display: none; }
  .amua-faq__q::marker { display: none; }

  /* ── Toggle icon ── */
  .amua-faq__toggle {
    flex-shrink: 0;
    font-size: {{ section.settings.toggle_size }}px;
    font-weight: 300;
    color: {{ section.settings.toggle_color }};
    transition: transform 0.25s;
    line-height: 1;
    width: 24px;
    text-align: center;
  }
  .amua-faq__item[open] .amua-faq__toggle { transform: rotate(45deg); }

  /* ── Answer ── */
  .amua-faq__a {
    padding: 0 {{ section.settings.q_padding_h }}px {{ section.settings.a_padding_b }}px;
    font-size: {{ section.settings.a_size }}px;
    color: {{ section.settings.a_color }};
    line-height: 1.6;
    background: {{ section.settings.a_bg }};
  }
  .amua-faq__a p { margin: 0; }

  @media (min-width: 990px) {
    #amua-faq-{{ section.id }} { padding-left: 50px; padding-right: 50px; }
  }
{%- endstyle -%}

<section id="amua-faq-{{ section.id }}">
  <div class="amua-faq">

    {%- if section.settings.heading != blank -%}
      <h2 class="amua-faq__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="amua-faq__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    <div class="amua-faq__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'item' and block.settings.question != blank -%}
          <details class="amua-faq__item" {{ block.shopify_attributes }}{% if section.settings.accordion_mode %} data-amua-accordion{% endif %}>
            <summary class="amua-faq__q">
              <span>{{ block.settings.question }}</span>
              <span class="amua-faq__toggle">+</span>
            </summary>
            <div class="amua-faq__a rte">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{%- if section.settings.accordion_mode -%}
<script>
(function(){
  var wrap = document.getElementById('amua-faq-{{ section.id }}');
  if (!wrap) return;
  wrap.addEventListener('toggle', function(e) {
    if (!e.target.open) return;
    wrap.querySelectorAll('details[data-amua-accordion]').forEach(function(d) {
      if (d !== e.target) d.removeAttribute('open');
    });
  }, true);
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Amua: FAQ",
  "tag": "section",
  "class": "amua-section",
  "settings": [
    { "type": "header", "content": "Heading" },
