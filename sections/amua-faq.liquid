    { "type": "color", "id": "container_border_color", "label": "Border color", "default": "#E5E5E5" },
    { "type": "range", "id": "container_radius", "label": "Border radius (px)", "min": 0, "max": 20, "step": 2, "default": 8 },
    { "type": "color", "id": "divider_color", "label": "Row divider color", "default": "#E5E5E5" },

    { "type": "header", "content": "Question" },
    { "type": "range", "id": "q_size", "label": "Font size (px)", "min": 14, "max": 20, "step": 1, "default": 16 },
    { "type": "select", "id": "q_weight", "label": "Font weight", "options": [{ "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semi Bold" }], "default": "400" },
    { "type": "color", "id": "q_color", "label": "Text color", "default": "#000000" },
    { "type": "color", "id": "q_bg", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "q_padding_v", "label": "Padding vertical (px)", "min": 10, "max": 28, "step": 2, "default": 18 },
    { "type": "range", "id": "q_padding_h", "label": "Padding horizontal (px)", "min": 10, "max": 28, "step": 2, "default": 20 },

    { "type": "header", "content": "Answer" },
    { "type": "range", "id": "a_size", "label": "Font size (px)", "min": 13, "max": 18, "step": 1, "default": 15 },
    { "type": "color", "id": "a_color", "label": "Text color", "default": "#333333" },
    { "type": "color", "id": "a_bg", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "a_padding_b", "label": "Padding bottom (px)", "min": 8, "max": 28, "step": 2, "default": 18 },

    { "type": "header", "content": "Toggle Icon" },
    { "type": "range", "id": "toggle_size", "label": "Size (px)", "min": 18, "max": 32, "step": 1, "default": 24 },
    { "type": "color", "id": "toggle_color", "label": "Color", "default": "#333333" },

    { "type": "header", "content": "Behavior" },
    { "type": "checkbox", "id": "accordion_mode", "label": "One open at a time", "default": true },

    { "type": "header", "content": "Section" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 60 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
