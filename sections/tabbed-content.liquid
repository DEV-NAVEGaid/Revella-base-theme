          "label": "Closing statement (optional, bold)",
          "info": "Shown below the body content, e.g. a key takeaway line."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabbed Content",
      "blocks": [
        {
          "type": "tab",
          "settings": {
