  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab label",
          "default": "Tab Label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Content heading",
          "default": "Content Heading"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Body content",
          "default": "<p>Add your tab content here.</p>"
        },
        {
          "type": "richtext",
