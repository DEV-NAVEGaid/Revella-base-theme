{% comment %}
  Tabbed Content Section
  - Pill-style tab nav switches between content panels (image + heading + rich text)
  - Each tab is a repeatable block, fully editable in the theme editor
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign tab_blocks = section.blocks | where: 'type', 'tab'
-%}

<style>
  #shopify-section-{{ sid }} {
    background-color: {{ section.settings.section_bg_color }};
    padding-top: {{ section.settings.section_padding_top_mobile }}px;
    padding-bottom: {{ section.settings.section_padding_bottom_mobile }}px;
  }

  @media (min-width: 750px) {
    #shopify-section-{{ sid }} {
      padding-top: {{ section.settings.section_padding_top_desktop }}px;
      padding-bottom: {{ section.settings.section_padding_bottom_desktop }}px;
    }
  }

  /* ── Container ── */
  .tc-inner-{{ sid }} {
    max-width: {{ section.settings.max_width }}px;
    margin-left: auto;
    margin-right: auto;
    padding-left: {{ section.settings.section_padding_x_mobile }}px;
    padding-right: {{ section.settings.section_padding_x_mobile }}px;
  }

  @media (min-width: 750px) {
    .tc-inner-{{ sid }} {
      padding-left: {{ section.settings.section_padding_x_desktop }}px;
      padding-right: {{ section.settings.section_padding_x_desktop }}px;
    }
  }

  /* ── Heading ── */
  .tc-heading-{{ sid }} {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-weight: {{ section.settings.heading_font.weight }};
    font-size: {{ section.settings.heading_size_mobile }}px;
    color: {{ section.settings.heading_color }};
    text-align: {{ section.settings.heading_align }};
    line-height: 1.25;
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px;
  }

  @media (min-width: 750px) {
    .tc-heading-{{ sid }} {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }
  }

  /* ── Tab nav ── */
  .tc-nav-wrap-{{ sid }} {
    display: flex;
    justify-content: {{ section.settings.nav_align }};
    margin-bottom: {{ section.settings.nav_margin_bottom }}px;
  }

  .tc-nav-{{ sid }} {
    display: inline-flex;
    flex-wrap: wrap;
    gap: {{ section.settings.nav_gap }}px;
    background-color: {{ section.settings.nav_bg_color }};
    border: 1px solid {{ section.settings.nav_border_color }};
    border-radius: {{ section.settings.tab_radius }}px;
    padding: 4px;
    width: 100%;
  }

  .tc-tab-{{ sid }} {
    flex: 1;
    appearance: none;
    cursor: pointer;
    border: none;
    background-color: transparent;
    color: {{ section.settings.tab_inactive_text_color }};
    font-family: {{ section.settings.tab_font.family }}, {{ section.settings.tab_font.fallback_families }};
    font-weight: {{ section.settings.tab_font.weight }};
    font-size: {{ section.settings.tab_font_size_mobile }}px;
    border-radius: {{ section.settings.tab_radius | minus: 4 | at_least: 0 }}px;
    padding: {{ section.settings.tab_padding_v }}px {{ section.settings.tab_padding_h }}px;
    transition: background-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }
  

  @media (min-width: 750px) {
    .tc-tab-{{ sid }} {
      font-size: {{ section.settings.tab_font_size_desktop }}px;
    }
  }

  .tc-tab-{{ sid }}:hover {
    color: {{ section.settings.tab_active_text_color }};
  }

  .tc-tab-{{ sid }}.is-active {
    background-color: {{ section.settings.tab_active_bg }};
    color: {{ section.settings.tab_active_text_color }};
  }

  .tc-tab-{{ sid }}:focus-visible {
    outline: 2px solid {{ section.settings.tab_active_bg }};
    outline-offset: 2px;
  }

  /* ── Panels ── */
  .tc-panel-{{ sid }} {
    display: block;
  }

  .tc-panel-{{ sid }}[hidden] {
    display: none;
  }

  .tc-panel-grid-{{ sid }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.content_gap_mobile }}px;
    align-items: center;
  }

  @media (min-width: 750px) {
    .tc-panel-grid-{{ sid }} {
      grid-template-columns: 1fr 1fr;
      gap: {{ section.settings.content_gap_desktop }}px;
      {%- if section.settings.image_position == 'right' -%}
        direction: rtl;
      {%- endif -%}
    }

    .tc-panel-grid-{{ sid }} > * {
      {%- if section.settings.image_position == 'right' -%}
        direction: ltr;
      {%- endif -%}
    }
  }

  .tc-panel-grid-{{ sid }}.tc-panel-grid--no-image {
    grid-template-columns: 1fr;
  }

  /* ── Image ── */
  .tc-image-wrap-{{ sid }} {
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    background-color: {{ section.settings.image_bg_color }};
  }

  .tc-image-wrap-{{ sid }} img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    display: block;
  }

  /* ── Content ── */
  .tc-content-heading-{{ sid }} {
    font-family: {{ section.settings.content_heading_font.family }}, {{ section.settings.content_heading_font.fallback_families }};
    font-weight: {{ section.settings.content_heading_font.weight }};
    font-size: {{ section.settings.content_heading_size_mobile }}px;
    color: {{ section.settings.content_heading_color }};
    line-height: 1.25;
    margin: 0 0 {{ section.settings.content_heading_margin_bottom }}px;
  }

  @media (min-width: 750px) {
    .tc-content-heading-{{ sid }} {
      font-size: {{ section.settings.content_heading_size_desktop }}px;
    }
  }

  .tc-body-{{ sid }},
  .tc-closing-{{ sid }} {
    font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    font-weight: {{ section.settings.body_font.weight }};
    font-size: {{ section.settings.body_size_mobile }}px;
    color: {{ section.settings.body_color }};
    line-height: {{ section.settings.body_line_height | times: 0.1 | plus: 1.0 }};
  }

  @media (min-width: 750px) {
    .tc-body-{{ sid }},
    .tc-closing-{{ sid }} {
      font-size: {{ section.settings.body_size_desktop }}px;
    }
  }

  .tc-body-{{ sid }} p,
  .tc-body-{{ sid }} ul {
    margin: 0 0 {{ section.settings.body_paragraph_spacing }}px;
  }

  .tc-body-{{ sid }} p:last-child,
  .tc-body-{{ sid }} ul:last-child {
    margin-bottom: 0;
  }

  .tc-body-{{ sid }} ul {
    padding-left: 1.2em;
  }

  .tc-body-{{ sid }} li {
    margin-bottom: 0.4em;
  }

  .tc-body-{{ sid }} li:last-child {
    margin-bottom: 0;
  }

  .tc-body-{{ sid }} strong,
  .tc-closing-{{ sid }} strong {
    font-weight: {{ section.settings.body_bold_weight }};
    color: {{ section.settings.body_bold_color }};
  }

  .tc-closing-{{ sid }} {
    margin-top: {{ section.settings.closing_margin_top }}px;
  }

  .tc-closing-{{ sid }} p {
    margin: 0;
  }

</style>

{% if tab_blocks.size > 0 %}
  <div class="tc-inner-{{ sid }}">

    {%- if section.settings.heading != blank -%}
      <h2 class="tc-heading-{{ sid }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="tc-nav-wrap-{{ sid }}">
      <div class="tc-nav-{{ sid }}" role="tablist" aria-label="{{ section.settings.heading | escape }}">
        {%- for block in tab_blocks -%}
          <button
            type="button"
            class="tc-tab-{{ sid }}{% if forloop.first %} is-active{% endif %}"
            id="tc-tab-{{ sid }}-{{ forloop.index0 }}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="tc-panel-{{ sid }}-{{ forloop.index0 }}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            data-tc-tab="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.tab_label | escape }}
          </button>
        {%- endfor -%}
      </div>
    </div>

    <div class="tc-panels-{{ sid }}" style="padding:0px 12px">
      {%- for block in tab_blocks -%}
        <div
          class="tc-panel-{{ sid }}{% if forloop.first %} is-active{% endif %}"
          id="tc-panel-{{ sid }}-{{ forloop.index0 }}"
          role="tabpanel"
          aria-labelledby="tc-tab-{{ sid }}-{{ forloop.index0 }}"
          {% unless forloop.first %}hidden{% endunless %}
        >
          <div class="tc-panel-grid-{{ sid }}{% if block.settings.image == blank %} tc-panel-grid--no-image{% endif %}">

            {%- if block.settings.image != blank -%}
              <div class="tc-image-wrap-{{ sid }}">
                <img
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  alt="{{ block.settings.image.alt | escape | default: block.settings.heading | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              </div>
            {%- endif -%}

            <div class="tc-content-{{ sid }}">
              {%- if block.settings.heading != blank -%}
                <h3 class="tc-content-heading-{{ sid }}">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.content != blank -%}
                <div class="tc-body-{{ sid }}">{{ block.settings.content }}</div>
              {%- endif -%}

              {%- if block.settings.closing_text != blank -%}
                <div class="tc-closing-{{ sid }}">{{ block.settings.closing_text }}</div>
              {%- endif -%}
            </div>

          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
{% endif %}

<script>
  (function() {
    var sid = {{ sid | json }};
    var root = document.getElementById('shopify-section-' + sid);
    if (!root) return;

    var tabs = Array.prototype.slice.call(root.querySelectorAll('.tc-tab-' + sid));
    var panels = Array.prototype.slice.call(root.querySelectorAll('.tc-panel-' + sid));

    function activate(index, focusTab) {
      tabs.forEach(function(tab, i) {
        var active = i === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.tabIndex = active ? 0 : -1;
        if (active && focusTab) tab.focus();
      });
      panels.forEach(function(panel, i) {
        var active = i === index;
        panel.classList.toggle('is-active', active);
        if (active) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      });
    }

    tabs.forEach(function(tab, i) {
      tab.addEventListener('click', function() {
        activate(i, false);
      });

      tab.addEventListener('keydown', function(e) {
        var newIndex = null;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          newIndex = (i + 1) % tabs.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          newIndex = (i - 1 + tabs.length) % tabs.length;
        } else if (e.key === 'Home') {
          newIndex = 0;
        } else if (e.key === 'End') {
          newIndex = tabs.length - 1;
        }
        if (newIndex !== null) {
          e.preventDefault();
          activate(newIndex, true);
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Tabbed Content",
  "tag": "section",
  "class": "tabbed-content-section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover Why Experts Trust [Product]"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font family",
      "default": "sans-serif"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Font size – Desktop (px)",
      "min": 16, "max": 60, "step": 1, "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Font size – Mobile (px)",
      "min": 14, "max": 40, "step": 1, "default": 24
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Margin below heading (px)",
      "min": 0, "max": 60, "step": 2, "default": 28
    },
    {
      "type": "header",
      "content": "Tab navigation"
    },
    {
      "type": "select",
