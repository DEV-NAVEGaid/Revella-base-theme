  <a class="btn btn--primary" href="{{ cta_url }}" data-stockcheck aria-label="Check REVELLA stock">Check stock</a>
</div>
{% endif %}

<script>
(function(){
  var lp=document.getElementById('rvla-{{ section.id }}');
  if(!lp)return;
  lp.classList.add('is-js');
  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var reveals=lp.querySelectorAll('.reveal');
  if(reduce||!('IntersectionObserver' in window)){
    reveals.forEach(function(el){el.classList.add('is-in');});
  } else {
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('is-in'); io.unobserve(e.target); } });
    },{rootMargin:'0px 0px -8% 0px',threshold:0.2});
    reveals.forEach(function(el){io.observe(el);});
  }

  var scta=lp.querySelector('.scta');
  var hero=lp.querySelector('.hero');
  if(scta&&hero&&'IntersectionObserver' in window){
    var s=new IntersectionObserver(function(entries){
      var past=!entries[0].isIntersecting;
      scta.classList.toggle('is-visible',past);
      scta.setAttribute('aria-hidden',past?'false':'true');
      scta.toggleAttribute('inert',!past);
    },{threshold:0});
    s.observe(hero);
  }

  lp.querySelectorAll('.acc__btn').forEach(function(btn){
    btn.addEventListener('click',function(){
      btn.setAttribute('aria-expanded',String(btn.getAttribute('aria-expanded')!=='true'));
    });
  });

  /* ---- Stock check interstitial ---- */
  var sc=lp.querySelector('.stockcheck');
  if(sc){
    var CIRC=2*Math.PI*70, DURATION=12000, REDIRECT_DELAY=2600;
    var bar=sc.querySelector('#sc-bar'), pct=sc.querySelector('#sc-pct');
    var check=sc.querySelector('#sc-check'), title=sc.querySelector('#sc-title');
    var sub=sc.querySelector('#sc-sub'), done=sc.querySelector('#sc-done');
    var live=sc.querySelector('#sc-live');
    var stepEls=sc.querySelectorAll('.sc__step');
    var STEPS=[
      {at:2600,checking:'Checking West Coast warehouse',res:'Out of stock',cls:'out',badge:'muted',icon:'x',say:'West Coast warehouse: out of stock.'},
      {at:5400,checking:'Checking Central warehouse',res:'Out of stock',cls:'out',badge:'muted',icon:'x',say:'Central warehouse: out of stock.'},
      {at:8200,checking:'Checking East Coast warehouse',res:'In stock · running low',cls:'low',badge:'warn',icon:'check',say:'East Coast warehouse: in stock, running low.'},
      {at:11000,checking:'Verifying current promotions',res:'70% off active',cls:'offer',badge:'ok',icon:'check',say:'Current promotions: 70% off is active.'}
    ];
    var ICONS={
      x:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>',
      check:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>'
    };
    var timer=null, redirTimer=null, trigger=null, redirectTarget='#';

    function setMark(i,html){stepEls[i].querySelector('.sc__mark').innerHTML=html;}
    function reset(){
      title.textContent='Checking REVELLA availability';
      sub.textContent='Hold on, this takes a few seconds.';
      pct.textContent='0%'; pct.hidden=false; check.hidden=true; done.hidden=true; live.textContent='';
      bar.style.strokeDashoffset=CIRC;
      stepEls.forEach(function(el,i){
        el.classList.remove('is-active');
        setMark(i,'<span class="sc__dot"></span>');
        var r=el.querySelector('.sc__res'); r.textContent=''; r.className='sc__res';
      });
    }
    function activate(i){
      stepEls[i].classList.add('is-active');
      setMark(i,'<span class="sc__dot sc__dot--spin"></span>');
      sub.textContent=STEPS[i].checking+'…';
    }
    function resolveStep(i){
      var s=STEPS[i];
      stepEls[i].classList.remove('is-active');
      setMark(i,'<span class="sc__badge sc__badge--'+s.badge+'">'+ICONS[s.icon]+'</span>');
      var r=stepEls[i].querySelector('.sc__res');
      r.textContent=s.res; r.className='sc__res sc__res--'+s.cls;
      live.textContent=s.say;
    }
    function complete(){
      pct.hidden=true; check.hidden=false;
      title.textContent="You're in time.";
      sub.textContent='East Coast warehouse has stock and the 70% off offer is active.';
      done.hidden=false;
      live.textContent='Check complete. One warehouse has stock and the 70% off offer is active. Redirecting to the special offer.';
      try{sessionStorage.setItem('revella-sc','1');}catch(e){}
      redirTimer=setTimeout(function(){
        window.location.assign(redirectTarget);
      },REDIRECT_DELAY);
    }
    function closeSC(){
      if(timer){clearInterval(timer);timer=null;}
      if(redirTimer){clearTimeout(redirTimer);redirTimer=null;}
      sc.hidden=true;
      document.documentElement.style.overflow='';
      document.removeEventListener('keydown',onKey);
      if(trigger){trigger.focus();trigger=null;}
    }
    function onKey(e){if(e.key==='Escape'){closeSC();}}
    function openSC(fromEl){
      trigger=fromEl;
      redirectTarget=fromEl.getAttribute('href')||'#';
      reset();
      sc.hidden=false;
      document.documentElement.style.overflow='hidden';
      document.addEventListener('keydown',onKey);
      title.focus();
      var start=performance.now(), next=0;
      var curve=[{t:0,p:0}];
      (function(){
        var segs=11+Math.floor(Math.random()*6),tw=[],pw=[],i,ts=0,ps=0,ct=0,cp=0;
        for(i=0;i<segs;i++){tw.push(.35+Math.random()*Math.random());pw.push(.2+Math.random());}
        for(i=0;i<segs;i++){ts+=tw[i];ps+=pw[i];}
        for(i=0;i<segs;i++){ct+=tw[i]/ts;cp+=pw[i]/ps;curve.push({t:ct*DURATION,p:cp});}
        curve[curve.length-1]={t:DURATION,p:1};
      })();
      function progAt(t){
        if(t<=0)return 0;
        for(var i=1;i<curve.length;i++){
          if(t<=curve[i].t){var a=curve[i-1],b=curve[i];return a.p+(b.p-a.p)*((t-a.t)/((b.t-a.t)||1));}
        }
        return 1;
      }
      activate(0);
      function tick(){
        var t=performance.now()-start;
        var resolved=0;
        while(next<STEPS.length&&t>=STEPS[next].at){
          resolveStep(next); next++;
          if(next<STEPS.length){activate(next);}
        }
        for(var i=0;i<STEPS.length;i++){if(t>=STEPS[i].at)resolved++;}
        var frac=reduce?resolved/STEPS.length:progAt(t);
        bar.style.strokeDashoffset=String(CIRC*(1-frac));
        pct.textContent=Math.round(frac*100)+'%';
        if(t>=DURATION){clearInterval(timer);timer=null;complete();}
      }
      timer=setInterval(tick,50);
    }
    lp.querySelectorAll('[data-stockcheck]').forEach(function(a){
      a.addEventListener('click',function(e){
        var seen=false;
        try{seen=sessionStorage.getItem('revella-sc')==='1';}catch(err){}
        if(seen)return;
        e.preventDefault();
        openSC(a);
      });
    });
  }
})();
</script>

</div>

