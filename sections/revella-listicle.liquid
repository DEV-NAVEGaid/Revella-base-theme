{% comment %}
  REVELLA · 7 Warning Signs · mechanism-explainer listicle lander.
  Ported from the standalone HTML build (REVELLA-7-warning-signs-mechanism-explainer.html).
  All CSS is scoped under .rvla so nothing leaks into the host theme.
  Pair with templates/page.revella-listicle-1.json and layout/landing.liquid.
{% endcomment %}

{% style %}
.rvla{
  --paper:      oklch(0.975 0.018 85);
  --paper-2:    oklch(0.955 0.028 78);
  --ink:        oklch(0.245 0.020 40);
  --ink-soft:   oklch(0.385 0.028 42);
  --ink-faint:  oklch(0.500 0.030 45);
  --accent:     oklch(0.560 0.140 42);
  --accent-deep:oklch(0.445 0.130 39);
  --accent-soft:oklch(0.930 0.045 62);
  --on-accent:  oklch(0.985 0.012 85);
  --warn:       oklch(0.470 0.140 45);
  --line:       oklch(0.880 0.022 70);
  --line-soft:  oklch(0.925 0.016 72);

  --font: "Atkinson Hyperlegible", system-ui, -apple-system, "Segoe UI", sans-serif;
  --text-hero: clamp(2.1rem, 1.5rem + 2.7vw, 3.3rem);
  --text-h2:   clamp(1.7rem, 1.35rem + 1.6vw, 2.4rem);
  --text-lead: clamp(1.3rem, 1.18rem + 0.55vw, 1.55rem);
  --text-base: 1.225rem;
  --text-sm:   1rem;
  --text-xs:   0.9rem;

  --s-2xs:.5rem; --s-xs:.75rem; --s-sm:1rem; --s-md:1.5rem; --s-lg:2rem;
  --s-xl:3rem; --s-2xl:4.5rem;
  --section-y: clamp(3rem, 2rem + 5vw, 6rem);

  --container: 60rem;
  --measure: 40rem;
  --radius: 20px;
  --radius-sm: 14px;
  --shadow-sm: 0 2px 4px oklch(0.4 0.04 40 / .05), 0 6px 22px oklch(0.4 0.05 40 / .07);
  --shadow-md: 0 14px 44px oklch(0.4 0.05 40 / .12);

  font-family:var(--font);
  font-size:var(--text-base);
  line-height:1.7;
  color:var(--ink);
  background:var(--paper);
  -webkit-font-smoothing:antialiased;
  font-kerning:normal;
}

/* ---------------------------------------------------------------- RESET (scoped) */
.rvla *,.rvla *::before,.rvla *::after{box-sizing:border-box}
.rvla *{margin:0}
.rvla img,.rvla svg{display:block;max-width:100%}
.rvla a{color:var(--accent-deep)}
.rvla h1,.rvla h2,.rvla h3{line-height:1.18;letter-spacing:-0.01em;text-wrap:balance;font-weight:700;color:var(--ink)}
.rvla strong,.rvla b{font-weight:700}
.rvla :focus-visible{outline:3px solid var(--accent-deep);outline-offset:3px;border-radius:6px}
.rvla .vh{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}

/* ---------------------------------------------------------------- LAYOUT */
.rvla .container{width:min(100% - 2.5rem, var(--container));margin-inline:auto}
.rvla .measure{max-width:var(--measure)}
.rvla .section{padding-block:var(--section-y)}
.rvla .eyebrow{display:block;font-weight:700;font-size:1rem;color:var(--accent-deep);letter-spacing:.005em;line-height:1.45;text-wrap:balance}
.rvla .eyebrow::before{content:"";display:block;width:34px;height:3px;background:var(--accent);border-radius:2px;margin-bottom:.75rem}
.rvla .skip{position:absolute;left:-999px;top:0;background:var(--accent-deep);color:var(--on-accent);padding:.75rem 1.25rem;z-index:80;font-weight:700;font-size:var(--text-sm)}
.rvla .skip:focus{left:0}

/* ----------------------------------------------------------- ANNOUNCEMENT */
.rvla .announce{background:var(--accent-deep);color:var(--on-accent);text-align:center;font-weight:700;font-size:var(--text-sm);padding:.55rem 1rem;letter-spacing:.02em}

/* ----------------------------------------------------------- MASTHEAD */
.rvla .masthead{border-bottom:1px solid var(--line);background:var(--paper)}
.rvla .masthead__row{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-block:1rem}
.rvla .wordmark{text-decoration:none;font-weight:700;font-size:2.0rem;letter-spacing:.06em;color:var(--ink);display:flex;align-items:center;gap:.55rem;min-height:44px}
.rvla .masthead .btn{white-space:nowrap}

/* ------------------------------------------------------------- BUTTONS */
.rvla .btn{display:inline-flex;align-items:center;justify-content:center;gap:.6rem;font-family:var(--font);font-weight:700;font-size:1.0rem;line-height:1.0;padding:1.05rem 2rem;min-height:56px;border-radius:999px;border:2px solid transparent;cursor:pointer;text-decoration:none;transition:transform .2s,box-shadow .2s,background-color .2s;text-align:center}
.rvla .btn--primary{background:var(--accent-deep);color:var(--on-accent);box-shadow:var(--shadow-sm)}
.rvla .btn--primary:hover{background:oklch(0.40 0.13 40);transform:translateY(-2px);box-shadow:var(--shadow-md)}
.rvla .btn--ghost{background:transparent;color:var(--accent-deep);border-color:var(--accent-deep)}
.rvla .btn--ghost:hover{background:var(--accent-soft)}
.rvla .btn--lg{font-size:1.25rem;padding:1.2rem 2.4rem;min-height:62px}
.rvla .btn svg{transition:transform .2s;flex:none}
.rvla .btn--primary:hover svg{transform:translateX(3px)}

/* --------------------------------------------------------------- HERO */
.rvla .hero{padding-top:clamp(2.25rem,1.5rem + 3.5vw,4rem);padding-bottom:clamp(1.5rem,1rem + 2vw,2.5rem)}
.rvla .hero__copy{max-width:46rem}
.rvla .hero .eyebrow{margin-bottom:1.1rem}
.rvla .hero h1{font-size:var(--text-hero);margin-bottom:1.25rem}
.rvla .hero h1 em{font-style:normal;color:var(--accent-deep)}
.rvla .hero__lede > p{font-size:var(--text-lead);color:var(--ink-soft);max-width:40rem;line-height:1.55}
.rvla .hero__lede > p + p{margin-top:1rem}
.rvla .hero__lede .turn{color:var(--ink);font-weight:700}
.rvla .hero__cta{margin-top:1.9rem;display:flex;flex-wrap:wrap;gap:1rem;align-items:center}
.rvla .hero__cta .microtrust{font-size:var(--text-sm);color:var(--ink-faint)}
.rvla .hero__grid{display:grid;align-items:center}
.rvla .hero__media{position:relative;margin-bottom:1.5rem}
.rvla .hero__media img{width:100%;height:auto;display:block;border-radius:var(--radius);border:1px solid var(--line);box-shadow:var(--shadow-md)}
.rvla .hero__ph{position:relative;aspect-ratio:16/11;border-radius:var(--radius);border:2px dashed var(--line);background:linear-gradient(160deg,var(--accent-soft),var(--paper-2));display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:.75rem;padding:1.75rem 1.5rem 2.4rem;box-shadow:var(--shadow-sm)}
.rvla .hero__ph svg{width:46px;height:46px;color:var(--accent-deep);opacity:.9}
.rvla .hero__ph-scene{color:var(--ink);font-weight:700;max-width:28rem;line-height:1.4}
.rvla .hero__ph-note{position:absolute;bottom:.95rem;left:0;right:0;font-size:var(--text-xs);color:var(--ink-faint);font-weight:400;padding-inline:1rem}
@media(min-width:820px){
  .rvla .hero{padding-top:clamp(2.5rem,1.5rem + 3vw,4.5rem);padding-bottom:clamp(2rem,1.25rem + 2vw,3rem)}
}

/* --------------------------------------------------------- SIGNS (listicle) */
.rvla .signs{display:grid;gap:clamp(2rem,1.25rem + 3vw,3.5rem)}
.rvla .sign{padding-top:clamp(2rem,1.25rem + 3vw,3.25rem);border-top:1px solid var(--line)}
.rvla .sign:first-child{border-top:0;padding-top:0}
.rvla .sign__tag{display:inline-flex;align-items:center;gap:.5rem;font-weight:700;font-size:var(--text-sm);color:var(--on-accent);background:var(--warn);padding:.4rem .9rem .4rem .7rem;border-radius:999px;margin-bottom:1rem;letter-spacing:.02em}
.rvla .sign__tag svg{width:18px;height:18px;flex:none}
.rvla .sign h3{font-size:clamp(1.5rem,1.2rem + 1.5vw,2.15rem);margin-bottom:1.1rem;max-width:34rem}
.rvla .sign p{color:var(--ink-soft);max-width:var(--measure)}
.rvla .sign p + p{margin-top:1rem}
.rvla .sign__body + .sign__body{margin-top:1rem}
.rvla .sign p b,.rvla .sign p strong{color:var(--ink)}
.rvla .sign__close{color:var(--ink);font-weight:700;border-left:4px solid var(--accent);padding-left:1.1rem;margin-top:1.4rem;max-width:var(--measure)}

/* callout box */
.rvla .callout{margin:1.5rem 0;background:var(--paper-2);border:1px solid var(--line);border-left:6px solid var(--accent-deep);border-radius:var(--radius-sm);padding:1.4rem 1.5rem}
.rvla .callout p{color:var(--ink);font-weight:700;font-size:clamp(1.25rem,1.1rem + .5vw,1.45rem);line-height:1.45;max-width:44rem}
.rvla .callout .callout__k{display:block;font-size:var(--text-xs);font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent-deep);margin-bottom:.6rem}

/* testimonial */
.rvla .tmi{margin:1.6rem 0;background:var(--paper-2);border:1px solid var(--line);border-radius:var(--radius-sm);padding:1.5rem 1.6rem;display:grid;grid-template-columns:auto 1fr;gap:1.1rem 1.25rem;align-items:start}
.rvla .tmi__av{flex:none;width:52px;height:52px;border-radius:50%;background:var(--accent-soft);color:var(--accent-deep);display:grid;place-items:center;font-weight:700;font-size:1.2rem;border:2px solid var(--line)}
.rvla .tmi__q{grid-column:2;color:var(--ink);font-weight:700;font-size:clamp(1.2rem,1.1rem + .4vw,1.4rem);line-height:1.45}
.rvla .tmi__by{grid-column:2;margin-top:.7rem;font-size:var(--text-sm);color:var(--ink-soft);font-weight:700}

/* image slot */
.rvla .figph{margin:1.6rem 0}
.rvla .figph__box{position:relative;background:var(--paper-2);border:2px dashed var(--line);border-radius:var(--radius-sm);aspect-ratio:16/9;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:.6rem;padding:1.5rem}
.rvla .figph__box svg{width:40px;height:40px;color:var(--ink-faint)}
.rvla .figph__scene{color:var(--ink-soft);font-weight:700;max-width:34rem;line-height:1.4}
.rvla .figph__note{position:absolute;bottom:.7rem;left:0;right:0;font-size:var(--text-xs);color:var(--ink-faint);font-weight:400}
.rvla .figph__img{display:block;width:100%;height:auto;border-radius:var(--radius-sm);border:1px solid var(--line);box-shadow:var(--shadow-sm)}
.rvla .figph__link{display:block;border-radius:var(--radius-sm);text-decoration:none;transition:transform .2s,box-shadow .2s}
.rvla .figph__link:hover{transform:translateY(-2px)}
.rvla .figph__link:hover .figph__img{box-shadow:var(--shadow-md)}
.rvla .medialink{display:block;border-radius:var(--radius-sm);text-decoration:none;transition:transform .2s,box-shadow .2s}
.rvla .medialink:hover{transform:translateY(-2px);box-shadow:var(--shadow-md)}

/* inline mid-listicle CTA */
.rvla .inlinecta{margin:1.7rem 0 0;background:var(--accent-soft);border:1px solid var(--line);border-radius:var(--radius-sm);padding:1.35rem 1.5rem;display:flex;flex-wrap:wrap;gap:1rem 1.5rem;align-items:center;justify-content:space-between}
.rvla .inlinecta p{color:var(--ink);font-weight:700;max-width:32rem;margin:0}

/* --------------------------------------------------------- REVEAL / BRIDGE */
.rvla .reveal-sec{background:var(--paper-2);border-block:1px solid var(--line)}
.rvla .reveal-sec__in{padding-block:var(--section-y);max-width:44rem}
.rvla .reveal-sec .eyebrow{margin-bottom:1.1rem}
.rvla .reveal-sec h2{font-size:var(--text-h2);margin-bottom:1.1rem}
.rvla .reveal-sec p{color:var(--ink-soft);max-width:42rem}
.rvla .reveal-sec p + p{margin-top:1rem}
.rvla .reveal-sec p b{color:var(--ink)}
.rvla .reveal-sec .kicker{font-size:clamp(1.4rem,1.2rem + .9vw,1.85rem);line-height:1.4;font-weight:700;color:var(--ink);margin-top:1.4rem}
.rvla .reveal-sec .kicker .hl{color:var(--accent-deep)}
.rvla .dimlist{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1rem}
.rvla .dimlist span{font-weight:700;color:var(--ink-soft);background:var(--paper);border:1px solid var(--line);border-radius:999px;padding:.35rem .85rem;font-size:var(--text-sm)}

/* --------------------------------------------------- MECHANISM MEDIA */
.rvla .diagram{margin-top:clamp(2rem,1.25rem + 3vw,3rem)}
.rvla .diagram__bed{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);padding:clamp(1.5rem,1rem + 2vw,2.5rem)}
.rvla .diagram__cap{font-weight:700;color:var(--accent-deep);margin-bottom:1.25rem;font-size:var(--text-lead)}
.rvla .videoph{aspect-ratio:16/9;border-radius:var(--radius-sm);border:2px dashed var(--line);background:var(--paper-2);display:grid;place-items:center}
.rvla .videoph svg{width:64px;height:64px;color:var(--accent-deep);opacity:.85}
.rvla .mechmedia video,.rvla .mechmedia img{width:100%;height:auto;display:block;border-radius:var(--radius-sm)}

/* --------------------------------------------------------- PRODUCT */
.rvla .product__head{max-width:42rem;margin-bottom:clamp(1.75rem,1.25rem + 2vw,2.5rem)}
.rvla .product__head .eyebrow{margin-bottom:1rem}
.rvla .product__head h2{font-size:var(--text-h2)}
.rvla .product__body{max-width:var(--measure)}
.rvla .product__body p{color:var(--ink-soft)}
.rvla .product__body p + p{margin-top:1rem}
.rvla .product__body p b{color:var(--ink)}
.rvla .diff{list-style:none;padding:0;margin:1.75rem 0 0;display:grid;gap:.9rem}
.rvla .diff li{display:grid;grid-template-columns:auto 1fr;gap:.9rem;align-items:start;color:var(--ink);font-weight:700;font-size:1.15rem;line-height:1.4}
.rvla .diff li .ck{flex:none;width:28px;height:28px;border-radius:50%;background:var(--accent-deep);color:var(--on-accent);display:grid;place-items:center;margin-top:.1rem}
.rvla .diff li .ck svg{width:16px;height:16px}
.rvla .product__price{margin-top:1.6rem;font-weight:700;color:var(--ink);font-size:clamp(1.25rem,1.1rem + .5vw,1.5rem)}
.rvla .product__deny{margin-top:.6rem;color:var(--ink-soft)}

/* --------------------------------------------------------- IDENTITY */
.rvla .identity{background:var(--accent-deep);color:var(--on-accent)}
.rvla .identity__in{padding-block:var(--section-y);max-width:44rem}
.rvla .identity h2{color:var(--on-accent);font-size:var(--text-h2);margin-bottom:1.3rem}
.rvla .identity p{color:oklch(0.94 0.02 80);font-size:var(--text-lead);line-height:1.55}
.rvla .identity p + p{margin-top:1.1rem}
.rvla .identity p b{color:var(--on-accent)}

/* --------------------------------------------------------- BRAND NOTE */
.rvla .note{background:var(--paper-2);border-block:1px solid var(--line)}
.rvla .note__in{padding-block:var(--section-y);max-width:44rem}
.rvla .note .eyebrow{margin-bottom:1rem}
.rvla .note h2{font-size:var(--text-h2);margin-bottom:1.1rem}
.rvla .note p{color:var(--ink-soft)}
.rvla .note p + p{margin-top:1rem}
.rvla .note p b{color:var(--ink)}
.rvla .note__sig{margin-top:1.5rem;font-weight:700;color:var(--ink)}

/* --------------------------------------------------------- FIT / QUALIFY */
.rvla .fit .eyebrow{margin-bottom:1rem}
.rvla .fit h2{font-size:var(--text-h2)}
.rvla .fit__lead{color:var(--ink-soft);font-size:var(--text-lead);max-width:42rem;margin-top:.6rem;line-height:1.5}
.rvla .fit__grid{display:grid;gap:1.25rem;margin-top:clamp(1.5rem,1rem + 2vw,2.25rem)}
.rvla .fit__col{background:var(--paper-2);border:1px solid var(--line);border-radius:var(--radius-sm);padding:1.5rem 1.6rem}
.rvla .fit__col--no{background:var(--paper)}
.rvla .fit__h{display:flex;align-items:center;gap:.65rem;font-weight:700;font-size:1.2rem;margin-bottom:1.1rem;color:var(--ink)}
.rvla .fit__h .badge{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;flex:none}
.rvla .fit__h .badge--yes{background:var(--accent-deep)}
.rvla .fit__h .badge--no{background:var(--ink-faint)}
.rvla .fit__h .badge svg{width:18px;height:18px;color:var(--on-accent)}
.rvla .fit__list{list-style:none;padding:0;margin:0;display:grid;gap:.9rem}
.rvla .fit__list li{display:grid;grid-template-columns:auto 1fr;gap:.75rem;align-items:start;color:var(--ink-soft);line-height:1.45}
.rvla .fit__list li svg{width:22px;height:22px;flex:none;margin-top:.15rem}
.rvla .fit__list--yes li svg{color:var(--accent-deep)}
.rvla .fit__list--no li svg{color:var(--ink-faint)}
@media(min-width:720px){.rvla .fit__grid{grid-template-columns:1fr 1fr;gap:1.5rem}}

/* --------------------------------------------------------- URGENCY */
.rvla .urgent__in{max-width:44rem}
.rvla .urgent .eyebrow{margin-bottom:1.1rem}
.rvla .urgent h2{font-size:var(--text-h2);margin-bottom:1.2rem}
.rvla .urgent p{color:var(--ink-soft);max-width:42rem}
.rvla .urgent p + p{margin-top:1rem}
.rvla .urgent p b{color:var(--ink)}
.rvla .urgent .stock{margin-top:1.4rem;background:var(--paper-2);border:1px solid var(--line);border-left:6px solid var(--warn);border-radius:var(--radius-sm);padding:1.2rem 1.4rem;color:var(--ink);font-weight:700;max-width:42rem}
.rvla .urgent__cta{margin-top:1.9rem}
.rvla .urgent .guarantee{margin-top:1.1rem;font-size:var(--text-sm);color:var(--ink-faint)}

/* --------------------------------------------------------- FAQ */
.rvla .faq{max-width:44rem;margin-inline:auto}
.rvla .faq h2{font-size:var(--text-h2);text-align:center;margin-bottom:clamp(1.75rem,1.25rem + 2vw,2.75rem)}
.rvla .acc__item{border-bottom:1px solid var(--line)}
.rvla .acc__item:first-child{border-top:1px solid var(--line)}
.rvla .acc__btn{width:100%;display:flex;gap:1.25rem;align-items:center;justify-content:space-between;background:none;border:0;cursor:pointer;text-align:left;font-family:var(--font);font-weight:700;font-size:1.2rem;color:var(--ink);padding:1.35rem 0;min-height:60px}
.rvla .acc__btn:hover{color:var(--accent-deep)}
.rvla .acc__icon{flex:none;width:1.2rem;height:1.2rem;position:relative;transition:transform .3s cubic-bezier(.22,1,.36,1)}
.rvla .acc__icon::before,.rvla .acc__icon::after{content:"";position:absolute;inset:0;margin:auto;background:var(--accent-deep)}
.rvla .acc__icon::before{width:100%;height:2.5px;border-radius:2px}
.rvla .acc__icon::after{width:2.5px;height:100%;border-radius:2px}
.rvla .acc__btn[aria-expanded="true"] .acc__icon{transform:rotate(135deg)}
.rvla .acc__panel{display:grid;grid-template-rows:0fr;transition:grid-template-rows .32s cubic-bezier(.22,1,.36,1)}
.rvla .acc__btn[aria-expanded="true"] + .acc__panel{grid-template-rows:1fr}
.rvla .acc__inner{overflow:hidden}
.rvla .acc__inner p{color:var(--ink-soft);padding-bottom:1.35rem;max-width:40rem}

/* --------------------------------------------------------- END CTA */
.rvla .endcta{text-align:center}
.rvla .endcta h2{font-size:var(--text-h2);max-width:30rem;margin:0 auto .9rem}
.rvla .endcta p{color:var(--ink-soft);max-width:34rem;margin:0 auto 1.8rem;font-size:var(--text-lead)}

/* --------------------------------------------------------- TRUST BAR */
.rvla .trustbar{background:var(--accent-deep);color:var(--on-accent)}
.rvla .trustbar__in{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:.6rem 1.4rem;padding-block:1.2rem;text-align:center;font-weight:700;font-size:var(--text-sm);letter-spacing:.03em}
.rvla .trustbar__in .dot{opacity:.5}
.rvla .trustbar__in .risk{background:var(--warn);padding:.2rem .7rem;border-radius:999px}

/* --------------------------------------------------------- FOOTER */
.rvla .foot{border-top:1px solid var(--line);background:var(--paper-2)}
.rvla .foot__in{padding-block:2.5rem 3rem}
.rvla .foot__brand{font-weight:700;color:var(--ink);font-size:1.35rem;margin-bottom:1.1rem;display:flex;align-items:center;gap:.55rem;letter-spacing:.06em}
.rvla .foot__brand .ic{width:22px;height:22px}
.rvla .foot__links{display:flex;flex-wrap:wrap;gap:.4rem 1.5rem;font-size:var(--text-sm);margin-bottom:1.6rem}
.rvla .foot__links a{color:var(--ink-soft);text-decoration:underline;text-underline-offset:3px;display:inline-flex;align-items:center;min-height:44px;padding-block:.5rem}
.rvla .foot__links a:hover{color:var(--accent-deep)}
.rvla .foot__fine{font-size:var(--text-xs);color:var(--ink-faint);line-height:1.7;max-width:54rem}
.rvla .foot__fine p+p{margin-top:.7rem}

/* --------------------------------------------------------- STICKY CTA */
.rvla .scta{position:fixed;left:0;right:0;bottom:0;z-index:50;display:flex;align-items:center;justify-content:space-between;gap:1rem;background:var(--paper);border-top:2px solid var(--line);box-shadow:0 -8px 30px oklch(0.4 0.04 40 / .08);padding:.85rem clamp(1rem,5vw,1.5rem);padding-bottom:max(.85rem,env(safe-area-inset-bottom));transform:translateY(120%);transition:transform .4s cubic-bezier(.22,1,.36,1)}
.rvla .scta.is-visible{transform:translateY(0)}
.rvla .scta__txt{font-size:var(--text-sm);line-height:1.3}
.rvla .scta__txt b{display:block;font-weight:700;color:var(--ink);font-size:1.05rem}
.rvla .scta__txt span{font-size:var(--text-xs);color:var(--ink-faint)}
.rvla .scta .btn{white-space:nowrap}
@media (min-width:880px){ .rvla .scta{display:none} }

/* --------------------------------------------------------- STOCK CHECK */
.rvla .stockcheck{position:fixed;inset:0;z-index:100;background:var(--paper);overflow-y:auto}
.rvla .stockcheck[hidden]{display:none}
.rvla .sc__in{min-height:100%;width:min(100% - 2.5rem, 30rem);margin-inline:auto;display:flex;flex-direction:column;align-items:center;justify-content:center;padding-block:3.5rem;text-align:center}
.rvla .sc__brand{display:flex;align-items:center;gap:.55rem;font-weight:700;font-size:1.35rem;letter-spacing:.06em;color:var(--ink);margin-bottom:2.25rem}
.rvla .sc__brand .ic{width:20px;height:20px}
.rvla .sc__ring{position:relative;width:150px;height:150px;margin-bottom:1.6rem}
.rvla .sc__ring > svg{width:100%;height:100%;transform:rotate(-90deg)}
.rvla .sc__track{fill:none;stroke:var(--accent-soft);stroke-width:10}
.rvla .sc__bar{fill:none;stroke:var(--accent-deep);stroke-width:10;stroke-linecap:round;stroke-dasharray:439.82;stroke-dashoffset:439.82}
.rvla .sc__pct{position:absolute;inset:0;display:grid;place-items:center;font-weight:700;font-size:2.1rem;color:var(--ink);font-variant-numeric:tabular-nums}
.rvla .sc__checkwrap{position:absolute;inset:0;display:grid;place-items:center}
.rvla .sc__checkwrap[hidden]{display:none}
.rvla .sc__checkwrap::before{content:"";position:absolute;top:50%;left:50%;width:124px;height:124px;margin:-62px 0 0 -62px;border-radius:50%;background:var(--paper-2)}
.rvla .sc__checkwrap svg{position:relative;width:64px;height:64px;color:var(--accent-deep);animation:rvla-scpop .45s cubic-bezier(.22,1,.36,1)}
.rvla .sc__redirect{display:flex;align-items:center;gap:.6rem;font-weight:700;font-size:var(--text-sm);color:var(--ink-soft)}
.rvla .sc__dot--sm{width:15px;height:15px;border-width:2.5px}
.rvla .sc__title{font-size:clamp(1.45rem,1.2rem + 1vw,1.8rem);margin-bottom:.45rem}
.rvla .sc__sub{color:var(--ink-soft);margin-bottom:1.6rem;min-height:1.7em}
.rvla .sc__steps{list-style:none;padding:0;margin:0;width:100%;text-align:left}
.rvla .sc__step{display:grid;grid-template-columns:auto 1fr auto;gap:1rem;align-items:center;padding-block:.9rem;border-top:1px solid var(--line-soft);min-height:56px}
.rvla .sc__step:first-child{border-top:0}
.rvla .sc__mark{width:24px;height:24px;display:grid;place-items:center}
.rvla .sc__dot{display:block;width:20px;height:20px;border-radius:50%;border:2.5px solid var(--line)}
.rvla .sc__dot--spin{border-color:var(--accent-soft);border-top-color:var(--accent-deep);animation:rvla-scspin .8s linear infinite}
.rvla .sc__badge{width:24px;height:24px;border-radius:50%;display:grid;place-items:center}
.rvla .sc__badge svg{width:14px;height:14px}
.rvla .sc__badge--muted{background:var(--paper-2);border:1.5px solid var(--line);color:var(--ink-faint)}
.rvla .sc__badge--warn{background:var(--warn);color:var(--on-accent)}
.rvla .sc__badge--ok{background:var(--accent-deep);color:var(--on-accent)}
.rvla .sc__lbl{font-weight:700;color:var(--ink-soft)}
.rvla .sc__step.is-active .sc__lbl{color:var(--ink)}
.rvla .sc__res{font-size:var(--text-sm);font-weight:700;border-radius:999px;padding:.28rem .8rem;white-space:nowrap}
.rvla .sc__res:empty{display:none}
.rvla .sc__res--out{background:var(--paper-2);border:1px solid var(--line);color:var(--ink-soft)}
.rvla .sc__res--low{background:var(--warn);color:var(--on-accent)}
.rvla .sc__res--offer{background:var(--accent-deep);color:var(--on-accent)}
.rvla .sc__done{display:flex;flex-direction:column;align-items:center;gap:.9rem;margin-top:2rem}
.rvla .sc__done[hidden]{display:none}
@keyframes rvla-scspin{to{transform:rotate(360deg)}}
@keyframes rvla-scpop{from{transform:scale(.4)}to{transform:scale(1)}}

/* --------------------------------------------------------- ANIMATION */
.rvla.is-js .reveal{opacity:0;transform:translateY(16px);transition:opacity .7s ease,transform .7s cubic-bezier(.22,1,.36,1)}
.rvla.is-js .reveal.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
  .rvla *{transition-duration:.001ms !important;scroll-behavior:auto !important}
  .rvla.is-js .reveal{opacity:1;transform:none}
  .rvla .sc__dot--spin{animation:none}
  .rvla .sc__checkwrap svg{animation:none}
}

/* -------------------------------------------------------- RESPONSIVE */
@media (max-width:560px){
  .rvla .tmi{grid-template-columns:1fr}
  .rvla .tmi__q,.rvla .tmi__by{grid-column:1}
  .rvla .inlinecta{flex-direction:column;align-items:flex-start}
  .rvla .inlinecta .btn{width:100%}
}
