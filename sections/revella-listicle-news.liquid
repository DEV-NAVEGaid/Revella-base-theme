{% comment %}
  REVELLA · 7 Warning Signs · native-news / advertorial skin.
  Same content model as revella-listicle.liquid (blocks: sign, faq; shared
  setting ids) so page content and images port 1:1 between the two skins.
  All CSS scoped under .rvnw. Pair with templates/page.revella-listicle-2.json
  and layout/landing-news.liquid.

  UPDATED: previously-hardcoded copy in the "reveal", "why we built it",
  "product", "identity", "fit", and "urgency" sections has been converted
  to schema settings so different market pages (joint, fertility, etc.)
  can override this copy per-template instead of sharing one fixed version.
  Defaults below match the original joint-pain copy exactly, so any
  existing page/template that doesn't set these new fields renders
  identically to before.
{% endcomment %}

{% style %}
.rvnw{
  --paper:#ffffff;
  --paper-2:#f4f4f2;
  --ink:#16171a;
  --ink-soft:#3f434b;
  --ink-faint:#71757e;
  --accent:#c1332a;
  --accent-deep:#9f2820;
  --accent-soft:#f7e7e3;
  --on-accent:#ffffff;
  --warn:#c1332a;
  --navy:#0d1f3c;
  --rust:#b5542a;
  --line:#e3e3e0;
  --line-soft:#efefec;

  --serif:Georgia,"Times New Roman",Times,serif;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;

  --measure:44rem;
  --shadow-sm:0 1px 2px rgba(13,31,60,.05),0 6px 20px rgba(13,31,60,.06);
  --shadow-md:0 12px 40px rgba(13,31,60,.14);
  --section-y:clamp(2rem,1.5rem + 2.5vw,3.5rem);

  font-family:var(--serif);
  font-size:1.18rem;
  line-height:1.7;
  color:var(--ink);
  background:var(--paper);
  -webkit-font-smoothing:antialiased;
}

.rvnw *,.rvnw *::before,.rvnw *::after{box-sizing:border-box}
.rvnw *{margin:0}
.rvnw img,.rvnw svg{display:block;max-width:100%}
.rvnw a{color:var(--accent-deep)}
.rvnw :focus-visible{outline:3px solid var(--accent-deep);outline-offset:3px;border-radius:4px}
.rvnw .vh{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.rvnw .wrap{width:min(100% - 2.5rem, var(--measure));margin-inline:auto}
.rvnw .skip{position:absolute;left:-999px;top:0;background:var(--accent-deep);color:#fff;padding:.75rem 1.25rem;z-index:80;font-family:var(--sans);font-weight:700;font-size:.9rem}
.rvnw .skip:focus{left:0}

.rvnw .mast{background:var(--navy);color:#fff}
.rvnw .mast__row{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-block:.85rem}
.rvnw .nameplate{font-family:var(--serif);font-weight:700;line-height:.9;letter-spacing:.005em}
.rvnw .np__l1{display:block;font-size:clamp(1.45rem,1.15rem + 1.7vw,2.15rem);text-transform:uppercase}
.rvnw .np__l2{display:flex;align-items:center;gap:.55rem;font-size:clamp(1.45rem,1.15rem + 1.7vw,2.15rem);text-transform:uppercase}
.rvnw .np__sq{width:1.6em;height:.48em;background:var(--accent);display:inline-block}
.rvnw .mast__meta{display:flex;flex-direction:column;align-items:flex-end;gap:.4rem;text-align:right}
.rvnw .mast__date{font-family:var(--sans);font-size:.7rem;letter-spacing:.09em;color:rgba(255,255,255,.72)}
.rvnw .badge-breaking{font-family:var(--sans);font-weight:800;font-size:.68rem;letter-spacing:.06em;background:var(--accent);color:#fff;padding:.36rem .6rem;text-transform:uppercase;white-space:nowrap}
.rvnw .mast__rule{height:3px;background:var(--accent)}
@media(max-width:520px){
  .rvnw .mast__row{align-items:flex-end}
  .rvnw .mast__date{font-size:.62rem}
  .rvnw .badge-breaking{font-size:.6rem;padding:.3rem .45rem}
}

.rvnw .art__head{padding-top:clamp(1.4rem,1rem + 2vw,2.25rem)}
.rvnw .kicker{font-family:var(--sans);font-weight:800;font-size:.82rem;letter-spacing:.1em;text-transform:uppercase;color:var(--accent)}
.rvnw .dek{font-family:var(--serif);font-style:italic;font-size:clamp(1.15rem,1.05rem + .5vw,1.4rem);color:var(--ink-soft);margin-top:.5rem;line-height:1.4}
.rvnw .headline{font-family:var(--serif);font-weight:700;font-size:clamp(2rem,1.5rem + 2.4vw,3rem);line-height:1.13;letter-spacing:-.012em;margin-top:.65rem;color:var(--ink)}
.rvnw .headline em{font-style:normal;color:var(--accent)}
.rvnw .byline{font-family:var(--sans);font-size:.85rem;color:var(--ink-faint);margin-top:1.1rem;padding-bottom:1.1rem;border-bottom:1px solid var(--line)}

.rvnw .media{position:relative;margin:1.3rem 0}
.rvnw .media img{width:100%;height:auto;display:block;border:1px solid var(--line)}
.rvnw .media__ph{position:relative;aspect-ratio:16/9;border:1px solid var(--line);background:var(--paper-2);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:.6rem;padding:1.5rem}
.rvnw .media__ph svg{width:44px;height:44px;color:var(--ink-faint)}
.rvnw .media__ph p{font-family:var(--sans);font-size:.82rem;color:var(--ink-faint)}
.rvnw .watch{position:absolute;right:.6rem;bottom:.6rem;font-family:var(--sans);font-weight:700;font-size:.72rem;letter-spacing:.04em;color:#fff;background:rgba(13,31,60,.86);padding:.32rem .55rem;display:inline-flex;align-items:center;gap:.35rem}
.rvnw .watch svg{width:12px;height:12px}

.rvnw .lede p{font-size:clamp(1.15rem,1.08rem + .35vw,1.28rem);line-height:1.7;color:var(--ink);margin-top:1rem}
.rvnw .lede p:first-child{margin-top:.4rem}
.rvnw .lede .turn{font-weight:700}

.rvnw .btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;font-family:var(--sans);font-weight:700;font-size:1rem;line-height:1;padding:1rem 1.6rem;min-height:54px;border:2px solid transparent;border-radius:6px;cursor:pointer;text-decoration:none;text-align:center;transition:background-color .2s,transform .2s,box-shadow .2s}
.rvnw .btn--primary{background:var(--accent);color:#fff;box-shadow:var(--shadow-sm)}
.rvnw .btn--primary:hover{background:var(--accent-deep);transform:translateY(-1px);box-shadow:var(--shadow-md)}
.rvnw .btn--lg{font-size:1.12rem;padding:1.1rem 1.9rem;min-height:58px}
.rvnw .btn svg{flex:none;transition:transform .2s}
.rvnw .btn--primary:hover svg{transform:translateX(3px)}
.rvnw .cta-row{margin:1.7rem 0 .5rem;display:flex;flex-wrap:wrap;gap:.9rem 1.2rem;align-items:center}
.rvnw .microtrust{font-family:var(--sans);font-size:.85rem;color:var(--ink-faint)}

.rvnw .signs{margin-top:.5rem}
.rvnw .sign{padding-top:clamp(1.75rem,1.25rem + 2vw,2.75rem);margin-top:clamp(1.75rem,1.25rem + 2vw,2.75rem);border-top:1px solid var(--line)}
.rvnw .sign:first-child{border-top:0;margin-top:0}
.rvnw .sign .sign__k{font-family:var(--sans);font-weight:800;font-size:2rem;letter-spacing:.08em;text-transform:uppercase;text-decoration:underline;color:var(--accent);display:inline-flex;align-items:center;gap:.45rem}
.rvnw .sign .sign__k svg{width:18px;height:18px}
.rvnw .sign__k svg{width:15px;height:15px;flex:none}
.rvnw .sign h2{font-family:var(--serif);font-weight:700;font-size:clamp(1.5rem,1.2rem + 1.4vw,2.1rem);line-height:1.2;margin-top:.55rem;color:var(--ink)}
.rvnw .sign p{font-family:var(--serif);font-size:1.18rem;line-height:1.7;color:var(--ink);margin-top:1rem}
.rvnw .sign p strong,.rvnw .sign p b{font-weight:700}
.rvnw .sign__close{font-family:var(--serif);font-weight:700;font-style:italic;color:var(--ink);border-left:3px solid var(--accent);padding-left:1.1rem;margin-top:1.3rem}

.rvnw .figph{margin:1.3rem 0}
.rvnw .figph__img{width:100%;height:auto;display:block;border:1px solid var(--line)}
.rvnw .figph__link{display:block;text-decoration:none;transition:opacity .2s}
.rvnw .figph__link:hover{opacity:.96}
.rvnw .figph__box{position:relative;aspect-ratio:16/9;border:1px dashed var(--line);background:var(--paper-2);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:.5rem;padding:1.4rem}
.rvnw .figph__box svg{width:38px;height:38px;color:var(--ink-faint)}
.rvnw .figph__note{font-family:var(--sans);font-size:.78rem;color:var(--ink-faint)}
.rvnw .figph__scene{font-family:var(--sans);font-size:.85rem;font-weight:700;color:var(--ink-soft);max-width:30rem}

.rvnw .callout{margin:1.3rem 0;background:var(--paper-2);border-left:4px solid var(--accent);padding:1.1rem 1.3rem}
.rvnw .callout__k{font-family:var(--sans);font-weight:800;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);display:block;margin-bottom:.45rem}
.rvnw .callout p{font-family:var(--serif);font-weight:700;font-size:1.22rem;line-height:1.5;color:var(--ink)}

.rvnw .tmi{margin:1.4rem 0;border-left:3px solid var(--line);padding-left:1.25rem}
.rvnw .tmi__q{font-family:var(--serif);font-style:italic;font-size:1.28rem;line-height:1.5;color:var(--ink)}
.rvnw .tmi__by{font-family:var(--sans);font-size:.85rem;color:var(--ink-faint);margin-top:.55rem;font-weight:700}

.rvnw .inlinecta{margin:1.6rem 0 0;background:var(--accent-soft);border:1px solid var(--line);padding:1.2rem 1.35rem;display:flex;flex-wrap:wrap;gap:.9rem 1.4rem;align-items:center;justify-content:space-between}
.rvnw .inlinecta p{font-family:var(--serif);font-weight:700;font-size:1.12rem;max-width:30rem}

.rvnw .band{background:var(--paper-2);border-block:1px solid var(--line);margin-top:var(--section-y)}
.rvnw .band__in{padding-block:var(--section-y)}
.rvnw .sec{padding-block:var(--section-y)}
.rvnw .eyebrow{font-family:var(--sans);font-weight:800;font-size:.8rem;letter-spacing:.09em;text-transform:uppercase;color:var(--accent)}
.rvnw h2.sech{font-family:var(--serif);font-weight:700;font-size:clamp(1.6rem,1.3rem + 1.5vw,2.25rem);line-height:1.18;margin-top:.6rem;color:var(--ink)}
.rvnw .sec p,.rvnw .band p{font-family:var(--serif);font-size:1.15rem;line-height:1.65;color:var(--ink-soft);margin-top:1rem}
.rvnw .sec p b,.rvnw .band p b{color:var(--ink)}
.rvnw .kick{font-family:var(--serif);font-weight:700;font-size:clamp(1.35rem,1.15rem + .9vw,1.7rem);color:var(--ink);margin-top:1.3rem;line-height:1.35}
.rvnw .kick .hl{color:var(--accent-deep)}
.rvnw .dimlist{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1rem}
.rvnw .dimlist span{font-family:var(--sans);font-weight:700;font-size:.85rem;color:var(--ink-soft);background:var(--paper);border:1px solid var(--line);border-radius:3px;padding:.32rem .7rem}

.rvnw .diagram{margin-top:1.6rem}
.rvnw .diagram__cap{font-family:var(--sans);font-weight:800;font-size:.8rem;letter-spacing:.06em;text-transform:uppercase;color:var(--accent);margin-bottom:.8rem}
.rvnw .mechmedia video,.rvnw .mechmedia img{width:100%;height:auto;display:block;border:1px solid var(--line)}
.rvnw .medialink{display:block;text-decoration:none;transition:opacity .2s}
.rvnw .medialink:hover{opacity:.96}
.rvnw .videoph{aspect-ratio:16/9;border:1px dashed var(--line);background:var(--paper);display:grid;place-items:center}
.rvnw .videoph svg{width:56px;height:56px;color:var(--accent)}

.rvnw .diff{list-style:none;padding:0;margin:1.5rem 0 0;display:grid;gap:.85rem}
.rvnw .diff li{display:grid;grid-template-columns:auto 1fr;gap:.8rem;align-items:start;font-family:var(--serif);font-size:1.12rem;line-height:1.45;color:var(--ink);font-weight:700}
.rvnw .diff .ck{flex:none;width:26px;height:26px;border-radius:50%;background:var(--accent);color:#fff;display:grid;place-items:center;margin-top:.15rem}
.rvnw .diff .ck svg{width:15px;height:15px}
.rvnw .price{font-family:var(--serif);font-weight:700;font-size:clamp(1.2rem,1.05rem + .5vw,1.45rem);color:var(--ink);margin-top:1.5rem}
.rvnw .deny{font-family:var(--serif);color:var(--ink-soft);margin-top:.55rem}

.rvnw .identity{background:var(--navy);color:#fff;margin-top:var(--section-y)}
.rvnw .identity__in{padding-block:var(--section-y)}
.rvnw .identity h2{color:#fff;font-family:var(--serif);font-weight:700;font-size:clamp(1.6rem,1.3rem + 1.5vw,2.25rem);line-height:1.2;margin-bottom:1.1rem}
.rvnw .identity p{font-family:var(--serif);font-size:1.2rem;line-height:1.6;color:rgba(255,255,255,.9);margin-top:1rem}
.rvnw .identity p:first-of-type{margin-top:0}
.rvnw .identity p b{color:#fff}

.rvnw .fit__lead{font-family:var(--serif);font-size:1.15rem;color:var(--ink-soft);margin-top:.6rem}
.rvnw .fit__grid{display:grid;gap:1.1rem;margin-top:1.5rem}
@media(min-width:720px){.rvnw .fit__grid{grid-template-columns:1fr 1fr;gap:1.25rem}}
.rvnw .fit__col{border:1px solid var(--line);padding:1.3rem 1.4rem;background:var(--paper)}
.rvnw .fit__col--yes{background:var(--paper-2)}
.rvnw .fit__h{font-family:var(--sans);font-weight:800;font-size:1.05rem;display:flex;align-items:center;gap:.6rem;margin-bottom:1rem;color:var(--ink)}
.rvnw .fit__h .badge{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;flex:none}
.rvnw .fit__h .badge--yes{background:var(--accent)}
.rvnw .fit__h .badge--no{background:var(--ink-faint)}
.rvnw .fit__h .badge svg{width:16px;height:16px;color:#fff}
.rvnw .fit__list{list-style:none;padding:0;margin:0;display:grid;gap:.8rem}
.rvnw .fit__list li{display:grid;grid-template-columns:auto 1fr;gap:.6rem;align-items:start;font-family:var(--serif);font-size:1.05rem;line-height:1.4;color:var(--ink-soft)}
.rvnw .fit__list li svg{width:20px;height:20px;flex:none;margin-top:.15rem}
.rvnw .fit__list--yes li svg{color:var(--accent)}
.rvnw .fit__list--no li svg{color:var(--ink-faint)}

.rvnw .stock{margin-top:1.3rem;background:var(--accent-soft);border-left:4px solid var(--accent);padding:1.1rem 1.35rem;font-family:var(--serif);font-weight:700;color:var(--ink)}
.rvnw .guarantee{font-family:var(--sans);font-size:.85rem;color:var(--ink-faint);margin-top:1rem}

.rvnw .faq h2{font-family:var(--serif);text-align:center;font-weight:700;font-size:clamp(1.6rem,1.3rem + 1.5vw,2.25rem);margin-bottom:clamp(1.5rem,1rem + 2vw,2.5rem)}
.rvnw .acc__item{border-bottom:1px solid var(--line)}
.rvnw .acc__item:first-child{border-top:1px solid var(--line)}
.rvnw .acc__btn{width:100%;display:flex;gap:1rem;align-items:center;justify-content:space-between;background:none;border:0;cursor:pointer;text-align:left;font-family:var(--serif);font-weight:700;font-size:1.18rem;color:var(--ink);padding:1.2rem 0;min-height:58px}
.rvnw .acc__btn:hover{color:var(--accent-deep)}
.rvnw .acc__icon{flex:none;width:1.1rem;height:1.1rem;position:relative;transition:transform .3s cubic-bezier(.22,1,.36,1)}
.rvnw .acc__icon::before,.rvnw .acc__icon::after{content:"";position:absolute;inset:0;margin:auto;background:var(--accent)}
.rvnw .acc__icon::before{width:100%;height:2.5px;border-radius:2px}
.rvnw .acc__icon::after{width:2.5px;height:100%;border-radius:2px}
.rvnw .acc__btn[aria-expanded="true"] .acc__icon{transform:rotate(135deg)}
.rvnw .acc__panel{display:grid;grid-template-rows:0fr;transition:grid-template-rows .32s cubic-bezier(.22,1,.36,1)}
.rvnw .acc__btn[aria-expanded="true"] + .acc__panel{grid-template-rows:1fr}
.rvnw .acc__inner{overflow:hidden}
.rvnw .acc__inner p{font-family:var(--serif);color:var(--ink-soft);padding-bottom:1.2rem}

.rvnw .endcta{text-align:center}
.rvnw .endcta h2{font-family:var(--serif);font-weight:700;font-size:clamp(1.6rem,1.3rem + 1.5vw,2.25rem);max-width:30rem;margin:0 auto .8rem}
.rvnw .endcta p{margin:0 auto 1.6rem;max-width:34rem}
.rvnw .endcta .fine{font-family:var(--sans);font-size:.85rem;color:var(--ink-faint);margin-top:1.1rem}

.rvnw .trustbar{background:var(--navy);color:#fff;margin-top:var(--section-y)}
.rvnw .trustbar__in{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:.5rem 1.3rem;padding-block:1.1rem;text-align:center;font-family:var(--sans);font-weight:700;font-size:.85rem;letter-spacing:.02em}
.rvnw .trustbar__in .dot{opacity:.5}
.rvnw .trustbar__in .risk{background:var(--accent);padding:.2rem .7rem;border-radius:3px}

.rvnw .foot{background:var(--paper-2);border-top:1px solid var(--line)}
.rvnw .foot__in{padding-block:2.4rem 3rem}
.rvnw .foot__brand{font-family:var(--serif);font-weight:700;font-size:1.2rem;letter-spacing:.03em;color:var(--ink);margin-bottom:1rem}
.rvnw .foot__links{display:flex;flex-wrap:wrap;gap:.4rem 1.4rem;margin-bottom:1.4rem}
.rvnw .foot__links a{font-family:var(--sans);font-size:.85rem;color:var(--ink-soft);text-decoration:underline;text-underline-offset:3px;display:inline-flex;align-items:center;min-height:44px;padding-block:.4rem}
.rvnw .foot__links a:hover{color:var(--accent-deep)}
.rvnw .foot__fine{font-family:var(--sans);font-size:.78rem;color:var(--ink-faint);line-height:1.65;max-width:54rem}
.rvnw .foot__fine p+p{margin-top:.7rem}
.rvnw .foot__fine .disc{font-weight:700;text-transform:uppercase;letter-spacing:.08em;font-size:.68rem;color:var(--ink-soft)}

.rvnw .scta{position:fixed;left:0;right:0;bottom:0;z-index:50;display:flex;align-items:center;justify-content:space-between;gap:1rem;background:var(--navy);color:#fff;box-shadow:0 -8px 30px rgba(13,31,60,.18);padding:.8rem clamp(1rem,5vw,1.5rem);padding-bottom:max(.8rem,env(safe-area-inset-bottom));transform:translateY(120%);transition:transform .4s cubic-bezier(.22,1,.36,1)}
.rvnw .scta.is-visible{transform:translateY(0)}
.rvnw .scta__txt{font-family:var(--sans);font-size:.85rem;line-height:1.25}
.rvnw .scta__txt b{display:block;font-weight:800;font-size:1rem}
.rvnw .scta__txt span{font-size:.72rem;color:rgba(255,255,255,.7)}
.rvnw .scta .btn{white-space:nowrap}
@media(min-width:880px){.rvnw .scta{display:none}}

.rvnw .stockcheck{position:fixed;inset:0;z-index:100;background:var(--paper);overflow-y:auto}
.rvnw .stockcheck[hidden]{display:none}
.rvnw .sc__in{min-height:100%;width:min(100% - 2.5rem, 30rem);margin-inline:auto;display:flex;flex-direction:column;align-items:center;justify-content:center;padding-block:3.5rem;text-align:center}
.rvnw .sc__brand{font-family:var(--serif);font-weight:700;font-size:1.3rem;letter-spacing:.02em;color:var(--navy);margin-bottom:2.25rem}
.rvnw .sc__ring{position:relative;width:150px;height:150px;margin-bottom:1.6rem}
.rvnw .sc__ring > svg{width:100%;height:100%;transform:rotate(-90deg)}
.rvnw .sc__track{fill:none;stroke:var(--accent-soft);stroke-width:10}
.rvnw .sc__bar{fill:none;stroke:var(--accent);stroke-width:10;stroke-linecap:round;stroke-dasharray:439.82;stroke-dashoffset:439.82}
.rvnw .sc__pct{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--sans);font-weight:700;font-size:2.1rem;color:var(--ink);font-variant-numeric:tabular-nums}
.rvnw .sc__checkwrap{position:absolute;inset:0;display:grid;place-items:center}
.rvnw .sc__checkwrap[hidden]{display:none}
.rvnw .sc__checkwrap::before{content:"";position:absolute;top:50%;left:50%;width:124px;height:124px;margin:-62px 0 0 -62px;border-radius:50%;background:var(--paper-2)}
.rvnw .sc__checkwrap svg{position:relative;width:64px;height:64px;color:var(--accent);animation:rvnw-scpop .45s cubic-bezier(.22,1,.36,1)}
.rvnw .sc__redirect{font-family:var(--sans);display:flex;align-items:center;gap:.6rem;font-weight:700;font-size:.9rem;color:var(--ink-soft)}
.rvnw .sc__dot--sm{width:15px;height:15px;border-width:2.5px}
.rvnw .sc__title{font-family:var(--serif);font-weight:700;font-size:clamp(1.45rem,1.2rem + 1vw,1.8rem);margin-bottom:.45rem;color:var(--ink)}
.rvnw .sc__sub{font-family:var(--sans);color:var(--ink-soft);margin-bottom:1.6rem;min-height:1.7em}
.rvnw .sc__steps{list-style:none;padding:0;margin:0;width:100%;text-align:left}
.rvnw .sc__step{display:grid;grid-template-columns:auto 1fr auto;gap:1rem;align-items:center;padding-block:.9rem;border-top:1px solid var(--line-soft);min-height:56px}
.rvnw .sc__step:first-child{border-top:0}
.rvnw .sc__mark{width:24px;height:24px;display:grid;place-items:center}
.rvnw .sc__dot{display:block;width:20px;height:20px;border-radius:50%;border:2.5px solid var(--line)}
.rvnw .sc__dot--spin{border-color:var(--accent-soft);border-top-color:var(--accent);animation:rvnw-scspin .8s linear infinite}
.rvnw .sc__badge{width:24px;height:24px;border-radius:50%;display:grid;place-items:center}
.rvnw .sc__badge svg{width:14px;height:14px}
.rvnw .sc__badge--muted{background:var(--paper-2);border:1.5px solid var(--line);color:var(--ink-faint)}
.rvnw .sc__badge--warn{background:var(--warn);color:#fff}
.rvnw .sc__badge--ok{background:var(--accent);color:#fff}
.rvnw .sc__lbl{font-family:var(--sans);font-weight:700;color:var(--ink-soft)}
.rvnw .sc__step.is-active .sc__lbl{color:var(--ink)}
.rvnw .sc__res{font-family:var(--sans);font-size:.85rem;font-weight:700;border-radius:3px;padding:.28rem .8rem;white-space:nowrap}
.rvnw .sc__res:empty{display:none}
.rvnw .sc__res--out{background:var(--paper-2);border:1px solid var(--line);color:var(--ink-soft)}
.rvnw .sc__res--low{background:var(--warn);color:#fff}
.rvnw .sc__res--offer{background:var(--accent);color:#fff}
.rvnw .sc__done{display:flex;flex-direction:column;align-items:center;gap:.9rem;margin-top:2rem}
.rvnw .sc__done[hidden]{display:none}
@keyframes rvnw-scspin{to{transform:rotate(360deg)}}
@keyframes rvnw-scpop{from{transform:scale(.4)}to{transform:scale(1)}}

.rvnw.is-js .reveal{opacity:0;transform:translateY(14px);transition:opacity .7s ease,transform .7s cubic-bezier(.22,1,.36,1)}
.rvnw.is-js .reveal.is-in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){
  .rvnw *{transition-duration:.001ms !important;scroll-behavior:auto !important}
  .rvnw.is-js .reveal{opacity:1;transform:none}
  .rvnw .sc__dot--spin{animation:none}
  .rvnw .sc__checkwrap svg{animation:none}
}
@media (max-width:560px){
  .rvnw .inlinecta{flex-direction:column;align-items:flex-start}
  .rvnw .inlinecta .btn{width:100%}
}
{% endstyle %}

{%- liquid
  assign cta_url = section.settings.cta_url | default: 'https://shoprevella.com/products/astaxanthin-softgels'
  assign sign_blocks = section.blocks | where: 'type', 'sign'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
  assign now_title = 'now' | date: '%B %-d, %Y'
  assign now_upper = now_title | upcase
-%}

{%- capture arrow_svg -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{%- endcapture -%}
{%- capture warn_svg -%}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 L3 20 H21 Z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><line x1="12" y1="10" x2="12" y2="15" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="12" cy="17.5" r="1.2" fill="currentColor"/></svg>{%- endcapture -%}
{%- capture check_svg -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{%- endcapture -%}
{%- capture x_svg -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>{%- endcapture -%}
{%- capture camera_svg -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="6" width="18" height="14" rx="2"/><circle cx="12" cy="13" r="4"/><path d="M8 6l1.5-2h5L16 6"/></svg>{%- endcapture -%}
{%- capture play_svg -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5v14l12-7z"/></svg>{%- endcapture -%}

<div class="rvnw" id="rvnw-{{ section.id }}">

<a class="skip" href="#signs">Skip to the 7 warning signs</a>

<header class="mast">
  <div class="wrap mast__row">
    <div class="nameplate">
