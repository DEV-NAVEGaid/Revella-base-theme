    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#e8e0e0"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card Inner Padding (px)",
      "min": 8, "max": 32, "step": 2, "default": 14
