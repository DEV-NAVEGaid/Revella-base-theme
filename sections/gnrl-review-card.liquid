{% comment %}
  Review Card Section
  Category: Template
  Carousel: 1 card per view on mobile, 3 per view on desktop
{% endcomment %}

{%- liquid
  assign sid         = section.id
  assign overlay_dir = section.settings.overlay_direction

  assign card_blocks = section.blocks | where: 'type', 'card'
  assign icon_blocks = section.blocks | where: 'type', 'icon_text'
  assign total_cards = card_blocks.size

  assign card_align_flex = 'flex-start'
  if section.settings.card_text_align == 'center'
    assign card_align_flex = 'center'
  elsif section.settings.card_text_align == 'right'
    assign card_align_flex = 'flex-end'
  endif
-%}

<style>
  /* ── Section ── */
  .rc-section-{{ sid }} {
    position: relative;
    background-color: {{ section.settings.background_color }};
    {% if section.settings.background_image != blank %}
    background-image: url('{{ section.settings.background_image | image_url: width: 1800 }}');
    background-size: {{ section.settings.bg_size }};
    background-position: {{ section.settings.bg_position }};
    background-repeat: no-repeat;
    {% endif %}
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    padding-left: {{ section.settings.padding_x_mobile }}px;
    padding-right: {{ section.settings.padding_x_mobile }}px;
  }

  @media (min-width: 768px) {
    .rc-section-{{ sid }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
      padding-left: {{ section.settings.padding_x_desktop }}px;
      padding-right: {{ section.settings.padding_x_desktop }}px;
    }
  }

  /* ── Overlay ── */
  .rc-overlay-{{ sid }} {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    {%- assign oc = section.settings.overlay_color -%}
    {%- assign oo = section.settings.overlay_opacity | times: 0.01 -%}
    {%- if overlay_dir == 'left' -%}
      background: linear-gradient(to right, {{ oc }}, transparent); opacity: {{ oo }};
    {%- elsif overlay_dir == 'right' -%}
      background: linear-gradient(to left, {{ oc }}, transparent); opacity: {{ oo }};
    {%- elsif overlay_dir == 'top' -%}
      background: linear-gradient(to bottom, {{ oc }}, transparent); opacity: {{ oo }};
    {%- elsif overlay_dir == 'bottom' -%}
      background: linear-gradient(to top, {{ oc }}, transparent); opacity: {{ oo }};
    {%- elsif overlay_dir == 'full' -%}
      background: {{ oc }}; opacity: {{ oo }};
    {%- endif -%}
  }

  /* ── Inner wrapper ── */
  .rc-inner-{{ sid }} {
    position: relative;
    z-index: 1;
    max-width: {{ section.settings.max_width }}px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ── Carousel viewport + track ── */
  .rc-viewport-{{ sid }} {
    overflow: hidden;
    transition: height 0.4s ease;
}

  .rc-track-{{ sid }} {
    display: flex;
    gap: {{ section.settings.card_gap_mobile }}px;
    transition: transform 0.4s ease;
    will-change: transform;
    align-items: flex-start;

  }

  @media (min-width: 768px) {
    .rc-track-{{ sid }} {
      gap: {{ section.settings.card_gap_desktop }}px;
    }
  }

  /* ── Card ── */
  .rc-card-{{ sid }} {
    /* Mobile: 1 card per view */
    position: relative;
    flex: 0 0 100%;
    min-width: 0;
    background-color: {{ section.settings.card_bg }};
    border-radius: {{ section.settings.card_radius }}px;
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    padding: {{ section.settings.card_padding_mobile }}px;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.card_inner_gap }}px;
    box-sizing: border-box;
    text-align: {{ section.settings.card_text_align }};
  }

  @media (min-width: 768px) {
    .rc-card-{{ sid }} {
      /* Desktop: 3 cards per view (account for 2 gaps inside the viewport) */
      flex: 0 0 calc((100% - 2 * {{ section.settings.card_gap_desktop }}px) / 3);
      padding: {{ section.settings.card_padding_desktop }}px;
    }
  }

  /* ── Quote badge (top-right corner) ── */
  .rc-card-quote-{{ sid }} {
    position: absolute;
    top: {{ section.settings.quote_badge_offset }}px;
    right: {{ section.settings.quote_badge_offset }}px;
    width: {{ section.settings.quote_badge_size }}px;
    height: {{ section.settings.quote_badge_size }}px;
    border-radius: 50%;
    background-color: {{ section.settings.quote_badge_bg }};
    color: {{ section.settings.quote_badge_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    z-index: 1;
  }

  .rc-card-quote-{{ sid }} svg {
    width: 80%;
    height: 80%;
    display: block;
    transform: translateY(0%);
  }

  /* ── Stars ── */
  .rc-card-stars-{{ sid }} {
    display: flex;
    align-items: center;
    justify-content: {{ card_align_flex }};
    gap: {{ section.settings.star_gap }}px;
    line-height: 1;
  }

  .rc-card-stars-{{ sid }} .rc-star {
    width: {{ section.settings.star_size_mobile }}px;
    height: {{ section.settings.star_size_mobile }}px;
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .rc-card-stars-{{ sid }} .rc-star {
      width: {{ section.settings.star_size_desktop }}px;
      height: {{ section.settings.star_size_desktop }}px;
    }
  }

  /* ── Card heading ── */
  .rc-card-heading-{{ sid }} {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-weight: {{ section.settings.heading_font_weight }};
    font-size: {{ section.settings.heading_size_mobile }}px;
    color: {{ section.settings.heading_color }};
    line-height: {{ section.settings.heading_line_height | times: 0.1 | plus: 1.0 }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    margin: 0;
  }

  @media (min-width: 768px) {
    .rc-card-heading-{{ sid }} {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }
  }

  /* ── Card body ── */
  .rc-card-body-{{ sid }} {
    font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    font-weight: {{ section.settings.body_font_weight }};
    font-size: {{ section.settings.body_size_mobile }}px;
    color: {{ section.settings.body_color }};
    line-height: {{ section.settings.body_line_height | times: 0.1 | plus: 1.0 }};
    letter-spacing: {{ section.settings.body_letter_spacing }}px;
    margin: 0;
    {% comment %} flex-grow: 1; {% endcomment %}
  }

  @media (min-width: 768px) {
    .rc-card-body-{{ sid }} {
      font-size: {{ section.settings.body_size_desktop }}px;
    }
  }

  /* ── Divider ── */
  .rc-card-divider-{{ sid }} {
    border: none;
    border-top: 1px solid {{ section.settings.divider_color }};
    margin: 0;
    {% unless section.settings.show_divider %}display: none;{% endunless %}
  }

  /* ── Profile row ── */
  .rc-card-profile-{{ sid }} {
    display: flex;
    align-items: center;
    justify-content: {{ card_align_flex }};
    gap: {{ section.settings.profile_gap }}px;
  }

  .rc-card-avatar-{{ sid }} {
    width: {{ section.settings.avatar_size }}px;
    height: {{ section.settings.avatar_size }}px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    display: block;
  }

  .rc-card-avatar-placeholder-{{ sid }} {
    width: {{ section.settings.avatar_size }}px;
    height: {{ section.settings.avatar_size }}px;
    border-radius: 50%;
    background-color: {{ section.settings.avatar_placeholder_color }};
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .rc-card-avatar-placeholder-{{ sid }} svg {
    width: 60%;
    height: 60%;
    fill: #ffffff;
    stroke: none;
  }

  .rc-card-meta-{{ sid }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .rc-card-name-{{ sid }} {
    font-family: {{ section.settings.name_font.family }}, {{ section.settings.name_font.fallback_families }};
    font-weight: {{ section.settings.name_font_weight }};
    font-size: {{ section.settings.name_size }}px;
    color: {{ section.settings.name_color }};
    margin: 0;
    line-height: 1.2;
  }

  .rc-card-verified-{{ sid }} {
    font-family: {{ section.settings.name_font.family }}, {{ section.settings.name_font.fallback_families }};
    font-size: {{ section.settings.verified_size }}px;
    color: {{ section.settings.verified_color }};
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    line-height: 1.2;
  }

  .rc-card-verified-{{ sid }} svg {
    width: {{ section.settings.verified_size }}px;
    height: {{ section.settings.verified_size }}px;
    flex-shrink: 0;
  }

  /* ── Pagination ── */
  .rc-pagination-{{ sid }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ section.settings.pagination_gap }}px;
    margin-top: {{ section.settings.pagination_margin_top }}px;
  }

  .rc-pagination-{{ sid }} .rc-pag-btn {
    width: {{ section.settings.arrow_size }}px;
    {% comment %} height: {{ section.settings.arrow_size }}px; {% endcomment %}
    border-radius: 50%;
    border: {{ section.settings.arrow_border_width }}px solid {{ section.settings.arrow_border_color }};
    background-color: {{ section.settings.arrow_bg }};
    color: {{ section.settings.arrow_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 0.2s;
    padding: 0;
    flex-shrink: 0;
  }

  .rc-pagination-{{ sid }} .rc-pag-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .rc-pagination-{{ sid }} .rc-pag-btn svg {
    width: {{ section.settings.arrow_size | times: 0.4 | round }}px;
    height: {{ section.settings.arrow_size | times: 0.4 | round }}px;
    stroke: {{ section.settings.arrow_color }};
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .rc-pagination-{{ sid }} .rc-pag-dots {
    display: flex;
    align-items: center;
    gap: {{ section.settings.dot_gap }}px;
  }

  .rc-pagination-{{ sid }} .rc-dot {
    width: {{ section.settings.dot_size }}px;
    height: {{ section.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ section.settings.dot_color_inactive }};
    cursor: pointer;
    transition: background-color 0.2s, transform 0.2s;
    border: none;
    padding: 0;
    flex-shrink: 0;
  }

  .rc-pagination-{{ sid }} .rc-dot.is-active {
    background-color: {{ section.settings.dot_color_active }};
    transform: scale(1.5);
  }

  /* ── Icon-Text card ── */
  .rc-icon-card-{{ sid }} {
    background-color: {{ section.settings.card_bg }};
    border-radius: {{ section.settings.card_radius }}px;
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.icon_card_icon_color }};
    padding: {{ section.settings.card_padding_mobile }}px;
    display: flex;
    align-items: center;
    gap: {{ section.settings.icon_card_gap }}px;
  }

  @media (min-width: 768px) {
    .rc-icon-card-{{ sid }} {
      padding: {{ section.settings.card_padding_desktop }}px;
      gap: {{ section.settings.icon_card_gap }}px;
    }
  }

  .rc-icon-card-icon-{{ sid }} {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.icon_card_icon_size }}px;
    height: {{ section.settings.icon_card_icon_size }}px;
    color: {{ section.settings.icon_card_icon_color }};
  }

  .rc-icon-card-icon-{{ sid }} svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .rc-icon-card-icon-{{ sid }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .rc-icon-card-text-{{ sid }} {
    font-family: {{ section.settings.icon_card_font.family }}, {{ section.settings.icon_card_font.fallback_families }};
    font-weight: {{ section.settings.icon_card_font_weight }};
    font-size: {{ section.settings.icon_card_font_size_mobile }}px;
    color: {{ section.settings.icon_card_text_color }};
    letter-spacing: {{ section.settings.icon_card_letter_spacing }}px;
    margin: 0;
    line-height: 1.3;
  }

  @media (min-width: 768px) {
    .rc-icon-card-text-{{ sid }} {
      font-size: {{ section.settings.icon_card_font_size_desktop }}px;
    }
  }

  /* ── Icon-Text row (below pagination) ── */
  .rc-icon-row-{{ sid }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.card_gap_mobile }}px;
  }

  @media (min-width: 640px) {
    .rc-icon-row-{{ sid }} {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: {{ section.settings.card_gap_desktop }}px;
    }
  }

  /* ── Disclaimer ── */
  .rc-disclaimer-{{ sid }} {
    font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    font-size: {{ section.settings.disclaimer_font_size }}px;
    color: {{ section.settings.disclaimer_color }};
    text-align: center;
    margin: {{ section.settings.disclaimer_margin_top }}px 0 0;
  }
</style>

<div class="rc-section-{{ sid }}">
  {% if overlay_dir != 'none' %}
    <div class="rc-overlay-{{ sid }}"></div>
  {% endif %}

  <div class="rc-inner-{{ sid }}">

    {%- comment -%} Carousel: all cards live in a single track, JS handles paging {%- endcomment -%}
    <div class="rc-viewport-{{ sid }}">
      <div class="rc-track-{{ sid }}" id="rc-track-{{ sid }}">
        {%- for block in card_blocks -%}
          <div class="rc-card-{{ sid }}" {{ block.shopify_attributes }}>
            {%- if section.settings.show_quote_badge -%}
              <span class="rc-card-quote-{{ sid }}" aria-hidden="true">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M9.5 8.5c-2.2 0-4 1.8-4 4 0 2 1.4 3.7 3.3 4-0.4 1.3-1.3 2.3-2.6 3l0.9 1.5c2.6-1.1 4.4-3.5 4.4-6.5v-2c0-2.2-0.9-4-2-4zm9 0c-2.2 0-4 1.8-4 4 0 2 1.4 3.7 3.3 4-0.4 1.3-1.3 2.3-2.6 3l0.9 1.5c2.6-1.1 4.4-3.5 4.4-6.5v-2c0-2.2-0.9-4-2-4z" fill="currentColor"/>
                </svg>
              </span>
            {%- endif -%}
            {%- assign filled = block.settings.rating | round -%}
            <div class="rc-card-stars-{{ sid }}">
              {%- for i in (1..5) -%}
                {%- if i <= filled -%}
                  <svg class="rc-star" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="{{ block.settings.star_color_filled }}" stroke="none"/></svg>
                {%- else -%}
                  <svg class="rc-star" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="{{ block.settings.star_color_empty }}" stroke="none"/></svg>
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- if block.settings.heading != blank -%}
              <p class="rc-card-heading-{{ sid }}">{{ block.settings.heading | escape }}</p>
            {%- endif -%}

            {%- if block.settings.body != blank -%}
              <p class="rc-card-body-{{ sid }}">{{ block.settings.body | escape }}</p>
            {%- endif -%}

            <hr class="rc-card-divider-{{ sid }}">

            <div class="rc-card-profile-{{ sid }}">
              {%- if section.settings.show_avatars -%}
                {%- if block.settings.avatar != blank -%}
                  <img class="rc-card-avatar-{{ sid }}"
                       src="{{ block.settings.avatar | image_url: width: 120 }}"
                       alt="{{ block.settings.name | escape }}"
                       width="60" height="60" loading="lazy">
                {%- else -%}
                  <div class="rc-card-avatar-placeholder-{{ sid }}">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                      <circle cx="12" cy="7" r="4" stroke="#ffffff" stroke-width="2" fill="none"/>
                    </svg>
                  </div>
                {%- endif -%}
              {%- endif -%}
              <div class="rc-card-meta-{{ sid }}">
                {%- if block.settings.name != blank -%}
                  <p class="rc-card-name-{{ sid }}">{{ block.settings.name | escape }}</p>
                {%- endif -%}
                {%- if section.settings.show_verified -%}
                  <p class="rc-card-verified-{{ sid }}">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <polyline points="20 6 9 17 4 12" stroke="{{ section.settings.verified_color }}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {{ section.settings.verified_label | default: 'Verified Customer' }}
                  </p>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if total_cards > 1 -%}
      <div class="rc-pagination-{{ sid }}" id="rc-pag-{{ sid }}" style="display:none;">
        <button class="rc-pag-btn" id="rc-prev-{{ sid }}" aria-label="Previous">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <div class="rc-pag-dots" id="rc-dots-{{ sid }}"></div>
        <button class="rc-pag-btn" id="rc-next-{{ sid }}" aria-label="Next">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    {%- endif -%}

    {%- comment -%} Icon & Text cards — always outside pagination, rendered as a static row {%- endcomment -%}
    {%- if icon_blocks.size > 0 -%}
      <div class="rc-icon-row-{{ sid }}" style="margin-top: {{ section.settings.icon_row_margin_top }}px;">
        {%- for block in icon_blocks -%}
          <div class="rc-icon-card-{{ sid }}" {{ block.shopify_attributes }}>

            {%- if block.settings.custom_svg != blank -%}
              <span class="rc-icon-card-icon-{{ sid }}">
                {{ block.settings.custom_svg }}
              </span>
            {%- elsif block.settings.custom_icon != blank -%}
              <span class="rc-icon-card-icon-{{ sid }}">
                <img src="{{ block.settings.custom_icon | image_url: width: 80 }}"
                    alt="" loading="lazy" width="80" height="80">
              </span>
            {%- elsif block.settings.icon != 'none' -%}

              <span class="rc-icon-card-icon-{{ sid }}">
                {%- case block.settings.icon -%}
                  {%- when 'shield-check' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                  {%- when 'lab' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2v9.764a5 5 0 1 1-5 0V2"/><line x1="9" y1="2" x2="15" y2="2"/></svg>
                  {%- when 'leaf' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8C8 10 5.9 16.17 3.82 21.34L5.71 22l1-2.3A4.49 4.49 0 0 0 8 20C19 20 22 3 22 3c-1 2-8 2-8 2s-2 0-2 5 5 5 6 7"/></svg>
                  {%- when 'check-circle' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  {%- when 'award' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>
                  {%- when 'star' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  {%- when 'heart' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  {%- when 'truck' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  {%- when 'tag' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                  {%- when 'recycle' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><polyline points="23 20 23 14 17 14"/><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/></svg>
                  {%- when 'drop' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                {%- endcase -%}
              </span>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <span class="rc-icon-card-text-{{ sid }}">{{ block.settings.text | escape }}</span>
            {%- endif -%}

          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.disclaimer_text != blank -%}
      <p class="rc-disclaimer-{{ sid }}">{{ section.settings.disclaimer_text | escape }}</p>
    {%- endif -%}

  </div>
</div>

<script>
(function () {
  var sid        = '{{ sid }}';
  var totalCards = {{ total_cards }};
  if (totalCards <= 1) return;

  var track   = document.getElementById('rc-track-' + sid);
  var pag     = document.getElementById('rc-pag-' + sid);
  var dotsBox = document.getElementById('rc-dots-' + sid);
  var prevBtn = document.getElementById('rc-prev-' + sid);
  var nextBtn = document.getElementById('rc-next-' + sid);
  if (!track || !pag || !dotsBox) return;

  var cards       = Array.prototype.slice.call(track.children);
  var currentPage = 0;
  var totalPages  = 1;

  function cardsPerView() {
    return window.innerWidth >= 768 ? 3 : 1;
  }

  function buildDots() {
    dotsBox.innerHTML = '';
    for (var i = 0; i < totalPages; i++) {
      var b = document.createElement('button');
      b.className = 'rc-dot' + (i === currentPage ? ' is-active' : '');
      b.setAttribute('data-target', i);
      b.setAttribute('aria-label', 'Page ' + (i + 1));
      b.addEventListener('click', (function (idx) {
        return function () { goTo(idx); };
      })(i));
      dotsBox.appendChild(b);
    }
  }
  function updateViewportHeight() {
  var viewport = track.parentElement;
  var perView = cardsPerView();
  var startIdx = currentPage * perView;
  var maxH = 0;
  for (var i = startIdx; i < startIdx + perView && i < cards.length; i++) {
    var h = cards[i].offsetHeight;
    if (h > maxH) maxH = h;
  }
  viewport.style.height = maxH + 'px';
}

  function applyTransform() {
    var perView  = cardsPerView();
    var firstIdx = currentPage * perView;
    var target   = cards[firstIdx];
    if (!target) {
      track.style.transform = 'translateX(0)';
      return;
    }
    track.style.transform = 'translateX(' + (-target.offsetLeft) + 'px)';
    updateViewportHeight();
  }

  function updateDots() {
    var dots = dotsBox.querySelectorAll('.rc-dot');
    for (var i = 0; i < dots.length; i++) {
      dots[i].classList.toggle('is-active', i === currentPage);
    }
  }

  function recompute() {
    var perView = cardsPerView();
    totalPages  = Math.ceil(totalCards / perView);
    if (currentPage >= totalPages) currentPage = totalPages - 1;
    if (currentPage < 0) currentPage = 0;

    pag.style.display = totalPages > 1 ? '' : 'none';

    buildDots();
    applyTransform();
  }

  function goTo(n) {
    if (n < 0) n = totalPages - 1;
    if (n > totalPages - 1) n = 0;
    currentPage = n;
    applyTransform();
    updateDots();
  }

  if (prevBtn) prevBtn.addEventListener('click', function () { goTo(currentPage - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function () { goTo(currentPage + 1); });

  recompute();

  var resizeTimer;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(recompute, 150);
  });
})();
</script>

