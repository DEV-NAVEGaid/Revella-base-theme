{%- comment -%} What Sets Us Apart — image + heading + feature list (Dawn 16) {%- endcomment -%}

<style>
  #shopify-section-{{ section.id }}{
    background:{{ section.settings.section_bg }};
    margin-top:0 !important;
    --bio-wsa-fs:{{ section.settings.font_scale }};
    --bio-wsa-line:{{ section.settings.divider_color }};
  }
  .bio-wsa{ padding:{{ section.settings.padding_top | times: 0.7 | round }}px 0 {{ section.settings.padding_bottom | times: 0.7 | round }}px; overflow-x:clip; }
  .bio-wsa *,.bio-wsa *::before,.bio-wsa *::after{ box-sizing:border-box; min-width:0; }
  .bio-wsa img{ max-width:100%; display:block; }

  .bio-wsa__media{ border-radius:{{ section.settings.image_radius }}px; overflow:hidden; margin-bottom:22px; }
  .bio-wsa__media img{ width:100%; height:100%; object-fit:cover; aspect-ratio:{{ section.settings.image_ratio }}; }
  .bio-wsa__media--empty{ aspect-ratio:{{ section.settings.image_ratio }}; background:rgba(0,0,0,.06); }

  .bio-wsa__head{ text-align:{{ section.settings.text_align }}; margin-bottom:22px; }
  .bio-wsa__title{ margin:0 0 10px; font-size:calc({{ section.settings.heading_size }}rem * var(--bio-wsa-fs)); line-height:1.2; font-weight:800; letter-spacing:-.02em; }
  .bio-wsa__intro{ margin:0 auto; max-width:620px; font-size:calc({{ section.settings.intro_size }}rem * var(--bio-wsa-fs)); line-height:1.5; opacity:.85; }
  .bio-wsa__intro p{ margin:0; }

  .bio-wsa__list{ display:grid; grid-template-columns:minmax(0,1fr);
    background:{{ section.settings.list_bg }};
    border-radius:{{ section.settings.list_radius }}px;
    padding:{{ section.settings.list_padding }}px {{ section.settings.list_padding_x }}px;
    {% if section.settings.list_full_width %}width:100vw; margin-left:calc(50% - 50vw); border-radius:0;{% endif %} }
  .bio-wsa__item:first-child{ padding-top:0; }
  .bio-wsa__item:last-child{ padding-bottom:0; }
  .bio-wsa__item{ text-align:{{ section.settings.item_align }}; padding:{{ section.settings.item_spacing }}px 0; }
  .bio-wsa__item+.bio-wsa__item{ border-top:1px solid var(--bio-wsa-line); }
  .bio-wsa__icon{ display:flex; justify-content:{% if section.settings.item_align == 'center' %}center{% else %}flex-start{% endif %}; margin-bottom:8px; }
  .bio-wsa__icon img,.bio-wsa__icon svg{ width:{{ section.settings.icon_size }}px; height:{{ section.settings.icon_size }}px; object-fit:contain; color:{{ section.settings.icon_color }}; }
  .bio-wsa__item h3{ margin:0 0 6px; font-size:calc({{ section.settings.item_heading_size }}rem * var(--bio-wsa-fs)); line-height:1.3; font-weight:700; }
  .bio-wsa__item .bio-wsa__copy{ font-size:calc({{ section.settings.item_text_size }}rem * var(--bio-wsa-fs)); line-height:1.5; opacity:.8; }
  .bio-wsa__copy p{ margin:0 0 8px; } .bio-wsa__copy p:last-child{ margin:0; }

  @media screen and (min-width:750px){
    .bio-wsa{ padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
    .bio-wsa__grid{ display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:44px; align-items:center; }
    .bio-wsa__media{ margin-bottom:0; {% if section.settings.image_position == 'right' %}order:2;{% endif %} }
    .bio-wsa__list{ grid-template-columns:repeat({{ section.settings.columns }},minmax(0,1fr)); gap:0 30px; }
    {% if section.settings.columns > 1 %}
      .bio-wsa__item+.bio-wsa__item{ border-top:0; }
      .bio-wsa__item{ border-top:1px solid var(--bio-wsa-line); }
    {% endif %}
  }
</style>

<div class="bio-wsa color-{{ section.settings.color_scheme }}" id="bio-wsa-{{ section.id }}">
  <div class="page-width">
    <div class="bio-wsa__grid">
      {%- if section.settings.show_image -%}
        <div class="bio-wsa__media{% unless section.settings.image %} bio-wsa__media--empty{% endunless %}">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '375,550,750,1100,1200', sizes: '(min-width:750px) 50vw, 100vw', alt: section.settings.heading | escape }}
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="bio-wsa__content">
        <div class="bio-wsa__head">
          {%- if section.settings.heading != blank -%}<h2 class="bio-wsa__title">{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.intro != blank -%}<div class="bio-wsa__intro rte">{{ section.settings.intro }}</div>{%- endif -%}
        </div>

        <div class="bio-wsa__list">
          {%- for block in section.blocks -%}
            <div class="bio-wsa__item" {{ block.shopify_attributes }}>
              {%- if section.settings.show_icon -%}
                <div class="bio-wsa__icon">
                  {%- if block.settings.icon != blank -%}
                    {{ block.settings.icon | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                  {%- else -%}
                    <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"><g fill="currentColor"><path d="M12.077,13.497h-.56l-.428,.359c-.586,.492-1.328,.762-2.09,.762s-1.505-.271-2.09-.762l-.428-.359h-.56c-.321,0-.628-.058-.923-.145v3.898c0,.286,.162,.546,.419,.673,.254,.125,.561,.096,.788-.079l2.793-2.148,2.793,2.148c.134,.103,.295,.156,.457,.156,.113,0,.227-.025,.331-.077,.257-.126,.419-.387,.419-.673v-3.898c-.295,.087-.602,.145-.923,.145Z"></path><path d="M15.229,6.536l-.506-.877c-.03-.052-.041-.113-.031-.169l.177-1c.147-.837-.325-1.656-1.125-1.948l-.953-.346c-.055-.02-.102-.059-.131-.111l-.508-.877c-.425-.738-1.316-1.06-2.114-.77l-.953,.347c-.055,.02-.115,.02-.17,0l-.953-.347c-.803-.292-1.69,.032-2.114,.769l-.509,.88c-.028,.05-.075,.089-.129,.109l-.955,.347c-.799,.292-1.271,1.11-1.124,1.949l.176,.996c.011,.059,0,.12-.029,.171l-.507,.878c-.426,.736-.262,1.668,.391,2.216l.775,.651c.046,.038,.076,.091,.087,.15l.177,.998c.147,.838,.872,1.446,1.723,1.446h1.015c.059,0,.115,.021,.16,.059l.777,.652c.326,.274,.726,.411,1.125,.411s.799-.137,1.125-.41l.777-.653c.045-.038,.102-.058,.16-.058h1.015c.851,0,1.575-.608,1.723-1.445l.177-1c.011-.058,.041-.111,.085-.148l.778-.652c.651-.548,.815-1.479,.39-2.215Zm-6.229,2.188c-1.105,0-2-.896-2-2s.895-2,2-2,2,.896,2,2-.895,2-2,2Z"></path></g></svg>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading }}</h3>{%- endif -%}
              {%- if block.settings.content != blank -%}<div class="bio-wsa__copy rte">{{ block.settings.content }}</div>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bio: What Sets Apart",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
        { "type": "color", "id": "section_bg", "label": "Section background", "default": "#FFFFFF" },
        { "type": "color", "id": "list_bg", "label": "Feature list background", "default": "#F1F0EE" },
    { "type": "checkbox", "id": "list_full_width", "label": "Full width list background", "default": true },
    { "type": "range", "id": "list_radius", "min": 0, "max": 30, "step": 1, "unit": "px", "label": "List radius", "default": 0 },
    { "type": "range", "id": "list_padding", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "List padding (vertical)", "default": 32 },
    { "type": "range", "id": "list_padding_x", "min": 0, "max": 60, "step": 4, "unit": "px", "label": "List padding (horizontal)", "default": 20 },
    { "type": "range", "id": "font_scale", "min": 0.6, "max": 1.2, "step": 0.1, "label": "Font scale", "default": 1 },

    { "type": "header", "content": "Image" },
    { "type": "checkbox", "id": "show_image", "label": "Show image", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "3 / 4",
      "options": [ {"value":"1 / 1","label":"Square"},{"value":"3 / 4","label":"Portrait 3:4"},{"value":"9 / 16","label":"Tall 9:16"},{"value":"4 / 3","label":"Landscape 4:3"} ] },
    { "type": "range", "id": "image_radius", "min": 0, "max": 30, "step": 1, "unit": "px", "label": "Image radius", "default": 10 },
    { "type": "select", "id": "image_position", "label": "Image position (desktop)", "default": "left",
      "options": [ {"value":"left","label":"Left"},{"value":"right","label":"Right"} ] },

    { "type": "header", "content": "Header" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Sets Our Turmeric Apart?" },
    { "type": "richtext", "id": "intro", "label": "Intro text" },
    { "type": "select", "id": "text_align", "label": "Header alignment", "default": "center",
      "options": [ {"value":"left","label":"Left"},{"value":"center","label":"Center"} ] },
    { "type": "range", "id": "heading_size", "min": 2.0, "max": 5.0, "step": 0.1, "unit": "rem", "label": "Heading size", "default": 3.0 },
    { "type": "range", "id": "intro_size", "min": 1.2, "max": 2.2, "step": 0.1, "unit": "rem", "label": "Intro size", "default": 1.5 },

    { "type": "header", "content": "Feature list" },
    { "type": "checkbox", "id": "show_icon", "label": "Show icon", "default": true },
    { "type": "color", "id": "icon_color", "label": "Default icon color", "default": "#121212" },
    { "type": "range", "id": "icon_size", "min": 14, "max": 60, "step": 2, "unit": "px", "label": "Icon size", "default": 22 },
    { "type": "select", "id": "item_align", "label": "Item alignment", "default": "center",
      "options": [ {"value":"left","label":"Left"},{"value":"center","label":"Center"} ] },
    { "type": "range", "id": "item_spacing", "min": 8, "max": 48, "step": 2, "unit": "px", "label": "Item spacing", "default": 20 },
    { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#DDDAD4" },
    { "type": "range", "id": "columns", "min": 1, "max": 3, "step": 1, "label": "Columns (desktop)", "default": 1 },
    { "type": "range", "id": "item_heading_size", "min": 1.3, "max": 2.6, "step": 0.1, "unit": "rem", "label": "Item heading size", "default": 1.6 },
    { "type": "range", "id": "item_text_size", "min": 1.1, "max": 2.0, "step": 0.1, "unit": "rem", "label": "Item text size", "default": 1.4 },

    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    { "type": "feature", "name": "Feature", "settings": [
      { "type": "image_picker", "id": "icon", "label": "Icon (optional)" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Clinically Effective Dosage" },
      { "type": "richtext", "id": "content", "label": "Text" } ] }
  ],
  "presets": [
    { "name": "Bio: What Sets Apart",
      "settings": {
        "heading": "What Sets Our Turmeric Apart?",
        "intro": "<p>Most turmeric supplements on the market sound the same—but there are <em>critical differences</em> that affect how well they work in your body. Here's why ours stands out:</p>"
      },
      "blocks": [
        { "type": "feature", "settings": { "heading": "Clinically Effective Dosage", "content": "<p>We don't just sprinkle in turmeric for the label, we use a high-potency extract standardized to 95% curcuminoids. This matches the clinical dose used in human studies for joint health, pain reduction, and systemic inflammation.</p>" } },
        { "type": "feature", "settings": { "heading": "Enhanced Absorption with Black Pepper Extract", "content": "<p>Curcumin (the active compound in turmeric) is notoriously hard for the body to absorb. That's why we include black pepper extract, proven in clinical studies to boost absorption by up to 2000%.</p>" } },
        { "type": "feature", "settings": { "heading": "Sustainably Sourced", "content": "<p>Our turmeric is sourced from organically grown roots and extracted using a solvent-free, clean extraction method that preserves the full spectrum of beneficial compounds without the fillers, additives, or artificial preservatives you'll find in cheaper alternatives.</p>" } },
        { "type": "feature", "settings": { "heading": "Customer First Approach", "content": "<p>Your satisfaction is our priority. Our dedicated support team is here to ensure you have a positive experience every step of the way.</p>" } }
      ]
    }
  ]
}
{% endschema %}