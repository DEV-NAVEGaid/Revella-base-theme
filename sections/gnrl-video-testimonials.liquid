{%- liquid
  assign sec_id = section.id
  assign s = section.settings
-%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css" media="print" onload="this.media='all'">

{%- style -%}
  #shopify-section-{{ sec_id }} .gnrl-vt-section {
    background-color: {{ s.bg_color }};
    padding-top: {{ s.padding_top }}px;
    padding-bottom: {{ s.padding_bottom }}px;
    padding-left: {{ s.padding_horizontal }}px;
    padding-right: {{ s.padding_horizontal }}px;
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-heading-wrap {
    text-align: center;
    margin: 0 auto {{ s.heading_gap }}px auto;
    max-width: 900px;
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-heading {
    margin: 0;
    font-size: {{ s.heading_size }}px;
    font-weight: {{ s.heading_font_weight }};
    line-height: 1.2;
    color: {{ s.heading_color }};
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-heading em {
    font-style: normal;
    color: {{ s.heading_highlight_color }};
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-carousel {
    max-width: 1400px;
    margin: 0 auto;
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-slide {
    box-sizing: border-box;
  }

  /* Card: cream matting around the inset video, like the reference */
  #shopify-section-{{ sec_id }} .gnrl-vt-card {
    background-color: {{ s.slide_bg_color }};
    border-radius: {{ s.border_radius }}px;
    padding: {{ s.card_padding }}px;
    box-sizing: border-box;
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-video-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: calc({{ s.border_radius }}px * 0.7);
    background-color: {{ s.slide_bg_color }};
    cursor: pointer;
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Play button + ripple */
  #shopify-section-{{ sec_id }} .gnrl-vt-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: {{ s.play_button_size }}px;
    height: {{ s.play_button_size }}px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background-color: {{ s.play_button_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 2;
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-play-btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: {{ s.play_button_color }};
    transform: translate(-50%, -50%) scale(1);
    opacity: 0.55;
    z-index: -1;
    animation: gnrl-vt-ripple-{{ sec_id }} 1.8s ease-out infinite;
  }

  @keyframes gnrl-vt-ripple-{{ sec_id }} {
    0% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.55;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.8);
      opacity: 0;
    }
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-play-btn:hover {
    transform: translate(-50%, -50%) scale(1.06);
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-play-btn svg {
    width: {{ s.play_icon_size }}px;
    height: {{ s.play_icon_size }}px;
    margin-left: 2px;
    position: relative;
    z-index: 1;
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-video-wrap.is-playing .gnrl-vt-play-btn {
    opacity: 0;
    pointer-events: none;
  }

  /* Sound toggle */
  #shopify-section-{{ sec_id }} .gnrl-vt-sound-btn {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background-color: {{ s.sound_btn_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-sound-btn svg {
    width: 13px;
    height: 13px;
    fill: {{ s.sound_icon_color }};
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-sound-btn .gnrl-vt-icon-unmuted {
    display: none;
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-video-wrap.is-unmuted .gnrl-vt-icon-muted {
    display: none;
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-video-wrap.is-unmuted .gnrl-vt-icon-unmuted {
    display: block;
  }

  /* Progress timeline */
  #shopify-section-{{ sec_id }} .gnrl-vt-timeline {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background-color: {{ s.timeline_track_color }};
    z-index: 3;
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-timeline-fill {
    height: 100%;
    width: 0%;
    background-color: {{ s.timeline_color }};
  }

  /* Combined arrows + dots row below the carousel */
  #shopify-section-{{ sec_id }} .gnrl-vt-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 24px;
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-arrow {
    background: none;
    border: none;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    line-height: 0;
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-arrow svg {
    width: {{ s.arrow_icon_size }}px;
    height: {{ s.arrow_icon_size }}px;
    fill: {{ s.arrow_color }};
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-arrow--prev svg {
    transform: rotate(180deg);
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-pagination {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background-color: {{ s.dot_color }};
    opacity: 0.35;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  #shopify-section-{{ sec_id }} .gnrl-vt-dot.is-active {
    opacity: 1;
    transform: scale(1.5);
  }
{%- endstyle -%}

<div class="gnrl-vt-section">
  <div class="gnrl-vt-heading-wrap">
    {%- if s.heading != blank -%}
      <h2 class="gnrl-vt-heading">{{ s.heading }}</h2>
    {%- endif -%}
  </div>

  <div class="gnrl-vt-carousel splide" id="gnrl-vt-splide-{{ sec_id }}" data-gnrl-vt-splide>
    <div class="splide__track">
      <ul class="splide__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'video' -%}
            {%- liquid
              assign vid = block.settings.video
            -%}
            {%- if vid != blank -%}
              <li class="splide__slide gnrl-vt-slide" {{ block.shopify_attributes }}>
                <div class="gnrl-vt-card">
                  <div class="gnrl-vt-video-wrap" data-gnrl-vt-video-wrap>
                    <video
                      class="gnrl-vt-video"
                      playsinline
                      preload="metadata"
                      muted
                      poster="{{ vid.preview_image | image_url: width: 400 }}"
                      data-gnrl-vt-video
                    >
                      <source src="{{ vid.sources[0].url }}" type="video/mp4">
                    </video>

                    <div class="gnrl-vt-timeline">
                      <div class="gnrl-vt-timeline-fill" data-gnrl-vt-timeline-fill></div>
                    </div>

                    <button type="button" class="gnrl-vt-play-btn" data-gnrl-vt-play aria-label="{{ 'sections.video.play_video' | t: default: 'Play video' }}">
                      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M5 3.5v17l16-8.5-16-8.5z" fill="#ffffff"/>
                      </svg>
                    </button>

                    <button type="button" class="gnrl-vt-sound-btn" data-gnrl-vt-sound aria-label="Toggle sound">
                      <svg class="gnrl-vt-icon-muted" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M16.5 12A4.5 4.5 0 0 0 14 8v8a4.49 4.49 0 0 0 2.5-4zM3 9v6h4l5 5V4L7 9H3zm15.5 3c0-3.31-2.69-6-6-6v1.5c2.49 0 4.5 2.01 4.5 4.5s-2.01 4.5-4.5 4.5V18c3.31 0 6-2.69 6-6zM19 3l-1.06 1.06A8.96 8.96 0 0 1 21 12a8.96 8.96 0 0 1-3.06 7.94L19 21A10.96 10.96 0 0 0 22.5 12 10.96 10.96 0 0 0 19 3z" opacity="0"/>
                        <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM5 9v6h4l5 5V4L9 9H5z"/>
                        <line x1="3" y1="3" x2="21" y2="21" stroke="currentColor" stroke-width="1.6"/>
                      </svg>
                      <svg class="gnrl-vt-icon-unmuted" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </li>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <div class="gnrl-vt-controls" data-gnrl-vt-controls>
    <button type="button" class="gnrl-vt-arrow gnrl-vt-arrow--prev" data-gnrl-vt-prev aria-label="Previous slide">
      <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
        <path d="m15.5 0.932-4.3 4.38 14.5 14.6-14.5 14.5 4.3 4.4 14.6-14.6 4.4-4.3-4.4-4.4-14.6-14.6z"/>
      </svg>
    </button>
    <ul class="gnrl-vt-pagination" data-gnrl-vt-pagination></ul>
    <button type="button" class="gnrl-vt-arrow gnrl-vt-arrow--next" data-gnrl-vt-next aria-label="Next slide">
      <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
        <path d="m15.5 0.932-4.3 4.38 14.5 14.6-14.5 14.5 4.3 4.4 14.6-14.6 4.4-4.3-4.4-4.4-14.6-14.6z"/>
      </svg>
    </button>
  </div>
</div>

<script>
  (function () {
    var sectionId = {{ sec_id | json }};
    var rootSelector = '#shopify-section-' + sectionId;

    function loadSplideAssets(callback) {
      if (window.Splide) {
        callback();
        return;
      }
      if (window.__gnrlVtSplideLoadingPromise) {
        window.__gnrlVtSplideLoadingPromise.then(callback);
        return;
      }
      window.__gnrlVtSplideLoadingPromise = new Promise(function (resolve) {
        var script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js';
        script.onload = function () {
          resolve();
        };
        document.head.appendChild(script);
      });
      window.__gnrlVtSplideLoadingPromise.then(callback);
    }

    function setupVideoControls(splideRoot) {
      var wraps = splideRoot.querySelectorAll('[data-gnrl-vt-video-wrap]');

      wraps.forEach(function (wrap) {
        var video = wrap.querySelector('[data-gnrl-vt-video]');
        var playBtn = wrap.querySelector('[data-gnrl-vt-play]');
        var soundBtn = wrap.querySelector('[data-gnrl-vt-sound]');
        var timelineFill = wrap.querySelector('[data-gnrl-vt-timeline-fill]');
        if (!video || !playBtn) return;

        playBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          video.play();
        });

        video.addEventListener('click', function () {
          if (!video.paused) {
            video.pause();
          }
        });

        video.addEventListener('play', function () {
          wraps.forEach(function (otherWrap) {
            if (otherWrap === wrap) return;
            var otherVideo = otherWrap.querySelector('[data-gnrl-vt-video]');
            if (otherVideo && !otherVideo.paused) {
              otherVideo.pause();
            }
          });
          wrap.classList.add('is-playing');
        });

        video.addEventListener('pause', function () {
          wrap.classList.remove('is-playing');
        });

        video.addEventListener('ended', function () {
          wrap.classList.remove('is-playing');
          if (timelineFill) timelineFill.style.width = '0%';
        });

        if (soundBtn) {
          soundBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            video.muted = !video.muted;
            wrap.classList.toggle('is-unmuted', !video.muted);
          });
        }

        if (timelineFill) {
          video.addEventListener('timeupdate', function () {
            if (video.duration) {
              var pct = (video.currentTime / video.duration) * 100;
              timelineFill.style.width = pct + '%';
            }
          });
        }
      });
    }

    function setupControls(root, splide) {
      var controlsEl = root.querySelector('[data-gnrl-vt-controls]');
      if (!controlsEl) return;

      var prevBtn = controlsEl.querySelector('[data-gnrl-vt-prev]');
      var nextBtn = controlsEl.querySelector('[data-gnrl-vt-next]');
      var dotsList = controlsEl.querySelector('[data-gnrl-vt-pagination]');

      function getPerPage() {
        return splide.options.perPage || 1;
      }

      function getPageCount() {
  var perPage = getPerPage();
  return Math.max(1, splide.length - perPage + 1);
}

function getCurrentPage() {
  return splide.index;
}

      function renderDots() {
        if (!dotsList) return;
        dotsList.innerHTML = '';
        var pageCount = getPageCount();
        var perPage = getPerPage();
        var currentPage = getCurrentPage();

        for (var i = 0; i < pageCount; i++) {
          var li = document.createElement('li');
          var dotBtn = document.createElement('button');
          dotBtn.type = 'button';
          dotBtn.className = 'gnrl-vt-dot';
          if (i === currentPage) dotBtn.classList.add('is-active');
          dotBtn.setAttribute('aria-label', 'Go to slide group ' + (i + 1));
          (function (pageIndex) {
            dotBtn.addEventListener('click', function () {
  splide.go(pageIndex);
});

          })(i);
          li.appendChild(dotBtn);
          dotsList.appendChild(li);
        }
      }

      function updateActiveDot() {
        if (!dotsList) return;
        var currentPage = getCurrentPage();
        var dots = dotsList.querySelectorAll('.gnrl-vt-dot');
        dots.forEach(function (dot, i) {
          dot.classList.toggle('is-active', i === currentPage);
        });
      }

      function updateArrowState() {
        var controller = splide.Components.Controller;
        if (prevBtn) prevBtn.disabled = controller.getPrev() === -1;
        if (nextBtn) nextBtn.disabled = controller.getNext() === -1;
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          splide.go('<');
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          splide.go('>');
        });
      }

      renderDots();
      updateArrowState();

      splide.on('moved', function () {
        updateActiveDot();
        updateArrowState();
      });

      splide.on('resize', function () {
        renderDots();
        updateArrowState();
      });
    }

    function initSection() {
      var root = document.querySelector(rootSelector);
      if (!root) return;

      var splideEl = root.querySelector('[data-gnrl-vt-splide]');
      if (!splideEl) return;

      if (splideEl.classList.contains('is-initialized') || splideEl.__gnrlVtSplide) {
        return;
      }

      loadSplideAssets(function () {
        var splide = new window.Splide(splideEl, {
          type: 'slide',
          perMove: 1,
          perPage: {{ s.slides_desktop }},
          gap: '{{ s.gap_desktop }}px',
          arrows: false,
          pagination: false,
          breakpoints: {
            749: {
              perPage: {{ s.slides_mobile }},
              gap: '{{ s.gap_mobile }}px'
            }
          }
        });

        splide.on('move', function () {
          var videos = splideEl.querySelectorAll('[data-gnrl-vt-video]');
          videos.forEach(function (video) {
            if (!video.paused) {
              video.pause();
            }
          });
        });

        splide.mount();
        splideEl.__gnrlVtSplide = splide;

        setupVideoControls(splideEl);
        setupControls(root, splide);
      });
    }

    function destroySection() {
      var root = document.querySelector(rootSelector);
      if (!root) return;
      var splideEl = root.querySelector('[data-gnrl-vt-splide]');
      if (splideEl && splideEl.__gnrlVtSplide) {
        splideEl.__gnrlVtSplide.destroy();
        splideEl.__gnrlVtSplide = null;
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSection);
    } else {
      initSection();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.target && event.target.id === 'shopify-section-' + sectionId) {
        initSection();
      }
    });

    document.addEventListener('shopify:section:unload', function (event) {
      if (event.target && event.target.id === 'shopify-section-' + sectionId) {
        destroySection();
      }
    });

    document.addEventListener('shopify:section:select', function (event) {
      if (event.target && event.target.id === 'shopify-section-' + sectionId) {
        initSection();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "GNRL_Video Testimonials",
  "tag": "section",
  "class": "gnrl-vt-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See How <em>Revella\u2122</em> Transforms Real Lives",
      "info": "Wrap text in <em></em> tags to apply the highlight color."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extrabold" }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "heading_highlight_color",
      "label": "Heading highlight color",
      "default": "#c8704f"
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Gap below heading",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Carousel layout"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "label": "Slides visible (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "slides_mobile",
      "label": "Slides visible (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Gap between slides (desktop)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap between slides (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Padding around video (card inset)",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "range",
      "id": "play_button_size",
      "label": "Play button size",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "play_icon_size",
      "label": "Play icon size",
      "min": 8,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "play_button_color",
      "label": "Play button color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "sound_btn_bg_color",
      "label": "Sound button background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "sound_icon_color",
      "label": "Sound icon color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "timeline_color",
      "label": "Timeline progress color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "timeline_track_color",
      "label": "Timeline track color",
      "default": "#5a5a5a"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "arrow_icon_size",
      "label": "Arrow icon size",
      "min": 10,
