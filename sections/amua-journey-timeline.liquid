    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FAF9F7" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#111111" },
    { "type": "color", "id": "heading_gradient_start", "label": "Heading highlight gradient — left", "default": "#F6D387" },
    { "type": "color", "id": "heading_gradient_end", "label": "Heading highlight gradient — right", "default": "#EFAF3E" },
