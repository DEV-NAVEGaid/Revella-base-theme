    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 48 },
    { "type": "range", "id": "item_gap", "min": 20, "max": 80, "step": 2, "unit": "px", "label": "Gap between steps", "default": 44 },
    { "type": "range", "id": "content_gap", "min": 12, "max": 40, "step": 1, "unit": "px", "label": "Gap between line & text", "default": 20 },
    { "type": "header", "content": "Timeline dot & line" },
    { "type": "range", "id": "dot_size", "min": 14, "max": 40, "step": 1, "unit": "px", "label": "Dot size", "default": 24 },
    { "type": "range", "id": "dot_ring_width", "min": 2, "max": 8, "step": 1, "unit": "px", "label": "Dot ring thickness", "default": 5 },
    { "type": "range", "id": "line_width", "min": 1, "max": 6, "step": 1, "unit": "px", "label": "Line thickness", "default": 3 },
