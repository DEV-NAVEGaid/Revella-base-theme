{% render 'oc-assets' %}
{%- assign s = section.settings -%}
{%- assign steps = section.blocks | where: 'type', 'step' -%}
<div class="lm">
  <section class="wrap rt" style="background: {{ s.background | default: '#f9f9f9' }}">
    <div class="rt-i">
      <div class="rt-h">
        {%- if s.heading != blank or s.accent != blank -%}
          <h2 class="rt-hd">{{ s.heading | escape }}{% if s.accent != blank %} <span>{{ s.accent | escape }}</span>{% endif %}</h2>
        {%- endif -%}
        {%- if s.intro != blank %}<p class="rt-intro">{{ s.intro }}</p>{% endif -%}
      </div>

      {%- if steps.size > 0 -%}
        <ol class="rt-tl">
          {%- for block in steps -%}
            <li class="rt-st" {{ block.shopify_attributes }}>
              <span class="rt-node" aria-hidden="true"></span>
              {%- if block.settings.label != blank %}<span class="rt-pill">{{ block.settings.label }}</span>{% endif -%}
              {%- if block.settings.title != blank %}<h3 class="rt-t">{{ block.settings.title }}</h3>{% endif -%}
              {%- assign lines = block.settings.lines | newline_to_br | split: '<br />' -%}
              <ul class="rt-ln">
                {%- for line in lines -%}
                  {%- assign l = line | strip -%}
                  {%- if l != blank %}<li>{{ l }}</li>{% endif -%}
                {%- endfor -%}
              </ul>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if s.footnote != blank %}<p class="rt-note">{{ s.footnote }}</p>{% endif -%}
    </div>
  </section>
</div>

<style>
  .lm.lm .rt{padding:40px 20px}
  .lm.lm .rt-i{max-width:800px;margin:0 auto;display:flex;flex-direction:column;gap:32px}
  .lm.lm .rt-h{display:flex;flex-direction:column;align-items:center;gap:16px;text-align:center}
  .lm.lm .rt-hd{margin:0;font-size:28px;line-height:1.3;font-weight:700;color:#121212}
  .lm.lm .rt-hd span{color:#289383}
  .lm.lm .rt-intro{margin:0;font-size:16px;line-height:24px;color:#121212;max-width:700px}
  .lm.lm .rt-tl{list-style:none;margin:0;padding:0}
  .lm.lm .rt-st{position:relative;padding:0 0 36px 50px;display:flex;flex-direction:column;align-items:flex-start;gap:8px}
  .lm.lm .rt-st:last-child{padding-bottom:0}
  .lm.lm .rt-st::before{content:"";position:absolute;left:14px;top:15px;bottom:0;width:2px;background:#d9d9d9}
  .lm.lm .rt-st:last-child::before{bottom:0}
  .lm.lm .rt-node{position:absolute;left:0;top:0;width:30px;height:30px;border-radius:50%;background:#289383;display:flex;align-items:center;justify-content:center;z-index:1}
  .lm.lm .rt-node::after{content:"";width:12px;height:12px;border-radius:50%;background:#fff}
  .lm.lm .rt-pill{padding:4px 12px;border-radius:50px;background:#289383;color:#fff;font-size:12px;line-height:18px;font-weight:600;text-transform:uppercase;letter-spacing:.02em}
  .lm.lm .rt-t{margin:0;font-size:22px;line-height:1.3;font-weight:700;color:#121212}
  .lm.lm .rt-ln{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
  .lm.lm .rt-ln li{position:relative;padding-left:18px;font-size:16px;line-height:25.6px;color:#666}
  .lm.lm .rt-ln li::before{content:"\2713";position:absolute;left:0;top:0}
  .lm.lm .rt-note{margin:0;text-align:center;font-size:14px;line-height:19.5px;color:#666}
  @media screen and (min-width:990px){
    .lm.lm .rt{padding:60px 20px}
    .lm.lm .rt-i{gap:40px}
    .lm.lm .rt-hd{font-size:36px;line-height:46.8px}
    .lm.lm .rt-tl{max-width:800px;margin:0 auto;width:100%}
    .lm.lm .rt-t{font-size:24px;line-height:31.2px}
  }
</style>

{% schema %}
{
  "name": "OC: Routine timeline",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Building Your" },
    { "type": "text", "id": "accent", "label": "Accent part of heading", "info": "Shown in teal after the heading. Empty = heading only.", "default": "Daily Routine" },
    { "type": "textarea", "id": "intro", "label": "Intro line", "info": "Empty = no intro.", "default": "A simple way to make this part of your day." },
    { "type": "header", "content": "Footnote" },
    { "type": "text", "id": "footnote", "label": "Footnote", "info": "Small centred text under the timeline. Empty = none.", "default": "Individual results may vary." },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background", "label": "Background colour", "info": "Empty = light grey (#f9f9f9).", "default": "#f9f9f9" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "info": "Short pill above the title, such as a time span. Empty = no pill.", "default": "Weeks 1-2" },
        { "type": "text", "id": "title", "label": "Title", "default": "Start simple" },
        { "type": "textarea", "id": "lines", "label": "Tick lines", "info": "One per line. Each line gets a tick mark.", "default": "Take one serving a day\nPick a set time" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OC: Routine timeline",
      "blocks": [
        { "type": "step", "settings": { "label": "Weeks 1-2", "title": "Start simple", "lines": "Take one serving a day\nPick a set time, like breakfast" } },
        { "type": "step", "settings": { "label": "Weeks 3-4", "title": "Stay consistent", "lines": "Keep it somewhere you will see it\nPair it with water and movement" } },
        { "type": "step", "settings": { "label": "Weeks 5-8", "title": "Make it a habit", "lines": "Daily use becomes part of your routine\nKeep up balanced meals" } },
        { "type": "step", "settings": { "label": "Week 8+", "title": "Keep going", "lines": "Ongoing daily support\nCheck in with your doctor about your goals" } }
      ]
    }
  ]
}
{% endschema %}
