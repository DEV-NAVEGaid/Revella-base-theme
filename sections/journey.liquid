      "id": "hero_border_radius",
      "label": "Hero border radius (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "hero_margin_bottom",
      "label": "Hero bottom spacing (px)",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 0
    },
    {
      "type": "header",
      "content": "Desktop image column"
