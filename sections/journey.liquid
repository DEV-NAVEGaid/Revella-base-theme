{% comment %}
  Journey Timeline — nvgd-journey-timeline.liquid
{% endcomment %}

{%- style -%}
  #JourneyTimeline-{{ section.id }} .jt-hero {
    position: relative;
    height: {{ section.settings.hero_image_height }}px;
    border-radius: {{ section.settings.hero_border_radius }}px;
    overflow: hidden;
    margin-bottom: {{ section.settings.hero_margin_bottom }}px;
  }

  #JourneyTimeline-{{ section.id }} .jt-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: {% if section.settings.hero_overlay_gradient != blank %}{{ section.settings.hero_overlay_gradient }}{% else %}{{ section.settings.hero_overlay_color }}{% endif %};
    opacity: {{ section.settings.hero_overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }
{%- endstyle -%}

<section id="JourneyTimeline-{{ section.id }}" class="jt-section" style="background: {{ section.settings.background_color }}; padding: {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}px {{ section.settings.padding_bottom }}px;">
  <div class="jt-inner" style="max-width: {{ section.settings.max_width }}px; margin: 0 auto;">
    <div class="jt-layout {% if section.settings.desktop_image_position == 'left' %}jt-layout--image-left{% endif %}">

      <div class="jt-content">

        {%- comment -%} Hero image — mobile only {%- endcomment -%}
        {% if section.settings.hero_image != blank %}
          <div class="jt-hero">
            <img src="{{ section.settings.hero_image | image_url: width: 800 }}" alt="{{ section.settings.hero_text | escape }}" class="jt-hero-img" loading="lazy">
            {% if section.settings.hero_text != blank %}
              <div class="jt-hero-text">
                <p style="color: {{ section.settings.hero_text_color }}; font-size: {{ section.settings.hero_text_font_size }}px; font-weight: {{ section.settings.heading_font_weight }}; font-family: var(--font-heading-family); margin: 0; text-align: center;">{{ section.settings.hero_text }}</p>
              </div>
            {% endif %}
          </div>
        {% elsif section.settings.mobile_image != blank %}
          <div style="margin-bottom: {{ section.settings.hero_margin_bottom }}px;">
            <img src="{{ section.settings.mobile_image | image_url: width: 800 }}" alt="{{ section.settings.mobile_image.alt | escape }}" style="width: 100%; height: auto; display: block; border-radius: {{ section.settings.hero_border_radius }}px; object-fit: cover;" loading="lazy">
          </div>
        {% endif %}

        {%- comment -%} Header {%- endcomment -%}
        <div style="margin-top: {{ section.settings.header_margin_top }}px; margin-bottom: {{ section.settings.header_margin_bottom }}px; text-align: {{ section.settings.header_alignment }};">
          {% if section.settings.eyebrow != blank %}
            <p style="color: {{ section.settings.eyebrow_color }}; font-size: {{ section.settings.eyebrow_font_size }}px; font-weight: {{ section.settings.eyebrow_font_weight }}; font-family: var(--font-heading-family); margin: 0 0 6px; line-height: 1.2;">{{ section.settings.eyebrow }}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 style="color: {{ section.settings.heading_color }}; font-size: {{ section.settings.heading_font_size }}px; font-weight: {{ section.settings.heading_font_weight }}; font-family: var(--font-heading-family); margin: 0 0 12px; line-height: 1.2;">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.subtext != blank %}
            <p style="color: {{ section.settings.subtext_color }}; font-size: {{ section.settings.subtext_font_size }}px; font-family: var(--font-body-family); line-height: 1.6; margin: 0;">{{ section.settings.subtext }}</p>
          {% endif %}
        </div>

        {%- comment -%} Timeline {%- endcomment -%}
        <div class="jt-timeline" id="jtTimeline-{{ section.id }}">
          {% for block in section.blocks %}
            {% if block.type == 'timeline_step' %}
              <div class="jt-step{% if forloop.last %} jt-step--last{% endif %}" style="--dot-size: {{ section.settings.dot_size }}px; --line-color: {{ section.settings.line_color }}; --line-width: {{ section.settings.line_width }}px; --dot-color: {{ section.settings.dot_color }}; --dot-offset: {{ section.settings.label_padding_vertical }}px;" {{ block.shopify_attributes }}>
                <div class="jt-step-left">
                  <div class="jt-step-dot"></div>
                  <div class="jt-step-line"></div>
                </div>
                <div style="flex: 1; min-width: 0; padding-bottom: {{ section.settings.step_gap }}px;">
                  {% if block.settings.label != blank %}
                    <div style="background: {{ section.settings.label_background }}; color: {{ section.settings.label_text_color }}; font-size: {{ section.settings.label_font_size }}px; font-weight: {{ section.settings.label_font_weight }}; font-family: var(--font-heading-family); border-radius: {{ section.settings.label_border_radius }}px; padding: {{ section.settings.label_padding_vertical }}px {{ section.settings.label_padding_horizontal }}px; line-height: 1.3; display: block; margin-bottom: {{ section.settings.label_margin_bottom }}px;">{{ block.settings.label }}</div>
                  {% endif %}
                  {% if block.settings.items != blank %}
                    {% assign item_lines = block.settings.items | newline_to_br | split: '<br />' %}
                    <ul style="list-style: none; padding: {{ section.settings.items_padding_top }}px 0 {{ section.settings.items_padding_bottom }}px; margin: 0; display: flex; flex-direction: column; gap: 6px; font-family: var(--font-body-family); font-size: {{ section.settings.item_font_size }}px; color: {{ section.settings.item_text_color }}; line-height: 1.5;">
                      {% for item in item_lines %}
                        {% assign item_stripped = item | strip_html | strip %}
                        {% if item_stripped != blank %}
                          <li style="display: flex; align-items: flex-start; gap: 8px;"><span style="color: {{ section.settings.checkmark_color }}; font-weight: 700; flex-shrink: 0; line-height: 1.5;">✓</span>{{ item_stripped }}</li>
                        {% endif %}
                      {% endfor %}
                    </ul>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {%- comment -%} Tagline {%- endcomment -%}
        {% if section.settings.tagline != blank %}
          <p style="color: {{ section.settings.tagline_color }}; font-size: {{ section.settings.tagline_font_size }}px; font-style: {{ section.settings.tagline_font_style }}; font-family: var(--font-body-family); line-height: 1.5; margin: {{ section.settings.tagline_margin_top }}px 0 0; text-align: {{ section.settings.header_alignment }};">{{ section.settings.tagline }}</p>
        {% endif %}

        {%- comment -%} CTA {%- endcomment -%}
        {% if section.settings.button_label != blank %}
          <div style="margin-top: {{ section.settings.cta_margin_top }}px;">
            <a href="{{ section.settings.button_url }}" style="display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px; background: {{ section.settings.button_background }}; color: {{ section.settings.button_text_color }}; border-radius: {{ section.settings.button_border_radius }}px; font-size: {{ section.settings.button_font_size }}px; font-weight: {{ section.settings.button_font_weight }}; font-family: var(--font-body-family); text-decoration: none; box-sizing: border-box; transition: opacity 0.2s;">
              {{ section.settings.button_label }}
              {% if section.settings.button_show_arrow %}<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endif %}
            </a>
            {% if section.settings.guarantee_text != blank %}
              <p style="text-align: center; margin: {{ section.settings.guarantee_margin_top }}px 0 0; color: {{ section.settings.guarantee_color }}; font-size: {{ section.settings.guarantee_font_size }}px; font-family: var(--font-body-family);">{{ section.settings.guarantee_text }}</p>
            {% endif %}
          </div>
        {% endif %}

      </div>

      {%- comment -%} Desktop image column {%- endcomment -%}
      <div class="jt-desktop-image">
        {% if section.settings.desktop_image != blank %}
          <img src="{{ section.settings.desktop_image | image_url: width: 1000 }}" alt="{{ section.settings.desktop_image.alt | escape }}" class="jt-desktop-img" loading="lazy">
        {% elsif section.settings.mobile_image != blank %}
          <img src="{{ section.settings.mobile_image | image_url: width: 1000 }}" alt="{{ section.settings.mobile_image.alt | escape }}" class="jt-desktop-img" loading="lazy">
        {% elsif section.settings.hero_image != blank %}
          <img src="{{ section.settings.hero_image | image_url: width: 1000 }}" alt="" class="jt-desktop-img" loading="lazy">
        {% endif %}
      </div>

    </div>
  </div>
</section>

<style>
  #JourneyTimeline-{{ section.id }} .jt-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    z-index: 0;
  }

  #JourneyTimeline-{{ section.id }} .jt-hero-text {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  #JourneyTimeline-{{ section.id }} .jt-desktop-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  /* ── Layout ── */
  #JourneyTimeline-{{ section.id }} .jt-section { box-sizing: border-box; width: 100%; }
  #JourneyTimeline-{{ section.id }} .jt-layout { display: flex; flex-direction: column; }
  #JourneyTimeline-{{ section.id }} .jt-desktop-image { display: none; }
  #JourneyTimeline-{{ section.id }} .jt-timeline { display: flex; flex-direction: column; }

  /* ── Timeline bar ── */
  #JourneyTimeline-{{ section.id }} .jt-step {
    display: flex !important;
    gap: {{ section.settings.dot_gap }}px;
    align-items: stretch !important;
  }

  #JourneyTimeline-{{ section.id }} .jt-step-left {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    flex-shrink: 0 !important;
    width: var(--dot-size);
  }

  #JourneyTimeline-{{ section.id }} .jt-step-dot {
    display: block !important;
    width: var(--dot-size) !important;
    height: var(--dot-size) !important;
    border-radius: 50% !important;
    background: {{ section.settings.line_color }};
    flex-shrink: 0 !important;
    margin-top: var(--dot-offset);
    position: relative;
    z-index: 1;
    transition: background 0.4s ease;
  }

  #JourneyTimeline-{{ section.id }} .jt-step-dot.is-active {
    background: {{ section.settings.dot_color }} !important;
  }

  #JourneyTimeline-{{ section.id }} .jt-step-line {
    display: block !important;
    flex: 1 1 auto !important;
    width: var(--line-width) !important;
    min-width: var(--line-width) !important;
    max-width: var(--line-width) !important;
    min-height: 24px !important;
    background: {{ section.settings.line_color }};
    margin-top: 2px;
    position: relative;
    overflow: hidden;
  }

  #JourneyTimeline-{{ section.id }} .jt-step-line::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0%;
    background: {{ section.settings.dot_color }};
    transition: height 0.5s ease;
  }

  #JourneyTimeline-{{ section.id }} .jt-step-line.is-active::after {
    height: 100%;
  }

  #JourneyTimeline-{{ section.id }} .jt-step--last .jt-step-line {
    display: none !important;
  }

  /* ── Desktop ── */
  @media screen and (min-width: 750px) {
    #JourneyTimeline-{{ section.id }} .jt-hero { display: none; }

    #JourneyTimeline-{{ section.id }} .jt-desktop-image {
      {% if section.settings.hide_image_on_desktop %}
      display: none !important;
      {% else %}
      display: flex !important;
      flex-shrink: 0;
      width: {{ section.settings.desktop_image_width }}%;
      align-items: flex-start;
      position: sticky;
      bottom: {{ section.settings.desktop_image_sticky_top }}px;
      align-self: flex-end;
      {% endif %}
    }

    {% if section.settings.hide_image_on_desktop %}
    #JourneyTimeline-{{ section.id }} .jt-layout {
      justify-content: center;
    }
    #JourneyTimeline-{{ section.id }} .jt-content {
      max-width: {{ section.settings.desktop_content_max_width }}px;
    }
    {% endif %}

    #JourneyTimeline-{{ section.id }} .jt-layout {
      flex-direction: row !important;
      gap: {{ section.settings.desktop_col_gap }}px;
      align-items: flex-start;
    }

    #JourneyTimeline-{{ section.id }} .jt-layout--image-left {
      flex-direction: row-reverse !important;
    }

    #JourneyTimeline-{{ section.id }} .jt-content {
      flex: 1;
      min-width: 0;
    }
  }
</style>

<script>
(function() {
  var section = document.getElementById('JourneyTimeline-{{ section.id }}');
  if (!section) return;

  var steps = Array.from(section.querySelectorAll('.jt-step'));
  if (!steps.length) return;

  function activate(index) {
    steps.forEach(function(step, i) {
      var dot = step.querySelector('.jt-step-dot');
      var line = step.querySelector('.jt-step-line');
      if (i <= index) {
        if (dot) dot.classList.add('is-active');
      } else {
        if (dot) dot.classList.remove('is-active');
      }
      if (i < index) {
        if (line) line.classList.add('is-active');
      } else {
        if (line) line.classList.remove('is-active');
      }
    });
  }

  function onScroll() {
    var windowH = window.innerHeight;
    var activeIndex = -1;
    steps.forEach(function(step, i) {
      var rect = step.getBoundingClientRect();
      var middle = rect.top + rect.height / 2;
      if (middle < windowH * 0.75) {
        activeIndex = i;
      }
    });
    activate(activeIndex);
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
})();
</script>

{% schema %}
{
  "name": "Journey timeline",
  "tag": "section",
  "class": "journey-timeline-section",
  "settings": [
    {
      "type": "header",
