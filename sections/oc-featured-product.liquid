    { "type": "header", "content": "Gallery" },
    { "type": "checkbox", "id": "show_thumbs", "label": "Show thumbnails", "default": true },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows on main image", "default": true, "info": "Needs thumbnails on and 2+ product images." },
    { "type": "image_picker", "id": "prev_icon", "label": "Previous arrow icon", "info": "Optional. Replaces the default left arrow. Square PNG/SVG." },
    { "type": "image_picker", "id": "next_icon", "label": "Next arrow icon", "info": "Optional. Replaces the default right arrow. Square PNG/SVG." },
    { "type": "range", "id": "thumb_limit", "label": "Max thumbnails", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "header", "content": "Info" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": false, "info": "Only switch on with a real rating." },
    { "type": "text", "id": "rating_text", "label": "Rating text" },
    { "type": "text", "id": "title", "label": "Title", "info": "Empty = product title." },
    { "type": "richtext", "id": "description", "label": "Description", "info": "Empty = product description." },
    { "type": "text", "id": "highlight", "label": "Highlight", "info": "Optional. One bold line under the description." },
    { "type": "header", "content": "Checklist icons" },
    { "type": "select", "id": "check_style", "label": "Checklist icon", "default": "circle-check-20", "options": [ { "value": "circle-check-20", "label": "Outline circle check" }, { "value": "check-green-18", "label": "Green filled check" }, { "value": "check-16", "label": "Plain check" } ], "info": "Used for check points and pack benefits." },
    { "type": "image_picker", "id": "check_icon", "label": "Custom checklist icon (optional)", "info": "Square PNG/SVG, shown 20 px. Replaces the icon above." },
    { "type": "header", "content": "Option picker" },
    { "type": "checkbox", "id": "show_flavors", "label": "Show option picker", "default": true, "info": "Buttons for the product's first option (flavor, size...). Hidden when the product has no options." },
    { "type": "text", "id": "flavor_label", "label": "Label", "info": "Empty = the option's own name." },
    { "type": "range", "id": "bestseller_position", "label": "Badge on option #", "min": 0, "max": 6, "step": 1, "default": 0, "info": "0 = no badge." },
