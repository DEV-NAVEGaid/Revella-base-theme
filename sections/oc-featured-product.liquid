        { "type": "text", "id": "per_day_label", "label": "Per-day suffix", "default": "Per Day" },
        { "type": "text", "id": "off_text", "label": "Discount pill text (optional)", "info": "Empty = calculated automatically from compare-at / plan price." },
        { "type": "text", "id": "off_suffix", "label": "Auto discount suffix", "default": "% Off" },
        { "type": "text", "id": "callout_text", "label": "Bottom callout text (optional)", "info": "Strip at the bottom of the card, e.g. +FREE Shipping. Empty = hidden." },
        { "type": "text", "id": "callout_compare", "label": "Bottom callout crossed-out value (optional)", "info": "e.g. $4.99" },
        { "type": "textarea", "id": "benefits", "label": "Benefits (one per line)", "info": "Shown when this pack is selected.", "default": "30-day supply\n60-day money-back guarantee" }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Description" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Accordion content.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    },
    {
      "type": "perk",
      "name": "Perk",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Icon image (optional)", "info": "Square PNG/SVG, shown 18 px. Replaces the built-in icon." },
        { "type": "select", "id": "icon", "label": "Built-in icon", "default": "calendar", "options": [ { "value": "calendar", "label": "Calendar" }, { "value": "box", "label": "Box" }, { "value": "repeat", "label": "Repeat" }, { "value": "refresh", "label": "Refill" }, { "value": "truck", "label": "Truck" }, { "value": "pause", "label": "Pause" }, { "value": "shield-perk", "label": "Shield" }, { "value": "gift", "label": "Gift" } ] },
        { "type": "text", "id": "text", "label": "Text", "default": "Refills Every 4 Weeks" }
      ]
    }
  ],
  "presets": [
    {
      "name": "OC: Featured product",
      "blocks": [
        { "type": "point" },
        { "type": "point", "settings": { "text": "FREE shipping on 1st order" } },
        { "type": "point", "settings": { "text": "FREE gift" } },
        { "type": "point", "settings": { "text": "Easy to take every day" } },
