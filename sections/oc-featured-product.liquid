    { "type": "header", "content": "Packs" },
    { "type": "text", "id": "packs_label", "label": "Label", "default": "Subscribe & Save:" },
    { "type": "text", "id": "bf_callout", "label": "Campaign callout above packs", "info": "e.g. Black Friday Offer. Empty = hidden." },
    { "type": "text", "id": "bf_callout_note", "label": "Campaign callout: right-side text", "info": "e.g. Up to 50% off. Empty = hidden." },
    { "type": "checkbox", "id": "bf_accents", "label": "Black Friday accents", "default": false, "info": "Black and gold discount pills and pack ribbon, plus a tag on the main image (uses the callout text)." },
    { "type": "range", "id": "default_pack", "label": "Selected pack by default", "min": 1, "max": 5, "step": 1, "default": 1 },
    { "type": "checkbox", "id": "show_otp", "label": "Show one-time purchase link", "default": true, "info": "Adds 1 unit without a subscription plan." },
    { "type": "text", "id": "otp_label", "label": "One-time purchase label", "default": "One Time Purchase" },
    { "type": "header", "content": "Buy button" },
    { "type": "text", "id": "buy_label", "label": "Label", "default": "Get started now" },
    { "type": "checkbox", "id": "show_buy_icon", "label": "Show button icon", "default": true },
    { "type": "image_picker", "id": "buy_icon", "label": "Button icon", "info": "Optional. Replaces the default arrow inside the button. Square PNG/SVG, shown at 24x24px." },
    { "type": "text", "id": "soldout_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "select", "id": "after_add", "label": "After adding to cart", "default": "cart", "options": [ { "value": "cart", "label": "Open cart drawer" }, { "value": "checkout", "label": "Go to checkout" } ], "info": "Cart drawer needs Theme settings > Cart > Type = Drawer; otherwise it goes to the cart page." },
