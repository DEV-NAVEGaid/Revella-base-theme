{% render 'oc-assets' %}
{%- liquid
  assign s = section.settings
  assign p = s.product | default: product
  assign points = section.blocks | where: 'type', 'point'
  assign packs = section.blocks | where: 'type', 'pack'
  assign perks = section.blocks | where: 'type', 'perk'
  assign init_qty = 1
  assign init_plan = ''
  if p != blank
    assign cur = p.selected_or_first_available_variant
    assign title = s.title | default: p.title
    assign main = cur.featured_media | default: p.featured_media
  else
    assign title = s.title
  endif
-%}
{%- capture check_icon -%}
  {%- if s.check_icon != blank -%}
    {{ s.check_icon | image_url: width: 64 | image_tag: loading: 'lazy', class: 'ck-img', alt: '' }}
  {%- else -%}
    {% render 'oc-icon', icon: s.check_style %}
  {%- endif -%}
{%- endcapture -%}
<div class="lm{% if s.bf_accents %} lm-bf{% endif %}">
  <section class="prod" id="{{ s.anchor | default: 'product' | handle }}"{% if s.background != blank %} style="background: {{ s.background }}"{% endif %}>
    <lm-product class="prod-i">
      {%- if p != blank -%}
        <script type="application/json" data-lm-json>
          {
            "moneyFormat": {{ shop.money_format | strip_html | json }},
            "variants": [
              {%- for v in p.variants -%}
                {
                  "id": {{ v.id }},
                  "option1": {{ v.option1 | json }},
                  "price": {{ v.price }},
                  "compare": {{ v.compare_at_price | default: 0 }},
                  "available": {{ v.available | json }},
                  "mediaId": {{ v.featured_media.id | default: 0 }},
                  "image": {% if v.featured_media %}{{ v.featured_media | image_url: width: 1400 | json }}{% else %}null{% endif %},
                  "plans": {
                    {%- for a in v.selling_plan_allocations -%}
                      "{{ a.selling_plan.id }}": {{ a.price }}{% unless forloop.last %},{% endunless %}
                    {%- endfor -%}
                  }
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          }
        </script>
      {%- endif -%}

      <div class="pmedia">
        <div class="main-img">
          {%- if s.bf_accents and s.bf_callout != blank %}<span class="bf-tag">{{ s.bf_callout }}</span>{% endif -%}
          {%- if p != blank and main != blank -%}
            <img
              data-main-img
              src="{{ main | image_url: width: 1100 }}"
              srcset="{{ main | image_url: width: 550 }} 550w, {{ main | image_url: width: 800 }} 800w, {{ main | image_url: width: 1100 }} 1100w, {{ main | image_url: width: 1400 }} 1400w"
              sizes="(min-width: 990px) 55vw, 100vw"
              alt="{{ main.alt | default: title | escape }}"
              width="{{ main.preview_image.width }}"
              height="{{ main.preview_image.height }}"
              {% if section.index == 1 %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
            >
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'ph-svg' }}
          {%- endif -%}
          {%- if s.show_arrows and s.show_thumbs and p != blank and p.media.size > 1 -%}
            <button type="button" class="m-nav prev" data-media-dir="-1" aria-label="Previous image">{% if s.prev_icon != blank %}{{ s.prev_icon | image_url: width: 80 | image_tag: loading: 'lazy', class: 'nv-img', alt: '' }}{% else %}{% render 'oc-icon', icon: 'chev-left' %}{% endif %}</button>
            <button type="button" class="m-nav next" data-media-dir="1" aria-label="Next image">{% if s.next_icon != blank %}{{ s.next_icon | image_url: width: 80 | image_tag: loading: 'lazy', class: 'nv-img', alt: '' }}{% else %}{% render 'oc-icon', icon: 'chev-right' %}{% endif %}</button>
          {%- endif -%}
        </div>
        {%- if s.show_thumbs -%}
          <div class="thumbs">
            {%- if p != blank and p.media.size > 1 -%}
              {%- for m in p.media limit: s.thumb_limit -%}
                <button type="button" class="thumb{% if m.id == main.id %} on{% endif %}" data-src="{{ m | image_url: width: 1400 }}" data-media-id="{{ m.id }}" aria-label="Show image {{ forloop.index }}">
                  {{- m | image_url: width: 120 | image_tag: loading: 'lazy', width: 59, height: 59, alt: '' -}}
                </button>
              {%- endfor -%}
            {%- elsif p == blank -%}
              {%- for i in (1..4) -%}
                <span class="thumb{% if forloop.first %} on{% endif %}">{{ 'product-1' | placeholder_svg_tag: 'ph-svg' }}</span>
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="info">
        <div class="ph-head">
          <div class="ph-top">
            {%- if s.show_rating -%}
              <div class="ph-rate">{% render 'oc-stars' %}<span>{{ s.rating_text }}</span></div>
            {%- endif -%}
            <h2 class="ph-title">{{ title }}</h2>
          </div>
          {%- if s.description != blank -%}
            <div class="ph-desc">{{ s.description }}</div>
          {%- elsif p != blank and p.description != blank -%}
            <div class="ph-desc">{{ p.description }}</div>
          {%- endif -%}
          {%- if s.highlight != blank %}<p class="ph-hl">{{ s.highlight }}</p>{% endif -%}
        </div>

        {%- if points.size > 0 -%}
          <ul class="tps">
            {%- for block in points -%}
              <li {{ block.shopify_attributes }}>{% if block.settings.icon != blank %}{{ block.settings.icon | image_url: width: 64 | image_tag: loading: 'lazy', class: 'ck-img', alt: '' }}{% else %}{{ check_icon }}{% endif %}<span>{{ block.settings.text }}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="bundle">
          {%- comment -%} Flavor = first product option {%- endcomment -%}
          {%- if s.show_flavors -%}
            {%- if p != blank -%}
              {%- unless p.has_only_default_variant -%}
                <p class="lbl3">{{ s.flavor_label | default: p.options_with_values.first.name }}</p>
                <div class="flv">
                  {%- for value in p.options_with_values.first.values -%}
                    {%- assign vname = value.name | default: value -%}
                    {%- assign fv = nil -%}
                    {%- for v in p.variants -%}
                      {%- if fv == nil and v.option1 == vname %}{% assign fv = v %}{% endif -%}
                    {%- endfor -%}
                    <button type="button" class="fo{% if vname == cur.option1 %} on{% endif %}" data-value="{{ vname | escape }}" aria-pressed="{% if vname == cur.option1 %}true{% else %}false{% endif %}">
                      <span class="fm">
                        {%- if fv.featured_media != blank -%}
                          {{ fv.featured_media | image_url: width: 200 | image_tag: loading: 'lazy', width: 84, height: 84, alt: '' }}
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'ph-svg' }}
                        {%- endif -%}
                      </span>
                      <span class="fn">{{ vname }}</span>
                      {%- if forloop.index == s.bestseller_position and s.bestseller_text != blank %}<span class="fbadge">{{ s.bestseller_text }}</span>{% endif -%}
                    </button>
                  {%- endfor -%}
                </div>
              {%- endunless -%}
            {%- endif -%}
          {%- endif -%}

          {%- if packs.size > 0 -%}
            {%- if s.packs_label != blank %}<p class="lbl3" style="color: rgba(21,35,30,.8)">{{ s.packs_label }}</p>{% endif -%}
            {%- if s.bf_callout != blank -%}
              <p class="bf-call"><b>{{ s.bf_callout }}</b>{% if s.bf_callout_note != blank %}<span>{{ s.bf_callout_note }}</span>{% endif %}</p>
            {%- endif -%}
            <div class="packs">
              {%- for block in packs -%}
                {%- liquid
                  assign b = block.settings
                  assign is_on = false
                  if forloop.index == s.default_pack
                    assign is_on = true
                  endif
                  if p != blank
                    assign qty = b.quantity
                    assign unit = cur.price
                    assign plan_ok = false
                    if b.selling_plan_id != blank
                      for a in cur.selling_plan_allocations
                        assign aid = a.selling_plan.id | append: ''
                        if aid == b.selling_plan_id
                          assign unit = a.price
                          assign plan_ok = true
                        endif
                      endfor
                    endif
                    assign free = b.free | default: 0
                    assign paid = qty | minus: free | at_least: 1
                    assign total = unit | times: paid
                    assign cmp_unit = cur.price
                    if cur.compare_at_price > cur.price
                      assign cmp_unit = cur.compare_at_price
                    endif
                    assign cmpt = cmp_unit | times: qty
                    assign day_count = b.days | times: qty
                    assign perday = total | times: 1.0 | divided_by: day_count | round
                    assign pct = 0
                    if cmpt > 0
                      assign pct = cmpt | minus: total | times: 100.0 | divided_by: cmpt | round
                    endif
                    if is_on
                      assign init_qty = qty
                      if plan_ok
                        assign init_plan = b.selling_plan_id
                      endif
                    endif
                  endif
                  assign ben_lines = b.benefits | newline_to_br | split: '<br />'
                -%}
                <button
                  type="button"
                  class="pk{% if is_on %} on{% endif %}"
                  aria-pressed="{{ is_on }}"
                  data-qty="{{ b.quantity }}"
                  data-free="{{ b.free | default: 0 }}"
                  data-plan="{{ b.selling_plan_id | strip }}"
                  data-days="{{ b.days }}"
                  data-perday-label="{{ b.per_day_label | escape }}"
                  data-off-suffix="{{ b.off_suffix | escape }}"
                  {% if b.off_text != blank %}data-off-text="1"{% endif %}
                  {{ block.shopify_attributes }}
                >
                  {%- if b.badge != blank %}<span class="lmx-rib">{{ b.badge }}</span>{% endif -%}
                  <div class="pk-row">
                    <div class="pk-main">
                      <span class="radio"><i></i></span>
                      <div class="pk-t">
                        <b>{{ b.title }}</b>
                        {%- unless b.hide_per_day -%}
                          {%- if p != blank %}<span data-perday>{{ perday | money }} {{ b.per_day_label }}</span>{% endif -%}
                        {%- endunless -%}
                      </div>
                    </div>
                    {%- if b.off_text != blank -%}
                      <span class="pk-off" data-off>{{ b.off_text }}</span>
                    {%- elsif p != blank -%}
                      <span class="pk-off" data-off{% if pct <= 0 %} style="visibility: hidden"{% endif %}>{{ pct }}{{ b.off_suffix }}</span>
                    {%- else -%}
                      <span></span>
                    {%- endif -%}
                    <div class="pk-pr">
                      {%- if p != blank -%}
                        <s data-compare{% if cmpt <= total %} hidden{% endif %}>{{ cmpt | money }}</s><b data-total>{{ total | money }}</b>
                      {%- endif -%}
                    </div>
                  </div>
                  {%- if b.benefits != blank -%}
                    <ul class="pk-ben">
                      {%- for line in ben_lines -%}
                        {%- assign l = line | strip -%}
                        {%- if l != blank %}<li>{{ check_icon }}<span>{{ l }}</span></li>{% endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                  {%- if b.callout_text != blank -%}
                <span class="pk-call"><span>{{ b.callout_text }}</span>{%- if b.callout_compare != blank -%}<s>{{ b.callout_compare }}</s>{%- endif -%}</span>
              {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if s.show_otp -%}
            <div class="otp">
              <a href="{% if p != blank %}#{% else %}#product{% endif %}"{% if p != blank %} data-otp{% endif %}>
                {{- s.otp_label }} <span data-otp-price>{% if p != blank %}{{ cur.price | money }}{% endif %}</span>
              </a>
            </div>
          {%- endif -%}

          {%- if p != blank -%}
            {%- form 'product', p, class: 'lm-form', novalidate: 'novalidate' -%}
              <input type="hidden" name="id" value="{{ cur.id }}">
              <input type="hidden" name="quantity" value="{{ init_qty }}">
              <input type="hidden" name="selling_plan" value="{{ init_plan }}"{% if init_plan == '' %} disabled{% endif %}>
              {%- if s.after_add == 'checkout' %}<input type="hidden" name="return_to" value="/checkout">{% endif -%}
              <button type="submit" class="buy" data-label="{{ s.buy_label | escape }}" data-soldout="{{ s.soldout_label | escape }}"{% unless cur.available %} disabled{% endunless %}>
                <span data-buy-text>{% if cur.available %}{{ s.buy_label }}{% else %}{{ s.soldout_label }}{% endif %}</span>
                {%- if s.show_buy_icon -%}
                  {%- if s.buy_icon != blank %}{{ s.buy_icon | image_url: width: 96 | image_tag: loading: 'lazy', class: 'ar ar-img', alt: '' }}{% else %}{% render 'oc-icon', icon: 'arrow' %}{% endif -%}
                {%- endif -%}
              </button>
            {%- endform -%}
          {%- else -%}
            <a class="buy" href="{{ s.fallback_link | default: '#product' }}">
              <span>{{ s.buy_label }}</span>
              {%- if s.show_buy_icon -%}
                {%- if s.buy_icon != blank %}{{ s.buy_icon | image_url: width: 96 | image_tag: loading: 'lazy', class: 'ar ar-img', alt: '' }}{% else %}{% render 'oc-icon', icon: 'arrow' %}{% endif -%}
              {%- endif -%}
            </a>
          {%- endif -%}

          {%- if s.guarantee != blank and s.show_guarantee -%}
            <div class="gtee dk">
              {%- if s.guarantee_icon != blank -%}
                {{ s.guarantee_icon | image_url: width: 80 | image_tag: loading: 'lazy', class: 'gtee-img', alt: '' }}
              {%- else -%}
                {% render 'oc-icon', icon: 'shield' %}
              {%- endif -%}
              <p>{{ s.guarantee }}</p>
            </div>
          {%- endif -%}

          {%- if perks.size > 0 -%}
            <div class="perks">
              {%- for block in perks -%}
                <div class="perk" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 72 | image_tag: loading: 'lazy', class: 'pk-img', alt: '' }}
                  {%- else -%}
                    {% render 'oc-icon', icon: block.settings.icon %}
                  {%- endif -%}
                  <span>{{ block.settings.text }}</span>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- assign accs = section.blocks | where: 'type', 'accordion' -%}
          {%- if accs.size > 0 -%}
            <div class="fl pacc" data-pacc>
              {%- for block in accs -%}
                <details class="qi" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
                  <summary><span>{{ block.settings.title }}</span><span class="ic">{% render 'oc-icon', icon: 'faq' %}</span></summary>
                  <div class="an">{{ block.settings.content }}</div>
                </details>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </lm-product>
    {%- if p != blank -%}
      <div class="lm-sticky" data-lm-sticky="{{ section.id }}" aria-hidden="true">
        <button type="button" class="buy lm-sticky-btn" tabindex="-1"{% unless cur.available %} disabled{% endunless %}>
          <span data-sticky-text>{% if cur.available %}{{ s.buy_label }}{% else %}{{ s.soldout_label }}{% endif %}</span>
          {%- if s.show_buy_icon -%}
            {%- if s.buy_icon != blank %}{{ s.buy_icon | image_url: width: 96 | image_tag: loading: 'lazy', class: 'ar ar-img', alt: '' }}{% else %}{% render 'oc-icon', icon: 'arrow' %}{% endif -%}
          {%- endif -%}
        </button>
      </div>
      <style>
        .lm .pacc { margin-top: 24px; }
        .lm .pacc .an { overflow: hidden; }
        .lm .pk { position: relative; }
        .lm .pk:has(.lmx-rib) { margin-top: 10px; padding-top: 18px; }
        .lm .pk .lmx-rib { position: absolute; top: -11px; left: 46px; display: inline-block; width: auto; height: auto; padding: 4px 10px; border-radius: 999px; background: #1b7a66; color: #fff; font-size: 11px; line-height: 13px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; box-shadow: 0 6px 14px -6px rgba(21,35,30, .5); }
        .lm .pk.on .lmx-rib { background: #15231e; }
        .lm .pk-t b { white-space: nowrap; }
      .lm .pk-call { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 12px -18px -10px; padding: 9px 18px; border-top: 1px solid #dde8e2; border-radius: 0 0 19px 19px; background: #f1f6f3; color: #15231e; font-size: 14px; font-weight: 700; line-height: 1.3; text-align: left; }
    .lm .pk-call s { flex-shrink: 0; color: #5f736a; font-weight: 400; }
    .lm .pk.on .pk-call { background: #c5ddd2; border-top-color: #aecdbf; }
    @media (max-width: 749px) { .lm .pk-call { font-size: 13px; padding: 8px 16px; margin: 10px -18px -10px; } }
        .lm .bundle p.bf-call { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0 0 12px; padding: 10px 18px; border-radius: 12px; background: #0b0b0b; color: #fff; font-size: 13px; line-height: 16px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
        .lm .bf-call b { font-weight: 800; color: #f2c14e; }
        .lm .bf-call b, .lm .bf-call span { white-space: nowrap; }
        @media (max-width: 374px) { .lm .bundle p.bf-call { padding: 10px 14px; font-size: 12px; letter-spacing: .02em; } }
        @media (max-width: 389px) { .lm .prod .pk-row { column-gap: 6px; } .lm .prod .pk-t b { font-size: 16px; line-height: 20px; } .lm .prod .pk-off { height: 24px; padding: 0 7px; font-size: 12px; line-height: 12px; } }
        @media (max-width: 349px) { .lm .prod .pk { padding-left: 12px; padding-right: 12px; } .lm .prod .pk-main { gap: 8px; } .lm .prod .pk-t b { font-size: 15px; } .lm .prod .pk-pr b { font-size: 18px; line-height: 22px; } .lm .prod .pk-pr s { font-size: 14px; line-height: 20px; } .lm .prod .pk-call { margin-left: -12px; margin-right: -12px; padding-left: 12px; padding-right: 12px; } }
        .lm .bf-tag { position: absolute; top: 12px; left: 12px; z-index: 1; padding: 7px 12px; border-radius: 4px; background: #0b0b0b; color: #f2c14e; font-size: 12px; line-height: 14px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; pointer-events: none; }
        .lm.lm-bf .pk-off { background: #0b0b0b; color: #f2c14e; }
        .lm.lm-bf .pk .lmx-rib, .lm.lm-bf .pk.on .lmx-rib { background: #0b0b0b; color: #f2c14e; }
        .lm .main-img { cursor: grab; user-select: none; -webkit-user-select: none; }
        .lm .main-img:active { cursor: grabbing; }
        .lm .lm-sticky { display: none; }
        @media (max-width: 749px) {
          .lm .lm-sticky {
            display: block; position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
            padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
            background: transparent; box-shadow: none;
            transform: translateY(110%); transition: transform .28s ease; pointer-events: none;
          }
          .lm .lm-sticky.is-on { transform: translateY(0); pointer-events: auto; }
          .lm .lm-sticky .lm-sticky-btn { width: 100%; margin: 0; box-shadow: 0 6px 18px rgba(21,35,30, .22); }
        }
      </style>
      <script>
        (function () {
          var bar = document.querySelector('[data-lm-sticky="{{ section.id }}"]');
          if (!bar) return;
          var root = bar.closest('.prod');
          var main = root && root.querySelector('form.lm-form button.buy');
          var btn = bar.querySelector('button');
          var label = bar.querySelector('[data-sticky-text]');
          if (!main || !btn) return;
          var mq = window.matchMedia('(max-width: 749px)');
          var hidden = false;
          function render() {
            var on = mq.matches && hidden;
            bar.classList.toggle('is-on', on);
            bar.setAttribute('aria-hidden', on ? 'false' : 'true');
            btn.tabIndex = on ? 0 : -1;
          }
          function sync() {
            btn.disabled = main.disabled;
            var t = main.querySelector('[data-buy-text]');
            if (t && label) label.textContent = t.textContent;
          }
          new IntersectionObserver(function (entries) {
            var e = entries[0]; hidden = !e.isIntersecting && e.boundingClientRect.top < 0;
            render();
          }).observe(main);
          new MutationObserver(sync).observe(main, { attributes: true, attributeFilter: ['disabled'], childList: true, subtree: true, characterData: true });
          if (mq.addEventListener) mq.addEventListener('change', render);
          btn.addEventListener('click', function () { if (!main.disabled) main.click(); });
          sync();
        })();
      </script>
      <script>
          (function () {
            var root = document.querySelector('#shopify-section-{{ section.id }} [data-pacc]');
            if (!root) return;
            var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            root.querySelectorAll('.qi').forEach(function (d) {
              var sum = d.querySelector('summary');
              var body = d.querySelector('.an');
              var anim = null;
              function run(from, to, done) {
                if (anim) anim.cancel();
                anim = body.animate([{ height: from + 'px', opacity: from ? 1 : 0 }, { height: to + 'px', opacity: to ? 1 : 0 }], { duration: 320, easing: 'cubic-bezier(.4, 0, .2, 1)' });
                anim.onfinish = function () { anim = null; done && done(); };
              }
              sum.addEventListener('click', function (e) {
                if (reduce || !body.animate) return;
                e.preventDefault();
                if (d.open && !d.classList.contains('closing')) {
                  d.classList.add('closing');
                  run(body.offsetHeight, 0, function () { d.open = false; d.classList.remove('closing'); });
                } else {
                  d.classList.remove('closing');
                  d.open = true;
                  run(0, body.offsetHeight);
                }
              });
            });
          })();
        </script>
      <script>
        (function () {
          var box = document.querySelector('#shopify-section-{{ section.id }} .main-img');
          if (!box) return;
          var img = box.querySelector('[data-main-img]');
          var next = box.querySelector('.m-nav.next');
          var prev = box.querySelector('.m-nav.prev');
          if (!img || !next || !prev) return;
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var EASE = 'transform .32s cubic-bezier(.4, 0, .2, 1), opacity .32s ease';
          var sx = 0, sy = 0, dx = 0, active = false, axis = null, pid = null, suppressClick = false;
          box.style.touchAction = 'pan-y';
          img.draggable = false;
          box.addEventListener('pointerdown', function (e) {
            if (e.target.closest('.m-nav') || (e.pointerType === 'mouse' && e.button !== 0)) return;
            active = true; axis = null; dx = 0; sx = e.clientX; sy = e.clientY; pid = e.pointerId;
            img.style.transition = 'none';
          });
          box.addEventListener('pointermove', function (e) {
            if (!active || e.pointerId !== pid) return;
            dx = e.clientX - sx;
            var dy = e.clientY - sy;
            if (axis === null && (Math.abs(dx) > 6 || Math.abs(dy) > 6)) {
              axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
              if (axis === 'x') { try { box.setPointerCapture(pid); } catch (err) {} }
            }
            if (axis === 'x') img.style.transform = 'translateX(' + dx * 0.6 + 'px)';
          });
          function end() {
            if (!active) return;
            active = false;
            var moved = dx;
            var swiped = axis === 'x' && Math.abs(moved) > 6;
            var go = axis === 'x' && Math.abs(moved) > 45;
            /* Reset drag state so later arrow taps are not treated as part of this swipe */
            axis = null; dx = 0;
            /* Only block the one native click the browser fires right after a drag */
            if (swiped) { suppressClick = true; setTimeout(function () { suppressClick = false; }, 0); }
            img.style.transition = reduce ? 'none' : EASE;
            if (!go) { img.style.transform = ''; return; }
            var dir = moved < 0 ? 1 : -1;
            if (reduce) { img.style.transform = ''; (dir > 0 ? next : prev).click(); return; }
            img.style.transform = 'translateX(' + (-dir * 60) + 'px)';
            img.style.opacity = '0';
            setTimeout(function () {
              (dir > 0 ? next : prev).click();
              img.style.transition = 'none';
              img.style.transform = 'translateX(' + (dir * 60) + 'px)';
              requestAnimationFrame(function () {
                requestAnimationFrame(function () {
                  img.style.transition = EASE;
                  img.style.transform = '';
                  img.style.opacity = '1';
                });
              });
            }, 200);
          }
          box.addEventListener('pointerup', end);
          box.addEventListener('pointercancel', end);
          box.addEventListener('click', function (e) {
            /* Let the swipe's own next/prev click through (it is not a trusted user click) */
            if (!suppressClick || !e.isTrusted) return;
            suppressClick = false;
            e.preventDefault(); e.stopPropagation();
          }, true);
        })();
      </script>
    {%- endif -%}
  </section>
</div>

