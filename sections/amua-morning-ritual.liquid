{%- style -%}
  #amua-mr-{{ section.id }},
  #amua-mr-{{ section.id }} * { box-sizing: border-box; }

  #amua-mr-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 16px {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
  }

  .amua-mr { max-width: 700px; margin: 0 auto; }

  /* ── Heading ── */
  .amua-mr__heading {
    text-align: center;
    margin: 0 0 {{ section.settings.heading_gap }}px;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    color: {{ section.settings.heading_color }};
    line-height: 1.15;
  }
  .amua-mr__heading-highlight {
    display: block;
    background: linear-gradient({{ section.settings.gradient_angle }}deg, {{ section.settings.gradient_from }}, {{ section.settings.gradient_to }});
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ── Subtitle ── */
  .amua-mr__subtitle {
    text-align: center;
    margin: 0 0 {{ section.settings.subtitle_gap }}px;
    font-size: {{ section.settings.subtitle_size }}px;
    font-weight: {{ section.settings.subtitle_weight }};
    color: {{ section.settings.subtitle_color }};
    line-height: 1.5;
  }

  /* ── Step Card ── */
  .amua-mr__card {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    border: {{ section.settings.card_border_width }}px dashed {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_padding }}px;
    margin-bottom: {{ section.settings.card_gap }}px;
    background: {{ section.settings.card_bg }};
  }
  .amua-mr__card:last-child { margin-bottom: 0; }

  /* ── Media (video/image) ── */
  .amua-mr__media {
    flex: 0 0 {{ section.settings.media_width }}%;
    aspect-ratio: {{ section.settings.media_ratio }};
    border-radius: {{ section.settings.media_radius }}px;
    overflow: hidden;
    background: #eee;
  }
  .amua-mr__media video,
  .amua-mr__media img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }

  /* ── Content ── */
  .amua-mr__content {
    flex: 1;
    min-width: 0;
    padding-top: 4px;
  }

  /* ── Step Number ── */
  .amua-mr__step-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .amua-mr__num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.num_size }}px;
    height: {{ section.settings.num_size }}px;
    border-radius: 50%;
    border: 2px solid {{ section.settings.num_border_color }};
    font-size: {{ section.settings.num_font_size }}px;
    font-weight: 700;
    color: {{ section.settings.num_text_color }};
    background: {{ section.settings.num_bg }};
    flex-shrink: 0;
  }

  /* ── Step Title ── */
  .amua-mr__step-title {
    margin: 0;
    line-height: 1.25;
  }

  /* ── Step Description ── */
  .amua-mr__step-desc {
    margin: 0;
    line-height: 1.55;
  }

  /* ── Desktop ── */
  @media (min-width: 990px) {
    #amua-mr-{{ section.id }} { padding-left: 50px; padding-right: 50px; }
    .amua-mr__card { gap: 20px; }
  }
{%- endstyle -%}

<section id="amua-mr-{{ section.id }}">
  <div class="amua-mr">

    {%- if section.settings.heading != blank -%}
      <h2 class="amua-mr__heading">
        {{ section.settings.heading }}
        {%- if section.settings.heading_highlight != blank -%}
          <span class="amua-mr__heading-highlight">{{ section.settings.heading_highlight }}</span>
        {%- endif -%}
      </h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="amua-mr__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'step' -%}
        <div class="amua-mr__card" {{ block.shopify_attributes }}>

          {%- comment -%}── Media ──{%- endcomment -%}
          <div class="amua-mr__media">
            {%- if block.settings.video != blank -%}
              {{
                block.settings.video
                | video_tag:
                    autoplay: true,
                    muted: true,
                    loop: true,
                    playsinline: true,
                    controls: false,
                    image_size: '600x'
              }}
            {%- elsif block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.image.alt | escape | default: block.settings.title }}"
                loading="lazy" width="600" height="600"
              >
            {%- endif -%}
          </div>

          {%- comment -%}── Content ──{%- endcomment -%}
          <div class="amua-mr__content">
            <div class="amua-mr__step-header">
              <span class="amua-mr__num">{{ forloop.index }}</span>
              {%- if block.settings.title != blank -%}
                <h3 class="amua-mr__step-title" style="font-size:{{ block.settings.title_size }}px;font-weight:{{ block.settings.title_weight }};color:{{ block.settings.title_color }};">
                  {{ block.settings.title }}
                </h3>
              {%- endif -%}
            </div>

            {%- if block.settings.description != blank -%}
              <p class="amua-mr__step-desc" style="font-size:{{ block.settings.desc_size }}px;color:{{ block.settings.desc_color }};">
                {{ block.settings.description }}
              </p>
            {%- endif -%}
          </div>

        </div>
      {%- endif -%}
    {%- endfor -%}

  </div>
</section>

{% schema %}
{
  "name": "Amua: Morning Ritual",
  "tag": "section",
  "class": "amua-section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading (line 1)", "default": "The Morning Ritual" },
    { "type": "text", "id": "heading_highlight", "label": "Heading (highlighted line)", "default": "That Builds Your Curves" },
    { "type": "range", "id": "heading_size", "label": "Heading size (px)", "min": 22, "max": 48, "step": 1, "default": 32 },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "options": [{ "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra Bold" }, { "value": "900", "label": "Black" }], "default": "900" },
    { "type": "color", "id": "heading_color", "label": "Heading color (line 1)", "default": "#121212" },
    { "type": "range", "id": "heading_gap", "label": "Heading bottom gap (px)", "min": 4, "max": 30, "step": 2, "default": 10 },

    { "type": "header", "content": "Gradient (highlighted line)" },
    { "type": "color", "id": "gradient_from", "label": "Gradient start", "default": "#F5D56A" },
    { "type": "color", "id": "gradient_to", "label": "Gradient end", "default": "#E8A820" },
    { "type": "range", "id": "gradient_angle", "label": "Gradient angle (°)", "min": 0, "max": 360, "step": 15, "default": 90 },

    { "type": "header", "content": "Subtitle" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Follow these simple steps to get started" },
    { "type": "range", "id": "subtitle_size", "label": "Subtitle size (px)", "min": 12, "max": 20, "step": 1, "default": 15 },
    { "type": "select", "id": "subtitle_weight", "label": "Subtitle weight", "options": [{ "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }], "default": "400" },
    { "type": "color", "id": "subtitle_color", "label": "Subtitle color", "default": "#777777" },
    { "type": "range", "id": "subtitle_gap", "label": "Subtitle bottom gap (px)", "min": 10, "max": 50, "step": 2, "default": 28 },

    { "type": "header", "content": "Step Cards" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "card_border_color", "label": "Card border color", "default": "#EDCC6A" },
    { "type": "range", "id": "card_border_width", "label": "Card border width (px)", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "card_radius", "label": "Card radius (px)", "min": 0, "max": 24, "step": 2, "default": 14 },
    { "type": "range", "id": "card_padding", "label": "Card padding (px)", "min": 0, "max": 30, "step": 2, "default": 14 },
    { "type": "range", "id": "card_gap", "label": "Gap between cards (px)", "min": 10, "max": 40, "step": 2, "default": 20 },

    { "type": "header", "content": "Media" },
    { "type": "range", "id": "media_width", "label": "Media width (%)", "min": 30, "max": 55, "step": 1, "default": 40 },
    { "type": "text", "id": "media_ratio", "label": "Media aspect ratio", "default": "4 / 5", "info": "e.g. 1 / 1, 4 / 5, 3 / 4" },
    { "type": "range", "id": "media_radius", "label": "Media radius (px)", "min": 0, "max": 16, "step": 2, "default": 8 },

    { "type": "header", "content": "Step Number" },
    { "type": "range", "id": "num_size", "label": "Circle size (px)", "min": 24, "max": 48, "step": 2, "default": 34 },
    { "type": "range", "id": "num_font_size", "label": "Number font size (px)", "min": 12, "max": 24, "step": 1, "default": 16 },
    { "type": "color", "id": "num_border_color", "label": "Circle border color", "default": "#EDBA2A" },
    { "type": "color", "id": "num_text_color", "label": "Number color", "default": "#EDBA2A" },
    { "type": "color", "id": "num_bg", "label": "Circle background", "default": "#ffffff" },

    { "type": "header", "content": "Section" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Padding bottom", "default": 40 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 5,
      "settings": [
        { "type": "header", "content": "Media" },
        { "type": "video", "id": "video", "label": "Video", "info": "Upload via Settings > Files, then select here" },
        { "type": "image_picker", "id": "image", "label": "Image (fallback if no video)" },
        { "type": "header", "content": "Content" },
        { "type": "text", "id": "title", "label": "Title", "default": "Squeeze & Fill" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Use the dropper to draw 2ml every morning. Same time. Same routine. That consistency is what makes it work." },
        { "type": "header", "content": "Style" },
        { "type": "range", "id": "title_size", "label": "Title size (px)", "min": 16, "max": 28, "step": 1, "default": 20 },
        { "type": "select", "id": "title_weight", "label": "Title weight", "options": [{ "value": "600", "label": "Semi Bold" }, { "value": "700", "label": "Bold" }, { "value": "800", "label": "Extra Bold" }], "default": "800" },
        { "type": "color", "id": "title_color", "label": "Title color", "default": "#121212" },
        { "type": "range", "id": "desc_size", "label": "Description size (px)", "min": 12, "max": 18, "step": 1, "default": 14 },
        { "type": "color", "id": "desc_color", "label": "Description color", "default": "#444444" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Amua: Morning Ritual",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Squeeze & Fill",
            "description": "Use the dropper to draw 2ml every morning. Same time. Same routine. That consistency is what makes it work."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Drop & Absorb",
            "description": "Place it under your tongue or mix it into your morning drink. Your body starts absorbing the curve-building signal right away."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Stay the Course",
            "description": "Women who show up every morning for 90 days are the ones who stop scrolling and start showing off. Let VitalDrops do the rest."
          }
        }
      ]
    }
  ]
}
{% endschema %}
