        "sign_ok4r05": {
          "type": "sign",
          "settings": {
            "heading": "It Is The Only Antioxidant Built To Guard Both Sides Of The Cell Wall",
            "image": "shopify://shop_images/molecule-transmembrane-1x1.gif",
            "image_alt": "Astaxanthin molecule spanning both sides of a cell membrane",
            "body": "<p>Vitamin C works in watery areas outside the cell. Vitamin E works in the fatty parts of the membrane. Most antioxidants guard one zone and leave the rest exposed.</p><p>Astaxanthin is shaped differently.</p><p>Its long molecule threads through the entire cell membrane. One end faces out. One end faces in. The protective chain locks across the wall between them.</p><p>That lets astaxanthin intercept damage from both directions while physically reinforcing the membrane itself. It can also cross the blood-brain barrier and travel to the brain, heart, eyes, joints, skin, and muscle tissue other compounds struggle to reach.</p>",
            "close_text": "Other antioxidants float past the wall. Astaxanthin moves in and stands guard.",
            "show_inline_cta": false,
            "inline_cta_text": "",
            "inline_cta_label": "Put the King of Antioxidants on guard",
            "testimonial_1_initial": "",
