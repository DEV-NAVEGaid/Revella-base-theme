        "faq_ok4b1": {
          "type": "faq",
          "settings": {
            "question": "What is astaxanthin?",
            "answer": "<p>Astaxanthin is the deep red antioxidant made by microalgae under extreme stress. It is the pigment that gives wild salmon, shrimp, and flamingos their color. Its unusual shape lets it span both sides of the cell membrane.</p>"
          }
        },
        "faq_ok4b2": {
          "type": "faq",
          "settings": {
            "question": "What benefits can I expect?",
            "answer": "<p>Astaxanthin has been studied for oxidative stress, inflammation, skin hydration and elasticity, daily energy and endurance, cardiovascular markers, eye fatigue, and joint comfort. Individual results and timing vary.</p>"
          }
        },
        "faq_ok4b3": {
          "type": "faq",
          "settings": {
            "question": "How many do I take a day?",
            "answer": "<p>One softgel, once a day, with a meal that contains some fat. Breakfast works well for most people.</p>"
          }
