        "review_group_nr3dGW": {
          "type": "review_group",
          "disabled": true,
          "settings": {
            "name_1": "Connie L.",
            "rating_1": 5,
            "text_1": "the hip pain went from a constant 7 to maybe a 3. its not perfect but going from 7 to 3 gave me my life back.",
            "image_url_1": "",
            "name_2": "Dorothy V.",
            "rating_2": 5,
            "text_2": "I stopped taking it after 2 months because i felt fine. within 10 days everything came back. the stiffness, the swelling, the pain getting out of bed. reordered immediately. i will never stop taking this again. lesson learned.",
            "image_url_2": "",
            "name_3": "Valerie C.",
            "rating_3": 5,
            "text_3": "i couldnt open a water bottle. couldnt grip a pen. couldnt hold my grandsons hand without pain. by week 8 i held my grandsons hand on a walk and squeezed it. he squeezed back. that was worth more than i can explain here.",
            "image_url_3": "",
            "name_4": "Marilyn A.",
            "rating_4": 5,
            "text_4": "frozen shoulder club. mine lasted 14 months before i found this. by week 4 the pain at night reduced. by week 8 i could reach behind my back. im at 80% and 80% is a miracle compared to where i was.",
            "image_url_4": "",
            "name_5": "Shirley F.",
            "rating_5": 5,
            "text_5": "i tried SO many things. turmeric. glucosamine. boswellia. collagen. fish oil. literally everything. none of them did what this does. week 6 i understood the difference.",
            "image_url_5": ""
          }
