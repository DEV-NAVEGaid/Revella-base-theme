    "information_card_igAJVJ": {
      "type": "information-card",
      "blocks": {
        "card_9m7djb": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/1.png",
            "eyebrow": "",
            "title": "Repairs at the Source",
            "text": "<p>Joint pain is a cellular problem. Cartilage and tendons break down from the inside, faster than your body can rebuild them. Astaxanthin reaches inside the cell and stops the damage where it actually starts. </p>"
          }
        },
        "card_dTUAaG": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/2_f3a0691d-e128-4bda-9344-a430b1cbe76a.png",
            "eyebrow": "",
            "title": "Driver of Aging: Inflammation",
            "text": "<p>Chronic inflammation is what scientists now call \"inflammaging.\" It's the root cause behind heart disease, joint breakdown, declining brain function, and how fast you age overall. Astaxanthin is one of the most powerful inflammation suppressors ever measured, with 30+ years of research backing it.</p>"
          }
        },
        "card_hWhKrE": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/3.png",
            "eyebrow": "",
            "title": "Backed by Earth's Longest-Living People",
            "text": "<p>Astaxanthin is what gives salmon their pink color, flamingos their red, and the people of Okinawa, Japan their place as the longest-living humans on Earth. They get it daily through their seafood diet. They live longer than anyone.</p>"
          }
        },
        "card_DLtUhH": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/4.png",
            "eyebrow": "",
            "title": "Reaches What Nothing Else Can",
            "text": "<p>Turmeric breaks apart in your stomach. Glucosamine floats in your bloodstream. Ibuprofen masks the signal. None of them get inside the cell. Astaxanthin is fat-soluble and water-soluble, the only compound that physically crosses the cell membrane and works from the inside.</p>"
          }
        }
      },
      "block_order": [
        "card_9m7djb",
        "card_dTUAaG",
        "card_hWhKrE",
        "card_DLtUhH"
      ],
