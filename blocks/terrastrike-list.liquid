{%- comment -%}
  Icon + rich text feature list. A theme block, so it can be added anywhere @theme
  blocks are accepted — including the product detail column on the product page.

  Each row is a "_terrastrike-list-item" child block. Shared look (icon colour and
  size, spacing, text size) is set here as inline custom properties, which the rows
  inherit — so a row only has to carry its own text, icon and any overrides.

  Styles live in assets/terrastrike.css rather than a {% stylesheet %} tag so the
  block works the same wherever it is placed.
{%- endcomment -%}

{{ 'terrastrike.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bs = block.settings

  assign styles = '--tsl-icon-size:' | append: bs.icon_size | append: 'px;'
  assign styles = styles | append: '--tsl-icon-gap:' | append: bs.icon_gap | append: 'px;'
  assign styles = styles | append: '--tsl-row-gap:' | append: bs.row_spacing | append: 'px;'
  assign styles = styles | append: '--tsl-text-size:' | append: bs.text_size | append: 'px;'
  assign styles = styles | append: '--tsl-radius:' | append: bs.corner_radius | append: 'px;'
  assign styles = styles | append: '--tsl-padding:' | append: bs.padding | append: 'px;'

  if bs.icon_color != blank
    assign styles = styles | append: '--tsl-icon-color:' | append: bs.icon_color | append: ';'
  endif
  if bs.text_color != blank
    assign styles = styles | append: '--tsl-text-color:' | append: bs.text_color | append: ';'
  endif
  if bs.background_color != blank
    assign styles = styles | append: '--tsl-bg:' | append: bs.background_color | append: ';'
  endif
-%}

<div class="ts-list" style="{{ styles }}" {{ block.shopify_attributes }}>
  {%- if bs.heading != blank -%}
    <p class="ts-list__heading">{{ bs.heading }}</p>
  {%- endif -%}

  <ul class="ts-list__items">
    {% content_for 'blocks' %}
  </ul>
</div>

{% schema %}
{
  "name": "Feature list",
  "tag": null,
  "blocks": [{ "type": "_terrastrike-list-item" }],
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Optional. Leave blank to show only the list." },

    { "type": "header", "content": "Icons" },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "info": "Each row can override this.",
      "default": "#16a085"
    },
    { "type": "range", "id": "icon_size", "min": 14, "max": 48, "step": 1, "unit": "px", "label": "Icon size", "default": 22 },

    { "type": "header", "content": "Text" },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "info": "Each row can override this.",
      "default": 17
    },
    { "type": "color", "id": "text_color", "label": "Text color", "info": "Leave empty to inherit from the theme." },

    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "icon_gap",
      "min": 4,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Space between icon and text",
      "default": 12
    },
    {
      "type": "range",
      "id": "row_spacing",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Space between rows",
      "default": 14
    },

    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "background_color", "label": "Background", "info": "Leave empty for none." },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Corner radius",
      "default": 0
    },
    { "type": "range", "id": "padding", "min": 0, "max": 48, "step": 2, "unit": "px", "label": "Inner padding", "default": 0 }
  ],
  "presets": [
    {
      "name": "Feature list",
      "category": "t:categories.product",
      "blocks": {
        "row-1": {
          "type": "_terrastrike-list-item",
          "settings": {
            "icon": "check",
            "text": "<p><strong>Spring-Loaded Tungsten Striker -</strong> Shatters Tempered Glass on Contact</p>"
          }
        },
        "row-2": {
          "type": "_terrastrike-list-item",
          "settings": {
            "icon": "check",
            "text": "<p><strong>Hidden Seatbelt Cutter -</strong> Slices Through Jammed Belts in Seconds</p>"
          }
        },
        "row-3": {
          "type": "_terrastrike-list-item",
          "settings": {
            "icon": "check",
            "text": "<p><strong>Weighs 34.5g -</strong> Smaller Than Most Key Fobs</p>"
          }
        },
        "row-4": {
          "type": "_terrastrike-list-item",
          "settings": {
            "icon": "check",
            "text": "<p><strong>Small but Mighty -</strong> Just 105mm, Breaks Glass and Cuts Belts in Seconds</p>"
          }
        }
      },
      "block_order": ["row-1", "row-2", "row-3", "row-4"]
    }
  ]
}
{% endschema %}
