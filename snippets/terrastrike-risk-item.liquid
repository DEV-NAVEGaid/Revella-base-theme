{% doc %}
  Renders one risk-statistic card in the emergency intro: image, icon + title, body.

  @param {object} block - A section block of type "risk"
  @example
  {% render 'terrastrike-risk-item', block: block %}
{% enddoc %}

<div class="ts-risk-item" {{ block.shopify_attributes }}>
  {% render 'terrastrike-image',
    image: block.settings.image,
    alt: block.settings.title,
    width: 440,
    lazy: true
  %}

  {%- if block.settings.title != blank -%}
    <div class="ts-risk-item__title">
      {% render 'terrastrike-icon', name: block.settings.icon %}
      <strong>{{ block.settings.title }}</strong>
    </div>
  {%- endif -%}

  <div class="ts-risk-item__body">{{ block.settings.body }}</div>
</div>
