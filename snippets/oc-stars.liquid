{%- comment -%}
  Five-star row. Params: rating (0-5, default 5), class (extra class on wrapper)
{%- endcomment -%}
{%- assign lm_rating = rating | default: 5 -%}
<div class="stars{% if class != blank %} {{ class }}{% endif %}">
  {%- for i in (1..5) -%}
    <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="{% if i <= lm_rating %}#239627{% else %}#d7ece6{% endif %}" d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z"></path></svg>
  {%- endfor -%}
</div>
