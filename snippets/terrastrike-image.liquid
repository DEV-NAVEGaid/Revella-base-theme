{% doc %}
  Renders a merchant-picked image with a responsive srcset, or a theme placeholder
  SVG when nothing has been picked yet — so a section never renders a broken image.

  @param {object} [image] - Image from an `image_picker` setting
  @param {string} [alt] - Alt text. Leave blank for decorative images.
  @param {string} [class] - Additional CSS class(es)
  @param {string} [style] - Inline CSS applied to the <img>, for sizes that must beat
                            the stylesheet (e.g. a per-block width override)
  @param {number} [width] - Largest width to request from the CDN. Defaults to 800.
  @param {boolean} [lazy] - When true, adds loading="lazy"
  @param {string} [placeholder] - `placeholder_svg_tag` name used when no image is set.
                                  Defaults to 'image'. Pass 'none' to render nothing.
  @example
  {% render 'terrastrike-image', image: block.settings.image, alt: block.settings.title, lazy: true %}
{% enddoc %}

{%- liquid
  assign render_width = width | default: 800

  assign loading_attr = 'eager'
  if lazy
    assign loading_attr = 'lazy'
  endif

  assign placeholder_name = placeholder | default: 'image'
  assign placeholder_class = 'ts-placeholder'
  if class != blank
    assign placeholder_class = placeholder_class | append: ' ' | append: class
  endif

  comment
    Intrinsic size, so the browser reserves the right box before the image loads.
  endcomment
  if image != blank
    assign intrinsic_width = image.width | at_most: render_width
    assign intrinsic_height = intrinsic_width | times: image.height | divided_by: image.width
  endif
-%}

{%- if image != blank -%}
  {{
    image
    | image_url: width: render_width
    | image_tag:
      class: class,
      alt: alt,
      loading: loading_attr,
      width: intrinsic_width,
      height: intrinsic_height,
      style: style,
      widths: '200, 300, 400, 500, 600, 800, 1000, 1200, 1600'
  }}
{%- elsif placeholder_name != 'none' -%}
  {{- placeholder_name | placeholder_svg_tag: placeholder_class -}}
{%- endif -%}
